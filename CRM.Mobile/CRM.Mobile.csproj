<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CRM.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>CRM Fiera</ApplicationTitle>
    <ApplicationId>it.redg.crm.fiera</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Icona composta: sfondo + primo piano. E' la forma che genera l'icona ADATTIVA di Android,
      quella che il launcher puo' ritagliare tonda, quadrata o a goccia; con un livello solo il
      disegno viene tagliato ai bordi. ForegroundScale lo riduce al 65% perche' la maschera puo'
      mangiare fino a un terzo del bordo.

      Color NON e' facoltativo: senza un colore di sfondo iOS considera l'icona trasparente e
      App Store Connect rifiuta il caricamento del pacchetto.
    -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              ForegroundScale="0.65"
              Color="#081524" />

    <!--
      Sullo splash ci va l'artwork completo: si vede grande, per qualche istante e da fermo,
      quindi il dettaglio che affonderebbe un'icona di launcher qui e' un pregio.
      BaseSize 256 e' la misura a cui viene disegnato: dai 1024px del file si ricavano il 2x e il
      3x senza mai ingrandire. Color e' il blu notte campionato dall'immagine, cosi' la cornice
      attorno all'artwork non si stacca sugli schermi di proporzioni diverse.
    -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#081524" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="9.0.111" />
  </ItemGroup>

</Project>
