<BlazorHeader Header="@($"CSV Mapping {TableName}")"></BlazorHeader>

@if (_csvMapping == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="row rounded-3 bg-light">
        <div class="col-md-8">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Campo</th>
                        <th scope="col">Colonna</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _csvMapping)
                    {
                        <tr>
                            <th scope="row">@item.FieldName</th>
                            <td><span>@item.NumCol</span></td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
}
