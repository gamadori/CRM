@using CRM.Shared

@typeparam TItem

@if (CSVFile != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
            @foreach (var field in _nameFields.Select((e, i)=> new {Index = i, Value = e}))
            {
                <th>
                    <DropDownFields Value="@field.Value"  TItem="@TItem" OnChangeName="@(async e => await OnChangeEvent(field.Index, e))"></DropDownFields>
                </th>
            }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in CSVFile)
            {
                <tr>
                    @foreach(var field in row)
                    {
                        <td>
                            <span>@field</span>
                        </td>
                    }
                </tr>    
            }
        </tbody>
    </table>
}