@typeparam TItem
@using Radzen
@using Radzen.Blazor

<div class="modern-scheduler-wrapper" @ref="_schedulerElement">
    <!-- Modern Toolbar -->
    <div class="scheduler-toolbar">
        <!-- Left: Filter -->
        <div class="toolbar-section toolbar-left">
            @Filter
        </div>

        <!-- Center: Navigation & Date -->
        <div class="toolbar-section toolbar-center">
            @* Cinque pezzi allo stesso livello, senza contenitore intermedio: cosi' sul
               telefono si possono ridisporre a griglia (frecce ai lati del periodo, data e
               Oggi sotto) invece di impilarsi a barre intere. *@
            <div class="date-navigation">
                <RadzenButton Icon="chevron_left"
                             ButtonStyle="ButtonStyle.Light"
                             Variant="Variant.Flat"
                             Size="ButtonSize.Medium"
                             Disabled="@DateLocked"
                             Click="Previous"
                             class="nav-btn nav-prev" />

                <div class="date-picker-wrapper">
                    <input type="date"
                           @onchange="OnChangeDate"
                           class="form-control date-input"
                           id="dataCurrent"
                           value="@DateCurrent.Date.ToString("yyyy-MM-dd")"
                           disabled="@DateLocked" />
                    <span class="material-icons date-icon">calendar_today</span>
                </div>

                <div class="period-display">
                    <h5 class="period-text">@_period</h5>
                </div>

                <RadzenButton Icon="chevron_right"
                             ButtonStyle="ButtonStyle.Light"
                             Variant="Variant.Flat"
                             Size="ButtonSize.Medium"
                             Disabled="@DateLocked"
                             Click="Next"
                             class="nav-btn nav-next" />

                <RadzenButton Text="@Localize["Today"]"
                             Icon="today"
                             ButtonStyle="ButtonStyle.Light"
                             Variant="Variant.Flat"
                             Size="ButtonSize.Medium"
                             Disabled="@DateLocked"
                             Click="Today"
                             class="today-btn" />
            </div>
        </div>

        <!-- Right: View Selector -->
        <div class="toolbar-section toolbar-right">
            <RadzenSelectBar @bind-Value="CurrentView" Change="ViewChanged" TValue="SchedulerViews" class="view-selector">
                <Items>
                    <RadzenSelectBarItem Text="@Localize["Month"]" Icon="calendar_view_month" Value="SchedulerViews.Month" class="month-view-option" />
                    <RadzenSelectBarItem Text="@Localize["Week"]" Icon="calendar_view_week" Value="SchedulerViews.Week" />
                    <RadzenSelectBarItem Text="@Localize["Day"]" Icon="calendar_view_day" Value="SchedulerViews.Day" />
                </Items>
            </RadzenSelectBar>
        </div>
    </div>

    <!-- Scheduler Content -->
    <div class="scheduler-content">
        <CascadingValue Value="Items" TValue="IEnumerable<TItem>" Name="Tickets">
            <CascadingValue Value="DateCurrent.Date" TValue="DateTime" Name="DateCurrent">
                <CascadingValue Value="DateProperty" TValue="string" Name="DateProperty">
                    <CascadingValue Value="TimeProperty" TValue="string" Name="TimeProperty">
                        <CascadingValue Value="DateEndProperty" TValue="string" Name="DateEndProperty">
                            <CascadingValue Value="CompanyProperty" TValue="string" Name="CompanyProperty">
                                <CascadingValue Value="UserProperty" TValue="string" Name="UserProperty">
                                    <CascadingValue Value="BackColorProperty" TValue="string" Name="BackColorProperty">
                                        <CascadingValue Value="DescriptionProperty" TValue="string" Name="DescriptionProperty">
                                            <CascadingValue Value="DateLocked" TValue="bool" Name="DateLocked">
                                                <CascadingValue Value="CurrentView" TValue="SchedulerViews" Name="CurrentView">
                                                    <CascadingValue Value="OnNewTicket" TValue="EventCallback<DateTime>" Name="OnNewTicket">
                                                        <CascadingValue Value="ViewMode" TValue="SchedulerViewMode" Name="ViewMode">
                                                            <CascadingValue Value="_dragDropContext">

                                                                @if (Loading)
                                                                {
                                                                    <WaitingSpinner></WaitingSpinner>
                                                                }
                                                                else
                                                                {
                                                                    @if (CurrentView == SchedulerViews.Week)
                                                                    {
                                                                        <AGWeekScheduler TItem="TItem" OnSelect="OnSelectDate" OpenModal="OpenModal"></AGWeekScheduler>
                                                                    }
                                                                    else if (CurrentView == SchedulerViews.Day)
                                                                    {
                                                                        <AGDayTimelineScheduler TItem="TItem" OnSelect="OnSelectDate" OpenModal="OpenModal"></AGDayTimelineScheduler>
                                                                    }
                                                                    else
                                                                    {
                                                                        <AGMonthScheduler TItem="TItem" OnSelect="OnSelectDate" OpenModal="OpenModal" OpenDaylyScheduler="OpenDaylyScheduler"></AGMonthScheduler>
                                                                    }
                                                                }
                                                            </CascadingValue>
                                                        </CascadingValue>
                                                    </CascadingValue>
                                                </CascadingValue>
                                            </CascadingValue>
                                        </CascadingValue>
                                    </CascadingValue>
                                </CascadingValue>
                            </CascadingValue>
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </div>
</div>

<!-- Detail Modal -->
<div class="offcanvas offcanvas-top h-auto" tabindex="-1" id="modalDetails" aria-labelledby="offcanvasTopLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasTopLabel">@($"{Localize["Ticket"]} #{_id}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body h-auto">
        @if (_id != null && Details != null)
        {
            @Details(_id)
        }
    </div>

    <div class="offcanvas-footer">
        <div class="container">
            <div class="m-3">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">@Localize["Close"]</button>
                <button type="button" class="btn btn-primary" @onclick="()=>OpenTicket(_id)">@Localize["Open"]</button>
            </div>
        </div>
    </div>
</div>

@* Colori solo dalle variabili del tema (--crm-*). La barra e' una riga sobria: filtro a
   sinistra, navigazione al centro, viste a destra. Niente sfondi sfumati. *@
<style>
    .modern-scheduler-wrapper {
        background: transparent;
        /* Niente min-height: 100vh. Il wrapper sta sotto l'header dell'app e il PageHeader (~200px),
           quindi imporgli un'altezza pari al viewport rendeva il documento sempre piu' alto dello
           schermo e la pagina scrollava anche con un mese quasi vuoto. */
    }

    /* Toolbar */
    .scheduler-toolbar {
        background: var(--crm-surface);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        padding: 0.6rem 0.9rem;
        margin-bottom: 0.75rem;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
    }

    .toolbar-section {
        display: flex;
        align-items: center;
    }

    .toolbar-left {
        justify-content: flex-start;
    }

    .toolbar-center {
        justify-content: center;
    }

    .toolbar-right {
        justify-content: flex-end;
    }

    /* Date Navigation */
    .date-navigation {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .nav-btn,
    .today-btn {
        transition: background-color 120ms ease;
    }

    /* Date Picker */
    .date-picker-wrapper {
        position: relative;
        width: auto;
    }

    .date-input {
        padding: 0.3rem 2.2rem 0.3rem 0.6rem;
        border: 1px solid var(--crm-border-strong);
        border-radius: var(--crm-radius-sm);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--crm-text);
        background: var(--crm-surface);
        transition: border-color 120ms ease, box-shadow 120ms ease;
        width: 100%;
    }

    .date-input:hover:not(:disabled) {
        border-color: var(--crm-primary);
    }

    .date-input:focus {
        outline: none;
        border-color: var(--crm-primary);
        box-shadow: var(--crm-focus-ring);
    }

    .date-input:disabled {
        background: var(--crm-surface-muted);
        cursor: not-allowed;
        opacity: 0.6;
    }

    .date-icon {
        position: absolute;
        right: 0.6rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--crm-text-muted);
        font-size: 18px;
        pointer-events: none;
    }

    /* Period Display: solo testo, e' il titolo della barra */
    .period-display {
        text-align: center;
        padding: 0 0.25rem;
        min-width: 9rem;
    }

    .period-text {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--crm-text);
        white-space: nowrap;
        text-transform: capitalize;
    }

    /* Scheduler Content */
    .scheduler-content {
        animation: fadeIn 0.25s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive
       Il breakpoint era a 1400px: con la sidebar la toolbar e' larga ~1030px su un monitor da
       1345px, quindi scattava SEMPRE e le tre sezioni si impilavano (221px per tre controlli che
       stanno in una riga da 40). Le tre sezioni occupano ~900px, quindi si impilano solo sotto
       i 900px veri di toolbar. */
    @@media (max-width: 900px) {
        .scheduler-toolbar {
            grid-template-columns: 1fr;
            gap: 0.6rem;
        }

        .toolbar-section {
            justify-content: center !important;
        }

        .date-navigation {
            flex-wrap: wrap;
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {
        .scheduler-toolbar {
            padding: 0.75rem;
        }

        /* Telefono: griglia su due righe.
           prima riga: freccia indietro, periodo centrato, freccia avanti
           seconda riga: data (larga) e Oggi
           Prima frecce e Oggi erano quattro barre a tutta larghezza una sotto l'altra. */
        .date-navigation {
            display: grid;
            width: 100%;
            grid-template-columns: auto minmax(0, 1fr) auto;
            grid-template-areas:
                "prev period next"
                "date date today";
            gap: 0.5rem;
        }

        .date-navigation .nav-prev { grid-area: prev; }
        .date-navigation .nav-next { grid-area: next; }
        .date-navigation .today-btn { grid-area: today; }
        .date-navigation .period-display { grid-area: period; min-width: 0; }
        .date-navigation .date-picker-wrapper { grid-area: date; }

        .period-text {
            font-size: 0.95rem;
            white-space: normal;
        }

        .toolbar-right .view-selector {
            display: flex;
            width: 100%;
        }

        .toolbar-right .view-selector .rz-button {
            flex: 1 1 0;
        }

        /* Niente vista Mese sul telefono: sette colonne in 375px non si leggono.
           RadzenSelectBarItem non riporta la classe sul pulsante, quindi si nasconde il
           primo pulsante del selettore, che e' sempre "Mese". */
        .month-view-option,
        .toolbar-right .view-selector .rz-button:first-child {
            display: none !important;
        }
    }
</style>
