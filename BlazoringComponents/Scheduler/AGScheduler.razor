<div class="offcanvas offcanvas-top h-auto"  tabindex="-1" id="modalDetails" aria-labelledby="offcanvasTopLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasTopLabel">@($"{Localize["Ticket"]} #{_id}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body h-auto">
        @if (_id != null && Details != null)
        {
            @Details(_id)
            
        }
    </div>

    <div class="offcanvas-footer">
        <div class="container">
            <div class="m-3">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">@Localize["Close"]</button>
                <button type="button" class="btn btn-primary" @onclick="()=>OpenTicket(_id)">@Localize["Open"]</button>
            </div>
        </div>
    </div>
</div>