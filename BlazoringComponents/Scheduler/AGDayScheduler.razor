@using Models
@typeparam TItem

<div class="modern-scheduler-container day-view">
    <!-- Vista singolo giorno -->
    <div class="day-detail-container">
        <div class="day-detail-column @GetDayCellClass(_dayTickets)">
            <!-- Header del giorno -->
            <div class="day-detail-header">
                <AGDayHead Day="@_dayTickets" OnSelect="OnSelect"></AGDayHead>
            </div>

            <!-- Contenuto ticket -->
            <div class="day-detail-content">
                @if (_dayTickets.Tickets.Any())
                {
                    <div class="tickets-timeline">
                        @foreach (var ticket in _dayTickets.Tickets)
                        {
                            <div class="timeline-item">
                                <CascadingValue Value="ticket" TValue="SchedulerTicket">
                                    <AGTicketScheduler OpenModal="OpenModal"></AGTicketScheduler>
                                </CascadingValue>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-day-detail">
                        <AGEmptyScheduler IsHoliday="@_dayTickets.IsHoliday"></AGEmptyScheduler>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Colori solo dalle variabili del tema (--crm-*). *@
<style>
    .modern-scheduler-container.day-view {
        background: var(--crm-surface);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        overflow: hidden;
        min-height: 600px;
    }

    /* Container dettaglio giorno */
    .day-detail-container {
        padding: 1rem;
    }

    .day-detail-column {
        background: var(--crm-surface);
        border-radius: var(--crm-radius-sm);
        display: flex;
        flex-direction: column;
        min-height: 550px;
        border: 1px solid var(--crm-border);
        overflow: hidden;
    }

    /* Tipi di giorno */
    .day-detail-column.holiday {
        background: color-mix(in srgb, var(--crm-danger) 5%, var(--crm-surface));
    }

    .day-detail-column.today {
        background: color-mix(in srgb, var(--crm-primary) 6%, var(--crm-surface));
        border-color: color-mix(in srgb, var(--crm-primary) 45%, var(--crm-border));
    }

    /* Header dettaglio */
    .day-detail-header {
        flex-shrink: 0;
        background: var(--crm-surface-muted);
        padding: 0;
    }

    /* Contenuto dettaglio */
    .day-detail-content {
        flex: 1;
        padding: 1.5rem;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .day-detail-content::-webkit-scrollbar {
        width: 8px;
    }

    .day-detail-content::-webkit-scrollbar-track {
        background: transparent;
    }

    .day-detail-content::-webkit-scrollbar-thumb {
        background: var(--crm-border-strong);
        border-radius: 4px;
    }

    /* Timeline tickets */
    .tickets-timeline {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .timeline-item {
        animation: fadeInUp 0.3s ease-out;
        position: relative;
        padding-left: 1.5rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--crm-border-strong);
        border-radius: 2px;
    }

    .timeline-item:hover::before {
        background: var(--crm-primary);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .empty-day-detail {
        height: 100%;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--crm-text-muted);
        font-size: 1rem;
        padding: 3rem;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .day-detail-column {
            min-height: 450px;
        }

        .day-detail-content {
            padding: 1.25rem;
        }
    }

    @@media (max-width: 900px) {
        .modern-scheduler-container.day-view {
            border-radius: 0;
            min-height: auto;
        }

        .day-detail-container {
            padding: 0.75rem;
        }

        .day-detail-column {
            min-height: 350px;
        }

        .day-detail-content {
            padding: 1rem;
        }

        .timeline-item {
            padding-left: 1rem;
        }

        .empty-day-detail {
            min-height: 300px;
            padding: 2rem 1rem;
        }
    }
</style>

@code {
    private string GetDayCellClass(DayTickets day)
    {
        var classes = new List<string>();

        if (day.IsHoliday)
            classes.Add("holiday");

        if (day.Date.Date == DateTime.Today)
            classes.Add("today");

        return string.Join(" ", classes);
    }
}
