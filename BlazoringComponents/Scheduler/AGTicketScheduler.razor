@using Radzen
@using Radzen.Blazor

@* Il bordo a sinistra porta il colore dell'utente assegnato: dice DI CHI e' il lavoro.
   L'urgenza non sta nei colori della card, resta a priorita' e scadenza, che sono dati veri. *@
<div class="modern-ticket-card"
     style="border-left-color: @Ticket.BackGroundColor"
     title="@BuildCardTitle()"
     draggable="true"
     data-scheduler-ticket
     @onclick="HandleCardClick"
     @ondragstart="HandleDragStart"
     @ondragend="HandleDragEnd"
     @onmouseleave="CloseTooltip">
    
    <div class="ticket-card-header">
        <!-- Time (se disponibile) -->
        @if (Ticket.TimeStart.HasValue && Ticket.TimeStart.Value != TimeOnly.MinValue)
        {
            <span class="ticket-time">@Ticket.TimeStart.Value.ToString("HH:mm")</span>
        }
        
        <!-- Ticket ID -->
        <span class="ticket-id">#@Ticket.Id</span>

        @* Lo stato era un chip maiuscolo a piena larghezza: nella cella stretta del mese mandava a
           capo l'header e da solo valeva una riga in piu' per ogni ticket. Qui e' un pallino del
           colore dello stato, con title e aria-label a portare l'etichetta leggibile — la stessa
           convenzione dei calendari. Il testo per esteso resta nel preview al click. *@
        @if (!string.IsNullOrEmpty(Ticket.StatusText))
        {
            <span class="ticket-status-dot"
                  style="background-color: @Ticket.StatusColor"
                  title="@Ticket.StatusText"
                  aria-label="@Ticket.StatusText"></span>
        }

        <!-- Assigned Users Badges -->
        @if (Ticket.AssignedUserNames != null && Ticket.AssignedUserNames.Any())
        {
            <div class="assigned-users">
                @foreach (var userName in Ticket.AssignedUserNames.Take(3))
                {
                    <span class="user-badge" title="@userName">@GetUserInitials(userName)</span>
                }
                @if (Ticket.AssignedUserNames.Count > 3)
                {
                    <span class="user-badge more" 
                          title="@GetAssignedUsersTooltip()"
                          @onclick="ToggleUsersPanel" 
                          @onclick:stopPropagation="true">
                        +@(Ticket.AssignedUserNames.Count - 3)
                    </span>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(Ticket.User))
        {
            <div class="assigned-users">
                <span class="user-badge" title="@Ticket.User">@GetUserInitials(Ticket.User)</span>
            </div>
        }
    </div>

    <div class="ticket-card-body">
        <div class="ticket-company">@Ticket.Company</div>
        @if (Ticket.IsCommessa)
        {
            <div class="ticket-commessa" title="@($"Commessa {Ticket.CommessaCode}")">
                <span class="material-icons">precision_manufacturing</span>
                <span class="commessa-code">@Ticket.CommessaCode</span>
            </div>
            @if (Ticket.HasPhaseWindow)
            {
                <div class="ticket-phase-window" title="@GetPhaseWindowTitle()">
                    <span class="material-icons">date_range</span>
                    <span>@Ticket.PhaseWindowText</span>
                    @if (!string.IsNullOrWhiteSpace(Ticket.CommessaFaseName))
                    {
                        <span class="phase-name">@Ticket.CommessaFaseName</span>
                    }
                </div>
            }
        }
        <div class="ticket-description" title="@Ticket.Description">@Ticket.Description</div>
    </div>

    <!-- Users Panel (popup) -->
    @if (_showUsersPanel && Ticket.AssignedUserNames != null && Ticket.AssignedUserNames.Count > 1)
    {
        <div class="users-panel-overlay" 
             @onclick="ToggleUsersPanel" 
             @onclick:stopPropagation="true">
            <div class="users-panel" @onclick:stopPropagation="true">
                <div class="users-panel-header">
                    <strong>Utenti assegnati (@Ticket.AssignedUserNames.Count)</strong>
                    <button type="button" class="btn-close-custom" @onclick="ToggleUsersPanel">×</button>
                </div>
                <ul class="users-list">
                    @foreach (var userName in Ticket.AssignedUserNames)
                    {
                        var isMain = Ticket.AssignedUserNames.IndexOf(userName) == 0;
                        <li class="user-item @(isMain ? "main-user" : "")">
                            <span class="user-avatar">@GetUserInitials(userName)</span>
                            <span class="user-name">@userName</span>
                            @if (isMain)
                            {
                                <span class="main-badge">Principale</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

@* Colori solo dalle variabili del tema (--crm-*): la card segue chiaro e scuro da sola.
   L'unico colore "dato" e' il bordo sinistro, che porta il colore dell'utente assegnato. *@
<style>
    .modern-ticket-card {
        background: var(--crm-surface-raised);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius-sm);
        /* Sopra si sta piu' stretti che sotto, e non e' una svista: la prima riga porta il
           tondino dell'utente, che e' alto 25px e si porta dietro il suo spazio. Con lo stesso
           margine su tutti i lati la card sembrava iniziare in ritardo. */
        padding: 0.25rem 0.55rem 0.45rem;
        border-left: 4px solid var(--crm-primary);
        box-shadow: var(--crm-shadow-sm);
        transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
        cursor: grab;
        position: relative;
        animation: slideIn 0.3s ease-out;
    }

    .modern-ticket-card:active {
        cursor: grabbing;
        opacity: .72;
    }

    /* Qui c'era una fascia di 3px in cima alla card: azzurra per l'assistenza, indaco per la
       commessa. Diceva la natura del lavoro, ma su questi calendari i ticket di commessa non
       arrivano piu' - li esclude la query in TicketsController.GetScheduleItems - quindi era
       sempre dello stesso colore. Un colore che non cambia mai non distingue niente, e in una
       cella del mese quei pixel servono al testo. */

    /* Riga commessa */
    .ticket-commessa {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        color: var(--crm-primary);
        font-size: 0.7rem;
        font-weight: 600;
        min-width: 0;
    }

    .ticket-commessa .material-icons {
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .commessa-code {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ticket-phase-window {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        color: var(--crm-text-secondary);
        font-size: 0.68rem;
        min-width: 0;
        background: var(--crm-surface-muted);
        border: 1px solid var(--crm-border);
        border-radius: 4px;
        padding: 0.08rem 0.25rem;
    }

    .ticket-phase-window .material-icons {
        font-size: 0.78rem;
        color: var(--crm-text-muted);
        flex-shrink: 0;
    }

    .phase-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--crm-text-muted);
    }

    .modern-ticket-card:hover {
        box-shadow: var(--crm-shadow);
        border-color: var(--crm-border-strong);
        transform: translateX(2px);
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */
    .ticket-card-header {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 0.3rem;
        flex-wrap: nowrap;
        min-width: 0;
    }

    .ticket-time {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--crm-primary);
        background: var(--crm-primary-soft);
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        white-space: nowrap;
    }

    .ticket-id {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--crm-text-muted);
        background: var(--crm-surface-muted);
        border: 1px solid var(--crm-border);
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        white-space: nowrap;
    }

    /* Stato: pallino colorato, etichetta su title/aria-label */
    .ticket-status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--crm-text) 20%, transparent);
    }

    .assigned-users {
        display: flex;
        gap: 0.15rem;
        margin-left: auto;
        flex-shrink: 0;
    }

    /* Gli avatar si sovrappongono leggermente: tre iniziali stanno in ~44px invece di 66,
       e nella cella del mese e' la differenza fra stare in riga e mandare a capo l'header. */
    .user-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 21px;
        height: 21px;
        background: var(--crm-primary);
        color: var(--crm-text-on-primary);
        border-radius: 50%;
        font-size: 0.6rem;
        font-weight: 600;
        border: 2px solid var(--crm-surface-raised);
        transition: transform 0.2s ease;
        margin-left: -6px;
    }

    .user-badge:first-child {
        margin-left: 0;
    }

    .user-badge:hover {
        transform: scale(1.15);
    }

    .user-badge.more {
        background: var(--crm-text-muted);
        font-size: 0.7rem;
        cursor: pointer;
    }

    .user-badge.more:hover {
        background: var(--crm-text-secondary);
    }

    /* Body */
    .ticket-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        min-width: 0;
    }

    .ticket-company {
        font-weight: 600;
        color: var(--crm-text);
        font-size: 0.8rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Una riga invece di due: nella cella del mese la seconda riga di descrizione costava
       ~18px per ticket e conteneva quasi sempre la coda troncata della prima. Il testo intero
       resta nel title e nel preview. */
    .ticket-description {
        color: var(--crm-text-muted);
        font-size: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
    }

    /* Users Panel Overlay */
    .users-panel-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(9, 12, 18, 0.5);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* Users Panel */
    .users-panel {
        background: var(--crm-surface);
        color: var(--crm-text);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        box-shadow: var(--crm-shadow-lg);
        min-width: 320px;
        max-width: 400px;
        animation: slideUp 0.3s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .users-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--crm-border);
        color: var(--crm-text);
    }

    .users-panel-header strong {
        font-size: 1rem;
        font-weight: 600;
    }

    .btn-close-custom {
        background: transparent;
        border: none;
        color: var(--crm-text-muted);
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: background 0.2s ease;
    }

    .btn-close-custom:hover {
        color: var(--crm-text);
        background: var(--crm-surface-hover);
    }

    /* Users List */
    .users-list {
        list-style: none;
        margin: 0;
        padding: 0.5rem;
        max-height: 400px;
        overflow-y: auto;
    }

    .user-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: var(--crm-radius-sm);
        transition: background 0.2s ease;
    }

    .user-item:hover {
        background: var(--crm-surface-hover);
    }

    .user-item.main-user {
        background: var(--crm-primary-soft);
        border-left: 3px solid var(--crm-primary);
    }

    .user-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: var(--crm-primary);
        color: var(--crm-text-on-primary);
        border-radius: 50%;
        font-size: 0.85rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .user-name {
        flex: 1;
        font-size: 0.95rem;
        color: var(--crm-text);
        font-weight: 500;
    }

    .main-badge {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--crm-primary);
        background: var(--crm-primary-soft);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    /* Scrollbar */
    .users-list::-webkit-scrollbar {
        width: 6px;
    }

    .users-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .users-list::-webkit-scrollbar-thumb {
        background: var(--crm-border-strong);
        border-radius: 3px;
    }
</style>
