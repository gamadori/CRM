@using BlazoringComponents.Helpers
@using Models
@typeparam TItem

<div class="modern-scheduler-container">
    <!-- Header con i giorni della settimana -->
    <div class="scheduler-header">
        @foreach (var weekDay in _weekDays)
        {
            <div class="day-header @(weekDay.IsHoliday ? "holiday-header" : "")">
                <span class="day-name">@weekDay.Name</span>
            </div>
        }
    </div>

    <!-- Griglia calendario -->
    <div class="scheduler-grid">
        @foreach (var week in _monthTickets)
        {
            <div class="scheduler-week">
                @foreach (var day in week)
                {
                    <div class="day-cell scheduler-drop-zone @GetDayCellClass(day)" data-scheduler-drop-zone
                         @onclick="() => OnDayClick(day.Date)"
                         @ondragover:preventDefault
                         @ondrop="() => OnTicketDrop(day.Date)">
                        <!-- Header del giorno -->
                        <div class="day-cell-header">
                            <AGDayHead Day="@day" OnSelect="OnSelect"></AGDayHead>
                        </div>

                        <!-- Contenuto ticket -->
                        <div class="day-cell-content">
                            @if (day.Tickets.Any())
                            {
                                @for (int i = 0; i < day.Tickets.Count && i < MaxNumDaylyTicket; ++i)
                                {
                                    <div class="ticket-item">
                                        <CascadingValue Value="day.Tickets[i]" TValue="SchedulerTicket">
                                            <AGTicketScheduler OpenModal="OpenModal"></AGTicketScheduler>
                                        </CascadingValue>
                                    </div>
                                }

                                @if (day.Tickets.Count > MaxNumDaylyTicket)
                                {
                                    <div class="more-tickets">
                                        <AGTicketOthersScheduler Day="@day.Date"
                                                                Desc="@day.DescOthers"
                                                                OpenDaylyScheduler="OpenDaylyScheduler">
                                        </AGTicketOthersScheduler>
                                    </div>
                                }
                            }
                            @* Giorno vuoto: nessun segnaposto. Qui c'era una card "Nessun Ticket" per
                               ogni cella libera — in un mese tipico 28 card che occupavano quanto
                               quelle vere, gonfiando ogni settimana anche quando non c'era niente
                               da vedere. La cella resta cliccabile e resta drop zone: il gestore sta
                               sul .day-cell, non sul contenuto. Nella vista giorno il messaggio ha
                               senso ed e' rimasto. *@
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Colori solo dalle variabili del tema (--crm-*): cosi' il calendario segue chiaro e scuro
   da solo, senza uno strato di eccezioni in app.css. *@
<style>
    .modern-scheduler-container {
        background: var(--crm-surface);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        overflow: hidden;
        min-width: 900px;
    }

    /* Header giorni settimana */
    .scheduler-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background: var(--crm-surface-muted);
        border-bottom: 1px solid var(--crm-border);
    }

    .day-header {
        text-align: center;
        padding: 0.5rem 0.5rem;
        color: var(--crm-text-muted);
        font-weight: 600;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .day-header.holiday-header {
        color: var(--crm-danger);
    }

    .day-name {
        display: block;
    }

    /* Griglia settimane: le linee fra le celle sono il colore del bordo che
       traspare dal gap di 1px. */
    .scheduler-grid {
        background: var(--crm-border);
        padding: 0;
    }

    .scheduler-week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1px;
        background: var(--crm-border);
    }

    .scheduler-week + .scheduler-week {
        margin-top: 1px;
    }

    /* Celle giorno
       min-height abbassata da 120px: e' il pavimento di ogni riga settimana, quindi una settimana
       senza ticket costava quanto una piena. 76px restano un bersaglio comodo per il drop e per il
       click che crea il ticket; le settimane con contenuto crescono da sole. */
    .day-cell {
        background: var(--crm-surface);
        min-height: 76px;
        padding: 0;
        display: flex;
        flex-direction: column;
        transition: background-color 120ms ease, box-shadow 120ms ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .day-cell:hover {
        background: var(--crm-surface-hover);
        box-shadow: inset 0 0 0 1px var(--crm-primary);
        z-index: 10;
    }

    /* Tipi di giorni */
    .day-cell.holiday {
        background: color-mix(in srgb, var(--crm-danger) 5%, var(--crm-surface));
    }

    .day-cell.holiday:hover {
        background: color-mix(in srgb, var(--crm-danger) 9%, var(--crm-surface));
    }

    .day-cell.other-month {
        background: var(--crm-surface-muted);
    }

    .day-cell.other-month .day-cell-content {
        opacity: 0.7;
    }

    .day-cell.today {
        background: color-mix(in srgb, var(--crm-primary) 7%, var(--crm-surface));
    }

    .day-cell.today:hover {
        background: color-mix(in srgb, var(--crm-primary) 11%, var(--crm-surface));
    }

    /* Header cella */
    .day-cell-header {
        flex-shrink: 0;
    }

    /* Contenuto cella */
    .day-cell-content {
        flex: 1;
        padding: 0.3rem;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .day-cell-content::-webkit-scrollbar {
        width: 4px;
    }

    .day-cell-content::-webkit-scrollbar-track {
        background: transparent;
    }

    .day-cell-content::-webkit-scrollbar-thumb {
        background: var(--crm-border-strong);
        border-radius: 2px;
    }

    /* Ticket items */
    .ticket-item {
        margin-bottom: 0.3rem;
        animation: slideIn 0.3s ease-out;
    }

    .ticket-item:last-child {
        margin-bottom: 0;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .more-tickets {
        margin-top: 0.3rem;
        padding-top: 0.3rem;
        border-top: 1px dashed var(--crm-border-strong);
    }

    /* .empty-day rimossa insieme al segnaposto delle celle libere */

    /* Responsive */
    @@media (max-width: 1200px) {
        .day-cell {
            min-height: 100px;
        }
    }

    @@media (max-width: 900px) {
        .modern-scheduler-container {
            min-width: unset;
            border-radius: 0;
        }

        .day-header {
            font-size: 0.7rem;
            padding: 0.5rem 0.25rem;
        }

        .day-cell {
            min-height: 80px;
        }

        .day-cell-content {
            padding: 0.25rem;
        }
    }
</style>

@code {
    private string GetDayCellClass(DayTickets day)
    {
        var classes = new List<string>();

        if (day.IsHoliday)
            classes.Add("holiday");

        if (!day.IsMonthCurrent)
            classes.Add("other-month");

        if (day.Date.Date == DateTime.Today)
            classes.Add("today");

        return string.Join(" ", classes);
    }

    private async Task OnDayClick(DateTime date)
    {
        await OnSelect.InvokeAsync(date);
    }

    private async Task OnTicketDrop(DateTime date)
    {
        if (DragDropContext != null)
            await DragDropContext.DropAsync(date, null);
    }
}
