@using Models
@typeparam TItem

<div class="day-timeline-container">
    <!-- Ticket da pianificare -->
    @if (_ticketsWithoutTime.Any())
    {
        <div class="no-time-section">
            <div class="section-header">
                <span class="material-icons">event_note</span>
                <h5>Ticket del giorno (@_ticketsWithoutTime.Count)</h5>
            </div>
            <div class="tickets-grid">
                @foreach (var ticket in _ticketsWithoutTime)
                {
                    <CascadingValue Value="ticket" TValue="SchedulerTicket">
                        <AGTicketScheduler OpenModal="OpenModal"></AGTicketScheduler>
                    </CascadingValue>
                }
            </div>
        </div>
    }

    <!-- Timeline oraria -->
    <div class="timeline-grid">
        @foreach (var slot in _timeSlots)
        {
            var hasTickets = _ticketsByTimeSlot.ContainsKey(slot) && _ticketsByTimeSlot[slot].Any();
            <div class="timeline-slot scheduler-drop-zone @(hasTickets ? "has-tickets" : "")"
                 data-scheduler-drop-zone
                 @ondragover:preventDefault
                 @ondrop="() => OnTicketDrop(slot)">
                <div class="time-label">
                    <span class="time-text">@slot.Label</span>
                    <span class="time-range">@slot.Start.ToString("HH:mm") - @slot.End.ToString("HH:mm")</span>
                </div>
                <div class="slot-content">
                    @if (hasTickets)
                    {
                        @foreach (var ticket in _ticketsByTimeSlot[slot])
                        {
                            <CascadingValue Value="ticket" TValue="SchedulerTicket">
                                <AGTicketScheduler OpenModal="OpenModal"></AGTicketScheduler>
                            </CascadingValue>
                        }
                    }
                    else
                    {
                        <div class="empty-slot">
                            <span class="material-icons">hourglass_empty</span>
                            <span>Nessun ticket</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@* Colori solo dalle variabili del tema (--crm-*). La card del ticket e' AGTicketScheduler:
   qui restano solo il contenitore, la fascia "da pianificare" e le fasce orarie. *@
<style>
    .day-timeline-container {
        background: var(--crm-surface);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        padding: 1.25rem;
    }

    /* No Time Section */
    .no-time-section {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: var(--crm-warning-soft);
        border: 1px solid color-mix(in srgb, var(--crm-warning) 35%, var(--crm-border));
        border-radius: var(--crm-radius);
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.85rem;
        color: var(--crm-warning);
    }

    .section-header .material-icons {
        font-size: 24px;
    }

    .section-header h5 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: inherit;
    }

    .tickets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 0.75rem;
    }

    /* Timeline Grid */
    .timeline-grid {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .timeline-slot {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 1rem;
        padding: 0.6rem 0.75rem;
        border-radius: var(--crm-radius-sm);
        transition: background 0.15s ease;
    }

    .timeline-slot:hover {
        background: var(--crm-surface-hover);
    }

    .timeline-slot.has-tickets {
        background: linear-gradient(90deg, var(--crm-primary-soft) 0%, transparent 25%);
    }

    /* Time Label */
    .time-label {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: center;
        padding-right: 1rem;
        border-right: 2px solid var(--crm-primary);
    }

    .time-text {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--crm-primary);
        line-height: 1;
    }

    .time-range {
        font-size: 0.75rem;
        color: var(--crm-text-muted);
        margin-top: 0.25rem;
    }

    /* Slot Content */
    .slot-content {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-height: 56px;
    }

    /* Empty Slot */
    .empty-slot {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        border: 1px dashed var(--crm-border-strong);
        border-radius: var(--crm-radius-sm);
        color: var(--crm-text-muted);
        font-size: 0.85rem;
    }

    .empty-slot .material-icons {
        font-size: 20px;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .timeline-slot {
            grid-template-columns: 120px 1fr;
        }

        .time-text {
            font-size: 1.15rem;
        }
    }

    @@media (max-width: 768px) {
        .timeline-slot {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }

        .time-label {
            align-items: flex-start;
            border-right: none;
            border-bottom: 2px solid var(--crm-primary);
            padding-right: 0;
            padding-bottom: 0.5rem;
        }

        .tickets-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
