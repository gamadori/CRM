@using Models
@typeparam TItem

<div class="modern-scheduler-container week-view">
    <!-- Griglia settimana -->
    <div class="week-grid">
        @foreach (var day in _weekTickets)
        {
            <div class="day-column scheduler-drop-zone @GetDayCellClass(day)" data-scheduler-drop-zone
                 @onclick="() => OnDayClick(day.Date)"
                 @ondragover:preventDefault
                 @ondrop="() => OnTicketDrop(day.Date)">
                <!-- Header del giorno -->
                <div class="day-column-header">
                    <AGDayHead Day="@day" OnSelect="OnSelect"></AGDayHead>
                </div>

                <!-- Contenuto ticket -->
                <div class="day-column-content">
                    @if (day.Tickets.Any())
                    {
                        @foreach (var ticket in day.Tickets)
                        {
                            <div class="ticket-item">
                                <CascadingValue Value="ticket" TValue="SchedulerTicket">
                                    <AGTicketScheduler OpenModal="OpenModal"></AGTicketScheduler>
                                </CascadingValue>
                            </div>
                        }
                    }
                    @* Come nel mese: il giorno libero non mostra un segnaposto. La colonna resta
                       cliccabile e drop zone, il gestore e' sul .day-column. *@
                </div>
            </div>
        }
    </div>
</div>

@* Colori solo dalle variabili del tema (--crm-*). *@
<style>
    .modern-scheduler-container.week-view {
        background: var(--crm-surface);
        border: 1px solid var(--crm-border);
        border-radius: var(--crm-radius);
        overflow: hidden;
        padding: 0.75rem;
    }

    /* Griglia settimana */
    .week-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.6rem;
    }

    /* Colonne giorno */
    .day-column {
        background: var(--crm-surface);
        border-radius: var(--crm-radius-sm);
        display: flex;
        flex-direction: column;
        /* Era 400px fissi per colonna: una settimana vuota occupava mezzo schermo per non dire
           niente. Le colonne crescono sul contenuto, con un minimo che resta un bersaglio comodo
           per il drop. */
        min-height: 160px;
        border: 1px solid var(--crm-border);
        transition: border-color 120ms ease, background-color 120ms ease;
        cursor: pointer;
        overflow: hidden;
    }

    .day-column:hover {
        border-color: var(--crm-primary);
        background: var(--crm-surface-hover);
    }

    /* Tipi di giorni */
    .day-column.holiday {
        background: color-mix(in srgb, var(--crm-danger) 5%, var(--crm-surface));
    }

    .day-column.today {
        background: color-mix(in srgb, var(--crm-primary) 7%, var(--crm-surface));
        border-color: color-mix(in srgb, var(--crm-primary) 45%, var(--crm-border));
    }

    /* Header colonna */
    .day-column-header {
        flex-shrink: 0;
        background: var(--crm-surface-muted);
    }

    /* Contenuto colonna */
    .day-column-content {
        flex: 1;
        padding: 0.5rem;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .day-column-content::-webkit-scrollbar {
        width: 6px;
    }

    .day-column-content::-webkit-scrollbar-track {
        background: transparent;
    }

    .day-column-content::-webkit-scrollbar-thumb {
        background: var(--crm-border-strong);
        border-radius: 3px;
    }

    /* Ticket items */
    .ticket-item {
        margin-bottom: 0.5rem;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* .empty-day rimossa insieme al segnaposto delle giornate libere */

    /* Responsive */
    @@media (max-width: 1200px) {
        .week-grid {
            gap: 0.4rem;
        }
    }

    @@media (max-width: 900px) {
        .week-grid {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        .modern-scheduler-container.week-view {
            border-radius: 0;
        }
    }
</style>

@code {
    private string GetDayCellClass(DayTickets day)
    {
        var classes = new List<string>();

        if (day.IsHoliday)
            classes.Add("holiday");

        if (day.Date.Date == DateTime.Today)
            classes.Add("today");

        return string.Join(" ", classes);
    }

    private async Task OnDayClick(DateTime date)
    {
        await OnSelect.InvokeAsync(date);
    }

    private async Task OnTicketDrop(DateTime date)
    {
        if (DragDropContext != null)
            await DragDropContext.DropAsync(date, null);
    }
}
