@using BlazoringComponents
@using CRM.Shared
@using Microsoft.Extensions.Localization
@using Radzen
@using Radzen.Blazor

@typeparam TItem

@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

<BlazorHeader Header="@PageTitle"></BlazorHeader>

@if (Items == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="row m-3">
        <div class="col-auto">
            <BlazorButton Template="TemplateButton.Filter" OnClick="OnFilterClick">

            </BlazorButton>
        </div>
        <div class="col" m-3>
            @if (_filterState)
            {
                <div class="row">
                    <div class="col-12">

                        @Filter

                    </div>
                </div>
            }
        </div>
    </div>
    
    <BlazorButton Template="TemplateButton.New" Text="@BtnNewLabel" OnClick="NewItem"></BlazorButton>
    @BtnUtility
    if (!Items.Any())
    {
        @Empty
    }
    else
    {
        @if (searching)
        {
           <SpinnerCircle></SpinnerCircle>
        }
        else
        {
            <div>
                <table class="@TableClass" >
                    <thead>
                        @Header
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            @Item(item)
                        }
                </tbody>
                <tfoot>

                </tfoot>
            </table>
        </div>
        }
    <div class="col-5">
        @if (LoaderData != null && _pagingData != null)
        {
             <RadzenPager  ShowPagingSummary="true" PagingSummaryFormat="@_pagingSummaryFormat" HorizontalAlign="HorizontalAlign.Left" Count="@_pagingData.TotalCount" PageSize="@_pagingData.PageSize" PageNumbersCount="8" PageChanged="@PageChanged" />
        }
        else
        {
            @Paging
        }
    </div>
    }
    
}
@code {

    [Parameter] public string PageTitle { get; set; }
    [Parameter] public string BtnNewLabel { get; set; } = "Nuovo";
    [Parameter] public Action NewItem { get; set; }
    [Parameter] public Action<bool> OnChangeFilter { get; set; }
    [Parameter] public Func<Task<IEnumerable<TItem>>> Loader { get; set; } = null;
    [Parameter] public Func<Task<PagingResponse<TItem>>> LoaderData { get; set; } = null;
    [Parameter] public RenderFragment Loading { get; set; }
    [Parameter] public RenderFragment Empty { get; set; }
    [Parameter] public RenderFragment Filter { get; set; }
    [Parameter] public RenderFragment Header { get; set; }
    [Parameter] public RenderFragment<TItem> Item { get; set; }
    [Parameter] public RenderFragment BtnUtility { get; set; } 
    [Parameter] public string TableClass { get; set; } = "table table-striped";
    [Parameter] public IEnumerable<TItem> Items { get; set; }
    [Parameter] public bool FilterState { get; set; } = false;
    [Parameter] public RenderFragment Paging { get; set; }
    [Parameter] public EventCallback<PagerEventArgs> PageChanged { get; set; }

    private PagingHeaderModel _pagingData;

    private bool _filterState = false;
    private bool searching = false;
    private string _pagingSummaryFormat;


    protected override void OnInitialized()
    {
        _pagingSummaryFormat = "Displaying page {0} of {1} (total {2} records)";
        base.OnInitialized();
    }
    protected override async Task OnParametersSetAsync()
    {
        searching = true;

        if (LoaderData != null)
        {
            var resp = await LoaderData();
            Items = resp.Items;
            _pagingData = resp.MetaData;
        }
        else if (Loader != null)
        {
            Items = await Loader();
        }
        searching = false;

    }


    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _filterState = FilterState;
    }

    protected void OnFilterClick()
    {
        _filterState = !_filterState;

        OnChangeFilter?.Invoke(FilterState);

        //await JSRuntime.InvokeAsync<object>("CollapseDiv", "multiCollapseExample1", _filterState.ToString());

    }

}
