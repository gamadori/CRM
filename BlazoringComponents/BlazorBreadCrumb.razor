
@if (Model != null && Model.Any() && Visible)
{
        
    <div class="flex-grow-0 mb-2">
        <ul id="breadcrumbs-one">
            @foreach (var item in Model)
            {
                if (item.Url != null)
                {
                    <li><a href="#" @onclick:preventDefault @onclick="@(async ()=>await Goto(item.Url, item.Action, item.Data))">@item.Title</a></li>
                }
                else
                {
                    <li><div><span class="current">@item.Title</span></div></li>
                }
            }

        </ul>
    
    </div>

   
}
