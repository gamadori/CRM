@using CRM.Client.Models
@using CRM.Client.Services
@using static CRM.Client.Helpers.PageHelper
@* Modern Page Header Component *@

@if (!Visible || Model == null)
{
    return;
}
@if (Model.PageMode == PageHelper.PageModality.Child || Model.PageMode == PageHelper.PageModality.Dialog)
{

    @if (Model.DialogTitle != null)
    {
        <!-- ? Rendering semplificato per pagine child -->
        <div class="page-header-wrapper mb-3">
            <h2 class="page-header-title">@Model.DialogTitle</h2>
        </div>
    }
}
else
{
    @* Una riga sola: percorso e titolo insieme. Il breadcrumb finiva con lo stesso testo
       del titolo ("Ticket" › poi "Ticket" in grande) e con l'icona da 52px l'intestazione
       costava ~110px per pagina. Qui i genitori stanno piccoli prima del titolo, il
       sottotitolo in grigio a fianco, le azioni a destra: ~44px. *@
    <div class="page-header-wrapper mb-3">
        <div class="page-header-row">
            <div class="page-header-main">
                @if (!string.IsNullOrEmpty(Model.Icon))
                {
                    <div class="header-icon-box">
                        <span class="material-icons">@Model.Icon</span>
                    </div>
                }
                <nav aria-label="breadcrumb" class="page-header-path">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/"
                               class="text-decoration-none breadcrumb-link"
                               title="Home"
                               @onclick="@(() => NavigateToUrl("/"))"
                               @onclick:preventDefault="true">
                                <span class="material-icons">home</span>
                            </a>
                        </li>
                        @foreach (var item in ParentItems)
                        {
                            <li class="breadcrumb-item">
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url"
                                       class="text-decoration-none breadcrumb-link"
                                       @onclick="@(() => NavigateToUrl(item.Url))"
                                       @onclick:preventDefault="true">
                                        @item.Text
                                    </a>
                                }
                                else
                                {
                                    <span>@item.Text</span>
                                }
                            </li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">
                            <h1 class="page-header-title">@CurrentTitle</h1>
                        </li>
                    </ol>
                    @* Il sottotitolo sta su una riga sua, sotto il titolo: in riga, corto si
                       confondeva col percorso e lungo si sovrapponeva al titolo. *@
                    @if (!string.IsNullOrEmpty(Model.Subtitle))
                    {
                        <div class="page-header-subtitle">@Model.Subtitle</div>
                    }
                </nav>
            </div>

            @if (Actions != null)
            {
                <div class="page-header-actions">
                    @Actions
                </div>
            }
        </div>

        @if (Filters != null)
        {
            <div class="card border-0 shadow-sm mt-2">
                <div class="card-body p-3">
                    @Filters
                </div>
            </div>
        }
    </div>
}

@* Lo stile dell'intestazione sta in css/theme.css (sezione "Intestazione di pagina"):
   cosi' segue il tema chiaro/scuro come tutto il resto. *@

@code {


    [Parameter]

    public PageHeaderModel? Model { get; set; } = null;

    [Parameter]
    public bool Visible { get; set; } = true;

    /// <summary>
    /// Il percorso e' il breadcrumb: i genitori piccoli, l'ultima voce in grassetto come
    /// titolo. Elenco: "Home › Ticket" con "Ticket" in grassetto. Scheda: "Home › Ticket › 2"
    /// con "2" in grassetto. Prima il titolo del modello si ripeteva sotto ("Ticket › 2" e poi
    /// "Ticket" grande): l'ultima voce e' gia' la pagina corrente, non serve dirlo due volte.
    /// Senza breadcrumb resta il titolo del modello.
    /// </summary>
    private IEnumerable<BreadcrumbItem> ParentItems
    {
        get
        {
            var items = Model?.BreadcrumbItems;
            if (items == null || items.Count == 0)
                return Array.Empty<BreadcrumbItem>();

            return items.Take(items.Count - 1);
        }
    }

    private string CurrentTitle
    {
        get
        {
            var items = Model?.BreadcrumbItems;
            if (items != null && items.Count > 0 && !string.IsNullOrWhiteSpace(items[items.Count - 1].Text))
                return items[items.Count - 1].Text;

            return Model?.Title ?? string.Empty;
        }
    }

    /// <summary>
    /// Render Fragment per azioni (pulsanti, dropdown, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Render Fragment per filtri di ricerca
    /// </summary>
    [Parameter]
    public RenderFragment? Filters { get; set; }

    [Parameter]
    public PageModality PageMode { get; set; } = PageModality.Visualization;

    [Inject]
    public IHeaderService HeaderService { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; }

    private bool _subscribed = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // await EnsureBreadcrumbsAsync();
        if (!_subscribed)
        {
            NavigationManager.LocationChanged += OnLocationChanged;
            _subscribed = true;
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        // await EnsureBreadcrumbsAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        //await EnsureBreadcrumbsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureBreadcrumbsAsync()
    {


        if (Model != null) // && (Model.BreadcrumbItems == null || !Model.BreadcrumbItems.Any()))
        {
            try
            {
                var list = await HeaderService.GetBreadCrumbFromCurrentUrlAsync();
                if (list != null && list.Any())
                {
                    Model.BreadcrumbItems = list;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // ignore errors
            }
        }
    }

    private async Task LoadDataAsync()
    {
        if (Model == null)
        {
            try
            {
                Model = await HeaderService.Create(PageMode);
                StateHasChanged();
            }
            catch
            {
                // ignore errors
            }
        }
    }

    /// <summary>
    /// ? NUOVO: Naviga all'URL specificato, forzando il reload se è la stessa pagina
    /// </summary>
    private void NavigateToUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return;

        // Normalizza gli URL per il confronto (rimuovi trailing slash, query params, ecc.)
        var currentPath = new Uri(NavigationManager.Uri).LocalPath.TrimEnd('/');
        var targetPath = url.TrimEnd('/');

        // Se l'URL è relativo, convertilo in assoluto per il confronto
        if (!url.StartsWith("http"))
        {
            var absoluteUrl = NavigationManager.ToAbsoluteUri(url);
            targetPath = absoluteUrl.LocalPath.TrimEnd('/');
        }

        if (currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase))
        {
            // ? STESSO URL: Forza reload completo della pagina
            Console.WriteLine($"?? Breadcrumb: Force reload same page: {url}");
            NavigationManager.NavigateTo(url, forceLoad: true);
        }
        else
        {
            // ? URL DIVERSO: Navigazione normale Blazor (no page reload)
            Console.WriteLine($"?? Breadcrumb: Navigate to: {url}");
            NavigationManager.NavigateTo(url, forceLoad: false);
        }
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
            _subscribed = false;
        }
    }

}
