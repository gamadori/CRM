@using CRM.Client.Models
@using CRM.Client.Services
@* Modern Page Header Component *@

@if (!Visible || Model == null)
{
    return;
}
@if (Model.PageMode == PageHelper.PageModality.Child || Model.PageMode == PageHelper.PageModality.Dialog)
{

    @if (Model.DialogTitle != null)
    {
        <!-- ? Rendering semplificato per pagine child -->
        <div class="page-header-wrapper mb-4">
            <div class="container-fluid px-0">
                <h5 class="fw-bold text-dark mb-1">@Model.DialogTitle</h5>
            </div>
        </div>
    }
}
else
{
    <div class="page-header-wrapper mb-4">
        <div class="container-fluid px-0">
            <!-- Breadcrumb -->
        
            @if (Model.BreadcrumbItems != null && Model.BreadcrumbItems.Any())
            {
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/" 
                               class="text-decoration-none breadcrumb-link"
                               @onclick="@(() => NavigateToUrl("/"))"
                               @onclick:preventDefault="true">
                                <span class="material-icons" style="font-size: 16px; vertical-align: middle;">home</span>
                            </a>
                        </li>
                        @foreach (var item in Model.BreadcrumbItems)
                        {
                            @if (item == Model.BreadcrumbItems.Last())
                            {
                                <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
                            }
                            else
                            {
                                <li class="breadcrumb-item">
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <a href="@item.Url" 
                                           class="text-decoration-none breadcrumb-link"
                                           @onclick="@(() => NavigateToUrl(item.Url))"
                                           @onclick:preventDefault="true">
                                            @item.Text
                                        </a>
                                    }
                                    else
                                    {
                                        <span>@item.Text</span>
                                    }
                                </li>
                            }
                        }
                    </ol>
                </nav>
            }

            <!-- Header Section -->
            <div class="row align-items-center">
                <div class="col">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.Icon))
                        {
                            <div class="header-icon-box bg-primary bg-opacity-10 rounded-3 p-2 me-3">
                                <span class="material-icons text-primary" style="font-size: 32px;">@Model.Icon</span>
                            </div>
                        }
                        <div>
                            <h4 class="fw-bold text-dark mb-1">@Model.Title</h4>
                            @if (!string.IsNullOrEmpty(Model.Subtitle))
                            {
                                <p class="text-muted mb-0">@Model.Subtitle</p>
                            }
                        </div>
                    </div>
                </div>
            
                @if (Actions != null)
                {
                    <div class="col-auto">
                        @Actions
                    </div>
                }
            </div>

            @if (Filters != null)
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3">
                                @Filters
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .page-header-wrapper {
        animation: fadeInDown 0.4s ease-out;
    }

    .header-icon-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 64px;
        min-height: 64px;
    }

    .breadcrumb {
        background-color: transparent;
        padding: 0.5rem 0;
        font-size: 0.875rem;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        font-size: 1.2rem;
        color: #6c757d;
    }

    .breadcrumb-link {
        color: #667eea;
        transition: all 0.2s ease;
        position: relative;
        cursor: pointer;
    }

    .breadcrumb-link:hover {
        color: #5a67d8;
    }

    .breadcrumb-link:active {
        transform: scale(0.95);
    }

    .breadcrumb-item.active {
        color: #6c757d;
        font-weight: 500;
    }

    /* Loading animation quando si forza il reload */
    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.6;
        }
    }

    .breadcrumb-link.loading {
        animation: pulse 0.5s ease-in-out;
        pointer-events: none;
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .header-icon-box {
            min-width: 48px;
            min-height: 48px;
            padding: 0.75rem !important;
        }

        .header-icon-box .material-icons {
            font-size: 24px !important;
        }

        .page-header-wrapper h2 {
            font-size: 1.5rem;
        }
    }
</style>

@code {

    [Parameter]

    public PageHeaderModel? Model { get; set; } = null;

    [Parameter]
    public bool Visible { get; set; } = true;

    /// <summary>
    /// Render Fragment per azioni (pulsanti, dropdown, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Render Fragment per filtri di ricerca
    /// </summary>
    [Parameter]
    public RenderFragment? Filters { get; set; }

    // [Inject]
    public IHeaderService HeaderService { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; }

    private bool _subscribed = false;

    protected override async Task OnInitializedAsync()
    {
       // await EnsureBreadcrumbsAsync();
        if (!_subscribed)
        {
            NavigationManager.LocationChanged += OnLocationChanged;
            _subscribed = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
       // await EnsureBreadcrumbsAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        //await EnsureBreadcrumbsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureBreadcrumbsAsync()
    {
        if (Model != null) // && (Model.BreadcrumbItems == null || !Model.BreadcrumbItems.Any()))
        {
            try
            {
                var list = await HeaderService.GetBreadCrumbFromCurrentUrlAsync();
                if (list != null && list.Any())
                {
                    Model.BreadcrumbItems = list;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // ignore errors
            }
        }
    }

    /// <summary>
    /// ? NUOVO: Naviga all'URL specificato, forzando il reload se è la stessa pagina
    /// </summary>
    private void NavigateToUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return;

        // Normalizza gli URL per il confronto (rimuovi trailing slash, query params, ecc.)
        var currentPath = new Uri(NavigationManager.Uri).LocalPath.TrimEnd('/');
        var targetPath = url.TrimEnd('/');

        // Se l'URL è relativo, convertilo in assoluto per il confronto
        if (!url.StartsWith("http"))
        {
            var absoluteUrl = NavigationManager.ToAbsoluteUri(url);
            targetPath = absoluteUrl.LocalPath.TrimEnd('/');
        }

        if (currentPath.Equals(targetPath, StringComparison.OrdinalIgnoreCase))
        {
            // ? STESSO URL: Forza reload completo della pagina
            Console.WriteLine($"?? Breadcrumb: Force reload same page: {url}");
            NavigationManager.NavigateTo(url, forceLoad: true);
        }
        else
        {
            // ? URL DIVERSO: Navigazione normale Blazor (no page reload)
            Console.WriteLine($"?? Breadcrumb: Navigate to: {url}");
            NavigationManager.NavigateTo(url, forceLoad: false);
        }
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
            _subscribed = false;
        }
    }

}
