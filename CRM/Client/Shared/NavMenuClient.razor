@using Microsoft.Extensions.Localization

<div class="top-row navbar modern-topbar">
    <a class="navbar-brand" href=""><img src="/img/logoCrm.png?v=4" height="32" alt="CRM Logo" /></a>
    <button class="navbar-toggler" aria-label="Apri o chiudi il menu" @onclick="ToggleNavMenu">
        <span class="material-icons">@(collapseNavMenu ? "menu" : "close")</span>
    </button>
</div>



<div class="@NavMenuCssClass client-nav">
    <ul class="nav flex-column">
        <li class="nav-item">
            <NavLink class="nav-link" href="DashBoardClient" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                <span class="material-icons">home</span><span class="nav-text">@Localize["Home"]</span>
            </NavLink>
            <NavLink class="nav-link" href="Companies/Customer/Details" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                <span class="material-icons">domain</span><span class="nav-text">@Localize["Azienda"]</span>
            </NavLink>
            <NavLink class="nav-link" href="Catalog" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                <span class="material-icons">category</span>
                <span class="nav-text">@Localize["Catalog"]</span>
            </NavLink>

            <NavLink class="nav-link" href="Articles" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                <span class="material-icons">inventory</span>
                <span class="nav-text">@Localize["Articles"]</span>
            </NavLink>
            <NavLink class="nav-link" href="Tickets" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                <span class="material-icons">support_agent</span><span class="nav-text">@Localize["Tickets"]</span>
            </NavLink>
             <!-- AI Assistant (chat) -->
            <NavLink class="nav-link highlight-ai" href="Tickets/Assistant" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                <span class="material-icons nav-icon-small">smart_toy</span>
                <span class="nav-text">@Localize["Assistant"]</span>
            </NavLink>
            <NavLink class="nav-link" href="About" Match=@NavLinkMatch.All @onclick="CloseNavMenu">
                <span class="material-icons">info</span><span class="nav-text">@Localize["About"]</span>
            </NavLink>

        </li>
    </ul>
</div>

@code {
    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }

    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;


    private bool _hasPageName = true;


   

    private void ToggleNavMenu()
    {
        if (_hasPageName)
            collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }


}
