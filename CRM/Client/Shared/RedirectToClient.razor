@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;

@using Microsoft.Extensions.Options

@inject IOptionsSnapshot<RemoteAuthenticationOptions<ApiAuthorizationProviderOptions>> Options
@inject NavigationManager Navigation
@layout EmptyLayout

<Waiting></Waiting>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> StateAuthenticate { get; set; }

    protected override async Task OnInitializedAsync()
    {

        var authenticationState = await StateAuthenticate;

        if (authenticationState?.User?.Identity is null || !authenticationState.User.Identity.IsAuthenticated)
         {
            var returnUri = Navigation.ToBaseRelativePath(Navigation.Uri);
             if (string.IsNullOrWhiteSpace(returnUri))
             {
               

                Navigation.NavigateTo(Options.Get(Microsoft.Extensions.Options.Options.DefaultName).AuthenticationPaths.LogInPath, true);
             }
             else
             {
                Navigation.NavigateTo($"{Options.Get(Microsoft.Extensions.Options.Options.DefaultName).AuthenticationPaths.LogInPath}={returnUri}", true);
             }
         }
         else
         {
            if (Navigation.Uri != null && Navigation.Uri.Equals(Navigation.BaseUri))

                Navigation.NavigateTo($"DashBoardClient");
            else
            
                Navigation.NavigateTo(nameof(NotAuthorized));
        }
    }
}
