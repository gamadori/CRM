@* Sezione di una scheda di dettaglio: titolo piccolo maiuscolo con icona, poi i campi in
   griglia fluida (la griglia e' definita in theme.css, "Scheda di dettaglio"). *@
<section class="@CssClass">
    @if (!string.IsNullOrWhiteSpace(Title) || HeaderContent != null)
    {
        <div class="rg-detail-section-header">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <span class="material-icons rg-detail-section-icon">@Icon</span>
            }
            <div class="rg-detail-section-title">
                @if (HeaderContent != null)
                {
                    @HeaderContent
                }
                else
                {
                    @Title
                }
            </div>
        </div>
    }

    <div class="rg-detail-section-content">
        @ChildContent
    </div>
</section>

<style>
    .rg-detail-section-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.25rem;
        color: var(--crm-text-muted);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        line-height: 1.25;
        text-transform: uppercase;
    }

    .rg-detail-section-icon {
        color: var(--crm-primary);
        font-size: 1rem !important;
        line-height: 1;
    }

    .rg-detail-section-title {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .rg-detail-section-content {
        min-width: 0;
    }

    /* Spazio fra le sezioni. Sta sulla sezione stessa e non su "sezione + sezione" perche'
       nelle pagine spesso c'e' un contenitore in mezzo (AuthorizeView, div condizionali). */
    .rg-detail-section {
        min-width: 0;
        margin-bottom: 1.5rem;
    }

    .rg-detail-section:last-child {
        margin-bottom: 0;
    }
</style>

@code {
    private string CssClass => string.Join(" ", new[] { "rg-detail-section", Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    [Parameter] public string Title { get; set; }
    [Parameter] public string Icon { get; set; }
    [Parameter] public string Class { get; set; }
    [Parameter] public RenderFragment HeaderContent { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
}
