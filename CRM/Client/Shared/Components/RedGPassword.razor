@using System.Reflection
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Resources



<RtzDisplayName For="For">
    <ChildContent>
        <RadzenTextBox Value="@Value" @rendermode="renderMode" Visible=@_show
            ValueChanged="@ValueChanged" Style="@Style" Name="@Name" Placeholder="@Placeholder" class="@($"{CssClass} remove-border")" />
        <RadzenPassword Value="@Value" @rendermode="renderMode" Visible="@(!_show)"
            ValueChanged="@ValueChanged" Style="@Style" Name="@Name" Placeholder="@Placeholder" class="@($"{CssClass} remove-border")" />
        
    </ChildContent>
    <Helper>
        <ValidationMessage For="@For" />
    </Helper>
    <End>
        <RadzenButton Icon="@_icon" Click="ToggleVisibility" Variant="Variant.Text" Size="ButtonSize.Small" />
        
    </End>
</RtzDisplayName>


@code {

    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter]
    public string Style { get; set; } = string.Empty;
    [Parameter]
    public string Name { get; set; } = string.Empty;
    [Parameter]
    public string Placeholder { get; set; } = string.Empty;
    [Parameter]
    public IComponentRenderMode renderMode { get; set; } = RenderMode.InteractiveAuto;
    [Parameter]
    public Expression<Func<string>> For { get; set; } = default!;
    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;
    [Parameter]
    public RenderFragment Helper { get; set; } = default!;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    private bool _show = false;

    private string _icon = "visibility";

    private void ToggleVisibility()
    {
        _show = !_show;
        _icon = _show ? "visibility_off" : "visibility";
        StateHasChanged();
    }
}
