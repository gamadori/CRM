@* Campo di una scheda di dettaglio: etichetta piccola sopra, valore in evidenza sotto, un filo
   sotto ogni riga. Nessun riquadro e nessuna icona per campo: prima ogni campo era una scatola
   con bordo, ombra e icona (34 scatole nella scheda azienda) e l'etichetta pesava piu' del valore.
   I campi si dispongono in una griglia fluida governata dal contenitore (vedi theme.css,
   "Scheda di dettaglio"): larghezza a colonne, non 296px fissi.
   Il parametro Icon resta per compatibilita' con le pagine: decide solo se il campo e' "largo"
   (descrizioni, note, email), non disegna piu' nulla. *@

<div class="@CssClass">
    <div class="rg-field-label">
        <span class="rg-label-text">
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                @Label
            }
            else if (LabelContent != null)
            {
                @LabelContent
            }
        </span>
    </div>

    <div class="rg-field-value">
        @if (!string.IsNullOrWhiteSpace(Value))
        {
            @Value
        }
        else if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <span class="rg-empty-value">-</span>
        }
    </div>
</div>

<style>
    /* Niente linea sotto la cella: con 3-4 colonne le sottolineature spezzate sembravano
       campi di un modulo, e con altezze diverse fra celle della stessa riga si vedevano a
       gradini. Le righe si separano con lo spazio (row-gap della griglia in theme.css). */
    .rg-detail-field {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
        /* Le pagine passano ancora mb-3/mb-4 come ContainerClass: la spaziatura la da' la
           griglia, il margine aprirebbe buchi diversi da campo a campo. */
        margin: 0 !important;
        padding: 0;
    }

    .rg-detail-field.rg-detail-field-wide,
    .rg-detail-field.details-wide,
    .rg-detail-field.wide {
        grid-column: span 2;
    }

    .rg-detail-field.rg-detail-field-full,
    .rg-detail-field.details-full,
    .rg-detail-field.full {
        grid-column: 1 / -1;
    }

    .rg-field-label {
        color: var(--crm-text-muted);
        font-size: 0.76rem;
        font-weight: 600;
        line-height: 1.25;
    }

    /* Le etichette arrivano spesso come label con classe label-floating (16px in app.css):
       qui devono essere l'etichetta piccola del campo, non un titolo. */
    .rg-field-label .label-floating,
    .rg-field-label label {
        margin: 0;
        color: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
    }

    .rg-label-text {
        overflow-wrap: anywhere;
        user-select: none;
    }

    .rg-field-value {
        color: var(--crm-text);
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .rg-field-value p {
        margin-bottom: 0;
    }

    .rg-field-value .text-dark,
    .rg-field-value .text-muted {
        color: inherit !important;
    }

    .rg-empty-value {
        color: var(--crm-text-disabled);
        font-weight: 400;
    }

    /* Molte pagine passano il valore come paragrafo e quando e' vuoto restava un buco: il campo
       vuoto mostra "-" come gli altri, cosi' la scheda si legge uguale dappertutto. */
    .rg-field-value > p:empty::before {
        content: "-";
        color: var(--crm-text-disabled);
        font-weight: 400;
    }

    .rg-field-value a {
        color: var(--crm-link);
        text-decoration: none;
        font-weight: 600;
    }

    .rg-field-value a:hover {
        text-decoration: underline;
    }

    .rg-field-value .badge {
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .rg-detail-field.rg-detail-field-wide,
        .rg-detail-field.details-wide,
        .rg-detail-field.wide {
            grid-column: auto;
        }
    }
</style>

@code {
    private static readonly HashSet<string> WideIcons = new(StringComparer.OrdinalIgnoreCase)
    {
        "description",
        "note",
        "notes",
        "message",
        "mail",
        "email",
        "subject",
        "forum",
        "article",
        "image",
        "language",
        "share",
        "insights",
        "smart_toy"
    };

    private string CssClass
    {
        get
        {
            var sizeClass = !string.IsNullOrWhiteSpace(Icon) && WideIcons.Contains(Icon)
                ? "rg-detail-field-wide"
                : string.Empty;

            return string.Join(" ", new[] { ContainerClass, "rg-detail-field", sizeClass }
                .Where(value => !string.IsNullOrWhiteSpace(value)));
        }
    }

    /// <summary>
    /// Icona Material (es. "business", "email"). Non viene piu' disegnata: serve solo a
    /// riconoscere i campi lunghi (descrizioni, email, note) che occupano due colonne.
    /// </summary>
    [Parameter]
    public string Icon { get; set; }

    /// <summary>
    /// Etichetta del campo (testo semplice)
    /// </summary>
    [Parameter]
    public string Label { get; set; }

    /// <summary>
    /// Contenuto personalizzato per l'etichetta (es. DisplayName)
    /// </summary>
    [Parameter]
    public RenderFragment LabelContent { get; set; }

    /// <summary>
    /// Valore del campo (testo semplice)
    /// </summary>
    [Parameter]
    public string Value { get; set; }

    /// <summary>
    /// Contenuto personalizzato per il valore (es. link, HTML, immagini)
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// Classi CSS del contenitore. "details-full"/"full" fa occupare tutta la riga,
    /// "details-wide"/"wide" due colonne. I margini Bootstrap (mb-*) vengono ignorati.
    /// </summary>
    [Parameter]
    public string ContainerClass { get; set; } = "mb-3";
}
