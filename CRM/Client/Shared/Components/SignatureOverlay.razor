@using Microsoft.Extensions.Localization
@using Radzen
@inject IJSRuntime JS
@inject DialogService DialogService
@inject HttpClient Http
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

@if (Visible)
{
    <!-- Overlay fullscreen semi-trasparente. La rubrica (contatti/utenti) viene
         mostrata in un pannello DENTRO questo stesso overlay: posizione e stile
         li controlliamo noi, e il canvas della firma resta montato (nascosto via
         CSS) così la firma già tracciata NON viene mai persa. -->
    <div class="signature-overlay-backdrop" @onclick="BackdropClick">
        <div class="signature-overlay-container @(_picker != PickerMode.None ? "signature-overlay-hidden" : "")" @onclick:stopPropagation>
            <!-- Header -->
            <div class="signature-overlay-header">
                <h5 class="mb-0">
                    <i class="material-icons middle">draw</i>
                    @Title
                </h5>
                <button type="button" class="btn-close" @onclick="Cancel"></button>
            </div>

            <!-- Global validation banner -->
            @if (!string.IsNullOrEmpty(_globalError))
            {
                <div class="signature-validation-banner">
                    <i class="material-icons">warning</i>
                    <span>@_globalError</span>
                </div>
            }

            <!-- Body -->
            <div class="signature-overlay-body">
                <!-- Input Nome Firmatario -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: #495057;">
                        <i class="material-icons" style="font-size: 18px; vertical-align: middle;">person</i>
                        Nome e Cognome del Firmatario <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input type="text"
                               class="form-control @(_errorName != null ? "is-invalid" : "")"
                               @bind="SignerName"
                               @oninput="@(() => _errorName = null)"
                               placeholder="Es: Mario Rossi"
                               maxlength="200"
                               style="font-size: 16px;" />
                        
                        <!-- Ricerca in rubrica: pulsanti diretti (niente dropdown Bootstrap,
                             che verrebbe tagliato dall'overflow del body dell'overlay) -->
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="OpenContactsDialog"
                                disabled="@(!IdCompany.HasValue)"
                                title="@(IdCompany.HasValue ? "Cerca tra Contatti" : "Ricerca contatti disponibile solo se l'azienda è specificata")">
                            <i class="material-icons">contacts</i>
                        </button>
                       
                       
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="OpenUsersDialog"
                                title="Cerca tra Utenti">
                            <i class="material-icons">people</i>
                        </button>

                        @if (_errorName != null)
                        {
                            <div class="invalid-feedback">@_errorName</div>
                        }
                    </div>
                    @if (!IdCompany.HasValue)
                    {
                        <small class="form-text text-muted">
                            <i class="material-icons" style="font-size: 14px; vertical-align: middle;">info</i>
                            Ricerca contatti disponibile solo se l'azienda � specificata
                        </small>
                    }
                </div>

                <!-- Input Email Firmatario -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: #495057;">
                        <i class="material-icons" style="font-size: 18px; vertical-align: middle;">email</i>
                        Email per Conferma Firma <span class="text-danger">*</span>
                    </label>
                    <input type="email"
                           class="form-control @(_errorEmail != null ? "is-invalid" : "")"
                           @bind="SignerEmail"
                           @oninput="@(() => _errorEmail = null)"
                           placeholder="Es: mario.rossi@@example.com"
                           maxlength="200"
                           style="font-size: 16px;" />
                    @if (_errorEmail != null)
                    {
                        <div class="invalid-feedback" style="display:block;">@_errorEmail</div>
                    }
                    else
                    {
                        <small class="form-text text-muted">
                            <i class="material-icons" style="font-size: 14px; vertical-align: middle;">info</i>
                            Riceverai un'email per confermare la firma. La firma sar� valida solo dopo la conferma.
                        </small>
                    }
                </div>

                <!-- Input Cellulare Firmatario (preferito per OTP via SMS) -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: #495057;">
                        <i class="material-icons" style="font-size: 18px; vertical-align: middle;">smartphone</i>
                        Cellulare (per il codice via SMS)
                    </label>
                    <input type="tel"
                           class="form-control"
                           @bind="SignerPhone"
                           placeholder="Es: +39 333 1234567"
                           maxlength="30"
                           style="font-size: 16px;" />
                    <small class="form-text text-muted">
                        <i class="material-icons" style="font-size: 14px; vertical-align: middle;">info</i>
                        Se indicato, il codice arriva via SMS; altrimenti via email.
                    </small>
                </div>

                <!-- Canvas firma -->
                <div class="signature-canvas-wrapper">
                    <canvas id="@CanvasId"
                            width="@Width"
                            height="@Height"
                            style="border: 2px solid @(_errorSignature != null ? "#dc3545" : "#dee2e6"); border-radius: 0.5rem; touch-action: none; background-color: white; cursor: crosshair;">
                    </canvas>
                </div>
                @if (_errorSignature != null)
                {
                    <div class="text-danger small mt-1 text-center">
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">error_outline</i>
                        @_errorSignature
                    </div>
                }
                else
                {
                    <div class="text-muted small mt-2 text-center">
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">info</i>
                        Firma all'interno del riquadro bianco
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="signature-overlay-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="Clear">
                    <i class="material-icons middle">clear</i>
                    Cancella
                </button>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-light" @onclick="Cancel">
                        <i class="material-icons middle">close</i>
                        Annulla
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="Save">
                        <i class="material-icons middle">check</i>
                        Conferma Firma
                    </button>
                </div>
            </div>
        </div>

        @if (_picker != PickerMode.None)
        {
            <div class="signature-overlay-container signature-picker-container" @onclick:stopPropagation>
                <div class="signature-overlay-header">
                    <h5 class="mb-0">
                        <i class="material-icons middle">@(_picker == PickerMode.Users ? "people" : "contacts")</i>
                        @(_picker == PickerMode.Users ? "Seleziona Utente" : _picker == PickerMode.NewContact ? "Nuovo Contatto" : "Seleziona Contatto")
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePicker"></button>
                </div>
                <div class="signature-overlay-body signature-picker-body">
                    @if (_picker == PickerMode.Contacts)
                    {
                        <CRM.Client.Pages.Contacts.Index IdCompany="IdCompany"
                                                         PageMode="CRM.Client.Helpers.PageHelper.PageModality.Dialog"
                                                         OnClickSelect="OnContactSelected"
                                                         OnClickNew="OpenNewContact" />
                    }
                    else if (_picker == PickerMode.Users)
                    {
                        <CRM.Client.Pages.Settings.Users.Index IdCompany="IdCompany"
                                                               PageMode="CRM.Client.Helpers.PageHelper.PageModality.Dialog"
                                                               OnSelectItem="OnUserSelected" />
                    }
                    else if (_picker == PickerMode.NewContact)
                    {
                        <CRM.Client.Pages.Contacts.Edit IdCompany="IdCompany"
                                                        PageMode="CRM.Client.Helpers.PageHelper.PageModality.Dialog"
                                                        OnSaving="OnNewContactSaved"
                                                        OnCancel="BackToContacts" />
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .signature-overlay-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
    }

    /* Nasconde il pannello firma mantenendo il canvas (e la firma) montato nel DOM */
    .signature-overlay-hidden {
        display: none !important;
    }

    /* Pannello rubrica (contatti/utenti) dentro l'overlay: più largo per la griglia */
    .signature-picker-container {
        width: min(1100px, 94vw);
        height: 85vh;
        max-height: 90vh;
    }

    .signature-picker-body {
        padding: 1rem 1.25rem;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .signature-overlay-container {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from { transform: translateY(50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .signature-overlay-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .signature-overlay-header h5 {
        color: #0d6efd;
        font-weight: 600;
    }

    .signature-validation-banner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #fff3cd;
        border-bottom: 1px solid #ffc107;
        color: #856404;
        font-weight: 500;
        font-size: 0.9rem;
        animation: bannerSlide 0.25s ease;
    }

    .signature-validation-banner .material-icons {
        font-size: 20px;
        color: #e65100;
    }

    @@keyframes bannerSlide {
        from { max-height: 0; opacity: 0; padding-top: 0; padding-bottom: 0; }
        to { max-height: 60px; opacity: 1; }
    }

    .signature-overlay-body {
        padding: 2rem 1.5rem;
        flex: 1;
        overflow: auto;
    }

    .signature-canvas-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .signature-overlay-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-bottom-left-radius: 0.75rem;
        border-bottom-right-radius: 0.75rem;
    }

    .material-icons.middle {
        vertical-align: middle;
        font-size: 20px;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Firma del Cliente";
    [Parameter] public int Width { get; set; } = 700;
    [Parameter] public int Height { get; set; } = 300;
    [Parameter] public bool RequireOtp { get; set; } = false;
    [Parameter] public EventCallback<string> OnSignatureSaved { get; set; }
    [Parameter] public EventCallback<(string signature, string signerName)> OnSignatureWithNameSaved { get; set; }
    [Parameter] public EventCallback<(string signature, string signerName, string signerEmail, string signerPhone)> OnOtpRequired { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public int? IdCompany { get; set; }

    private string CanvasId = $"signatureOverlay_{Guid.NewGuid():N}";
    private bool _initialized = false;
    private string SignerName { get; set; } = string.Empty;
    private string SignerEmail { get; set; } = string.Empty;
    private string SignerPhone { get; set; } = string.Empty;
    private bool _wasVisible = false;

    private enum PickerMode { None, Contacts, Users, NewContact }

    // Rubrica mostrata DENTRO l'overlay (nessun side-dialog Radzen esterno):
    // posizione/stile controllati da noi e canvas della firma sempre montato
    // (nascosto via CSS) così la firma non si perde mai.
    private PickerMode _picker = PickerMode.None;

    private string? _globalError = null;
    private string? _errorName = null;
    private string? _errorEmail = null;
    private string? _errorSignature = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Il canvas resta montato per tutto il tempo in cui Visible è true (anche
        // mentre la rubrica è aperta, dove l'overlay è solo nascosto via CSS):
        // inizializziamo il signature pad UNA sola volta, così la firma non si perde.
        bool justBecameVisible = Visible && !_wasVisible;
        _wasVisible = Visible;

        if ((firstRender || justBecameVisible) && Visible && !_initialized)
        {
            for (int i = 0; i < 10; i++)
            {
                try
                {
                    await JS.InvokeVoidAsync("signaturePad.initialize", CanvasId);
                    _initialized = true;
                    break;
                }
                catch
                {
                    if (i == 9)
                    {
                        Console.Error.WriteLine("SignatureOverlay: impossibile inizializzare canvas");
                    }
                    else
                    {
                        await Task.Delay(100);
                    }
                }
            }
        }

        if (!Visible && _initialized)
        {
            _initialized = false;
        }
    }

    private void ClearValidation()
    {
        _globalError = null;
        _errorName = null;
        _errorEmail = null;
        _errorSignature = null;
    }

    private async Task Clear()
    {
        if (_initialized)
        {
            await JS.InvokeVoidAsync("signaturePad.clear");
            _errorSignature = null;
        }
    }

    // === Rubrica embedded ============================================

    private void OpenContactsDialog()
    {
        if (!IdCompany.HasValue) return;
        _picker = PickerMode.Contacts;
        StateHasChanged();
    }

    private void OpenUsersDialog()
    {
        _picker = PickerMode.Users;
        StateHasChanged();
    }

    // Richiamato da Contacts.Index quando l'utente crea un nuovo contatto.
    private void OpenNewContact()
    {
        _picker = PickerMode.NewContact;
        StateHasChanged();
    }

    private void BackToContacts()
    {
        _picker = PickerMode.Contacts;
        StateHasChanged();
    }

    private void ClosePicker()
    {
        _picker = PickerMode.None;
        StateHasChanged();
    }

    // Click sullo sfondo: chiude la rubrica se aperta, altrimenti annulla la firma.
    private async Task BackdropClick()
    {
        if (_picker != PickerMode.None)
        {
            ClosePicker();
            return;
        }
        await Cancel();
    }

    private async Task OnContactSelected(int? id)
    {
        _picker = PickerMode.None;
        if (id is int cid && cid > 0)
            await LoadContactData(cid);
        StateHasChanged();
    }

    private async Task OnUserSelected(string? id)
    {
        _picker = PickerMode.None;
        if (!string.IsNullOrEmpty(id))
            await LoadUserData(id);
        StateHasChanged();
    }

    private async Task OnNewContactSaved(int? id)
    {
        _picker = PickerMode.None;
        if (id is int cid && cid > 0)
            await LoadContactData(cid);
        StateHasChanged();
    }

    private async Task LoadContactData(int contactId)
    {
        try
        {
            var contact = await Http.GetFromJsonAsync<CRM.Shared.Contact>($"{CRM.Client.Helpers.ConstHelper.ContactsPath}/{contactId}");
            if (contact != null)
            {
                SignerName = contact.NameComplete ?? string.Empty;
                SignerEmail = contact.Email ?? string.Empty;
                SignerPhone = !string.IsNullOrWhiteSpace(contact.Mobile) ? contact.Mobile : (contact.Phone ?? string.Empty);
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore caricamento contatto: {ex.Message}");
        }
    }

    private async Task LoadUserData(string userId)
    {
        try
        {
            var user = await Http.GetFromJsonAsync<CRM.Shared.ApplicationUser>($"{CRM.Client.Helpers.ConstHelper.UsersPath}/{userId}");
            if (user != null)
            {
                SignerName = user.NameComplete ?? string.Empty;
                SignerEmail = user.Email ?? string.Empty;
                SignerPhone = user.PhoneNumber ?? string.Empty;
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore caricamento utente: {ex.Message}");
        }
    }

    private async Task Save()
    {
        if (!_initialized) return;

        ClearValidation();

        try
        {
            bool hasErrors = false;

            if (string.IsNullOrWhiteSpace(SignerName))
            {
                _errorName = "Il nome e cognome del firmatario � obbligatorio";
                hasErrors = true;
            }

            var hasEmail = !string.IsNullOrWhiteSpace(SignerEmail);
            var hasPhone = !string.IsNullOrWhiteSpace(SignerPhone);

            if (!hasEmail && !hasPhone)
            {
                _errorEmail = "Inserisci email o cellulare per ricevere il codice di conferma";
                hasErrors = true;
            }
            else if (hasEmail && (!SignerEmail.Contains('@') || !SignerEmail.Contains('.')))
            {
                _errorEmail = "Inserisci un indirizzo email valido";
                hasErrors = true;
            }

            var isEmpty = await JS.InvokeAsync<bool>("signaturePad.isEmpty");
            if (isEmpty)
            {
                _errorSignature = "La firma � vuota. Firma nel riquadro bianco prima di confermare.";
                hasErrors = true;
            }

            if (hasErrors)
            {
                _globalError = "Compila tutti i campi obbligatori prima di confermare la firma.";
                StateHasChanged();
                return;
            }

            var signatureBase64 = await JS.InvokeAsync<string>("signaturePad.getSignature");

            if (!string.IsNullOrWhiteSpace(signatureBase64))
            {
                if (RequireOtp && OnOtpRequired.HasDelegate)
                {
                    await OnOtpRequired.InvokeAsync((signatureBase64, SignerName.Trim(), SignerEmail.Trim(), SignerPhone.Trim()));
                }
                else if (OnSignatureWithNameSaved.HasDelegate)
                {
                    await OnSignatureWithNameSaved.InvokeAsync((signatureBase64, SignerName.Trim()));
                }
                else
                {
                    await OnSignatureSaved.InvokeAsync(signatureBase64);
                }

                _initialized = false;
                SignerName = string.Empty;
                SignerEmail = string.Empty;
                SignerPhone = string.Empty;
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore salvataggio firma overlay: {ex.Message}");
            _globalError = $"Errore durante il salvataggio della firma: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task Cancel()
    {
        _initialized = false;
        _picker = PickerMode.None;
        SignerName = string.Empty;
        SignerEmail = string.Empty;
        SignerPhone = string.Empty;
        ClearValidation();
        await OnCancelled.InvokeAsync();
    }
}
