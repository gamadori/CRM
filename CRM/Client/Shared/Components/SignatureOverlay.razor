@using Microsoft.Extensions.Localization
@using Radzen
@inject IJSRuntime JS
@inject DialogService DialogService
@inject HttpClient Http
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

@if (Visible)
{
    <!-- Overlay fullscreen semi-trasparente -->
    <div class="signature-overlay-backdrop" @onclick="Cancel">
        <div class="signature-overlay-container" @onclick:stopPropagation>
            <!-- Header -->
            <div class="signature-overlay-header">
                <h5 class="mb-0">
                    <i class="material-icons middle">draw</i>
                    @Title
                </h5>
                <button type="button" class="btn-close" @onclick="Cancel"></button>
            </div>

            <!-- Global validation banner -->
            @if (!string.IsNullOrEmpty(_globalError))
            {
                <div class="signature-validation-banner">
                    <i class="material-icons">warning</i>
                    <span>@_globalError</span>
                </div>
            }

            <!-- Body -->
            <div class="signature-overlay-body">
                <!-- Input Nome Firmatario -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: #495057;">
                        <i class="material-icons" style="font-size: 18px; vertical-align: middle;">person</i>
                        Nome e Cognome del Firmatario <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input type="text"
                               class="form-control @(_errorName != null ? "is-invalid" : "")"
                               @bind="SignerName"
                               @oninput="@(() => _errorName = null)"
                               placeholder="Es: Mario Rossi"
                               maxlength="200"
                               style="font-size: 16px;" />
                        
                        <!-- Dropdown per scegliere tra Contatti e Utenti -->
                        <button type="button"
                                class="btn btn-outline-secondary dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                title="Seleziona da rubrica">
                            <i class="material-icons">search</i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item" 
                                        type="button"
                                        @onclick="OpenContactsDialog"
                                        disabled="@(!IdCompany.HasValue)">
                                    <i class="material-icons me-2" style="font-size: 18px; vertical-align: middle;">contacts</i>
                                    Cerca tra Contatti
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" 
                                        type="button"
                                        @onclick="OpenUsersDialog">
                                    <i class="material-icons me-2" style="font-size: 18px; vertical-align: middle;">people</i>
                                    Cerca tra Utenti
                                </button>
                            </li>
                        </ul>
                        
                        @if (_errorName != null)
                        {
                            <div class="invalid-feedback">@_errorName</div>
                        }
                    </div>
                    @if (!IdCompany.HasValue)
                    {
                        <small class="form-text text-muted">
                            <i class="material-icons" style="font-size: 14px; vertical-align: middle;">info</i>
                            Ricerca contatti disponibile solo se l'azienda è specificata
                        </small>
                    }
                </div>

                <!-- Input Email Firmatario -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: #495057;">
                        <i class="material-icons" style="font-size: 18px; vertical-align: middle;">email</i>
                        Email per Conferma Firma <span class="text-danger">*</span>
                    </label>
                    <input type="email"
                           class="form-control @(_errorEmail != null ? "is-invalid" : "")"
                           @bind="SignerEmail"
                           @oninput="@(() => _errorEmail = null)"
                           placeholder="Es: mario.rossi@@example.com"
                           maxlength="200"
                           style="font-size: 16px;" />
                    @if (_errorEmail != null)
                    {
                        <div class="invalid-feedback" style="display:block;">@_errorEmail</div>
                    }
                    else
                    {
                        <small class="form-text text-muted">
                            <i class="material-icons" style="font-size: 14px; vertical-align: middle;">info</i>
                            Riceverai un'email per confermare la firma. La firma sarà valida solo dopo la conferma.
                        </small>
                    }
                </div>

                <!-- Canvas firma -->
                <div class="signature-canvas-wrapper">
                    <canvas id="@CanvasId"
                            width="@Width"
                            height="@Height"
                            style="border: 2px solid @(_errorSignature != null ? "#dc3545" : "#dee2e6"); border-radius: 0.5rem; touch-action: none; background-color: white; cursor: crosshair;">
                    </canvas>
                </div>
                @if (_errorSignature != null)
                {
                    <div class="text-danger small mt-1 text-center">
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">error_outline</i>
                        @_errorSignature
                    </div>
                }
                else
                {
                    <div class="text-muted small mt-2 text-center">
                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">info</i>
                        Firma all'interno del riquadro bianco
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="signature-overlay-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="Clear">
                    <i class="material-icons middle">clear</i>
                    Cancella
                </button>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-light" @onclick="Cancel">
                        <i class="material-icons middle">close</i>
                        Annulla
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="Save">
                        <i class="material-icons middle">check</i>
                        Conferma Firma
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .signature-overlay-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .signature-overlay-container {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from { transform: translateY(50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .signature-overlay-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .signature-overlay-header h5 {
        color: #0d6efd;
        font-weight: 600;
    }

    .signature-validation-banner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #fff3cd;
        border-bottom: 1px solid #ffc107;
        color: #856404;
        font-weight: 500;
        font-size: 0.9rem;
        animation: bannerSlide 0.25s ease;
    }

    .signature-validation-banner .material-icons {
        font-size: 20px;
        color: #e65100;
    }

    @@keyframes bannerSlide {
        from { max-height: 0; opacity: 0; padding-top: 0; padding-bottom: 0; }
        to { max-height: 60px; opacity: 1; }
    }

    .signature-overlay-body {
        padding: 2rem 1.5rem;
        flex: 1;
        overflow: auto;
    }

    .signature-canvas-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .signature-overlay-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-bottom-left-radius: 0.75rem;
        border-bottom-right-radius: 0.75rem;
    }

    .material-icons.middle {
        vertical-align: middle;
        font-size: 20px;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Firma del Cliente";
    [Parameter] public int Width { get; set; } = 700;
    [Parameter] public int Height { get; set; } = 300;
    [Parameter] public bool RequireOtp { get; set; } = false;
    [Parameter] public EventCallback<string> OnSignatureSaved { get; set; }
    [Parameter] public EventCallback<(string signature, string signerName)> OnSignatureWithNameSaved { get; set; }
    [Parameter] public EventCallback<(string signature, string signerName, string signerEmail)> OnOtpRequired { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public int? IdCompany { get; set; }

    private string CanvasId = $"signatureOverlay_{Guid.NewGuid():N}";
    private bool _initialized = false;
    private string SignerName { get; set; } = string.Empty;
    private string SignerEmail { get; set; } = string.Empty;
    private bool _isOpeningNewContact = false;
    private bool _wasVisible = false;

    private string? _globalError = null;
    private string? _errorName = null;
    private string? _errorEmail = null;
    private string? _errorSignature = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool justBecameVisible = Visible && !_wasVisible;
        _wasVisible = Visible;

        if ((firstRender || justBecameVisible) && Visible && !_initialized)
        {
            for (int i = 0; i < 10; i++)
            {
                try
                {
                    await JS.InvokeVoidAsync("signaturePad.initialize", CanvasId);
                    _initialized = true;
                    break;
                }
                catch
                {
                    if (i == 9)
                    {
                        Console.Error.WriteLine("SignatureOverlay: impossibile inizializzare canvas");
                    }
                    else
                    {
                        await Task.Delay(100);
                    }
                }
            }
        }

        if (!Visible && _initialized)
        {
            _initialized = false;
        }
    }

    private void ClearValidation()
    {
        _globalError = null;
        _errorName = null;
        _errorEmail = null;
        _errorSignature = null;
    }

    private async Task Clear()
    {
        if (_initialized)
        {
            await JS.InvokeVoidAsync("signaturePad.clear");
            _errorSignature = null;
        }
    }

    private async Task OpenContactsDialog()
    {
        if (!IdCompany.HasValue) return;

        try
        {
            Visible = false;
            StateHasChanged();
            await Task.Delay(150);

            var contactId = await DialogService.OpenSideAsync<CRM.Client.Pages.Contacts.Index>(
                Localize["Seleziona il contatto..."],
                new Dictionary<string, object>()
                {
                    { "IdCompany", IdCompany },
                    { "PageMode", CRM.Client.Helpers.PageHelper.PageModality.Dialog },
                    { "OnClickNew", EventCallback.Factory.Create(this, OpenNewContactDialog) }
                },
                new SideDialogOptions
                {
                    Position = DialogPosition.Top,
                    ShowMask = true,
                    Height = "auto",
                    Style = "max-height: 90%;"
                });

            if (contactId is int id && id > 0)
            {
                await LoadContactData(id);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore apertura dialog contatti: {ex.Message}");
        }
        finally
        {
            if (!_isOpeningNewContact)
            {
                Visible = true;
                StateHasChanged();
            }
        }
    }

    private async Task OpenNewContactDialog()
    {
        _isOpeningNewContact = true;

        try
        {
            DialogService.CloseSide();
            await Task.Delay(500);

            Action onSave = () => { };
            Action onCancel = () => { DialogService.CloseSide(); };

            var newContactId = await DialogService.OpenSideAsync<CRM.Client.Pages.Contacts.Edit>(
                Localize["Nuovo Contatto"],
                new Dictionary<string, object>()
                {
                    { "IdCompany", IdCompany },
                    { "PageMode", CRM.Client.Helpers.PageHelper.PageModality.Dialog },
                    { "OnClickSave", onSave },
                    { "OnClickCancel", onCancel }
                },
                new SideDialogOptions
                {
                    Position = DialogPosition.Top,
                    ShowMask = true,
                    Height = "auto",
                    Style = "max-height: 90%;"
                });

            if (newContactId is int id && id > 0)
            {
                await LoadContactData(id);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore creazione nuovo contatto: {ex.Message}");
        }
        finally
        {
            _isOpeningNewContact = false;
            Visible = true;
            StateHasChanged();
        }
    }

    private async Task LoadContactData(int contactId)
    {
        try
        {
            var contact = await Http.GetFromJsonAsync<CRM.Shared.Contact>($"{CRM.Client.Helpers.ConstHelper.ContactsPath}/{contactId}");
            if (contact != null)
            {
                SignerName = contact.NameComplete ?? string.Empty;
                SignerEmail = contact.Email ?? string.Empty;
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore caricamento contatto: {ex.Message}");
        }
    }

    private async Task OpenUsersDialog()
    {
        try
        {
            Visible = false;
            StateHasChanged();
            await Task.Delay(150);

            var userId = await DialogService.OpenSideAsync<CRM.Client.Pages.Settings.Users.Index>(
                Localize["Seleziona utente..."],
                new Dictionary<string, object>()
                {
                    { "PageMode", CRM.Client.Helpers.PageHelper.PageModality.Dialog },
                    { "IdCompany", IdCompany }
                },
                new SideDialogOptions
                {
                    Position = DialogPosition.Top,
                    ShowMask = true,
                    Height = "auto",
                    Style = "max-height: 90%;"
                });

            if (userId is string id && !string.IsNullOrEmpty(id))
            {
                await LoadUserData(id);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore apertura dialog utenti: {ex.Message}");
        }
        finally
        {
            Visible = true;
            StateHasChanged();
        }
    }

    private async Task LoadUserData(string userId)
    {
        try
        {
            var user = await Http.GetFromJsonAsync<CRM.Shared.ApplicationUser>($"{CRM.Client.Helpers.ConstHelper.UsersPath}/{userId}");
            if (user != null)
            {
                SignerName = user.NameComplete ?? string.Empty;
                SignerEmail = user.Email ?? string.Empty;
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore caricamento utente: {ex.Message}");
        }
    }

    private async Task Save()
    {
        if (!_initialized) return;

        ClearValidation();

        try
        {
            bool hasErrors = false;

            if (string.IsNullOrWhiteSpace(SignerName))
            {
                _errorName = "Il nome e cognome del firmatario è obbligatorio";
                hasErrors = true;
            }

            if (string.IsNullOrWhiteSpace(SignerEmail))
            {
                _errorEmail = "L'email per la conferma della firma è obbligatoria";
                hasErrors = true;
            }
            else if (!SignerEmail.Contains('@') || !SignerEmail.Contains('.'))
            {
                _errorEmail = "Inserisci un indirizzo email valido";
                hasErrors = true;
            }

            var isEmpty = await JS.InvokeAsync<bool>("signaturePad.isEmpty");
            if (isEmpty)
            {
                _errorSignature = "La firma è vuota. Firma nel riquadro bianco prima di confermare.";
                hasErrors = true;
            }

            if (hasErrors)
            {
                _globalError = "Compila tutti i campi obbligatori prima di confermare la firma.";
                StateHasChanged();
                return;
            }

            var signatureBase64 = await JS.InvokeAsync<string>("signaturePad.getSignature");

            if (!string.IsNullOrWhiteSpace(signatureBase64))
            {
                if (RequireOtp && OnOtpRequired.HasDelegate)
                {
                    await OnOtpRequired.InvokeAsync((signatureBase64, SignerName.Trim(), SignerEmail.Trim()));
                }
                else if (OnSignatureWithNameSaved.HasDelegate)
                {
                    await OnSignatureWithNameSaved.InvokeAsync((signatureBase64, SignerName.Trim()));
                }
                else
                {
                    await OnSignatureSaved.InvokeAsync(signatureBase64);
                }

                _initialized = false;
                SignerName = string.Empty;
                SignerEmail = string.Empty;
                ClearValidation();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore salvataggio firma overlay: {ex.Message}");
            _globalError = $"Errore durante il salvataggio della firma: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task Cancel()
    {
        _initialized = false;
        SignerName = string.Empty;
        SignerEmail = string.Empty;
        ClearValidation();
        await OnCancelled.InvokeAsync();
    }
}
