@namespace CRM.Client.Shared.Components.Gantt
@using CRM.Shared
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor

<div class="redg-gantt-wrap">
    @if (_editing != null)
    {
        <div class="gantt-editor card border-0 shadow-sm mb-2">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small mb-1 d-block">Nome</label>
                        <input class="form-control form-control-sm" @bind="_editing.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-block">Inizio</label>
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_editing.StartDate" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </div>
                    @if (!_editing.IsMilestone)
                    {
                        <div class="col-md-2">
                            <label class="form-label small mb-1 d-block">Fine</label>
                            <RadzenDatePicker TValue="DateTime" @bind-Value="_editing.EndDate" DateFormat="dd/MM/yyyy" Style="width:100%" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1 d-block">Avanzamento %</label>
                            <RadzenNumeric TValue="int" @bind-Value="_editing.Progress" Min="0" Max="100" Style="width:100%" />
                        </div>
                    }
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-block">Padre</label>
                        <RadzenDropDown TValue="int?" @bind-Value="_editing.ParentId" Data="_parentOptions" TextProperty="Name" ValueProperty="Id"
                                        AllowClear="true" Placeholder="-" Style="width:100%" />
                    </div>
                </div>

                @if (!_editing.IsMilestone)
                {
                    <div class="row g-2 align-items-end mt-1">
                        <div class="col-md-4">
                            <label class="form-label small mb-1 d-block">Completamento</label>
                            <RadzenDropDown TValue="CommessaFaseCompletionMode" @bind-Value="_editing.CompletionMode"
                                            Data="_completionOptions" TextProperty="Text" ValueProperty="Value"
                                            Style="width:100%" />
                        </div>
                        <div class="col-md-3">
                            <RadzenCheckBox TValue="bool" @bind-Value="_editing.AutoCreateTicketOnTake" />
                            <label class="form-label small ms-1 mb-0">Apri ticket alla presa in carico</label>
                        </div>
                        <div class="col-md-3">
                            <RadzenCheckBox TValue="bool" @bind-Value="_editing.RequiresTicket" />
                            <label class="form-label small ms-1 mb-0">Richiede ticket</label>
                        </div>
                    </div>
                }

                @if (_editing.Id > 0)
                {
                    <div class="mt-3">
                        <label class="form-label small mb-1 d-block">Dipendenze (predecessori)</label>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @foreach (var dep in _editing.Dependencies)
                            {
                                <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                    @TaskName(dep.IdPredecessorFase)
                                    <span class="material-icons gantt-dep-remove" style="font-size:14px;cursor:pointer;" @onclick="@(() => RemoveDependency(dep))">close</span>
                                </span>
                            }
                            <RadzenDropDown TValue="int?" @bind-Value="_newPredecessorId" Data="_predecessorOptions" TextProperty="Name" ValueProperty="Id"
                                            AllowClear="true" AllowFiltering="true" Placeholder="Aggiungi predecessore" Style="width:220px" />
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AddDependency" disabled="@(_newPredecessorId == null)">Aggiungi</button>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-sm btn-primary" @onclick="SaveTask">Salva</button>
                    <button class="btn btn-sm btn-light" @onclick="CancelEdit">Annulla</button>
                    @if (_editing.Id > 0)
                    {
                        <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="DeleteTask">Elimina</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-muted p-4 text-center">Caricamento pianificazione...</div>
    }
    else if (!_tasks.Any())
    {
        <div class="gantt-empty text-center text-muted p-5">
            <span class="material-icons" style="font-size:42px;opacity:.4;">view_timeline</span>
            <div class="mt-2">Nessun task pianificato. Aggiungi il primo task o una milestone.</div>
        </div>
    }
    else
    {
        <div class="rg-toolbar">
            <div class="rg-zoom" role="group" aria-label="Scala temporale">
                <button type="button" class="rg-zoom-btn" title="Riduci la scala" @onclick="@(() => Zoom(-1))" disabled="@IsMinZoom">
                    <span class="material-icons">remove</span>
                </button>
                <button type="button" class="rg-zoom-label @(IsFitZoom ? "fit" : "")" title="Adatta la scala alla larghezza disponibile" @onclick="ResetZoom">
                    @ZoomLabel
                </button>
                <button type="button" class="rg-zoom-btn" title="Aumenta la scala" @onclick="@(() => Zoom(1))" disabled="@IsMaxZoom">
                    <span class="material-icons">add</span>
                </button>
            </div>

            @if (TodayOffsetPx is not null)
            {
                <button type="button" class="rg-tool-btn" title="Vai a oggi" @onclick="ScrollToToday">
                    <span class="material-icons">today</span> Oggi
                </button>
            }

            <div class="rg-legend">
                <span class="rg-legend-item"><i class="rg-dot planned"></i>Pianificata</span>
                <span class="rg-legend-item"><i class="rg-dot active"></i>In corso</span>
                <span class="rg-legend-item"><i class="rg-dot done"></i>Completata</span>
                <span class="rg-legend-item"><i class="rg-dot late"></i>In ritardo</span>
                <span class="rg-legend-item"><i class="rg-dot blocked"></i>Bloccata</span>
            </div>
        </div>

        <div class="rg-grid" @ref="_gridEl" @onpointermove="OnChartPointerMove" @onpointerup="OnChartPointerUp">
            <div class="rg-left">
                <div class="rg-left-head" style="@HeaderStyle">
                    <span>Attivita</span>
                    <span>Avanz.</span>
                </div>
                @for (var i = 0; i < _rows.Count; i++)
                {
                    var index = i;
                    var row = _rows[index];
                    var t = row.Task;
                    <div class="rg-left-row @(index == _hoverRow ? "hover" : "") @(row.IsSummary ? "summary" : "")"
                         style="@RowHeightStyle"
                         @onmouseenter="@(() => OnRowEnter(index))"
                         @onmouseleave="OnRowLeave"
                         @onclick="@(() => EditTask(t))">
                        <div class="rg-name" style="padding-left:@(10 + row.Depth * 14)px" title="@t.Name">
                            @if (t.IsMilestone)
                            {
                                <span class="material-icons gantt-ms-ico" style="font-size:14px;">flag</span>
                            }
                            @if (t.HasBlockingTickets)
                            {
                                <span class="material-icons gantt-blocked-ico" title="@TicketTitle(t)" style="font-size:15px;">report_problem</span>
                            }
                            <span class="rg-name-text">@t.Name</span>
                        </div>
                        <div class="rg-metrics">
                            <span class="gantt-progress-pill @(t.ProgressFromTickets ? "auto" : "")" title="@ProgressTitle(t)">@t.Progress%</span>
                            @if (t.TicketCount > 0)
                            {
                                <span class="gantt-ticket-pill @(t.HasBlockingTickets ? "blocked" : "")" title="@TicketTitle(t)">@t.ClosedTicketCount/@t.TicketCount</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="rg-canvas" style="@CanvasStyle">
                <div class="rg-head">
                    <div class="rg-months">
                        @foreach (var band in _months)
                        {
                            <div class="rg-month" style="@MonthBandStyle(band)" title="@band.Label">
                                <span>@MonthBandLabel(band)</span>
                            </div>
                        }
                    </div>
                    <div class="rg-days">
                        @for (var i = 0; i < _workdays.Count; i++)
                        {
                            var index = i;
                            var date = _workdays[index];
                            var skipped = SkippedBefore(index);
                            var dayTitle = skipped > 0 ? $"{FullDate(date)} - {GapTitle(index)}" : FullDate(date);
                            <div class="rg-day @(IsWeekStart(index) ? "week-start" : "") @(skipped > 0 ? "gap" : "") @(date == DateTime.Today ? "today" : "")"
                                 style="@DayStyle(index)"
                                 title="@dayTitle">
                                @if (ShowDayNumber(index))
                                {
                                    <span class="rg-day-num">@date.Day</span>
                                    @if (ShowWeekdayName)
                                    {
                                        <span class="rg-day-name">@ShortWeekday(date)</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="rg-body" style="@BodyStyle">
                    @if (_hoverRow >= 0 && _hoverRow < _rows.Count)
                    {
                        <div class="rg-row-hover" style="@HoverStyle(_hoverRow)"></div>
                    }

                    @for (var i = 1; i < _workdays.Count; i++)
                    {
                        var index = i;
                        @if (SkippedBefore(index) > 0)
                        {
                            <div class="rg-gap-line" style="@LineStyle(index)" title="@GapTitle(index)"></div>
                        }
                        else if (IsWeekStart(index))
                        {
                            <div class="rg-week-line" style="@LineStyle(index)"></div>
                        }
                    }

                    @if (TodayOffsetPx is double todayOffset)
                    {
                        <div class="rg-today" style="@TodayLineStyle(todayOffset)"></div>
                    }

                    <svg class="rg-deps" width="@TimelineWidthPx" height="@TimelineHeightPx" aria-hidden="true">
                        <defs>
                            <marker id="rg-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
                                <path d="M0,0 L7,3.5 L0,7 Z"></path>
                            </marker>
                        </defs>
                        @foreach (var arc in _arcs)
                        {
                            <path d="@DependencyPath(arc)" marker-end="url(#rg-arrow)"></path>
                        }
                    </svg>

                    @for (var i = 0; i < _rows.Count; i++)
                    {
                        var index = i;
                        var row = _rows[index];
                        var t = row.Task;
                        @if (t.IsMilestone)
                        {
                            <button type="button"
                                    class="rg-milestone @(index == _hoverRow ? "hover" : "")"
                                    style="@MilestoneStyle(row)"
                                    title="@BarTitle(row)"
                                    @onmouseenter="@(() => OnRowEnter(index))"
                                    @onpointerdown="@((args) => OnTaskPointerDown(args, row, DragMode.Move))"
                                    @onpointerdown:stopPropagation="true"></button>
                        }
                        else
                        {
                            <div class="rg-bar @BarStateClass(t) @(row.IsSummary ? "summary" : "") @(index == _hoverRow ? "hover" : "")"
                                 style="@BarStyle(row)"
                                 title="@BarTitle(row)"
                                 @onmouseenter="@(() => OnRowEnter(index))"
                                 @onpointerdown="@((args) => OnTaskPointerDown(args, row, DragMode.Move))"
                                 @onpointerdown:stopPropagation="true">
                                <button type="button"
                                        class="rg-handle start"
                                        title="Ridimensiona inizio"
                                        @onpointerdown="@((args) => OnTaskPointerDown(args, row, DragMode.ResizeStart))"
                                        @onpointerdown:stopPropagation="true"></button>
                                <div class="rg-bar-progress" style="width:@(t.Progress)%"></div>
                                <span class="rg-bar-label @BarLabelClass(row)">@t.Name</span>
                                @if (t.TicketCount > 0 && !row.IsSummary)
                                {
                                    <span class="rg-bar-badge">@t.ClosedTicketCount/@t.TicketCount</span>
                                }
                                @if (t.HasBlockingTickets && !row.IsSummary)
                                {
                                    <span class="rg-bar-blocked" title="@TicketTitle(t)">
                                        <span class="material-icons">report_problem</span>
                                        @t.BlockedTicketCount
                                    </span>
                                }
                                <button type="button"
                                        class="rg-handle end"
                                        title="Ridimensiona fine"
                                        @onpointerdown="@((args) => OnTaskPointerDown(args, row, DragMode.ResizeEnd))"
                                        @onpointerdown:stopPropagation="true"></button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
