@namespace CRM.Client.Shared.Components.Gantt
@using CRM.Shared
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor

<div class="redg-gantt-wrap">

    <!-- Toolbar -->
    @* <div class="gantt-toolbar">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn @(_zoom == GanttZoomLevel.Day ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => SetZoom(GanttZoomLevel.Day))">Giorno</button>
            <button class="btn @(_zoom == GanttZoomLevel.Week ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => SetZoom(GanttZoomLevel.Week))">Settimana</button>
            <button class="btn @(_zoom == GanttZoomLevel.Month ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => SetZoom(GanttZoomLevel.Month))">Mese</button>
        </div>
        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="FitToWidth" title="Adatta la scala alla larghezza disponibile">
            <span class="material-icons" style="font-size:16px;">fit_screen</span> Adatta
        </button>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="@(() => NewTask(false))">
                <span class="material-icons" style="font-size:16px;">add_task</span> Task
            </button>
            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="@(() => NewTask(true))">
                <span class="material-icons" style="font-size:16px;">flag</span> Milestone
            </button>
        </div>
    </div>
 *@
    @if (_editing != null)
    {
        <div class="gantt-editor card border-0 shadow-sm mb-2">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small mb-1 d-block">Nome</label>
                        <input class="form-control form-control-sm" @bind="_editing.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-block">Inizio</label>
                        <RadzenDatePicker TValue="DateTime" @bind-Value="_editing.StartDate" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </div>
                    @if (!_editing.IsMilestone)
                    {
                        <div class="col-md-2">
                            <label class="form-label small mb-1 d-block">Fine</label>
                            <RadzenDatePicker TValue="DateTime" @bind-Value="_editing.EndDate" DateFormat="dd/MM/yyyy" Style="width:100%" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1 d-block">Avanzamento %</label>
                            <RadzenNumeric TValue="int" @bind-Value="_editing.Progress" Min="0" Max="100" Style="width:100%" />
                        </div>
                    }
                    <div class="col-md-2">
                        <label class="form-label small mb-1 d-block">Padre</label>
                        <RadzenDropDown TValue="int?" @bind-Value="_editing.ParentId" Data="_parentOptions" TextProperty="Name" ValueProperty="Id"
                                        AllowClear="true" Placeholder="—" Style="width:100%" />
                    </div>
                </div>

                @if (!_editing.IsMilestone)
                {
                    <div class="row g-2 align-items-end mt-1">
                        <div class="col-md-4">
                            <label class="form-label small mb-1 d-block">Completamento</label>
                            <RadzenDropDown TValue="CommessaFaseCompletionMode" @bind-Value="_editing.CompletionMode"
                                            Data="_completionOptions" TextProperty="Text" ValueProperty="Value"
                                            Style="width:100%" />
                        </div>
                        <div class="col-md-3">
                            <RadzenCheckBox TValue="bool" @bind-Value="_editing.AutoCreateTicketOnTake" />
                            <label class="form-label small ms-1 mb-0">Apri ticket alla presa in carico</label>
                        </div>
                        <div class="col-md-3">
                            <RadzenCheckBox TValue="bool" @bind-Value="_editing.RequiresTicket" />
                            <label class="form-label small ms-1 mb-0">Richiede ticket</label>
                        </div>
                    </div>
                }

                @if (_editing.Id > 0)
                {
                    <div class="mt-3">
                        <label class="form-label small mb-1 d-block">Dipendenze (predecessori)</label>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @foreach (var dep in _editing.Dependencies)
                            {
                                <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                    @TaskName(dep.IdPredecessorFase)
                                    <span class="material-icons gantt-dep-remove" style="font-size:14px;cursor:pointer;" @onclick="@(() => RemoveDependency(dep))">close</span>
                                </span>
                            }
                            <RadzenDropDown TValue="int?" @bind-Value="_newPredecessorId" Data="_predecessorOptions" TextProperty="Name" ValueProperty="Id"
                                            AllowClear="true" AllowFiltering="true" Placeholder="Aggiungi predecessore" Style="width:220px" />
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AddDependency" disabled="@(_newPredecessorId == null)">Aggiungi</button>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-sm btn-primary" @onclick="SaveTask">Salva</button>
                    <button class="btn btn-sm btn-light" @onclick="CancelEdit">Annulla</button>
                    @if (_editing.Id > 0)
                    {
                        <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="DeleteTask">Elimina</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-muted p-4 text-center">Caricamento pianificazione…</div>
    }
    else if (!_tasks.Any())
    {
        <div class="gantt-empty text-center text-muted p-5">
            <span class="material-icons" style="font-size:42px;opacity:.4;">view_timeline</span>
            <div class="mt-2">Nessun task pianificato. Aggiungi il primo task o una milestone.</div>
        </div>
    }
    else
    {
        <RadzenGantt @ref="_gantt" TItem="CommessaFaseDTO" Data="@_tasks"
                     IdProperty="@nameof(CommessaFaseDTO.Id)"
                     ParentIdProperty="@nameof(CommessaFaseDTO.ParentId)"
                     TextProperty="@nameof(CommessaFaseDTO.Name)"
                     StartProperty="@nameof(CommessaFaseDTO.StartDate)"
                     EndProperty="@nameof(CommessaFaseDTO.EndDate)"
                     ProgressProperty="@nameof(CommessaFaseDTO.Progress)"
                     Dependencies="@_dependencies"
                     ShowCriticalPath="true" ShowTodayLine="true" ShowWeekends="true"
                     ZoomLevel="@_zoom" RowHeightPx="34" LeftPaneWidth="320px"
                     TaskClick="@OnTaskClick" TaskMove="@OnTaskMove" TaskResize="@OnTaskResize">
            <Columns>
                <RadzenDataGridColumn TItem="CommessaFaseDTO" Property="@nameof(CommessaFaseDTO.Name)" Title="Attività">
                    <Template Context="t">
                        @if (t.IsMilestone)
                        {
                            <span class="material-icons gantt-ms-ico" style="font-size:14px;">flag</span>
                        }
                        @if (t.HasBlockingTickets)
                        {
                            <span class="material-icons gantt-blocked-ico" title="@TicketTitle(t)" style="font-size:15px;">report_problem</span>
                        }
                        <span title="@t.Name">@t.Name</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CommessaFaseDTO" Property="@nameof(CommessaFaseDTO.Progress)" Title="%" Width="110px" Sortable="false">
                    <Template Context="t">
                        <span class="gantt-progress-pill @(t.ProgressFromTickets ? "auto" : "")" title="@ProgressTitle(t)">@t.Progress%</span>
                        @if (t.TicketCount > 0)
                        {
                            <span class="gantt-ticket-pill ms-1 @(t.HasBlockingTickets ? "blocked" : "")" title="@TicketTitle(t)">@t.ClosedTicketCount/@t.TicketCount</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <TaskTemplate Context="t">
                @if (t.IsMilestone)
                {
                    <div class="gantt-ms-diamond" title="@t.Name"></div>
                }
                else
                {
                    <div class="gantt-bar-inner @BarStateClass(t)" style="@BarColorStyle(t)" title="@BarTitle(t)">
                        <div class="gantt-bar-progress" style="width:@(t.Progress)%"></div>
                        <span class="gantt-bar-label">@t.Name</span>
                        @if (t.TicketCount > 0)
                        {
                            <span class="gantt-bar-ticket-count">@t.ClosedTicketCount/@t.TicketCount</span>
                        }
                        @if (t.HasBlockingTickets)
                        {
                            <span class="gantt-bar-blocked" title="@TicketTitle(t)">
                                <span class="material-icons">report_problem</span>
                                @t.BlockedTicketCount
                            </span>
                        }
                    </div>
                }
            </TaskTemplate>
        </RadzenGantt>
    }
</div>
