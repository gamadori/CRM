@using System.Reflection
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Humanizer

@typeparam TEnum where TEnum : struct, Enum

@inherits InputBase<TEnum>

<RtzDisplayName For="For" Text="@Label">
    <ChildContent>
        <RadzenDropDown TValue="TEnum" Data="@_enumValues" TextProperty="@nameof(EnumItem.DisplayName)" ValueProperty="@nameof(EnumItem.Value)"
                        Value="@CurrentValue" ValueChanged="OnValueChanged" Style="@Style" AllowFiltering="@AllowFiltering" 
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="@AllowClear" Placeholder="@Placeholder"
                        Disabled="@Disabled" />
    </ChildContent>
    <Helper>
        @if (For != null)
        {
            <ValidationMessage For="@For" />
        }
    </Helper>
    <End>@End</End>
</RtzDisplayName>

@code {
    private List<EnumItem> _enumValues = new();

    [Parameter]
    public string Style { get; set; } = string.Empty;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public Expression<Func<TEnum>>? For { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Helper { get; set; }

    [Parameter]
    public RenderFragment? End { get; set; }

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public bool AllowFiltering { get; set; } = false;

    [Parameter]
    public bool AllowClear { get; set; } = false;

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string? Label { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadEnumValues();
    }

    private void LoadEnumValues()
    {
        _enumValues = Enum.GetValues<TEnum>()
            .Select(e => new EnumItem
            {
                Value = e,
                DisplayName = GetDisplayName(e)
            })
            .ToList();
    }

    private async Task OnValueChanged(TEnum value)
    {
        CurrentValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    private string GetDisplayName(TEnum value)
    {
        // Read the Display attribute name
        var member = value.GetType().GetMember(value.ToString())[0];
        var displayAttribute = member.GetCustomAttribute<DisplayAttribute>();
        if (displayAttribute != null)
            return displayAttribute.GetName() ?? value.ToString();

        // Fallback on Humanizer to decamelize the enum member name
        return value.ToString().Humanize();
    }

    protected override bool TryParseValueFromString(string? value, out TEnum result, out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo(value, CultureInfo.CurrentCulture, out TEnum parsedValue))
        {
            result = parsedValue;
            validationErrorMessage = null;
            return true;
        }

        if (string.IsNullOrEmpty(value))
        {
            result = default;
            validationErrorMessage = null;
            return true;
        }

        result = default;
        validationErrorMessage = $"The {FieldIdentifier.FieldName} field is not valid.";
        return false;
    }

    private class EnumItem
    {
        public TEnum Value { get; set; }
        public string DisplayName { get; set; } = string.Empty;
    }
}