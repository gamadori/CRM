@using CRM.Shared.Helper
@using Microsoft.Extensions.Localization
@using System.IO


@if (IdFile == null)
{
    <div><SpinnerCircle></SpinnerCircle></div>
    return;
}

<div class="col-md-3 rgfile-col">
    <div class="rgfile-card" style="--rgfile-accent: @_accent;">
        <div class="rgfile-head">
            <div class="rgfile-icon">
                <span class="material-icons">@_icon</span>
            </div>
            <div class="rgfile-info">
                <span class="rgfile-name" title="@_displayName">@_displayName</span>
                <span class="rgfile-size">@_size</span>
            </div>
        </div>

        <div class="rgfile-actions">
            <RedGButton RGButtonType="RGButtonType.Download" Text="" Size="ButtonSize.Small" title="@Localize["Scarica"]" Click="@OnClickDownload"></RedGButton>
            <RedGButton RGButtonType="RGButtonType.View" Text="" Size="ButtonSize.Small" title="@Localize["Anteprima"]" Click="@OnClickView"></RedGButton>
            @if (CanImportToKnowledge && _importable)
            {
                <RadzenButton Icon="menu_book" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                              title="@Localize["Importa in Knowledge"]" Click="@OnClickImportToKnowledge"></RadzenButton>
            }
            @if (!ReadOnly)
            {
                <span class="rgfile-actions-spacer"></span>
                <RedGButton RGButtonType="RGButtonType.Edit" Size="ButtonSize.Small" title="@Localize["Rinomina File"]" Click="@OnClickEdit"></RedGButton>
                <RedGButton RGButtonType="RGButtonType.Delete" Size="ButtonSize.Small" title="@Localize["Delete"]" Click="@OnClickDelete"></RedGButton>
            }
        </div>
    </div>
</div>

<style>
    .rgfile-col {
        padding: 0.5rem;
    }

    .rgfile-card {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        height: 100%;
        padding: 1rem;
        background: var(--crm-surface-raised, #fff);
        border: 1px solid var(--crm-border, #e5e7eb);
        border-radius: 14px;
        box-shadow: var(--crm-shadow, 0 6px 16px rgba(31, 42, 68, 0.06));
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .rgfile-card:hover {
        transform: translateY(-3px);
        border-color: var(--rgfile-accent, var(--crm-border-strong));
        box-shadow: 0 14px 30px rgba(31, 42, 68, 0.14);
    }

    .rgfile-head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-width: 0;
    }

    .rgfile-icon {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        color: var(--rgfile-accent, var(--rz-primary));
        background: color-mix(in srgb, var(--rgfile-accent, var(--rz-primary)) 14%, transparent);
        transition: transform 0.2s ease;
    }

    .rgfile-card:hover .rgfile-icon {
        transform: scale(1.06);
    }

    .rgfile-icon .material-icons {
        font-size: 26px;
    }

    .rgfile-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 0.15rem;
    }

    .rgfile-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--crm-text, #333);
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rgfile-size {
        font-size: 0.75rem;
        color: var(--crm-text-muted, #6c757d);
    }

    .rgfile-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--crm-border, #eef2f7);
    }

    .rgfile-actions-spacer {
        margin-left: auto;
    }

    /* Uniforma i pulsanti icona nella barra azioni */
    .rgfile-actions .rz-button {
        border-radius: 9px;
        transition: transform 0.15s ease, filter 0.15s ease;
    }

    .rgfile-actions .rz-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
    }
</style>

@code
{
    [Inject]
    DialogService DialogService { get; set; }

    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }

    [Inject]
    NavigationManager NavigationManager { get; set; }   

   
    [Parameter]
    public int? IdFile { get; set; } = null;

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public double Size { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;


    [Parameter]
    public EventCallback<bool> OnSelectedChanged { get; set; }

    [Parameter]
    public EventCallback<int?> OnDownload { get; set; }

    [Parameter]
    public EventCallback<int?> OnDelete { get; set; }

    [Parameter]
    public EventCallback<(int? IdFile, string NewName)> OnRename { get; set; }

    /// <summary>Abilita il pulsante "Importa in Knowledge" (mostrato solo per formati importabili: PDF/DOCX/TXT/MD).</summary>
    [Parameter]
    public bool CanImportToKnowledge { get; set; } = false;

    [Parameter]
    public EventCallback<int?> OnImportToKnowledge { get; set; }

    private string _icon;

    private string _size;

    private string _displayName;

    private bool _importable;

    private FileTypes _fileTypes;

    /// <summary>Colore accento del file, in base al tipo (usato per icona e hover della card).</summary>
    private string _accent = "#64748b";

    protected void CheckBoxOnClick()
    {
        Selected = !Selected;
        StateHasChanged();
        OnSelectedChanged.InvokeAsync(Selected);
    }

    protected void OnClickDelete()
    {
        OnDelete.InvokeAsync(IdFile);
    }

    protected void OnClickDownload()
    {
        OnDownload.InvokeAsync(IdFile);
    }

    protected void OnClickImportToKnowledge()
    {
        OnImportToKnowledge.InvokeAsync(IdFile);
    }

    protected async Task OnClickEdit()
    {
        var nameWithoutExtension = System.IO.Path.GetFileNameWithoutExtension(Name);
        var extension = System.IO.Path.GetExtension(Name);

        var result = await DialogService.OpenAsync(Localize["Rinomina File"], ds =>
    @<div>
        <div class="mb-3">
            <label class="form-label">@Localize["Nome File"]</label>
            <RadzenTextBox @bind-Value="nameWithoutExtension" Style="width: 100%" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localize["Estensione"]</label>
            <RadzenText TextStyle="TextStyle.Body1">@extension</RadzenText>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <RadzenButton Text="@Localize["Annulla"]" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="@Localize["Salva"]" Click="() => ds.Close(true)" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
    );

        if (result == true && !string.IsNullOrWhiteSpace(nameWithoutExtension))
        {
            var newName = $"{nameWithoutExtension}{extension}";
            await OnRename.InvokeAsync((IdFile, newName));
            _displayName = newName;
            StateHasChanged();
        }
    }

    protected async Task OnClickView()
    {
        
        var id = await DialogService.OpenSideAsync<CRM.Client.Pages.DocViewer.Viewer>(Localize["Preview Documento"], new Dictionary<string, object>() { { "Id", IdFile } },
                new SideDialogOptions { Position = DialogPosition.Top, ShowMask = false, Height = "100vh" });

    }

    

    protected override void OnParametersSet()
    {
        _displayName = Name;

        switch (Path.GetExtension(Name).ToLower())
        {
            case ".pdf":
                _icon = "picture_as_pdf";
                _fileTypes = FileTypes.Document;
                _accent = "#e2574c"; // rosso PDF
                break;

            case ".zip":
                _icon = "folder_zip";
                _fileTypes = FileTypes.Zip;
                _accent = "#f0a020"; // ambra archivi
                break;
            case ".docx":
            case ".doc":
                _icon = "description";
                _fileTypes = FileTypes.Document;
                _accent = "#2b7de9"; // blu Word
                break;
            case ".dxf":
                _icon = "architecture";
                _fileTypes = FileTypes.CAD;
                _accent = "#6b7a90"; // slate CAD
                break;
            case ".xlsx":
            case ".xls":
                _icon = "grid_on";
                _fileTypes = FileTypes.Spreadsheet;
                _accent = "#21a366"; // verde Excel
                break;
            case ".jpg":
            case ".png":
            case ".jpeg":
            case ".gif":
            case ".bmp":
            case ".tiff":
            case ".svg":

                _fileTypes = FileTypes.Image;
                _icon = "image";
                _accent = "#8b5cf6"; // viola immagini
            break;
            default:
                _icon = "article";
                _fileTypes = FileTypes.Other;
                _accent = "#64748b"; // grigio neutro
                break;
        }

        _size = FileHelper.FormatToHumanReadableFileSize(Size);

        // Formati importabili nella base di conoscenza (allineato a DocumentTextExtractor lato server).
        _importable = Path.GetExtension(Name).ToLower() is ".pdf" or ".docx" or ".txt" or ".md";

    }

   
}
