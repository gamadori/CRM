@using CRM.Shared.Helper
@using Microsoft.Extensions.Localization
@using System.IO


@if (IdFile == null)
{
    <div><SpinnerCircle></SpinnerCircle></div>
    return;
}

<div class="col-md-3">
    <div class="card file-card-3d m-3 shadow h-100 py-2">
        <div class="row g-0">
            <div class="col">
                
                <div class="p-3 py-4 bg-light text-center rounded">
                    <span class="material-icons file-icon" style="font-size:32px;color:#1976d2;">
                        @_icon
                    </span>
                </div>
                
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h6 class="file-name mb-1" title="@_displayName">@_displayName</h6>
                    <p class="file-size mb-0"><small class="text-muted">@_size</small></p>
                </div>
            </div>
        </div>
        <div class="card-footer bg-transparent pt-3">
           
            <RedGButton class="mx-1" RGButtonType="RGButtonType.Download" Text="" Click="@OnClickDownload"></RedGButton>
            <RedGButton class="mx-1" RGButtonType="RGButtonType.View" Text="" Click="@OnClickView"></RedGButton>
            @if (!ReadOnly)
            {
                <RedGButton class="mx-1" RGButtonType="RGButtonType.Edit" Text="" Click="@OnClickEdit"></RedGButton>
                <RedGButton class="mx-1" RGButtonType="RGButtonType.Delete" Click="@OnClickDelete"></RedGButton>
            }
        </div>
    </div>
    
</div>

<style>
    .file-card-3d {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 8px;
    }

    .file-card-3d:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2) !important;
    }

    .file-icon {
        transition: transform 0.2s ease;
    }

    .file-card-3d:hover .file-icon {
        transform: scale(1.1);
    }

    .file-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: #333;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-size {
        font-size: 0.75rem;
        color: #6c757d;
    }
</style>

@code
{
    [Inject]
    DialogService DialogService { get; set; }

    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }

    [Inject]
    NavigationManager NavigationManager { get; set; }   

   
    [Parameter]
    public int? IdFile { get; set; } = null;

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public double Size { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;


    [Parameter]
    public EventCallback<bool> OnSelectedChanged { get; set; }

    [Parameter]
    public EventCallback<int?> OnDownload { get; set; }

    [Parameter]
    public EventCallback<int?> OnDelete { get; set; }

    [Parameter]
    public EventCallback<(int? IdFile, string NewName)> OnRename { get; set; }

    private string _icon;

    private string _size;

    private string _displayName;

    private FileTypes _fileTypes;

    protected void CheckBoxOnClick()
    {
        Selected = !Selected;
        StateHasChanged();
        OnSelectedChanged.InvokeAsync(Selected);
    }

    protected void OnClickDelete()
    {
        OnDelete.InvokeAsync(IdFile);
    }

    protected void OnClickDownload()
    {
        OnDownload.InvokeAsync(IdFile);
    }

    protected async Task OnClickEdit()
    {
        var nameWithoutExtension = System.IO.Path.GetFileNameWithoutExtension(Name);
        var extension = System.IO.Path.GetExtension(Name);

        var result = await DialogService.OpenAsync(Localize["Rinomina File"], ds =>
    @<div>
        <div class="mb-3">
            <label class="form-label">@Localize["Nome File"]</label>
            <RadzenTextBox @bind-Value="nameWithoutExtension" Style="width: 100%" />
        </div>
        <div class="mb-3">
            <label class="form-label">@Localize["Estensione"]</label>
            <RadzenText TextStyle="TextStyle.Body1">@extension</RadzenText>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <RadzenButton Text="@Localize["Annulla"]" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="@Localize["Salva"]" Click="() => ds.Close(true)" ButtonStyle="ButtonStyle.Primary" />
        </div>
    </div>
    );

        if (result == true && !string.IsNullOrWhiteSpace(nameWithoutExtension))
        {
            var newName = $"{nameWithoutExtension}{extension}";
            await OnRename.InvokeAsync((IdFile, newName));
            _displayName = newName;
            StateHasChanged();
        }
    }

    protected async Task OnClickView()
    {
        
        var id = await DialogService.OpenSideAsync<CRM.Client.Pages.DxfViewer.Viewer>(Localize["Preview Documento"], new Dictionary<string, object>() { { "Id", IdFile } },
                new SideDialogOptions { Position = DialogPosition.Top, ShowMask = false, Height = "100vh" });

    }

    

    protected override void OnParametersSet()
    {
        _displayName = Name;

        switch (Path.GetExtension(Name).ToLower())
        {
            case ".pdf":
                _icon = "picture_as_pdf";
                _fileTypes = FileTypes.Document;
                break;

            case ".zip":
                _icon = "folder_zip";
                _fileTypes = FileTypes.Zip;
                break;
            case ".docx":
            case ".doc":
                _icon = "description";
                _fileTypes = FileTypes.Document;
                break;
            case ".dxf":
                _icon = "architecture";
                _fileTypes = FileTypes.CAD;
                break;
            case ".xlsx":
            case ".xls":
                _icon = "grid_on";
                _fileTypes = FileTypes.Spreadsheet;
                break;
            case ".jpg":
            case ".png":
            case ".jpeg":
            case ".gif":
            case ".bmp":
            case ".tiff":
            case ".svg":
            
                _fileTypes = FileTypes.Image;
                _icon = "image";
            break;
            default:
                _icon = "article";
                _fileTypes = FileTypes.Other;
                break;
        }

        _size = FileHelper.FormatToHumanReadableFileSize(Size);

    }

   
}
