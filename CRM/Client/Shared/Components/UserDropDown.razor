
@if (_users != null)
{
    <RadzenDropDownDataGrid class="form-control" @bind-Value="@Value" TValue="string" AllowFiltering="true" PageSize="@ConstHelper.PageSize" AllowClear="true"
                            Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id" Change="OnSelectedUserChange" />
}
else
{
    <SpinnerComponent></SpinnerComponent>
}