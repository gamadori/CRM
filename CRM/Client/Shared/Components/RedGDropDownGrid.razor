@using System.Reflection
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Resources
@using Microsoft.Extensions.Localization

@typeparam TItem
@typeparam TValue

@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

<RtzDisplayName For="For" Text="@Label">
    <ChildContent>

        <RadzenDropDownDataGrid @rendermode="renderMode" TValue="TValue" Data="@Data" TextProperty="@TextProperty" AllowClear=@AllowClear PageSize="@PageSize" Count="@Count" PagingSummaryFormat="@ConstHelper.PagingSummaryFormatShort"
                        ValueProperty="@ValueProperty" Value="@Value" ValueChanged="ValueChanged" Style="@Style" AllowFiltering="@AllowFiltering" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="@EffectivePlaceholder" Change="@Change">
            <Columns>
                @ChildColumns
            </Columns>
        </RadzenDropDownDataGrid>
    </ChildContent>
    <Helper>
        @if (For != null)
        {
            <ValidationMessage For="@For" />
        }
    </Helper>
    <End>@End</End>
</RtzDisplayName>


@code {

    [Parameter]
    public TValue Value { get; set; } = default!;
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter]
    public string Style { get; set; } = string.Empty;
    [Parameter]
    public string Name { get; set; } = string.Empty;
    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    // Segnaposto mostrato quando non c'è selezione (Value null): mantiene la
    // floating label ancorata in alto invece di lasciarla al centro del campo.
    private string EffectivePlaceholder =>
        string.IsNullOrWhiteSpace(Placeholder) ? Localize["Seleziona"] : Placeholder;

    [Parameter]
    public IComponentRenderMode renderMode { get; set; } = RenderMode.InteractiveAuto;
    [Parameter]
    public Expression<Func<TValue>> For { get; set; } = default!;
    [Parameter]
    public RenderFragment ChildColumns { get; set; } = default!;
    [Parameter]
    public RenderFragment Helper { get; set; } = default!;
    [Parameter]
    public RenderFragment? End { get; set; } = default!;
    [Parameter]
    public string CssClass { get; set; } = string.Empty;
    [Parameter]
    public IEnumerable<TItem> Data { get; set; } = Enumerable.Empty<TItem>();
    [Parameter]
    public string TextProperty { get; set; } = "Text";
    [Parameter]
    public string ValueProperty { get; set; } = "Value";

    [Parameter]
    public bool AllowFiltering { get; set; } = false;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public int PageSize { get; set; } = ConstHelper.PageSize;

    [Parameter]
    public bool AllowClear { get; set; } = true;

    [Parameter]
    public int Count { get; set; } = 0; 

    [Parameter]
    public EventCallback<object> Change { get; set; }
}
