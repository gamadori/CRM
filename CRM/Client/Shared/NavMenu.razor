@using CRM.Client.Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<CRM.Shared.Resources.App> Localize

<!-- Modern Top Bar -->
<div class="top-row navbar modern-topbar">
    <div class="container-fluid px-3">
        <div class="d-flex justify-content-center align-items-center w-100">
            <a class="navbar-brand d-flex align-items-center" href="">
                <img src="/img/logoCrm.png?v=4" height="32" alt="CRM Logo" />
            </a>
        </div>
        <button class="navbar-toggler border-0 position-absolute end-0 me-3" @onclick="ToggleNavMenu">
            <span class="material-icons">@(collapseNavMenu ? "menu" : "close")</span>
        </button>
    </div>
</div>

<!-- Modern Navigation Menu -->
<div class="@NavMenuCssClass nav-scrollable modern-nav">
    <nav class="flex-column">
        
        <!-- Home Section -->
        <div class="nav-section">
            <div class="nav-item" @onclick="MenuHomeClicked">
                <div class="nav-link @(_expandHome ? "active" : "")">
                    <span class="material-icons nav-icon">home</span>
                    <span class="nav-text">Home</span>
                    <span class="material-icons expand-icon">@(_expandHome ? "expand_less" : "expand_more")</span>
                </div>
            </div>

            @if (_expandHome)
            {
                <div class="nav-submenu">
                    <NavLink class="nav-link submenu-link" href="/" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                        <span class="material-icons nav-icon">dashboard</span>
                        <span class="nav-text">@Localize["DashBoard"]</span>
                    </NavLink>

                    <div class="nav-item">
                        <div class="nav-link submenu-link" @onclick="()=>_expandCRM = !_expandCRM">
                            <span class="material-icons nav-icon">groups</span>
                            <span class="nav-text">CRM</span>
                            <span class="material-icons expand-icon-small">@(_expandCRM ? "expand_less" : "expand_more")</span>
                        </div>

                        @if (_expandCRM)
                        {
                            <div class="nav-submenu-2">
                                <NavLink class="nav-link submenu-link-2" href="Companies" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">domain</span>
                                    <span class="nav-text">@Localize["Aziende"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Contacts" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">contacts</span>
                                    <span class="nav-text">@Localize["Contacts"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Agenda" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">event</span>
                                    <span class="nav-text">@Localize["Agenda"]</span>
                                </NavLink>
                            </div>
                        }
                    </div>

                    <div class="nav-item">
                        <div class="nav-link submenu-link" @onclick="()=>_expandCommerciale = !_expandCommerciale">
                            <span class="material-icons nav-icon">trending_up</span>
                            <span class="nav-text">Commerciale</span>
                            <span class="material-icons expand-icon-small">@(_expandCommerciale ? "expand_less" : "expand_more")</span>
                        </div>

                        @if (_expandCommerciale)
                        {
                            <div class="nav-submenu-2">
                                <NavLink class="nav-link submenu-link-2" href="Leads" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">person_search</span>
                                    <span class="nav-text">Lead</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Deals" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">handshake</span>
                                    <span class="nav-text">@Localize["Deals"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Deals/Forecast" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">query_stats</span>
                                    <span class="nav-text">Forecast</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Quotes" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">request_quote</span>
                                    <span class="nav-text">@Localize["Quotes"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Orders" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">shopping_cart</span>
                                    <span class="nav-text">@Localize["Orders"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Invoices" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">receipt_long</span>
                                    <span class="nav-text">@Localize["Invoices"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="WorkflowAutomations" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">rule</span>
                                    <span class="nav-text">Automazioni</span>
                                </NavLink>
                            </div>
                        }
                    </div>

                    <div class="nav-item">
                        <div class="nav-link submenu-link" @onclick="()=>_expandService = !_expandService">
                            <span class="material-icons nav-icon">support_agent</span>
                            <span class="nav-text">Service</span>
                            <span class="material-icons expand-icon-small">@(_expandService ? "expand_less" : "expand_more")</span>
                        </div>

                        @if (_expandService)
                        {
                            <div class="nav-submenu-2">
                                <NavLink class="nav-link submenu-link-2" href="Tickets" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">confirmation_number</span>
                                    <span class="nav-text">@Localize["Tickets"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Tickets/Schedule" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">event_note</span>
                                    <span class="nav-text">Pianificazione Ticket</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Projects" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">account_tree</span>
                                    <span class="nav-text">@Localize["Projects"]</span>
                                </NavLink>

                                <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                    <NavLink class="nav-link submenu-link-2" href="TicketFeedbacks" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                        <span class="material-icons nav-icon-small">rate_review</span>
                                        <span class="nav-text">Feedback Clienti</span>
                                        @if (_unreadFeedbacksCount > 0)
                                        {
                                            <span class="badge bg-danger ms-auto">@_unreadFeedbacksCount</span>
                                        }
                                    </NavLink>
                                </AuthorizeView>
                            </div>
                        }
                    </div>

                    <div class="nav-item">
                        <div class="nav-link submenu-link" @onclick="()=>_expandMenuProdotti = !_expandMenuProdotti">
                            <span class="material-icons nav-icon">inventory_2</span>
                            <span class="nav-text">Catalogo</span>
                            <span class="material-icons expand-icon-small">@(_expandMenuProdotti ? "expand_less" : "expand_more")</span>
                        </div>

                        @if (_expandMenuProdotti)
                        {
                            <div class="nav-submenu-2">
                                <NavLink class="nav-link submenu-link-2" href="Catalog" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">category</span>
                                    <span class="nav-text">@Localize["Catalog"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Products" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">inventory_2</span>
                                    <span class="nav-text">@Localize["Products"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2" href="Articles" Match="NavLinkMatch.Prefix" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">precision_manufacturing</span>
                                    <span class="nav-text">@Localize["Articles"]</span>
                                </NavLink>
                            </div>
                        }
                    </div>

                    <div class="nav-item">
                        <div class="nav-link submenu-link highlight-ai" @onclick="()=>_expandAI = !_expandAI">
                            <span class="material-icons nav-icon">auto_awesome</span>
                            <span class="nav-text">AI Assistant</span>
                            <span class="material-icons expand-icon-small">@(_expandAI ? "expand_less" : "expand_more")</span>
                        </div>

                        @if (_expandAI)
                        {
                            <div class="nav-submenu-2">
                                <NavLink class="nav-link submenu-link-2 highlight-ai" href="Tickets/Search" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">psychology</span>
                                    <span class="nav-text">@Localize["Search"] AI</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2 highlight-ai" href="Tickets/Assistant" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">smart_toy</span>
                                    <span class="nav-text">@Localize["Assistant"]</span>
                                </NavLink>

                                <NavLink class="nav-link submenu-link-2 highlight-ai" href="Tickets/DataAssistant" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                                    <span class="material-icons nav-icon-small">storage</span>
                                    <span class="nav-text">@Localize["DataAssistant"]</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Settings Section -->
        <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
            <div class="nav-section">
                <NavLink class="nav-link" href="Settings" @onclick="@(() => { MenuSettingsClicked(); CloseNavMenu(); })">
                    <span class="material-icons nav-icon">settings</span>
                    <span class="nav-text">@Localize["Settings"]</span>
                </NavLink>
            </div>
        </AuthorizeView>

        <!-- About Section -->
        <div class="nav-section">
            <NavLink class="nav-link" href="About" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                <span class="material-icons nav-icon">info</span>
                <span class="nav-text">@Localize["About"]</span>
            </NavLink>
        </div>

    </nav>
</div>

@code {
    [Inject]
    ITicketFeedbackService TicketFeedbacksService { get; set; }

    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool _expandedSettings = false;

    private bool _expandHome = false;

    private bool _hasPageName = true;

    private bool _expandCRM = false;

    private bool _expandCommerciale = false;

    private bool _expandService = false;

    private bool _expandMenuProdotti = false;

    private bool _expandAI = false;

    private int _unreadFeedbacksCount = 0;

    private void MenuHomeClicked()
    {
        _expandedSettings = false;
        _expandHome = !_expandHome;
    }

    private void MenuSettingsClicked()
    {
        _expandHome = false;
        _expandedSettings = !_expandedSettings;
    }

    private void ToggleNavMenu()
    {
        if (_hasPageName)
            collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadFeedbacksCount();
    }

    private async Task LoadUnreadFeedbacksCount()
    {
        try
        {
            // TODO: Implementare chiamata API per ottenere il count dei feedback non letti
            // var count = await HttpClient.GetFromJsonAsync<int>("api/TicketFeedback/pending/count");
            // _unreadFeedbacksCount = count;
            var unread = await TicketFeedbacksService.GetListAsync(new TicketFeedbackFilterModel { IsRead = false });

            _unreadFeedbacksCount = unread.Count(); // Placeholder per ora
        }
        catch
        {
            _unreadFeedbacksCount = 0;
        }
    }
}
