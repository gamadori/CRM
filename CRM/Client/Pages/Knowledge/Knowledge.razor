@page "/Knowledge"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Forms

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <span class="material-icons me-2" style="vertical-align: middle;">menu_book</span>
                Base di Conoscenza
            </h2>
            <p class="text-muted mb-0">Manuali, procedure e guasti tipici associati ai modelli di macchina. Usata dall'assistente ticket.</p>
        </div>
        <div class="d-flex gap-2">
            <RadzenButton Click="@NewItem" Icon="add" Text="Nuova voce" ButtonStyle="ButtonStyle.Primary" Disabled="@_editing" />
            <RadzenButton Click="@GenerateEmbeddings" Icon="bolt" Text="Genera embedding" ButtonStyle="ButtonStyle.Light" Disabled="@_editing" />
        </div>
    </div>

    @if (_editing)
    {
        <!-- Form voce -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Titolo *</label>
                        <RadzenTextBox @bind-Value="@_current.Title" class="w-100" Placeholder="Es: Sostituzione filtro aria" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Categoria</label>
                        <RadzenTextBox @bind-Value="@_current.Category" class="w-100" Placeholder="Es: Manutenzione" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Modello</label>
                        <RadzenDropDown @bind-Value="@_current.IdProduct"
                                        Data="@_products"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="(Conoscenza generale — tutti i modelli)"
                                        class="w-100" TValue="int?" />
                        <small class="text-muted">Lascia vuoto per una voce valida per tutti i modelli.</small>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Contenuto *</label>
                        <RadzenTextArea @bind-Value="@_current.Content" Rows="10" class="w-100" Style="resize: vertical;"
                                        Placeholder="Descrivi la procedura, la soluzione o le informazioni tecniche..." />
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <RadzenButton Click="@SaveItem" Icon="save" Text="Salva" ButtonStyle="ButtonStyle.Primary" />
                        <RadzenButton Click="@CancelEdit" Icon="close" Text="Annulla" ButtonStyle="ButtonStyle.Light" />
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Import documento -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="fw-semibold mb-2">
                    <span class="material-icons me-1" style="font-size: 18px; vertical-align: middle;">upload_file</span>
                    Importa documento
                </h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small">File (PDF, DOCX, TXT, MD)</label>
                        @if (_stagedFileName != null)
                        {
                            <div class="form-control d-flex align-items-center justify-content-between gap-2">
                                <span class="text-truncate d-flex align-items-center gap-1">
                                    <span class="material-icons text-info" style="font-size: 18px;">description</span>
                                    <span class="text-truncate" title="@_stagedFileName">@_stagedFileName</span>
                                </span>
                                <a href="#" @onclick:preventDefault @onclick="ClearStaged" class="small text-danger text-nowrap">rimuovi</a>
                            </div>
                            <div class="small text-muted mt-1">Documento precaricato da allegato prodotto.</div>
                        }
                        else
                        {
                            <InputFile OnChange="@OnFileSelected" class="form-control" accept=".pdf,.docx,.txt,.md" />
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Modello (opzionale)</label>
                        <RadzenDropDown @bind-Value="@_importProductId"
                                        Data="@_products"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Placeholder="(Generale)"
                                        class="w-100" TValue="int?" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Categoria</label>
                        <RadzenTextBox @bind-Value="@_importCategory" class="w-100" Placeholder="Documento" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small">Da pag.</label>
                        <RadzenNumeric @bind-Value="@_importPageFrom" TValue="int?" Min="1" ShowUpDown="false"
                                       Placeholder="1" class="w-100" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small">A pag.</label>
                        <RadzenNumeric @bind-Value="@_importPageTo" TValue="int?" Min="1" ShowUpDown="false"
                                       Placeholder="fine" class="w-100" />
                    </div>
                    <div class="col-md-2">
                        <RadzenButton Click="@ImportDocumentAsync" Icon="upload" Text="Importa"
                                      ButtonStyle="ButtonStyle.Secondary" Disabled="@_importing" class="w-100" />
                    </div>
                </div>
                @if (_importing)
                {
                    <div class="mt-2 small text-muted d-flex align-items-center gap-2">
                        <Waiting></Waiting> Estrazione ed elaborazione in corso...
                    </div>
                }
                else
                {
                    <div class="mt-2 small text-muted">Il documento viene spezzato in blocchi e indicizzato per la ricerca dell'assistente. L'intervallo pagine vale solo per i PDF: se lasci vuoto viene elaborato l'intero documento.</div>
                }
            </div>
        </div>

        <!-- Ricerca -->
        <div class="input-group mb-3" style="max-width: 480px;">
            <RadzenTextBox @bind-Value="@_search" Placeholder="Cerca in titolo/contenuto..." class="form-control"
                           @onkeyup="@(async (e) => { if (e.Key == "Enter") await LoadItems(); })" />
            <RadzenButton Click="@LoadItems" Icon="search" ButtonStyle="ButtonStyle.Light" />
        </div>

        <!-- Elenco: una riga per documento; espandi per vedere le singole parti -->
        <RadzenDataGrid Data="@_documents" TItem="KnowledgeDocument" IsLoading="@_loading"
                        AllowSorting="true" AllowPaging="true" PageSize="15"
                        ExpandMode="DataGridExpandMode.Single" RowRender="@OnDocRowRender"
                        EmptyText="Nessuna voce di conoscenza.">
            <Template Context="doc">
                <div class="p-3 bg-light">
                    <div class="small text-muted mb-2">
                        <span class="material-icons" style="font-size:14px;vertical-align:middle;">list</span>
                        @doc.PartCount parti del documento
                    </div>
                    <RadzenDataGrid Data="@doc.Parts" TItem="ProductKnowledgeDTO" AllowPaging="false" class="shadow-sm">
                        <Columns>
                            <RadzenDataGridColumn TItem="ProductKnowledgeDTO" Property="Title" Title="Parte" />
                            <RadzenDataGridColumn TItem="ProductKnowledgeDTO" Title="Embedding" Width="110px" TextAlign="Radzen.TextAlign.Center">
                                <Template Context="p">
                                    @if (p.HasEmbedding)
                                    {
                                        <span class="badge bg-success">Sì</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductKnowledgeDTO" Title="Azioni" Width="120px" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                                <Template Context="p">
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="@(async () => await EditItem(p.Id))" class="me-1" />
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                  Click="@(async () => await DeleteItem(p))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </Template>
            <Columns>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Title="Titolo">
                    <Template Context="doc">
                        <span class="material-icons me-1" style="font-size:16px;vertical-align:middle;color:#94a3b8;">
                            @(doc.IsImport ? "description" : "article")
                        </span>
                        @doc.Title
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Title="Modello">
                    <Template Context="doc">
                        @(string.IsNullOrWhiteSpace(doc.ProductName) ? "Generale" : doc.ProductName)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Property="Category" Title="Categoria" Width="140px" />
                <RadzenDataGridColumn TItem="KnowledgeDocument" Property="CreatedAt" Title="Caricato il" Width="120px">
                    <Template Context="doc">
                        @doc.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Title="Parti" Width="80px" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="doc">
                        @(doc.IsImport ? doc.PartCount.ToString() : "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Title="Embedding" Width="130px" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="doc">
                        @if (doc.AllEmbedded)
                        {
                            <span class="badge bg-success">Sì</span>
                        }
                        else if (doc.WithEmbedding > 0)
                        {
                            <span class="badge bg-warning text-dark">@doc.WithEmbedding/@doc.PartCount</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="KnowledgeDocument" Title="Azioni" Width="160px" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="doc">
                        @if (doc.IsImport)
                        {
                            <RadzenButton Icon="bolt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          title="Rigenera embedding del documento"
                                          Click="@(async () => await RegenerateDocumentEmbeddings(doc))" class="me-1" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          title="Elimina l'intero documento"
                                          Click="@(async () => await DeleteDocument(doc))" />
                        }
                        else
                        {
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(async () => await EditItem(doc.Parts[0].Id))" class="me-1" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(async () => await DeleteItem(doc.Parts[0]))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>
