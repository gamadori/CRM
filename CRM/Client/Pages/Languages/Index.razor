
@page "/Settings/Languages"
@page "/Settings/Languages/Index"


@using CRM.Shared.Models


<style>
    .rz-grid-table {
    width: unset;
    }
</style>

<RadzenDataGrid @ref="_grdLanguages" AllowAlternatingRows="false" LoadData="@LoadData" AllowFiltering="true" AllowPaging="true" PageSize="@ConstHelper.PageSize" AllowSorting="true" EditMode="DataGridEditMode.Single"
                 Data="@_languages" TItem="Language" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" Sort="@Reset" Page="@Reset" Filter="@Reset" ColumnWidth="200px">
    <HeaderTemplate>
        <RedGButton RGButtonType="RGButtonType.New" Click="@InsertRow" Disabled="@(_languagesToInsert.Count() > 0)"></RedGButton>
        @* <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="@Localize["AddNew"]" Click="@InsertRow" Disabled="@(_languagesToInsert.Count() > 0)" /> *@
    </HeaderTemplate>

    <Columns>
        
        <RadzenDataGridColumn Property="@nameof(Language.Index)" Title="Position">
            <EditTemplate Context="Language">
                <RadzenNumeric  @bind-Value="Language.Index" Style="min-width: 280px; display: block" Name="LanguageIndex" aria-label="Enter Language Index" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(Language.LanguageCode)" Title="Code">
            <EditTemplate Context="Language">
                <RadzenTextBox @bind-Value="Language.LanguageCode" Style="min-width: 280px; display: block" Name="LanguageCode" aria-label="Enter Language Code" />
                <RadzenRequiredValidator  Text="@Localize["Required"]" Component="LanguageCode" Popup="true" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(Language.Name)" Title="Name" >
            <EditTemplate Context="Language">
                <RadzenTextBox @bind-Value="Language.Name" Style="min-width:300px; display: block" Name="LanguageName" aria-label="Enter Language Name" />
                <RadzenRequiredValidator Text="@Localize["Required"]" Component="LanguageName" Popup="true" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(Language.Flag)" Title="Flag">
            <Template Context="Language">
                <RadzenImage Path="@Language.Flag" Style="width: 32px; height: 32px;" AlternateText="@Language.Name" />
            </Template>
            <EditTemplate Context="Language">
                <RadzenFileInput ChooseText="Carica Logo..." ImageStyle="Widt:32px; Height:auto" @bind-Value="@Language.Flag" TValue="string" Style="width: 100%"
                                 Change=@(args => OnChange(args, "FileInput")) Error=@(args => OnError(args, "FileInput")) 
                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})" />
            </EditTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="language" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="language">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(language))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(language))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="language">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(language))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(language))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(language))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>