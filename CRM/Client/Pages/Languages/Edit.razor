@page "/Settings/Languages/New"
@page "/Settings/Languages/{Id:int}/Edit"

@using Radzen
@using Radzen.Blazor

<h3>Lingua</h3>

@if (_language == null)
{
    <Waiting></Waiting>
}
else
{
<EditForm Model="@_language" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label for="Name">Nome</label>
                <input id="Name" class="form-control" @bind-value="@_language.Name" />
                <ValidationMessage For="@(() => _language.Name)" />
            </div>
             <div class="mb-3">
                <label for="Name">Codice</label>
                <input id="Name" class="form-control" @bind-value="@_language.LanguageCode" />
                <ValidationMessage For="@(() => _language.LanguageCode)" />
            </div>
                <div class="mb-3">
                    <label for="Name">Index</label>
                    <input id="Name" class="form-control" @bind-value="@_language.Index" />
                    <ValidationMessage For="@(() => _language.Index)" />
                </div>
            <div class="mb-3">
                <label for="Descrizione">Descrizione</label>
                <input id="Descrizione" class="form-control" @bind-value="@_language.Description" />
                <ValidationMessage For="@(() => _language.Description)" />
            </div>
            <div class="mb-3">
                <div>
                    <RadzenCard Style="width:auto;margin-bottom: 20px; height:auto;">
                        <div class="row">
                            <div class="col-md-12">
                                <div style="margin-top:20px">File Logo:</div>

                                <br />
                                <RadzenFileInput @ref="inputImage" ImageStyle="width:32px" Accept="Image/*" @bind-Value="@_language.Flag" TValue="string" ChooseText="Seleziona"
                                                 Change="@(args => Change(args, "FileInput"))" Error="@(args => Error(args, "FileInput"))" />
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
            <BlazorButton Type="BtnType.Submit" Style="BtnStyle.Primary" Text="Salva" Icon="save"></BlazorButton>
            <BlazorButton  Style="BtnStyle.Secondary" OnClick="Annulla" Text="Annulla" Icon="cancel"></BlazorButton>
            
        </div>
    </div>
</EditForm>
}