@page "/Settings/Accessories/Details/{Id:int}"
@using CRM.Shared.Helper

<BlazorHeader Header="@_header" />

@if (_accessory == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            
            <RedGDetailField Icon="build" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _accessory.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_accessory.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="category">
                <LabelContent><DisplayName For="@(() => _accessory.AccessoryType)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_accessory.Type</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="qr_code">
                <LabelContent><DisplayName For="@(() => _accessory.Code)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_accessory.Code</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="tag">
                <LabelContent><DisplayName For="@(() => _accessory.SupplierCode)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_accessory.SupplierCode</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="description">
                <LabelContent><DisplayName For="@(() => _accessory.Description)" /></LabelContent>
                <ChildContent><span class="note-report mb-0">@_accessory.Description</span></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Accessory List"]" OnClick="Annulla" />
                @if (_accessory.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}