@page "/Deals/{Id:int}/Details"
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen.Blazor

<PageHeader Model="_pageHeader" Visible="@(OnClickCancel == null)">
</PageHeader>

<RedGDetailPage IsLoading="_loading" IsEmpty="@(_deal == null)" EmptyIcon="work_off" EmptyText="Opportunita non trovata">
    <ChildContent>
        @if (_deal != null)
        {
            <RedGDetailSection Title="Dati principali" Icon="work">
                <RedGDetailField Icon="work">
                    <LabelContent><DisplayName For="@(() => _deal.Name)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.Name</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="business">
                    <LabelContent><DisplayName For="@(() => _deal.IdCompany)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.CompanyName</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="person">
                    <LabelContent><DisplayName For="@(() => _deal.IdContact)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@(string.IsNullOrWhiteSpace(_deal.ContactName) ? "-" : _deal.ContactName)</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="account_circle">
                    <LabelContent><DisplayName For="@(() => _deal.IdUser)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.UserName</p></ChildContent>
                </RedGDetailField>
            </RedGDetailSection>

            <RedGDetailSection Title="Pipeline" Icon="timeline">
                <RedGDetailField Icon="flag">
                    <LabelContent><DisplayName For="@(() => _deal.State)" /></LabelContent>
                    <ChildContent><span class="badge @StateBadgeClass(_deal.State)">@StateText(_deal.State)</span></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="timeline" ContainerClass="deal-phase-detail-field mb-3">
                    <LabelContent><DisplayName For="@(() => _deal.Phase)" /></LabelContent>
                    <ChildContent>
                        <div class="deal-phase-summary">
                            <span class="deal-phase-name" title="@PhaseText(_deal.Phase)">@PhaseText(_deal.Phase)</span>
                            <RadzenProgressBar Value="@DealProgress" ShowValue="false" class="deal-phase-progress" />
                        </div>
                    </ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="euro">
                    <LabelContent><DisplayName For="@(() => _deal.Amount)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.Amount.ToString("C")</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="track_changes">
                    <LabelContent><DisplayName For="@(() => _deal.Target)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.Target.ToString("C")</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="percent">
                    <LabelContent><DisplayName For="@(() => _deal.Probability)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.Probability%</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="query_stats">
                    <LabelContent><DisplayName For="@(() => _deal.WeightedAmount)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.WeightedAmount.ToString("C")</p></ChildContent>
                </RedGDetailField>
            </RedGDetailSection>

            <RedGDetailSection Title="Date" Icon="event">
                <RedGDetailField Icon="event">
                    <LabelContent><DisplayName For="@(() => _deal.Date)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_deal.Date.ToString("dd/MM/yyyy")</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="event_available">
                    <LabelContent><DisplayName For="@(() => _deal.ExpectedCloseDate)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@(_deal.ExpectedCloseDate == null ? "-" : _deal.ExpectedCloseDate.Value.ToString("dd/MM/yyyy"))</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="event_busy">
                    <LabelContent><DisplayName For="@(() => _deal.DateClosed)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@(_deal.DateClosed == default ? "-" : _deal.DateClosed.ToString("dd/MM/yyyy"))</p></ChildContent>
                </RedGDetailField>
            </RedGDetailSection>

            @* Da dove nasce l'opportunita'. Compare solo quando c'e': un'opportunita' creata a
               mano non ha un'origine da mostrare, e una riga vuota sarebbe solo rumore. *@
            @if (_deal.IdActivityOrigin.HasValue)
            {
                <RedGDetailSection Title="Origine" Icon="event_available">
                    <RedGDetailField Icon="event_available">
                        <LabelContent>Nata da</LabelContent>
                        <ChildContent>
                            <a href="/Activities/@_deal.IdActivityOrigin/Info" class="text-decoration-none">
                                <strong>@OriginLabel</strong>
                            </a>
                        </ChildContent>
                    </RedGDetailField>
                </RedGDetailSection>
            }

            @if (!string.IsNullOrWhiteSpace(_deal.Note))
            {
                <RedGDetailSection Title="Note" Icon="note">
                    <RedGDetailField Icon="note">
                        <LabelContent><DisplayName For="@(() => _deal.Note)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark" style="white-space: pre-wrap;">@_deal.Note</p></ChildContent>
                    </RedGDetailField>
                </RedGDetailSection>
            }
        }
    </ChildContent>
    <ActionsContent>
        <RedGDetailActions>
            <RedGButton RGButtonType="RGButtonType.Back" Click="Back" Text="Lista opportunita" />
            @if (_deal?.Permits.Edit() == true)
            {
                <RedGButton RGButtonType="RGButtonType.Edit" Click="Edit" AutoLabel="true" />
            }
        </RedGDetailActions>
    </ActionsContent>
</RedGDetailPage>

<style>
    .deal-phase-detail-field .rg-field-value {
        overflow-wrap: normal;
    }

    .deal-phase-summary {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        width: 100%;
        min-width: 0;
    }

    .deal-phase-name {
        display: block;
        width: 100%;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--crm-text, #101828);
        line-height: 1.25;
    }

    .deal-phase-progress {
        width: 100%;
        height: 0.4rem;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .deal-phase-name {
            white-space: normal;
        }
    }
</style>
