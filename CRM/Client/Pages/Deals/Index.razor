@page "/Deals"
@page "/Deals/Index"
@using Radzen
@using Radzen.Blazor
@using CRM.Shared.DTOs
@using CRM.Shared.Helper

<div class="deals-page">
    <PageHeader Model="_pageHeader">
        <Actions>
            <button type="button" class="deals-primary" @onclick="NewDeal">
                <span class="material-icons">add</span>
                <span>Nuova opportunita</span>
            </button>
        </Actions>
    </PageHeader>

    <section class="deals-metrics">
        <article>
            <span>Pipeline filtrata</span>
            <strong>@_deals.Total.ToString("C")</strong>
            <small>@TotalCount opportunita</small>
        </article>
        <article>
            <span>Aperte in pagina</span>
            <strong>@OpenAmount.ToString("C")</strong>
            <small>@_deals.Items.Count risultati visibili</small>
        </article>
        <article>
            <span>Vinte in pagina</span>
            <strong>@WonAmount.ToString("C")</strong>
            <small>Su @PageAmount.ToString("C") visualizzati</small>
        </article>
        <article>
            <span>Target in pagina</span>
            <strong>@TargetAmount.ToString("C")</strong>
            <small>Obiettivo aggregato</small>
        </article>
    </section>

    <section class="deals-filters">
        <div class="deals-search">
            <span class="material-icons">search</span>
            <input @bind="_search" @bind:event="oninput" placeholder="Cerca per nome, azienda, contatto o note" />
        </div>

        <RadzenDropDown class="deals-filter-control"
                        @bind-Value="_idUser"
                        TValue="string"
                        Data="@_users"
                        TextProperty="NameComplete"
                        ValueProperty="Id"
                        AllowClear="true"
                        AllowFiltering="true"
                        Placeholder="Owner" />

        <RadzenDropDown class="deals-filter-control"
                        @bind-Value="_state"
                        TValue="DealStates?"
                        Data="@_states"
                        TextProperty="Text"
                        ValueProperty="Value"
                        AllowClear="true"
                        Placeholder="Stato" />

        <RadzenDropDown class="deals-filter-control"
                        @bind-Value="_phase"
                        TValue="DealPhases?"
                        Data="@_phases"
                        TextProperty="Text"
                        ValueProperty="Value"
                        AllowClear="true"
                        Placeholder="Fase" />

        <button type="button" class="deals-filter-button" @onclick="ApplyFilters">
            <span class="material-icons">tune</span>
        </button>
        <button type="button" class="deals-filter-button" @onclick="ClearFilters">
            <span class="material-icons">filter_alt_off</span>
        </button>
    </section>

    @if (_isLoading)
    {
        <Waiting></Waiting>
    }
    else if (!_deals.Items.Any())
    {
        <section class="deals-empty">
            <span class="material-icons">work_outline</span>
            <strong>Nessuna opportunita trovata</strong>
            <p>Modifica i filtri o crea una nuova opportunita commerciale.</p>
        </section>
    }
    else
    {
        <section class="deals-table-wrap">
            <table class="deals-table">
                <thead>
                    <tr>
                        <th>Opportunita</th>
                        <th>Azienda</th>
                        <th>Stato</th>
                        <th>Fase</th>
                        <th>Valore</th>
                        <th>Owner</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var deal in _deals.Items)
                    {
                        <tr>
                            <td>
                                <button type="button" class="deals-link" @onclick="@(() => Details(deal.Id))">@deal.Name</button>
                                <small>@deal.Date.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <strong>@deal.CompanyName</strong>
                                @if (!string.IsNullOrWhiteSpace(deal.ContactName))
                                {
                                    <small>@deal.ContactName</small>
                                }
                            </td>
                            <td>
                                <span class="deal-state @StateClass(deal.State)">@StateText(deal.State)</span>
                            </td>
                            <td>
                                <div class="deal-phase">
                                    <span>@PhaseText(deal.Phase)</span>
                                    <div><i style="width:@PhaseProgress(deal.Phase)%"></i></div>
                                </div>
                            </td>
                            <td class="deals-money">
                                <strong>@deal.Amount.ToString("C")</strong>
                                <small>Target @deal.Target.ToString("C")</small>
                            </td>
                            <td>@deal.UserName</td>
                            <td>
                                <div class="deals-actions">
                                    <button type="button" title="Dettagli" @onclick="@(() => Details(deal.Id))">
                                        <span class="material-icons">visibility</span>
                                    </button>
                                    <button type="button" title="Modifica" disabled="@(!deal.Permits.Edit())" @onclick="@(() => Edit(deal.Id))">
                                        <span class="material-icons">edit</span>
                                    </button>
                                    <button type="button" title="Elimina" disabled="@(!deal.Permits.Delete())" @onclick="@(() => Delete(deal.Id))">
                                        <span class="material-icons">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="deals-pager">
            <button type="button" disabled="@(!CanGoPrevious)" @onclick="PreviousPage">
                <span class="material-icons">chevron_left</span>
                <span>Precedente</span>
            </button>
            <strong>Pagina @_pageNumber di @TotalPages</strong>
            <button type="button" disabled="@(!CanGoNext)" @onclick="NextPage">
                <span>Successiva</span>
                <span class="material-icons">chevron_right</span>
            </button>
        </section>
    }
</div>

<style>
    .deals-page {
        min-height: calc(100vh - 1rem);
        padding: 1.25rem;
        color: #182235;
        background: #f7f9fc;
    }

    .deals-toolbar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .deals-kicker {
        text-transform: uppercase;
        font-size: 0.74rem;
        font-weight: 800;
        color: #64748b;
    }

    .deals-toolbar h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 850;
    }

    .deals-toolbar p {
        margin: 0.25rem 0 0;
        color: #64748b;
    }

    .deals-primary,
    .deals-filter-button,
    .deals-pager button,
    .deals-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        border: 1px solid #bfd2e7;
        border-radius: 8px;
        background: #fff;
        color: #0f4a8a;
        font-weight: 800;
    }

    .deals-primary {
        background: #0f4a8a;
        color: #fff;
        padding: 0.62rem 0.85rem;
    }

    .deals-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    .deals-metrics article,
    .deals-filters,
    .deals-table-wrap {
        border: 1px solid #dfe7f1;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(31, 42, 68, 0.07);
    }

    .deals-metrics article {
        display: grid;
        gap: 0.2rem;
        padding: 0.9rem;
        min-width: 0;
    }

    .deals-metrics span,
    .deals-metrics small,
    .deals-table small,
    .deal-phase span {
        color: #64748b;
    }

    .deals-metrics strong {
        font-size: 1.35rem;
        overflow-wrap: anywhere;
    }

    .deals-filters {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 210px 160px 190px 42px 42px;
        gap: 0.6rem;
        align-items: center;
        padding: 0.75rem;
        margin-bottom: 1rem;
    }

    .deals-search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid #d7e0ec;
        border-radius: 8px;
        padding: 0.42rem 0.55rem;
        min-width: 0;
    }

    .deals-search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
    }

    .deals-filter-control {
        width: 100%;
    }

    .deals-filter-button {
        width: 40px;
        height: 40px;
        padding: 0;
    }

    .deals-table-wrap {
        overflow-x: auto;
    }

    .deals-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
    }

    .deals-table th,
    .deals-table td {
        padding: 0.78rem 0.85rem;
        border-bottom: 1px solid #e6edf5;
        vertical-align: middle;
    }

    .deals-table th {
        color: #64748b;
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0;
        background: #fbfdff;
    }

    .deals-table td small {
        display: block;
        margin-top: 0.15rem;
    }

    .deals-link {
        width: fit-content;
        border: 0;
        padding: 0;
        background: transparent;
        color: #0f4a8a;
        font-weight: 850;
        text-align: left;
    }

    .deal-state {
        display: inline-flex;
        border-radius: 999px;
        padding: 0.25rem 0.55rem;
        font-weight: 850;
        font-size: 0.78rem;
    }

    .deal-state.is-open {
        background: #eaf5f1;
        color: #13705b;
    }

    .deal-state.is-paused {
        background: #fff7e6;
        color: #996515;
    }

    .deal-state.is-won {
        background: #e7f7ea;
        color: #176d2c;
    }

    .deal-state.is-lost {
        background: #fdecec;
        color: #9f1d1d;
    }

    .deal-state.is-muted {
        background: #eef2f7;
        color: #526174;
    }

    .deal-phase {
        display: grid;
        gap: 0.35rem;
        min-width: 170px;
    }

    .deal-phase div {
        height: 7px;
        border-radius: 999px;
        overflow: hidden;
        background: #e6edf5;
    }

    .deal-phase i {
        display: block;
        height: 100%;
        background: #0f4a8a;
    }

    .deals-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.35rem;
    }

    .deals-actions button {
        width: 34px;
        height: 34px;
        padding: 0;
    }

    .deals-actions button:disabled,
    .deals-pager button:disabled {
        opacity: 0.45;
    }

    .deals-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 0;
    }

    .deals-pager button {
        padding: 0.45rem 0.7rem;
    }

    .deals-empty {
        min-height: 300px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #64748b;
        text-align: center;
    }

    .deals-empty .material-icons {
        font-size: 48px;
    }

    @@media (max-width: 1120px) {
        .deals-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .deals-filters {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 720px) {
        .deals-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .deals-metrics,
        .deals-filters {
            grid-template-columns: 1fr;
        }

        .deals-filter-button {
            width: 100%;
        }
    }
</style>
