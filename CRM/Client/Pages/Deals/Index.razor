@page "/Deals"
@page "/Deals/Index"
@using BlazoringComponents.DropDownButton
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor

<PageHeader Model="_pageHeader">
</PageHeader>

<RadzenDataGrid @ref="grdDeals"
                IsLoading="@_isLoading"
                Count="@TotalCount"
                Data="@_deals.Items"
                LoadData="@LoadData"
                Responsive="true"
                AllowSorting="true"
                AllowFiltering="false"
                AllowPaging="true"
                PageSize="@_pageSize"
                PagerHorizontalAlign="Radzen.HorizontalAlign.Center"
                TItem="DealDTO">
    <HeaderTemplate>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <RedGButton RGButtonType="RGButtonType.New" Click="@NewDeal"></RedGButton>

            <RedGTextBox @bind-Value="@_search" Label="@Localize["search..."]" @oninput="@OnSearchChanged" Style="width: 300px; margin-left: 10px;">
                <End>
                    <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                </End>
            </RedGTextBox>

            <RadzenDropDown @bind-Value="_idUser"
                            TValue="string"
                            Data="@_users"
                            TextProperty="NameComplete"
                            ValueProperty="Id"
                            AllowClear="true"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="@Localize["Owner"]"
                            Style="width: 190px"
                            Change="@(_ => ReloadGrid())" />

            <RadzenDropDown @bind-Value="_state"
                            TValue="DealStates?"
                            Data="@_states"
                            TextProperty="Text"
                            ValueProperty="Value"
                            AllowClear="true"
                            Placeholder="@Localize["Stato"]"
                            Style="width: 150px"
                            Change="@(_ => ReloadGrid())" />

            <RadzenDropDown @bind-Value="_phase"
                            TValue="DealPhases?"
                            Data="@_phases"
                            TextProperty="Text"
                            ValueProperty="Value"
                            AllowClear="true"
                            Placeholder="@Localize["Fase"]"
                            Style="width: 190px"
                            Change="@(_ => ReloadGrid())" />

            <RadzenButton Icon="filter_alt_off"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@ClearFilters"
                          title="@Localize["Azzera filtri"]" />

            <span class="text-muted ms-auto">
                @Localize["Pipeline"]: <strong>@_deals.Total.ToString("C")</strong>
            </span>
        </div>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Context="deal" TItem="DealDTO" Title="@Localize["Opportunità"]" Property="@nameof(DealDTO.Name)">
            <Template Context="deal">
                <a href="#" class="link-primary" @onclick:preventDefault @onclick="@(() => Details(deal.Id))">@deal.Name</a>
                <div class="small text-muted">@deal.Date.ToString("dd/MM/yyyy")</div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="deal" TItem="DealDTO" Title="@Localize["Azienda"]" Property="@nameof(DealDTO.CompanyName)">
            <Template Context="deal">
                <div>@deal.CompanyName</div>
                @if (!string.IsNullOrWhiteSpace(deal.ContactName))
                {
                    <div class="small text-muted">@deal.ContactName</div>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="deal" TItem="DealDTO" Title="Stato" Property="@nameof(DealDTO.State)">
            <Template Context="deal">
                <span class="badge @StateBadgeClass(deal.State)">@StateText(deal.State)</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="deal" TItem="DealDTO" Title="Fase" Property="@nameof(DealDTO.Phase)">
            <Template Context="deal">
                <div>@PhaseText(deal.Phase)</div>
                <RadzenProgressBar Value="@PhaseProgress(deal.Phase)" ShowValue="false" Style="height: 6px; margin-top: 4px;" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="DealDTO" Title="Valore" TextAlign="Radzen.TextAlign.Right">
            <Template Context="deal">
                <strong>@deal.Amount.ToString("C")</strong>
                <div class="small text-muted">Target @deal.Target.ToString("C")</div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="DealDTO" Title="Forecast" TextAlign="Radzen.TextAlign.Right">
            <Template Context="deal">
                <strong>@deal.WeightedAmount.ToString("C")</strong>
                <div class="small text-muted">@deal.Probability% - @(deal.ExpectedCloseDate == null ? "senza data" : deal.ExpectedCloseDate.Value.ToString("dd/MM/yyyy"))</div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="DealDTO" Property="@nameof(DealDTO.UserName)" Title="Owner" />

        <RadzenDataGridColumn Context="deal" TItem="DealDTO" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
            <Template Context="deal">
                <RedGButton RGButtonType="RGButtonType.View" Click="@(() => Details(deal.Id))"></RedGButton>
                <RedGButton RGButtonType="RGButtonType.Edit" Click="@(() => Edit(deal.Id))" Disabled="@(!deal.Permits.Edit())"></RedGButton>
                <RedGButton RGButtonType="RGButtonType.Delete" Click="@(() => Delete(deal.Id))" Disabled="@(!deal.Permits.Delete())"></RedGButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
