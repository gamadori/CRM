@using CRM.Shared.DTOs

<article class="forecast-panel">
    <div class="forecast-panel-title">
        <span class="material-icons">@Icon</span>
        <h2>@Title</h2>
    </div>
    @if (Items == null || !Items.Any())
    {
        <p class="forecast-muted">Nessun dato nel periodo.</p>
    }
    else
    {
        <table class="forecast-table">
            <thead>
                <tr>
                    <th>Voce</th>
                    <th>Deal</th>
                    <th>Ponderato</th>
                    <th>Vinto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        <td>@item.Label</td>
                        <td>@item.DealCount</td>
                        <td>@item.WeightedAmount.ToString("C")</td>
                        <td>@item.WonAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</article>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "query_stats";
    [Parameter] public List<CommercialForecastBucketDTO>? Items { get; set; }
}

<style>
    .forecast-panel { padding: 1rem; min-width: 0; }
    .forecast-panel-title { display: flex; align-items: center; gap: .5rem; margin-bottom: .8rem; }
    .forecast-panel-title h2 { margin: 0; font-size: 1.05rem; font-weight: 850; }
    .forecast-muted { color: #64748b; margin: 0; }
    .forecast-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .forecast-table th, .forecast-table td { padding: .58rem .45rem; border-bottom: 1px solid #e6edf5; text-align: right; }
    .forecast-table th:first-child, .forecast-table td:first-child { text-align: left; }
    .forecast-table th { color: #64748b; font-size: .72rem; text-transform: uppercase; letter-spacing: 0; }
</style>
