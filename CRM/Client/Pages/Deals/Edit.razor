@page "/Deals/New"
@page "/Deals/{Id:int}/Edit"
@page "/Initiatives/{IdInitiative:int}/Deals/New"
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor

@if (_loading || _deal == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="_pageHeader" Visible="@(OnClickSave == null)">
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_messageState))
    {
        <div class="alert alert-danger">@_messageState</div>
    }

    <EditForm Model="@_deal" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-muted fw-bold mb-3">Dati opportunita</h6>

                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <label class="form-label"><DisplayName For="@(() => _deal.Name)" /></label>
                        <InputText class="form-control" @bind-Value="_deal.Name" />
                        <ValidationMessage For="@(() => _deal.Name)" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label"><DisplayName For="@(() => _deal.Date)" /></label>
                        <InputDate class="form-control" @bind-Value="_deal.Date" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label"><DisplayName For="@(() => _deal.DateClosed)" /></label>
                        <InputDate class="form-control" @bind-Value="_deal.DateClosed" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label"><DisplayName For="@(() => _deal.Amount)" /></label>
                        <InputNumber class="form-control" @bind-Value="_deal.Amount" disabled="@_deal.ProductInterests.Any()" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label"><DisplayName For="@(() => _deal.Target)" /></label>
                        <InputNumber class="form-control" @bind-Value="_deal.Target" disabled="@_deal.ProductInterests.Any()" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Probabilita</label>
                        <InputNumber class="form-control" @bind-Value="_deal.Probability" />
                        <ValidationMessage For="@(() => _deal.Probability)" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Chiusura prevista</label>
                        <InputDate class="form-control" @bind-Value="_deal.ExpectedCloseDate" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label"><DisplayName For="@(() => _deal.State)" /></label>
                        <InputSelect class="form-select" @bind-Value="_deal.State">
                            @foreach (var state in _dealStates)
                            {
                                <option value="@state.Value">@StateText(state.Value)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label"><DisplayName For="@(() => _deal.Phase)" /></label>
                        <InputSelect class="form-select" @bind-Value="_deal.Phase">
                            @foreach (var phase in _dealPhases)
                            {
                                <option value="@phase.Value">@PhaseText(phase.Value)</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <hr class="my-4" />

                <h6 class="text-uppercase text-muted fw-bold mb-3">Cliente e contatto</h6>

                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        @* L'etichetta la mette RedGDropDown (RadzenFormField): niente label esterna, sarebbe doppia. *@
                        <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="@nameof(CompanyDTO.Id)" TextProperty="@nameof(CompanyDTO.RagioneSociale)" @bind-Value="@_deal.IdCompany"
                                      Data="_companies" AllowFiltering="true" Change="OnChangeCompany" For="@(() => _deal.IdCompany)">
                            <End>
                                <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem="OnGetCompany" DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                            </End>
                        </RedGDropDown>
                    </div>

                    <div class="col-12 col-lg-6">
                        <RedGDropDown TItem="ContactDTO" TValue="int?" ValueProperty="@nameof(ContactDTO.Id)" TextProperty="@nameof(ContactDTO.NameComplete)" @bind-Value="@_deal.IdContact"
                                      Data="_contacts" AllowFiltering="true" Change="OnChangeContact" For="@(() => _deal.IdContact)">
                            <End>
                                <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem="OnGetContact" DialogType="RedGDialog.DialogType.Contacts"></RedGButtonDialog>
                            </End>
                        </RedGDropDown>
                    </div>

                    @* Da quale fiera/campagna nasce l'opportunità. Una volta assegnata non si
                       cambia: spostarla altrove falserebbe il confronto fra iniziative, ed è la
                       stessa regola che applica il server. *@
                    <div class="col-12 col-lg-6">
                        @if (InitiativeLocked)
                        {
                            <label class="form-label">Iniziativa</label>
                            <div class="form-control-plaintext">@InitiativeName</div>
                        }
                        else
                        {
                            @* Stessa etichetta fluttuante di Ditta e Contatto, così la riga resta allineata. *@
                            <RadzenFormField Text="Iniziativa" Variant="Variant.Text" class="remove-border" Style="width:100%">
                                <ChildContent>
                                    <RadzenDropDown TValue="int?" @bind-Value="_deal.IdInitiative"
                                                    Data="_initiatives" TextProperty="Name" ValueProperty="Id"
                                                    AllowFiltering="true" AllowClear="true"
                                                    FilterCaseSensitivity="Radzen.FilterCaseSensitivity.CaseInsensitive"
                                                    Placeholder="Nessuna" Style="width:100%" />
                                </ChildContent>
                            </RadzenFormField>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label"><DisplayName For="@(() => _deal.Note)" /></label>
                        <InputTextArea class="form-control" rows="5" @bind-Value="_deal.Note" />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                    <div class="flex-grow-1">
                        <label class="form-label">Prodotto</label>
                        <InputSelect class="form-select" @bind-Value="_selectedProductId">
                            <option value="">Seleziona prodotto</option>
                            @foreach (var product in ProductsAvailableToAdd)
                            {
                                <option value="@product.Id">@ProductText(product)</option>
                            }
                        </InputSelect>
                    </div>
                    <RadzenButton Icon="add" Text="Aggiungi" ButtonStyle="ButtonStyle.Secondary" Click="AddProductInterest" ButtonType="ButtonType.Button" />
                </div>

                @if (_deal.ProductInterests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Prodotto</th>
                                    <th style="width: 110px;">Qta</th>
                                    <th style="width: 140px;">Prezzo</th>
                                    <th style="width: 120px;">Sconto %</th>
                                    <th class="text-end">Totale</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _deal.ProductInterests.OrderBy(x => x.SortOrder))
                                {
                                    <tr>
                                        <td>@row.DisplayName</td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="row.Quantity" @onchange="@(() => RecalculateProductInterest(row))" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="row.UnitPrice" @onchange="@(() => RecalculateProductInterest(row))" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="row.DiscountPct" @onchange="@(() => RecalculateProductInterest(row))" /></td>
                                        <td class="text-end fw-bold">@row.LineTotal.ToString("C")</td>
                                        <td class="text-end">
                                            <RedGButton RGButtonType="RGButtonType.Delete" Click="@(() => RemoveProductInterest(row))"></RedGButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Nessun prodotto collegato.</p>
                }
            </div>

            <div class="card-footer bg-light border-top py-3">
                <div class="d-flex gap-2 justify-content-end">
                    <RedGButton RGButtonType="RGButtonType.Cancel" Click="Cancel" Text="Annulla" Disabled="@_saving" />
                    <RedGButton RGButtonType="RGButtonType.Submit" Text="@(_saving ? "Salvataggio..." : "Salva opportunita")" Disabled="@_saving" />
                </div>
            </div>
        </div>
    </EditForm>
}
