@page "/Settings/TicketTypes/New"
@page "/Settings/TicketTypes/{Id:int}/Edit"

@if (_state== null)
{
    <Waiting></Waiting>
}
else
{
     <PageHeader Model="@_pageHeader">
    </PageHeader>

    <EditForm Model="@_state" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_state.Desc" For="@(() => _state.Desc)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <div class="form-check form-switch col-md-3">
                                    <input class="form-check-input" id="checkbox1" @bind="_state.CustomerEnabled" type="checkbox">
                                    <DisplayName For="@(() => _state.CustomerEnabled)" />
                                </div>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.Date"
                                                For="@(() => _state.Date)" AllowClear="false" />
                                
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.Time"
                                                For="@(() => _state.Time)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.DateEnd"
                                                For="@(() => _state.DateEnd)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.IdProdotto"
                                                For="@(() => _state.IdProdotto)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.IdArticolo"
                                                For="@(() => _state.IdArticolo)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.ExpiredDate"
                                                For="@(() => _state.ExpiredDate)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="PropertyStates" TValue="PropertyStates" @bind-Value="@_state.Project"
                                                For="@(() => _state.Project)" AllowClear="false" />

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGNumeric @bind-Value="@_state.MaxHoursLife" For="@(() => _state.MaxHoursLife)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGNumeric @bind-Value="@_state.Price" For="@(() => _state.Price)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel=true  />
    </EditForm>

