@page "/Contacts/New"
@page "/Contacts/{Id:int}/Edit"


<PageHeader Model="@_pageHeader">
</PageHeader>

@if (_contact == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="@_contact" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
         <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.Name" For="@(() => _contact.Name)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.Surname" For="@(() => _contact.Surname)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="@nameof(CompanyDTO.Id)" TextProperty="@nameof(CompanyDTO.RagioneSociale)" @bind-Value="@_contact.IdCompany" 
                                For="@(() => _contact.IdCompany)"
                                              Data="_companies" AllowFiltering="true">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
           
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.Mobile" For="@(() => _contact.Mobile)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.Phone" For="@(() => _contact.Phone)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.Email" For="@(() => _contact.Email)" />
                            </RadzenStack>
                        </RadzenColumn>
                        
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextArea @bind-Value="@_contact.Note" For="@(() => _contact.Note)" Rows="3" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <!-- Social Links -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.FacebookUrl" For="@(() => _contact.FacebookUrl)" Placeholder="Facebook URL" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.LinkedInUrl" For="@(() => _contact.LinkedInUrl)" Placeholder="LinkedIn URL" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_contact.TwitterUrl" For="@(() => _contact.TwitterUrl)" Placeholder="Twitter URL" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>


        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />

    </EditForm>
}