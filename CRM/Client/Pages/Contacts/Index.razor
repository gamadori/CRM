@page "/Contacts"
@page "/Contacts/Index"

@using Radzen
@using Radzen.Blazor
@using BlazoringComponents.DropDownButton
@* 
<BlazorHeader Header="@Localize["Contacts"]" Visible="@(PageMode != PageHelper.PageModality.Dialog)"></BlazorHeader> *@


@if (_contacts != null)
{

    <PageHeader Model="@_pageHeader">
    </PageHeader>

    <RadzenDataGrid @ref="grdContacts" IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_contacts" Responsive=true LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="@_filterMode"
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="ContactDTO" PagingSummaryFormat="@pagingSummaryFormat">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
                <RedGTextBox @bind-Value="@_filter.Name" Label="@Localize["search..."]" @oninput="@OnChangeNameFilter" Style="width: 300px; margin-left: 10px;">
                    <End>
                        <RadzenIcon Icon="search" Style="color: #9e9e9e; font-size: 20px;" />
                    </End>
                </RedGTextBox>
            </div>

        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Context="item" Property="@nameof(ContactDTO.NameComplete)" TItem="ContactDTO"  Title=@TranslateHelper.GetDisplayName(nameof(ContactDTO.NameComplete), typeof(ContactDTO)) FilterProperty="Surname">
                <Template>
                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async () => await OnClickName(item.Id)">@item.NameComplete</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ContactDTO" Property="@nameof(ContactDTO.CompanyName)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(ContactDTO.IdCompany), typeof(ContactDTO)) />
            <RadzenDataGridColumn TItem="ContactDTO" Property="@nameof(ContactDTO.Mobile)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(ContactDTO.Mobile), typeof(ContactDTO)) />
            <RadzenDataGridColumn TItem="ContactDTO" Property="@nameof(ContactDTO.Phone)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(ContactDTO.Phone), typeof(ContactDTO)) />
            <RadzenDataGridColumn TItem="ContactDTO" Property="@nameof(ContactDTO.Email)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(ContactDTO.Email), typeof(ContactDTO)) />

           

            @if (PageMode != PageHelper.PageModality.Dialog)
            {
                <RadzenDataGridColumn Context="item" TItem="ContactDTO"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="item">
                        <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>

                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}
