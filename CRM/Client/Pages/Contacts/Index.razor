@page "/Contacts"
@page "/Contacts/Index"

@using Radzen
@using Radzen.Blazor
@using BlazoringComponents.DropDownButton
@* 
<BlazorHeader Header="@Localize["Contacts"]" Visible="@(PageMode != PageHelper.PageModality.Dialog)"></BlazorHeader> *@

@if (IdCompany == null)
{

    <PageHeader Model="@_pageHeader">
    </PageHeader>
}

@if (_contacts != null)
{

    <RadzenDataGrid @ref="grdContacts" IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_contacts" Responsive=true LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="@_filterMode"
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="Contact" PagingSummaryFormat="@pagingSummaryFormat">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
                <RedGTextBox @bind-Value="@_filter.Name" Label="@Localize["search..."]" @oninput="@OnChangeNameFilter" Style="width: 300px; margin-left: 10px;">
                    <End>
                        <RadzenIcon Icon="search" Style="color: #9e9e9e; font-size: 20px;" />
                    </End>
                </RedGTextBox>
            </div>

        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Context="item" TItem="Contact" Property="@nameof(Contact.Surname)" Title=@TranslateHelper.GetDisplayName(nameof(Contact.NameComplete), typeof(Contact)) FilterProperty="Surname">
                <Template>
                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OnClickName(item.Id)">@item.NameComplete</a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Contact" Property="Company.RagioneSociale" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(Contact.IdCompany), typeof(Contact)) />
            <RadzenDataGridColumn TItem="Contact" Property="@nameof(Contact.Mobile)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(Contact.Mobile), typeof(Contact)) />
            <RadzenDataGridColumn TItem="Contact" Property="@nameof(Contact.Phone)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(Contact.Phone), typeof(Contact)) />
            <RadzenDataGridColumn TItem="Contact" Property="@nameof(Contact.Email)" Filterable="true" Title=@TranslateHelper.GetDisplayName(nameof(Contact.Email), typeof(Contact)) />

           

            @if (PageMode == PageHelper.PageModality.Visualization)
            {
                <RadzenDataGridColumn Context="item" TItem="Contact"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="item">
                        <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>

                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}
