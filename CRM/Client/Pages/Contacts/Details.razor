@page "/Contacts/{Id:int}/Details"
@page "/Contacts/{Id:int}"
@page "/Companies/{CompanyId:int}/Contacts/{Id:int}/Details"
@page "/Companies/{CompanyId:int}/Contacts/{Id:int}"

@using CRM.Shared.Helper

<PageHeader Model="@_pageHeader">
</PageHeader>

@if (_contact == null)
{
    <Waiting></Waiting>     
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            
            <RedGDetailField Icon="person" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _contact.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_contact.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person_outline">
                <LabelContent><DisplayName For="@(() => _contact.Surname)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_contact.Surname</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="business">
                <LabelContent><DisplayName For="@(() => _contact.IdCompany)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_contact.CompanyName</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="phone">
                <LabelContent><DisplayName For="@(() => _contact.Phone)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_contact.Phone</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="smartphone">
                <LabelContent><DisplayName For="@(() => _contact.Mobile)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_contact.Mobile</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="email">
                <LabelContent><DisplayName For="@(() => _contact.Email)" /></LabelContent>
                <ChildContent>
                    @if (!string.IsNullOrWhiteSpace(_contact.Email))
                    {
                        <a href="mailto:@_contact.Email" class="text-primary text-decoration-none">
                            <span class="material-icons" style="font-size: 18px; vertical-align: middle;">mail_outline</span>
                            @_contact.Email
                        </a>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">-</p>
                    }
                </ChildContent>
            </RedGDetailField>

            <!-- Social Links -->
            @if (!string.IsNullOrWhiteSpace(_contact.FacebookUrl) || !string.IsNullOrWhiteSpace(_contact.LinkedInUrl) || !string.IsNullOrWhiteSpace(_contact.TwitterUrl))
            {
                <RedGDetailField Icon="share">
                    <LabelContent>Social</LabelContent>
                    <ChildContent>
                        <div class="d-flex gap-2 align-items-center">
                            @if (!string.IsNullOrWhiteSpace(_contact.FacebookUrl))
                            {
                                <a href="@_contact.FacebookUrl" target="_blank" rel="noopener noreferrer" title="Facebook">
                                    <span class="material-icons" style="font-size: 24px; color: #4267B2;">facebook</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(_contact.LinkedInUrl))
                            {
                                <a href="@_contact.LinkedInUrl" target="_blank" rel="noopener noreferrer" title="LinkedIn">
                                    <span class="material-icons" style="font-size: 24px; color: #0077B5;">linkedin</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(_contact.TwitterUrl))
                            {
                                <a href="@_contact.TwitterUrl" target="_blank" rel="noopener noreferrer" title="Twitter">
                                    <span class="material-icons" style="font-size: 24px; color: #1DA1F2;">twitter</span>
                                </a>
                            }
                        </div>
                    </ChildContent>
                </RedGDetailField>
            }
        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" Text="@Localize["Lista Contatti"]" />
                <RedGButton RGButtonType="RGButtonType.Edit" Click="Edit" AutoLabel=true />

                
            </div>
        </div>
    </div>
}