@page "/Settings/EmailTemplates/New"
@page "/Settings/EmailTemplates/{Id:int}/Edit"
@using Radzen
@using Radzen.Blazor


@if (_template == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="_pageHeader">
    </PageHeader>

    <EditForm Model="@_template" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="8">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                
                                <RedGSelectEnumGeneric TEnum="CRM.Shared.EmailsTypes" @bind-Value="@_template.Tipo" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                     <RadzenRow>
                        <RadzenColumn Size="12" >
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_template.Subject" For="@(() => _template.Subject)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextArea @bind-Value="@_template.Body" For="@(() => _template.Subject)" Rows="9" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" >
                            <RadzenStack>
                                <RedGDropDown TValue="int?" TItem="Logo" Data="_loghi" @bind-Value="@_template.IdLogo" For="@(() => _template.IdLogo)" ValueProperty="Id" TextProperty="Codice" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>

            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
    </EditForm>
    
    
}