@page "/Settings/Logos/Edit"
@page "/Settings/Logos/Edit/{Id:int}"

@using Radzen
@using Radzen.Blazor

<h3>Logo</h3>

@if (_logo == null)
{
    <Waiting></Waiting>
}
else
{
<EditForm Model="@_logo" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label for="Codice">Codice</label>
                <input id="Codice" class="form-control" @bind-value="@_logo.Codice" />
                <ValidationMessage For="@(() => _logo.Codice)" />
            </div>
            <div class="mb-3">
                <label for="Descrizione">Descrizione</label>
                <input id="Descrizione" class="form-control" @bind-value="@_logo.Descrizione" />
                <ValidationMessage For="@(() => _logo.Descrizione)" />
            </div>
            <div class="mb-3">
                <div>
                    <RadzenCard Style="width:600px;margin-bottom: 20px; height:500px;">
                        <div class="row">
                            <div class="col-md-12">
                                <div style="margin-top:20px">File Logo:</div>

                                <br />
                                <RadzenFileInput @ref="inputImage" Accept="Image/*" @bind-Value="@_logo.InputFile" Style="width:400px;" TValue="string" ChooseText="Seleziona"
                                                 Change="@(args => Change(args, "FileInput"))" Error="@(args => Error(args, "FileInput"))" />
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
            <BlazorButton Type="BtnType.Submit" Style="BtnStyle.Primary" Text="Salva" Icon="save"></BlazorButton>
            <BlazorButton  Style="BtnStyle.Secondary" OnClick="Annulla" Text="Annulla" Icon="cancel"></BlazorButton>
            
        </div>
    </div>
</EditForm>
}