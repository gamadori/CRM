@page "/Settings/Smtps/New"
@page "/Settings/Smtps/{Id:int}/Edit"
@attribute [Authorize(Policy = "AdminRole")]
@using Microsoft.AspNetCore.Authorization
@using CRM.Shared
@using Radzen
@using Radzen.Blazor

@if (_item == null || _isLoading)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="_pageHeader"></PageHeader>

    <EditForm Model="@_item" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <RedGTextBox For="@(() => _item.Name)" @bind-value="@_item.Name" />

                    <div class="mb-1">
                        <DisplayName For="@(() => _item.Provider)" />
                        <RadzenDropDown TValue="EmailProvider" @bind-Value="_item.Provider" Data="_providers" Style="width:100%" />
                    </div>

                    <div class="mb-1">
                        <DisplayName For="@(() => _item.IsActive)" />
                        <RadzenCheckBox @bind-Value="_item.IsActive" Name="chkActive" />
                    </div>

                    <RedGTextBox For="@(() => _item.SenderName)" @bind-value="@_item.SenderName" />
                    <RedGTextBox For="@(() => _item.SenderEmail)" @bind-value="@_item.SenderEmail" />

                    @if (_item.Provider == EmailProvider.Smtp)
                    {
                        <RedGTextBox For="@(() => _item.Server)" @bind-value="@_item.Server" />
                        <RedGNumeric For="@(() => _item.Port)" @bind-value="@_item.Port" />
                        <div class="mb-1">
                            <DisplayName For="@(() => _item.Ssl)" />
                            <RadzenCheckBox @bind-Value="_item.Ssl" Name="chkSsl" />
                        </div>
                        <RedGTextBox For="@(() => _item.Username)" @bind-value="@_item.Username" />
                        <RedGPassword For="@(() => _item.Password)" @bind-value="@_item.Password" />
                        @if (_item.HasPassword)
                        {
                            <div class="text-muted small">Password salvata sul server. Lascia il campo vuoto per non cambiarla.</div>
                        }
                    }
                    else
                    {
                        <RedGPassword For="@(() => _item.ApiKey)" @bind-value="@_item.ApiKey" />
                        @if (_item.HasApiKey)
                        {
                            <div class="text-muted small">API key salvata sul server. Lascia il campo vuoto per non cambiarla.</div>
                        }
                        <div class="text-muted small">
                            Per il pieno rendering del logo nei template, in alternativa all'API puoi configurare @_item.Provider come canale <b>SMTP</b> (relay <code>@(_item.Provider == EmailProvider.SendGrid ? "smtp.sendgrid.net" : "smtp-relay.brevo.com")</code>).
                        </div>
                    }

                    <div class="mt-2">
                        <RedGButton RGButtonType="RGButtonType.Submit" Click="TestAsync" Disabled="@_testInProgress">Test canale</RedGButton>
                        @if (!string.IsNullOrEmpty(_testResult))
                        {
                            <div class="mt-2 @(_testOk ? "text-success" : "text-danger")">@_testResult</div>
                        }
                    </div>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
    </EditForm>
}
