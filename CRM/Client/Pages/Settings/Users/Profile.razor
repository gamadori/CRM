@page "/Settings/Users/Profile"

@using Radzen
@using Radzen.Blazor


@if (_user == null)
{
    <Waiting></Waiting>
}
else
{   
    <PageHeader ></PageHeader>

    <EditForm Model="@_user" OnValidSubmit="HandleValidSubmit" class="mb-3">
     <div class="row rounded-3 bg-light">
        <div class="col-md-8">

            <div class="row g-3">
                
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><DisplayName For="@(()=>_user.Name)" /></td>
                            <td>@_user.Name</td>
                        </tr>
                        <tr>
                            <td><DisplayName For="@(()=>_user.Surname)" /></td>
                            <td>@_user.Surname</td>
                        </tr>
                         <tr>
                            <td><DisplayName For="@(()=>_user.Email)" /></td>
                            <td>@_user.Email</td>
                        </tr>
                         <tr>
                            <td><DisplayName For="@(()=>_user.PhoneNumber)" /></td>
                            <td>@_user.PhoneNumber</td>
                        </tr>
                         <tr>
                            <td><DisplayName For="@(()=>_user.Company)" /></td>
                            <td>@_user.Company</td>
                        </tr>
                        
                        <tr>
                            <td><DisplayName For="@(()=>_user.LanguageCode)" /></td>
                            <td>
                                <LanguageSelectorDb Languages="@_languages"  @bind-Value="@_user.LanguageCode" /> @_user.LanguageCode
                            </td>
                        </tr>
                        <tr>
                            <td><DisplayName For="@(()=>_user.Photo)" /></td>
                            <td>
                                <div class="avatar-upload-container">
                                   
                                    <RadzenFileInput Accept="image/*" 
                                                    ImageStyle="max-width:400px" 
                                                    @bind-Value="@_user.Photo" 
                                                    @onchange="PhotoChange" 
                                                    TValue="string" 
                                                    ChooseText="@Localize["Seleziona"]" 
                                                    class="avatar-file-input" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <BlazorButton Style="BtnStyle.Primary"  Template="TemplateButton.Submit" Label="true" Text="@Localize["Save Changes"]"></BlazorButton>
    </EditForm>
}

<style>
    .avatar-upload-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }

    .avatar-preview-wrapper {
        position: relative;
        display: inline-block;
    }

    .avatar-preview-wrapper:hover .avatar-upload-overlay {
        opacity: 1;
    }

    .avatar-upload-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        cursor: pointer;
    }

    .avatar-upload-overlay .material-icons {
        color: white;
        font-size: 2rem;
    }

    .avatar-file-input {
        width: 100%;
        max-width: 400px;
    }

    @@media (max-width: 768px) {
        .avatar-upload-container {
            align-items: center;
        }

        .avatar-file-input {
            width: 100%;
        }
    }
</style>