 @page "/Settings/Users/New"
@page "/Settings/Users/{Id}/Edit"
@page "/Company/{IdCompany:int?}/Users/New"
@page "/Company/{IdCompany:int?}/Users/{Id}/Edit"

@using Radzen
@using Radzen.Blazor
@using CRM.Shared.DTOs
@if (IdCompany == null && PageMode != PageHelper.PageModality.Dialog)
{
    <PageHeader Model=@_pageHeader />
}




@if (_user == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="@_user" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_user.Name" For="@(() => _user.Name)" />
                            </RadzenStack>
                        </RadzenColumn>
                    
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_user.Surname" For="@(() => _user.Surname)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_user.Email" For="@(() => _user.Email)" ReadOnly=@readOnly />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_user.PhoneNumber" For="@(() => _user.PhoneNumber)" ReadOnly=@readOnly />
                            </RadzenStack>
                        </RadzenColumn>
                        
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                    <Authorized Context="AuthorizeRole">
                                        
                                        <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="Id" TextProperty="RagioneSociale" @bind-Value="@_user.IdCompany" For="@(() => _user.IdCompany)"
                                                      Data="_companies" AllowFiltering="true" />
                                    </Authorized>
                                    <NotAuthorized Context="AuthorizeRole">
                                        <RedGTextBox Value="@_user.Company" For="@(() => _user.Company)" ReadOnly=true />
                                       
                                    </NotAuthorized>
                                </AuthorizeView>
                                
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            @if (_user.IdCompany == null)
                            {
                                <RedGTextBox Value="@_user.CompanyPreview" For="@(() => _user.CompanyPreview)" ReadOnly=true />
                               
                            }
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                    <Authorized Context="AuthorizeRole">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenLabel Component="True">
                                                <DisplayName For="@(() => _user.Enabled)" />
                                            </RadzenLabel>
                                            <RadzenSwitch  Value="@_user.Enabled"  Name="True" />
                                        </RadzenStack>

                                    </Authorized>
                                    <NotAuthorized Context="AuthorizeRole">
                                        <RedGTextBox Value="@Localize[_user.Enabled.ToString()]" For="@(() => _user.Enabled)" ReadOnly=true />
                                       
                                    </NotAuthorized>
                                </AuthorizeView>
                                
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenStack>
                                <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                    <Authorized Context="AuthorizeRole">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenLabel Component="True">
                                                <DisplayName For="@(() => _user.Color)" />
                                            </RadzenLabel>
                                            <RadzenColorPicker @bind-Value=@_user.Color ShowHSV=true ShowRGBA=true ShowColors=true />   
                                        </RadzenStack>

                                    </Authorized>
                                    <NotAuthorized Context="AuthorizeRole">
                                        <RadzenLabel Component="True">
                                            <DisplayName For="@(() => _user.Color)" />
                                        </RadzenLabel>
                                        <RadzenColorPicker @bind-Value=@_user.Color ShowHSV=true ShowRGBA=true ShowColors=true Disabled="true" />   
                                    </NotAuthorized>
                                </AuthorizeView>
                                
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    
                    
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true"  />
    </EditForm>


    <MsgBoxConfirm Id="dlgDelete" @ref="msgBox" LabelBtnNo="@_labelNo" LabelBtnYes="@_labelYes" Header="@Localize["Invio Invito"]" Message="@_message" OnClick="msgBoxEvent"></MsgBoxConfirm>
    
}