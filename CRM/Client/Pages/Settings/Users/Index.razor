@page "/Settings/Users"
@page "/Settings/Users/Index"
@page "/Company/{IdCompany:int?}/Users/"
@page "/Settings/Users/{NeedConfirm:bool}"

@using Radzen
@using Radzen.Blazor


@if (IdProject == null && IdCompany == null)
{
    <PageHeader Model="@_pageHeader"></PageHeader>
}



<RadzenDataGrid @ref="grdUsers" IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_users" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced" 
    AllowSorting="true" AllowFiltering="true" AllowPaging="true" 
        PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="ApplicationUser">
    <HeaderTemplate>
       
        @if (IdProject == null)
        {
            <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
        }
        else
        {
            <BtnUsers OnGetItem="NewItem" Text=@Localize["Add User"] IdProjectParent="@IdProject"></BtnUsers>
        }
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Context="Item" TItem="ApplicationUser" Title="@Localize["Avatar"]"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center" Width="128px">
            <Template Context="item">

                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OnClickName(item?.Id)"><RedGAvatar IdUser="@item.Id"></RedGAvatar></a>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ApplicationUser" Property="Company.RagioneSociale" Title=@TranslateHelper.GetDisplayName(nameof(Company.RagioneSociale), typeof(Company)) />
        <RadzenDataGridColumn TItem="ApplicationUser" Property="@nameof(ApplicationUser.Email)" Title=@TranslateHelper.GetDisplayName(nameof(ApplicationUser.Email), typeof(ApplicationUser)) />
       
        <RadzenDataGridColumn TItem="ApplicationUser" Property="@nameof(ApplicationUser.Surname)" Title=@TranslateHelper.GetDisplayName(nameof(ApplicationUser.Surname), typeof(ApplicationUser)) />
        <RadzenDataGridColumn TItem="ApplicationUser" Property="@nameof(ApplicationUser.Name)" Title=@TranslateHelper.GetDisplayName(nameof(ApplicationUser.Name), typeof(ApplicationUser)) />
        <RadzenDataGridColumn TItem="ApplicationUser" Property="@nameof(ApplicationUser.Enabled)" Title=@TranslateHelper.GetDisplayName(nameof(ApplicationUser.Enabled), typeof(ApplicationUser)) />

        <RadzenDataGridColumn Context="Item" TItem="ApplicationUser" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center" Title=@TranslateHelper.GetDisplayName(nameof(ApplicationUser.Color), typeof(ApplicationUser))>
            <Template Context="item">
                    <div class="alert align-middle" style="width:200px;margin:0 auto; background-color:@item.Color"></div>
            </Template>
        </RadzenDataGridColumn>
        @if (PageMode != PageHelper.PageModality.Dialog)
        {
            <RadzenDataGridColumn Context="item" TItem="ApplicationUser" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <div class="d-flex gap-2 justify-content-center align-items-center">
                        @if (CmdDetails)
                        {
                        
                            <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                        }
                        @if (CmdEdit)
                        {
                            <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                        }
                        @if (CmdDelete)
                        {
                            <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>
                        }   
                        @if (!item.AdminConfirmed)
                        {
                        
                            <RedGButton RGButtonType="RGButtonType.Confirm" Icon="check" Click=@(() => Confirm(item))></RedGButton>

                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>
        }
       
    </Columns>
</RadzenDataGrid>



