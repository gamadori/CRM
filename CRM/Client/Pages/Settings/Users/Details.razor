@page "/Settings/Users/Details/{Id}"

@using Radzen
@using Radzen.Blazor

<div class="container-fluid">
<BlazorHeader Header="@Localize["Dettagli Utente"]">
</BlazorHeader>

<BlazorBreadCrumb Model="@_bread"></BlazorBreadCrumb>

@if (_user == null)
{
    <Waiting></Waiting>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col"></th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Name)"/></th>
                <td><span>@_user.Name</span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Surname)"/></th>
                <td><span>@_user.Surname</span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Enabled)"/></th>
                <td><span>@_user.Enabled</span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.AdminConfirmed)"/></th>
                <td><span>@_user.AdminConfirmed</span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.WaitConfirmInvite)"/></th>
                <td><span>@_user.WaitConfirmInvite</span></td>
            </tr>
            @if (_user.DateSendInvite != null)
            {
                <tr>
                    <th scope="row"><DisplayName For="@(()=>_user.DateSendInvite)"/></th>
                    <td><span>@_user.DateSendInvite</span></td>
                </tr>
                <tr>
                    <th scope="row"><DisplayName For="@(()=>_user.DateAcceptInvite)"/></th>
                        <td><span>@_user.DateAcceptInvite</span></td>
                </tr>
            }
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Email)"/></th>
                <td><span>@_user.Email</span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.PhoneNumber)"/></th>
                <td><span>@_user.PhoneNumber</span></td>
            </tr>
            <tr>
                @if (_user.IdCompany != null)
                {
                    <th scope="row"><DisplayName For="@(()=>_user.Company)"/></th>
                    <td><span>@_user.Company?.RagioneSociale</span></td>
                }
                else
                {
                    <th scope="row"><DisplayName For="@(()=>_user.CompanyPreview)" /></th>
                    <td><span>@_user.CompanyPreview</span></td>
                }
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Color)"/></th>
                <td><span><RadzenColorPicker @bind-Value=@_user.Color ShowHSV=true ShowRGBA=true ShowColors=true Disabled="true" /></span></td>
            </tr>
            <tr>
                <th scope="row"><DisplayName For="@(()=>_user.Photo)"/></th>
                <td>
                        <RedGAvatar IdUser="@_user.Id"></RedGAvatar>
                </td>
            </tr>
        

        </tbody>
    </table>
    
    <div class="row m-3">
        <BlazorButton CssClass="col-auto" Style="BtnStyle.Secondary" OnClick="Annulla" Text="Lista Utenti" Template="TemplateButton.Back"></BlazorButton>
            <BlazorButton CssClass="col-auto" Style="BtnStyle.Primary" OnClick="Edit" Template="TemplateButton.Edit" Label="true"></BlazorButton>
            <BlazorButton CssClass="col-auto" Style="BtnStyle.Dark" OnClick="Roles" Icon="supervised_user_circle" Text="Roles" Label="true"></BlazorButton>
    

        @if (!_user.AdminConfirmed)
        {
            <BlazorButton CssClass="col-auto" Template="TemplateButton.Confirm" Label="true" OnClick="() => PreparateConfirm()"></BlazorButton>
        }
        @* @if (_user.WaitConfirmInvite) *@
        @* { *@
                <BlazorButton CssClass="col-auto" Template="TemplateButton.Invitation" Label="true" OnClick="() => PrepareSendInvite()"></BlazorButton>
        @* } *@
    </div>

    <MsgBoxConfirm Id="dlgDelete" LabelBtnNo="No" LabelBtnYes="Yes" Header="Confermare il documento" Message="@_message" OnClick="ConfirmUser"></MsgBoxConfirm>
}
</div>