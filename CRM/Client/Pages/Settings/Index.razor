@page "/Settings"
@using CRM.Client.Models
@using CRM.Client.Services
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.Extensions.Localization;
@using CRM.Client.Pages.Settings.Components

@attribute [Authorize(Policy = "AdminRole")]

<PageHeader Model="_pageHeader">
</PageHeader>

<div class="settings-container">

    <div class="settings-search">
        <span class="material-icons">search</span>
        <input type="text" placeholder="@Localize["Cerca impostazione..."]"
               aria-label="@Localize["Cerca impostazione..."]"
               @bind="_search" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <span class="material-icons search-clear" role="button" @onclick="ClearSearch">close</span>
        }
    </div>

    @foreach (var section in FilteredSections)
    {
        <div class="settings-section">
            <div class="section-title">
                <span>@section.Title</span>
                <span class="section-count">@section.Items.Count</span>
            </div>
            <div class="settings-cards">
                @foreach (var item in section.Items)
                {
                    <SettingCard Icon="@item.Icon" Href="@item.Href" Title="@item.Title"
                                 Description="@item.Description" Color="@item.Color" />
                }
            </div>
        </div>
    }

    @if (!FilteredSections.Any())
    {
        <div class="settings-empty">
            <span class="material-icons">search_off</span>
            <span>@Localize["Nessun risultato"]</span>
        </div>
    }
</div>

<style>
    .settings-container {
        width: 100%;
        max-width: 1400px;
        margin: 0;
        padding: 1rem;
    }

    .settings-search {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 420px;
        margin-bottom: 1.5rem;
    }

    .settings-search > .material-icons {
        position: absolute;
        left: 12px;
        color: var(--crm-text-muted, #64748b);
        font-size: 20px;
        pointer-events: none;
    }

    .settings-search input {
        width: 100%;
        height: 44px;
        box-sizing: border-box;
        padding: 0 40px;
        font-size: 0.95rem;
        color: var(--crm-text, #1f2937);
        background: var(--crm-surface, #fff);
        border: 1px solid var(--crm-border-strong, #cbd5e1);
        border-radius: 10px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .settings-search input:focus {
        border-color: var(--rz-primary, #1976d2);
        box-shadow: 0 0 0 3px var(--rz-primary-lighter, rgba(25, 118, 210, 0.15));
    }

    .search-clear {
        position: absolute;
        right: 10px;
        color: var(--crm-text-muted, #64748b);
        font-size: 18px;
        cursor: pointer;
        border-radius: 50%;
        padding: 2px;
    }

    .search-clear:hover {
        background: var(--crm-surface-hover, #f1f5f9);
    }

    .settings-section {
        margin-bottom: 1.5rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 0.625rem 0.125rem;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--crm-text-muted, #64748b);
    }

    .section-count {
        background: var(--crm-surface-muted, #f1f5f9);
        color: var(--crm-text-muted, #64748b);
        border-radius: 20px;
        padding: 1px 9px;
        font-size: 0.75rem;
    }

    .settings-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 0.5rem;
    }

    .settings-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 3rem 0;
        color: var(--crm-text-muted, #64748b);
    }

    .settings-empty .material-icons {
        font-size: 40px;
        opacity: 0.6;
    }

    @@media (max-width: 767px) {
        .settings-container {
            padding: 0.5rem;
        }

        .settings-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }

    [Inject]
    IHeaderService HeaderService { get; set; }

    private PageHeaderModel? _pageHeader = null;

    private string _search = string.Empty;

    private List<Section> _sections = new();

    private IEnumerable<Section> FilteredSections
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
                return _sections;

            var q = _search.Trim();
            return _sections
                .Select(s => new Section(s.Title, s.Items
                    .Where(i => Contains(i.Title, q) || Contains(i.Description, q))
                    .ToList()))
                .Where(s => s.Items.Count > 0);
        }
    }

    private static bool Contains(string source, string query) =>
        (source ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase);

    private void ClearSearch() => _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();
        BuildSections();
        await base.OnInitializedAsync();
    }

    private void BuildSections()
    {
        _sections = new()
        {
            new(Localize["UserManagement"], new()
            {
                new("account_circle", "Settings/Users", Localize["Users"], "Gestisci utenti e permessi", "#1976d2"),
                new("groups", "Settings/Groups", Localize["Groups"], "Configura gruppi di lavoro", "#455a64"),
            }),

            new(Localize["ProductsAndTickets"], new()
            {
                new("category", "Settings/ProductsTypes", Localize["ProductTypes"], "Tipi di prodotto", "#fbc02d"),
                new("class", "Settings/TicketTypes", Localize["TicketTypes"], "Tipi di ticket", "#455a64"),
                new("traffic", "TicketStates", Localize["TicketStates"], "Stati del ticket", "#c62828"),
                new("home_repair_service", "Settings/InterventionTypes", Localize["ServiceTypes"], "Gestisci tipi intervento", "#7b1fa2"),
                new("precision_manufacturing", ConstHelper.ClientProductsSettings, Localize["ProductsSettings"], "Configurazione prodotti", "#00897b"),
                new("sell", ConstHelper.ClientPriceListPath, Localize["PriceList"], "Prezzi dedicati per cliente", "#6a1b9a"),
            }),

            new(Localize["Communications"], new()
            {
                new("forward_to_inbox", "Settings/Smtps", Localize["Smtp"], "Configurazione email", "#c62828"),
                new("inbox", "Settings/EmailInboxes", "Caselle in ingresso", "IMAP / inbound-parse", "#00838f"),
                new("move_to_inbox", "Settings/InboundEmails", "Email in ingresso", "Triage e associazione", "#0277bd"),
                new("mail", "Settings/EmailTemplates", Localize["Email Template"], "Template email", "#455a64"),
                new("send", "Settings/Telegram", Localize["Telegram"], "Integrazione Telegram", "#0088cc"),
            }),

            new(Localize["SystemConfiguration"], new()
            {
                new("language", "Settings/Languages", Localize["Languages"], "Lingue del sistema", "#388e3c"),
                new("folder", "Settings/Folders", Localize["Folders"], "Gestisci cartelle", "#388e3c"),
                new("switch_account", "Settings/Logos", Localize["Logos"], "Gestisci loghi aziendali", "#e64a19"),
                new("settings", "GlobalSettings", Localize["GlobalSettings"], "Impostazioni globali", "#fbc02d"),
                new("event_note", ConstHelper.ClientLogEventsPath, Localize["logevents"], "Visualizza log di sistema", "#388e3c"),
                new("vpn_key", "Settings/MachineParameterApiKeys", "Chiavi API macchina", "Accesso ai backup via API", "#0f4a8a"),
                new("engineering", "Settings/Maintenance", "Manutenzione server", "Avvisa gli utenti prima di un aggiornamento", "#ed6c02"),
            }),

            new(Localize["ArtificialIntelligence"], new()
            {
                new("menu_book", "Knowledge", Localize["KnowledgeBase"], "Knowledge Base", "#388e3c"),
                new("forum", "Settings/AssistantLogs", "Log Assistente", "Domande, risposte e feedback", "#3b5bdb"),
            }),
        };
    }

    private record Item(string Icon, string Href, string Title, string Description, string Color);

    private record Section(string Title, List<Item> Items);
}
