@page "/GlobalSettings"


<h3>Settaggi</h3>
<hr/>

@if (_settings == null || _saving)
{
    <Waiting></Waiting>
}

else
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>

     <EditForm Model="@_settings" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <ValidationSummary />


                    <!-- Company and Contact -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.TicketDaysExpired" For="@(() => _settings.TicketDaysExpired)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_settings.ScheduleTimeStart" For="@(() => _settings.ScheduleTimeStart)"
                                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_settings.ScheduleTimeEnd" For="@(() => _settings.ScheduleTimeEnd)"
                                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDropDown TValue="int" @bind-Value="@_settings.IdHeadQuarter" For="@(() => _settings.IdHeadQuarter)" TItem="CompanyDTO" 
                                        TextProperty="@nameof(CompanyDTO.RagioneSociale)" ValueProperty="@nameof(CompanyDTO.Id)" Data="_companies"/>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.MonthlySchedulerMaxNumTickets" For="@(() => _settings.MonthlySchedulerMaxNumTickets)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDropDown TValue="int?" @bind-Value="@_settings.LogoSiteHeader" For="@(() => _settings.LogoSiteHeader)" TItem="Logo"
                                                  TextProperty="@nameof(Logo.Codice)" ValueProperty="@nameof(Logo.Id)" Data="_loghi" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDropDown TValue="int?" @bind-Value="@_settings.LogoReport" For="@(() => _settings.LogoReport)" TItem="Logo"
                                                  TextProperty="@nameof(Logo.Codice)" ValueProperty="@nameof(Logo.Id)" Data="_loghi" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="@_settings.Telegram" id="flexSwitchCheckChecked">
                                        <DisplayName For="@(() => _settings.Telegram)" CssClass="form-check-label" />
                                    </div>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel=true />
    </EditForm>
   
}