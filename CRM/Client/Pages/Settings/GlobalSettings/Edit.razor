@page "/GlobalSettings"


<h3>Settaggi</h3>
<hr/>

@if (_settings == null || _saving)
{
    <Waiting></Waiting>
}

else
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>

     <EditForm Model="@_settings" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <ValidationSummary />


                    <!-- Company and Contact -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.TicketDaysExpired" For="@(() => _settings.TicketDaysExpired)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_settings.ScheduleTimeStart" For="@(() => _settings.ScheduleTimeStart)"
                                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_settings.ScheduleTimeEnd" For="@(() => _settings.ScheduleTimeEnd)"
                                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.MonthlySchedulerMaxNumTickets" For="@(() => _settings.MonthlySchedulerMaxNumTickets)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDropDown TValue="int?" @bind-Value="@_settings.LogoSiteHeader" For="@(() => _settings.LogoSiteHeader)" TItem="Logo"
                                                  TextProperty="@nameof(Logo.Codice)" ValueProperty="@nameof(Logo.Id)" Data="_loghi" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGDropDown TValue="int?" @bind-Value="@_settings.LogoReport" For="@(() => _settings.LogoReport)" TItem="Logo"
                                                  TextProperty="@nameof(Logo.Codice)" ValueProperty="@nameof(Logo.Id)" Data="_loghi" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="@_settings.Telegram" id="flexSwitchCheckChecked">
                                        <DisplayName For="@(() => _settings.Telegram)" CssClass="form-check-label" />
                                    </div>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="@_settings.RemoteSignatureEnabled" id="switchRemoteSignature">
                                        <DisplayName For="@(() => _settings.RemoteSignatureEnabled)" CssClass="form-check-label" />
                                        <div class="form-text">
                                            Interruttore generale del canale remoto. Che firma serva per ogni tipo di
                                            intervento si decide in
                                            <a href="Settings/SignatureTypes">Firma degli interventi</a>.
                                        </div>
                                    </div>
                                    @if (_settings.RemoteSignatureEnabled)
                                    {
                                        <div class="mb-3">
                                            <DisplayName For="@(() => _settings.SignatureLinkValidityDays)" CssClass="form-label" />
                                            <RadzenNumeric TValue="int" @bind-Value="_settings.SignatureLinkValidityDays" Min="1" Max="365" Style="width:100%" />
                                            <div class="form-text">
                                                Passati questi giorni il link non firma piu' niente e va rimandato.
                                                Vale dal momento dell'invio, non da quello dell'intervento.
                                            </div>
                                        </div>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <label class="form-label mb-1">
                                        <DisplayName For="@(() => _settings.VoiceInputMode)" />
                                    </label>
                                    <select class="form-select" @bind="@_settings.VoiceInputMode">
                                        <option value="@VoiceInputMode.Off">Disattivata</option>
                                        <option value="@VoiceInputMode.Browser">Browser (dettatura locale, gratis, solo Chrome/Edge)</option>
                                        <option value="@VoiceInputMode.Whisper">Server (Whisper OpenAI, più accurata, a consumo)</option>
                                    </select>
                                    <small class="text-muted">
                                        Abilita il microfono nell'assistente AI. "Browser" trascrive localmente senza costi (richiede Chrome/Edge);
                                        "Server" usa OpenAI Whisper: più accurata e su tutti i browser, ma con un costo per utilizzo.
                                    </small>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <label class="form-label mb-1">
                                        <DisplayName For="@(() => _settings.TicketRerankMode)" />
                                    </label>
                                    <select class="form-select" @bind="@_settings.TicketRerankMode">
                                        <option value="@TicketRerankMode.Off">Nessuno (solo soglia e istruzioni)</option>
                                        <option value="@TicketRerankMode.AgentReread">Rilettura da parte dell'assistente</option>
                                        <option value="@TicketRerankMode.LlmJudge">Giudice AI dedicato (rilegge e filtra)</option>
                                    </select>
                                    <small class="text-muted">
                                        Come l'assistente verifica i "Ticket di riferimento" prima di mostrarli. "Rilettura": l'assistente
                                        rilegge il ticket completo prima di citarlo (nessun costo dedicato). "Giudice AI": un modello veloce
                                        rilegge i candidati e scarta i non pertinenti (una chiamata extra a costo ridotto, massima precisione).
                                    </small>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <hr class="my-2" />
                    <h5 class="mb-1">Tipologia delle note spese</h5>
                    <small class="text-muted mb-2 d-block">
                        La voce di rimborso (vitto, alloggio, trasporti...) viene proposta leggendo il tipo di
                        documento riconosciuto dall'OCR e l'esercente: due livelli che non costano nulla e sono
                        sempre attivi. Il modello AI interviene <strong>solo</strong> quando quei due non sanno
                        rispondere, e si paga a chiamata. In ogni caso la tipologia resta una proposta:
                        la conferma chi registra la spesa.
                    </small>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="@_settings.ExpenseCategoryAiEnabled" id="switchExpenseCategoryAi">
                                        <DisplayName For="@(() => _settings.ExpenseCategoryAiEnabled)" CssClass="form-check-label" />
                                    </div>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <label class="form-label mb-1">
                                        <DisplayName For="@(() => _settings.ExpenseCategoryMinConfidence)" />
                                    </label>
                                    <input type="number" class="form-control" step="0.05" min="0" max="1"
                                           @bind="@_settings.ExpenseCategoryMinConfidence" />
                                    <small class="text-muted">
                                        Sotto questa confidenza la tipologia non viene proposta e il campo resta da compilare.
                                        Alzarla riduce le proposte sbagliate e aumenta quelle mancanti; abbassarla fa il contrario.
                                        Valore consigliato: 0,6.
                                    </small>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <hr class="my-2" />
                    <h5 class="mb-1">Preavvisi ticket</h5>
                    <small class="text-muted mb-2 d-block">
                        Notifica automatica agli assegnatari prima dell'appuntamento (Data + Ora) e, se il ticket non è
                        ancora chiuso, prima della scadenza. L'anticipo è espresso in minuti.
                    </small>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="@_settings.TicketReminderEnabled" id="switchTicketReminder">
                                        <DisplayName For="@(() => _settings.TicketReminderEnabled)" CssClass="form-check-label" />
                                    </div>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.TicketAppointmentReminderMinutes" For="@(() => _settings.TicketAppointmentReminderMinutes)" ReadOnly="@(!_settings.TicketReminderEnabled)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.TicketExpiryReminderMinutes" For="@(() => _settings.TicketExpiryReminderMinutes)" ReadOnly="@(!_settings.TicketReminderEnabled)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <small class="text-muted mb-2 d-block">
                        Il preavviso ticket può essere sovrascritto per singolo Tipo Ticket (in Impostazioni → Tipi Ticket);
                        se lì non è indicato nulla vale il default globale qui sopra.
                    </small>

                    <hr class="my-2" />
                    <h5 class="mb-1">Default promemoria attività per tipo</h5>
                    <small class="text-muted mb-2 d-block">
                        Anticipo (minuti prima della scadenza) con cui precompilare il Promemoria quando si crea un'attività
                        di questo tipo. Lascia vuoto per non impostare alcun promemoria automatico. Resta sempre modificabile a mano.
                    </small>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.ActivityReminderMinutesCall" For="@(() => _settings.ActivityReminderMinutesCall)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.ActivityReminderMinutesEmail" For="@(() => _settings.ActivityReminderMinutesEmail)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.ActivityReminderMinutesMeeting" For="@(() => _settings.ActivityReminderMinutesMeeting)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.ActivityReminderMinutesTask" For="@(() => _settings.ActivityReminderMinutesTask)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RadzenStack>
                                    <RedGNumeric @bind-Value="@_settings.ActivityReminderMinutesNote" For="@(() => _settings.ActivityReminderMinutesNote)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
    </EditForm>
   
}