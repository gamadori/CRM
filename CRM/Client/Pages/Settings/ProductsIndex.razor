@page "/Settings/Products"
@using CRM.Client.Models;
@using CRM.Client.Services;
@using Microsoft.Extensions.Localization;

<PageHeader Model="@_pageHeader"></PageHeader>
<content class="p-4">
    <div class="row">

        <BlazorIcon href="Settings/ProductsTypes/Index" Icon="category" Text="@Localize["Product Types"]" />
        <BlazorIcon href="Settings/AccessoryTypes" Icon="type_specimen" Text="@Localize["Accessory Type"]" />
        <BlazorIcon href="Settings/GanttPlans" Icon="account_tree" Text="Template Gantt" />
     
        
        
 
    </div>

</content>
@code {
    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }

    [Inject]
    IHeaderService HeaderService { get; set; }


    private PageHeaderModel _pageHeader = null;

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();

        await base.OnInitializedAsync();
    }

}

