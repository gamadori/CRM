@using Microsoft.AspNetCore.Components

<a href="@Href" class="setting-card" style="--card-color: @Color">
    <span class="card-icon-wrapper">
        <span class="material-icons card-icon">@Icon</span>
    </span>
    <span class="card-content">
        <span class="card-title">@Title</span>
        <span class="card-description">@Description</span>
    </span>
    <span class="material-icons card-arrow">chevron_right</span>
</a>

<style>
    .setting-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.75rem;
        background: var(--crm-surface, #fff);
        border: 1px solid var(--crm-border, #e9ecef);
        border-radius: 10px;
        text-decoration: none;
        color: var(--crm-text, #1f2937);
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .setting-card:hover {
        border-color: var(--card-color);
        background: var(--crm-surface-hover, #f1f5f9);
    }

    .card-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: var(--crm-surface-muted, #f8fafc);
        border: 1px solid var(--crm-border, #e9ecef);
        border-radius: 9px;
        transition: all 0.15s ease;
    }

    .setting-card:hover .card-icon-wrapper {
        background: var(--card-color);
        border-color: var(--card-color);
    }

    .card-icon {
        font-size: 22px;
        color: var(--crm-text-muted, #64748b);
        transition: color 0.15s ease;
    }

    .setting-card:hover .card-icon {
        color: #fff;
    }

    .card-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .card-title {
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--crm-text, #1f2937);
        line-height: 1.25;
    }

    .card-description {
        font-size: 0.8125rem;
        color: var(--crm-text-muted, #64748b);
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-arrow {
        margin-left: auto;
        font-size: 20px;
        color: var(--crm-text-muted, #94a3b8);
        opacity: 0.4;
        transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .setting-card:hover .card-arrow {
        opacity: 1;
        transform: translateX(3px);
    }

    @@media (max-width: 768px) {
        .card-description {
            white-space: normal;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Href { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Color { get; set; } = "#1976d2";
}
