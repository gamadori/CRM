@using CRM.Client.Services
@using CRM.Shared
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService
@inject NotificationService Notification
@inject IBaseRestService<ApplicationUser, UsersFilterModel, string> UserService

<div class="activity-complete-dialog">
    <div class="activity-complete-summary">
        <span class="material-icons">@Icon</span>
        <div>
            <strong>@Subject</strong>
            <small>@KindText</small>
        </div>
    </div>

    <div class="activity-complete-grid">
        <div class="activity-complete-field">
            <label>Esito</label>
            <RadzenDropDown TValue="string" @bind-Value="_completion.Outcome" Data="_outcomes"
                            Style="width:100%" AllowClear="true" Placeholder="Seleziona esito" />
        </div>

        <div class="activity-complete-field activity-complete-field-full">
            <label>Relazione</label>
            <textarea class="form-control" rows="5" @bind="_completion.CompletionNotes"
                      placeholder="@NotesPlaceholder"></textarea>
        </div>

        <div class="activity-complete-field activity-complete-field-full">
            <label>Prossima azione</label>
            <textarea class="form-control" rows="2" @bind="_completion.NextStep"
                      placeholder="Es. inviare offerta, fissare follow-up, attendere documenti"></textarea>
        </div>

        <div class="activity-followup">
            <label class="activity-followup-toggle">
                <input type="checkbox" class="form-check-input" @bind="_completion.CreateFollowUp" @bind:after="PrepareFollowUp" />
                <span>Crea attività di follow-up</span>
            </label>

            @if (_completion.CreateFollowUp)
            {
                <div class="activity-followup-grid">
                    <div class="activity-complete-field">
                        <label>Tipo</label>
                        <RadzenDropDown TValue="ActivityKind" @bind-Value="_completion.FollowUpKind" Data="_kindOptions"
                                        TextProperty="Text" ValueProperty="Value" Style="width:100%" />
                    </div>

                    <div class="activity-complete-field">
                        <label>Scadenza</label>
                        <RadzenDatePicker TValue="DateTime?" @bind-Value="_completion.FollowUpDueDate" ShowTime="true"
                                          DateFormat="dd/MM/yyyy HH:mm" Style="width:100%" />
                    </div>

                    <div class="activity-complete-field activity-complete-field-full">
                        <label>Oggetto</label>
                        <input class="form-control" @bind="_completion.FollowUpSubject" />
                    </div>

                    <div class="activity-complete-field activity-complete-field-full">
                        <label>Assegna a</label>
                        <RadzenDropDown TValue="string" @bind-Value="_completion.FollowUpAssigneeId" Data="_users"
                                        TextProperty="NameComplete" ValueProperty="Id" AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowClear="true" Placeholder="Stesso assegnatario" Style="width:100%" />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="activity-complete-actions">
        <RadzenButton Icon="close" Text="Annulla" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                      Click="@Cancel" />
        <RadzenButton Icon="check" Text="Completa" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                      Click="@Complete" />
    </div>
</div>

<style>
    .activity-complete-dialog {
        min-width: min(620px, 82vw);
    }

    .activity-complete-summary {
        align-items: center;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        gap: .75rem;
        margin-bottom: 1rem;
        padding-bottom: .85rem;
    }

    .activity-complete-summary .material-icons {
        color: #1976d2;
        font-size: 28px;
    }

    .activity-complete-summary strong,
    .activity-complete-summary small {
        display: block;
    }

    .activity-complete-summary small {
        color: #6b7280;
        font-size: .78rem;
        margin-top: .15rem;
    }

    .activity-complete-grid {
        display: grid;
        gap: .9rem;
        grid-template-columns: 1fr;
    }

    .activity-complete-field label {
        color: #4b5563;
        display: block;
        font-size: .74rem;
        font-weight: 700;
        margin-bottom: .25rem;
        text-transform: uppercase;
    }

    .activity-followup {
        border-top: 1px solid #e5e7eb;
        padding-top: .9rem;
    }

    .activity-followup-toggle {
        align-items: center;
        color: #111827;
        display: inline-flex;
        font-weight: 700;
        gap: .5rem;
        margin-bottom: .85rem;
    }

    .activity-followup-grid {
        display: grid;
        gap: .9rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .activity-complete-field-full {
        grid-column: 1 / -1;
    }

    .activity-complete-actions {
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
        margin-top: 1rem;
    }

    @@media (max-width: 700px) {
        .activity-complete-dialog {
            min-width: 0;
        }

        .activity-followup-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter] public ActivityKind Kind { get; set; }
    [Parameter] public string Subject { get; set; } = string.Empty;
    [Parameter] public string? DefaultAssigneeId { get; set; }

    private readonly ActivityCompletionRequest _completion = new();
    private List<ApplicationUser> _users = new();

    private record KindOption(string Text, ActivityKind Value);
    private readonly List<KindOption> _kindOptions = new()
    {
        new("Chiamata", ActivityKind.Call),
        new("Email", ActivityKind.Email),
        new("Meeting", ActivityKind.Meeting),
        new("Task", ActivityKind.Task)
    };

    private List<string> _outcomes => Kind switch
    {
        ActivityKind.Meeting => new() { "Positivo", "Da approfondire", "Non interessato", "Rinviato" },
        ActivityKind.Call => new() { "Risposto", "Non risposto", "Richiamare", "Non interessato" },
        ActivityKind.Task => new() { "Completato", "Parzialmente completato", "Bloccato" },
        _ => new() { "Completato" }
    };

    private string KindText => Kind switch
    {
        ActivityKind.Call => "Chiamata",
        ActivityKind.Email => "Email",
        ActivityKind.Meeting => "Meeting",
        ActivityKind.Note => "Nota",
        ActivityKind.Task => "Task",
        _ => "Attivita"
    };

    private string Icon => Kind switch
    {
        ActivityKind.Call => "call",
        ActivityKind.Email => "mail",
        ActivityKind.Meeting => "groups",
        ActivityKind.Task => "task_alt",
        _ => "notes"
    };

    private string NotesPlaceholder => Kind == ActivityKind.Meeting
        ? "Sintesi del meeting, decisioni prese, punti aperti"
        : "Sintesi dell'esito e informazioni utili per la timeline";

    protected override async Task OnInitializedAsync()
    {
        _completion.FollowUpKind = SuggestedFollowUpKind();
        _completion.FollowUpAssigneeId = DefaultAssigneeId;

        var response = await UserService.GetList(new UsersFilterModel());
        _users = response?.Items?.OrderBy(x => x.NameComplete).ToList() ?? new List<ApplicationUser>();
    }

    private void PrepareFollowUp()
    {
        if (!_completion.CreateFollowUp)
            return;

        _completion.FollowUpKind = SuggestedFollowUpKind();
        _completion.FollowUpAssigneeId ??= DefaultAssigneeId;
        _completion.FollowUpDueDate ??= DateTime.Now.AddDays(1);
        _completion.FollowUpSubject = string.IsNullOrWhiteSpace(_completion.NextStep)
            ? $"Follow-up: {Subject}"
            : _completion.NextStep.Trim();
    }

    private void Complete()
    {
        if (_completion.CreateFollowUp)
        {
            if (string.IsNullOrWhiteSpace(_completion.FollowUpSubject))
            {
                Notification.Notify(NotificationSeverity.Warning, "Follow-up", "Inserisci l'oggetto del follow-up");
                return;
            }

            if (_completion.FollowUpDueDate == null)
            {
                Notification.Notify(NotificationSeverity.Warning, "Follow-up", "Inserisci la scadenza del follow-up");
                return;
            }
        }

        DialogService.Close(_completion);
    }

    private void Cancel()
    {
        DialogService.Close(null);
    }

    private ActivityKind SuggestedFollowUpKind() => Kind switch
    {
        ActivityKind.Call => ActivityKind.Call,
        ActivityKind.Meeting => ActivityKind.Task,
        ActivityKind.Task => ActivityKind.Task,
        _ => ActivityKind.Task
    };
}
