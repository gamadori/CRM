@using CRM.Client.Helpers
@using CRM.Client.Services
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@inject IActivityService ActivityService
@inject IBaseRestService<ApplicationUser, UsersFilterModel, string> UserService
@inject DialogService DialogService
@inject NotificationService Notification
@inject Microsoft.Extensions.Localization.IStringLocalizer<CRM.Shared.Resources.App> Localize

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1 small">@Localize["Tipo"]</label>
                <RadzenDropDown TValue="ActivityKind" @bind-Value="_new.Kind" Data="Kinds"
                                TextProperty="Text" ValueProperty="Value" Style="width:100%" />
            </div>
            <div class="col-md-4">
                <label class="form-label mb-1 small">@Localize["Oggetto"]</label>
                <input class="form-control form-control-sm" @bind="_new.Subject" placeholder="@Localize["Es. Chiamata di follow-up"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1 small">@Localize["Assegna a"]</label>
                <RadzenDropDown TValue="string" @bind-Value="_new.IdAssignee" Data="_users"
                                TextProperty="NameComplete" ValueProperty="Id" AllowFiltering="true" AllowClear="true"
                                Placeholder="@Localize["Me stesso"]" Style="width:100%" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small">@Localize["Scadenza (opz.)"]</label>
                <RadzenDatePicker TValue="DateTime?" @bind-Value="_new.DueDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width:100%" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small">@Localize["Promemoria"]</label>
                <RadzenDropDown TValue="int" @bind-Value="_reminderMinutes" Data="ReminderOptions"
                                TextProperty="Text" ValueProperty="Value" Style="width:100%" Disabled="@(_new.DueDate == null)" />
            </div>
            <div class="col-md-8">
                <input class="form-control form-control-sm" @bind="_new.Description" placeholder="@Localize["Note (facoltative)"]" />
            </div>
            <div class="col-md-4">
                <RadzenButton class="w-100" Icon="add" Text="@Localize["Aggiungi"]" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Disabled="@(_saving || string.IsNullOrWhiteSpace(_new.Subject))" Click="Add" />
            </div>
        </div>
    </div>
</div>

@if (_items == null)
{
    <Waiting></Waiting>
}
else if (!_items.Any())
{
    <div class="text-muted text-center py-4">@Localize["Nessuna attività registrata."]</div>
}
else
{
    <div class="activity-timeline">
        @foreach (var a in _items)
        {
            <div class="d-flex gap-3 mb-3">
                <div class="text-center" style="width:40px">
                    <span class="material-icons" style="@($"color:{Helpers.ActivityUi.Color(a.Kind)}")">@Helpers.ActivityUi.Icon(a.Kind)</span>
                </div>
                <div class="flex-grow-1 border-bottom pb-2">
                    <div class="d-flex align-items-center">
                        <strong class="@(a.State == ActivityState.Done ? "text-decoration-line-through text-muted" : "")">@a.Subject</strong>
                        <span class="badge ms-2 @Helpers.ActivityUi.BadgeClass(a.Kind)">@Helpers.ActivityUi.KindText(a.Kind)</span>
                        @if (a.DueDate != null && a.State == ActivityState.Planned)
                        {
                            <span class="badge ms-2 @(a.DueDate < DateTime.Now ? "bg-danger" : "bg-warning text-dark")">
                                <span class="material-icons align-middle" style="font-size:14px">event</span> @a.DueDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                        @if (a.State == ActivityState.Done)
                        {
                            @if (a.Kind == ActivityKind.Email && a.IdInboundEmail != null)
                            {
                                <span class="badge bg-info ms-2">@Localize["Ricevuta"]</span>
                            }
                            else if (a.Kind == ActivityKind.Email && a.IdEmailSent != null)
                            {
                                <span class="badge bg-success ms-2">@Localize["Inviata"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-2">@Localize["Fatta"]</span>
                            }
                        }
                        <div class="ms-auto">
                            @if (a.State == ActivityState.Planned && a.Permits.Edit())
                            {
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => Complete(a))" title="@Localize["Completa"]" />
                            }
                            @if (a.Permits.Delete())
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => Delete(a))" title="@Localize["Elimina"]" />
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.Description))
                    {
                        <div class="text-body small mt-1">@a.Description</div>
                    }
                    @if (a.ParticipantNames.Any())
                    {
                        <div class="small mt-1 text-primary">
                            <span class="material-icons align-middle" style="font-size:14px">groups</span>
                            @Localize["Partecipanti"]: @string.Join(", ", a.ParticipantNames)
                        </div>
                    }
                    @if (a.State == ActivityState.Done && HasCompletionDetails(a))
                    {
                        <div class="activity-completion mt-2">
                            @if (!string.IsNullOrWhiteSpace(a.Outcome))
                            {
                                <div><strong>@Localize["Esito"]:</strong> @a.Outcome</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.CompletionNotes))
                            {
                                <div><strong>@Localize["Relazione"]:</strong> @a.CompletionNotes</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.NextStep))
                            {
                                <div><strong>@Localize["Prossima azione"]:</strong> @a.NextStep</div>
                            }
                            @if (a.DoneDate != null || !string.IsNullOrWhiteSpace(a.CompletedByName))
                            {
                                <div class="text-muted">
                                    @Localize["Chiusura"]
                                    @if (a.DoneDate != null)
                                    {
                                        <span> @a.DoneDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.CompletedByName))
                                    {
                                        <span> - @a.CompletedByName</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (a.IdInboundEmail != null)
                    {
                        <div class="small mt-1">
                            <a href="@($"/InboundEmails/{a.IdInboundEmail}")" class="link-primary text-decoration-none">
                                <span class="material-icons align-middle" style="font-size:14px">mail</span> @Localize["Apri email ricevuta"]
                            </a>
                        </div>
                    }
                    @if (a.IdEmailSent != null)
                    {
                        <div class="small mt-1 d-flex align-items-center flex-wrap gap-2">
                            <a href="@($"/EmailSent/{a.IdEmailSent}")" class="link-primary text-decoration-none">
                                <span class="material-icons align-middle" style="font-size:14px">mail</span> @Localize["Apri email"]
                            </a>
                            @if (a.EmailEngagement != null)
                            {
                                var eui = CRM.Client.Helpers.EmailEngagementUi.Status(a.EmailEngagement.Value);
                                <span class="badge @eui.Css">
                                    <span class="material-icons align-middle" style="font-size:12px">@eui.Icon</span> @eui.Label
                                </span>
                                @if (a.EmailOpenCount > 0)
                                {
                                    <span class="text-muted" style="font-size:0.75rem">@a.EmailOpenCount @Localize["aperture"]</span>
                                }
                                @if (a.EmailClickCount > 0)
                                {
                                    <span class="text-muted" style="font-size:0.75rem">· @a.EmailClickCount click</span>
                                }
                            }
                        </div>
                    }
                    <div class="text-muted" style="font-size:0.75rem">
                        @a.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(a.UserName)) { <span> · @a.UserName</span> }
                        @if (!string.IsNullOrWhiteSpace(a.AssigneeName) && a.AssigneeName != a.UserName)
                        {
                            <span class="text-primary"> · <span class="material-icons align-middle" style="font-size:14px">assignment_ind</span> @a.AssigneeName</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public ActivityEntityType EntityType { get; set; }
    [Parameter] public int EntityId { get; set; }

    private List<ActivityDTO>? _items;
    private List<ApplicationUser> _users = new();
    private Activity _new = new() { Kind = ActivityKind.Note };
    private int _reminderMinutes;
    private bool _saving;

    private record ReminderOption(string Text, int Value);
    private List<ReminderOption> ReminderOptions => new()
    {
        new(Localize["Nessuno"], 0),
        new(Localize["15 min prima"], 15),
        new(Localize["1 ora prima"], 60),
        new(Localize["1 giorno prima"], 1440),
    };

    private record KindOption(string Text, ActivityKind Value);
    private List<KindOption> Kinds => new()
    {
        new(Localize["Nota"], ActivityKind.Note),
        new(Localize["Chiamata"], ActivityKind.Call),
        new(Localize["Email"], ActivityKind.Email),
        new(Localize["Meeting"], ActivityKind.Meeting),
        new(Localize["Task"], ActivityKind.Task),
    };

    protected override async Task OnInitializedAsync()
    {
        var response = await UserService.GetList(new UsersFilterModel());
        _users = response?.Items?.ToList() ?? new List<ApplicationUser>();
    }

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load() => _items = await ActivityService.GetByEntityAsync(EntityType, EntityId);

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_new.Subject)) return;
        _saving = true;
        try
        {
            _new.EntityType = EntityType;
            _new.EntityId = EntityId;
            _new.State = ActivityState.Planned;
            // Promemoria derivato dalla scadenza (scadenza − offset)
            _new.ReminderAt = (_new.DueDate != null && _reminderMinutes > 0)
                ? _new.DueDate.Value.AddMinutes(-_reminderMinutes)
                : null;

            var resp = await ActivityService.PostAsync(_new);
            if (resp.State)
            {
                _new = new Activity { Kind = ActivityKind.Note };
                _reminderMinutes = 0;
                await Load();
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Salvataggio fallito"]);
            }
        }
        finally { _saving = false; }
    }

    private async Task Complete(ActivityDTO a)
    {
        ActivityCompletionRequest? completion = null;
        if (RequiresCompletionDetails(a.Kind))
        {
            completion = await DialogService.OpenAsync<ActivityCompleteDialog>(
                Localize["Completa attività"],
                new Dictionary<string, object?>
                {
                    ["Kind"] = a.Kind,
                    ["Subject"] = a.Subject,
                    ["DefaultAssigneeId"] = a.IdAssignee
                },
                new DialogOptions
                {
                    Width = "680px",
                    Height = "auto",
                    Resizable = false,
                    Draggable = true
                }) as ActivityCompletionRequest;

            if (completion == null)
                return;
        }

        var resp = await ActivityService.CompleteAsync(a.Id, completion);
        if (resp.State) await Load();
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"]);
    }

    private async Task Delete(ActivityDTO a)
    {
        if (await DialogService.Confirm(string.Format(Localize["Eliminare l'attività \"{0}\"?"], a.Subject), Localize["Conferma"]) != true) return;
        if (await ActivityService.DeleteAsync(a.Id)) await Load();
    }

    private static bool RequiresCompletionDetails(ActivityKind kind)
        => kind is ActivityKind.Meeting or ActivityKind.Call or ActivityKind.Task;

    private static bool HasCompletionDetails(ActivityDTO activity)
        => !string.IsNullOrWhiteSpace(activity.Outcome)
            || !string.IsNullOrWhiteSpace(activity.CompletionNotes)
            || !string.IsNullOrWhiteSpace(activity.NextStep)
            || !string.IsNullOrWhiteSpace(activity.CompletedByName);

}
