@page "/Agenda"
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Client.Helpers
@using CRM.Shared
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICalendarService CalendarService
@inject IActivityService ActivityService
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject NotificationService Notification
@inject DialogService DialogService
@inject Microsoft.Extensions.Localization.IStringLocalizer<CRM.Shared.Resources.App> Localize

<PageHeader Model="_pageHeader">
    <Actions>
        <div class="agenda-toolbar">
            <div class="agenda-actions">
                <RadzenButton Icon="add_task" Text="@Localize["Nuova attività"]" ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Flat" Click="@NewActivity" />
                <RadzenButton Icon="@(_includeActivities ? "event_available" : "event_busy")"
                                Text="@Localize["Attività"]"
                                ButtonStyle="@(_includeActivities ? ButtonStyle.Primary : ButtonStyle.Light)"
                                Variant="Variant.Flat"
                                Click="@ToggleActivities" />
                <RadzenButton Icon="@(_includeTickets ? "confirmation_number" : "confirmation_number")"
                                Text="@Localize["Ticket"]"
                                ButtonStyle="@(_includeTickets ? ButtonStyle.Primary : ButtonStyle.Light)"
                                Variant="Variant.Flat"
                                Click="@ToggleTickets" />
                <RadzenButton Icon="support_agent" Text="@Localize["Pianificazione Ticket"]" ButtonStyle="ButtonStyle.Light"
                                Variant="Variant.Flat" Click="@GoToTicketPlanning" />
            </div>
        </div>
    </Actions>
</PageHeader>

<div class="agenda-page">
    <section class="agenda-filters">
        @if (_canViewTeam)
        {
            <div class="agenda-filter-field agenda-filter-scope">
                <label>@Localize["Vista"]</label>
                <RadzenSelectBar TValue="CalendarScope" Value="_scope" Change="@ScopeChanged">
                    <Items>
                        <RadzenSelectBarItem Text="@Localize["La mia agenda"]" Icon="person" Value="CalendarScope.Mine" />
                        <RadzenSelectBarItem Text="@Localize["Agenda team"]" Icon="groups" Value="CalendarScope.Team" />
                    </Items>
                </RadzenSelectBar>
            </div>
        }
        <div class="agenda-filter-field">
            <label>@Localize["Da"]</label>
            <RadzenDatePicker TValue="DateTime?" @bind-Value="_dateFrom" DateFormat="dd/MM/yyyy" Style="width:100%" />
        </div>
        <div class="agenda-filter-field">
            <label>@Localize["A"]</label>
            <RadzenDatePicker TValue="DateTime?" @bind-Value="_dateTo" DateFormat="dd/MM/yyyy" Style="width:100%" />
        </div>
        @if (_canViewTeam && _scope == CalendarScope.Team)
        {
            <div class="agenda-filter-field agenda-filter-user">
                <label>@Localize["Responsabile"]</label>
                <RadzenDropDown TValue="string" @bind-Value="_idUser" Data="_users"
                                TextProperty="Name" ValueProperty="Id" AllowClear="true"
                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="@Localize["Tutto il team"]" Style="width:100%" />
            </div>
        }
        <div class="agenda-filter-field">
            <label>@Localize["Tipo"]</label>
            <RadzenDropDown TValue="CalendarSourceFilter" @bind-Value="_sourceFilter" Data="SourceOptions"
                            TextProperty="Text" ValueProperty="Value" Style="width:100%" />
        </div>
        <div class="agenda-filter-field">
            <label>@Localize["Stato"]</label>
            <RadzenDropDown TValue="CalendarStateFilter" @bind-Value="_stateFilter" Data="StateOptions"
                            TextProperty="Text" ValueProperty="Value" Style="width:100%" />
        </div>
        <div class="agenda-filter-field agenda-filter-search">
            <label>@Localize["Cerca"]</label>
            <input class="form-control" @bind="_searchText" @bind:event="oninput" placeholder="@Localize["Titolo, cliente, assegnatario"]" />
        </div>
        <div class="agenda-filter-actions">
            <RadzenButton Icon="search" Text="@Localize["Applica"]" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                          Disabled="@_loading" Click="@ApplyFilters" />
            <RadzenButton Icon="restart_alt" Text="@Localize["Reset"]" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Disabled="@_loading" Click="@ResetFilters" />
        </div>
    </section>

    <div class="agenda-metrics">
        <div class="agenda-metric agenda-metric-danger">
            <span>@Localize["Scadute"]</span>
            <strong>@_summary.Overdue</strong>
        </div>
        <div class="agenda-metric agenda-metric-primary">
            <span>@Localize["Oggi"]</span>
            <strong>@_summary.Today</strong>
        </div>
        <div class="agenda-metric">
            <span>@Localize["Prossimi 7 giorni"]</span>
            <strong>@_summary.NextSevenDays</strong>
        </div>
    </div>

    <div class="agenda-layout">
        <section class="agenda-list">
            <div class="agenda-section-title">@ListTitle</div>
            @if (_loading)
            {
                <Waiting></Waiting>
            }
            else if (!_filteredItems.Any())
            {
                <div class="agenda-empty">@Localize["Nessuna scadenza trovata con i filtri selezionati."]</div>
            }
            else
            {
                @foreach (var group in _groups)
                {
                    @if (group.Items.Any())
                    {
                        <div class="agenda-group">
                            <div class="agenda-group-title @group.Class">@group.Title <span>@group.Items.Count</span></div>
                            @foreach (var item in group.Items)
                            {
                                <div class="agenda-row">
                                    <span class="material-icons agenda-row-icon" style="@($"color:{item.Color}")">@Icon(item)</span>
                                    <div class="agenda-row-body">
                                        <a href="@item.Url" class="agenda-row-title">@item.Title</a>
                                        <div class="agenda-row-meta">
                                            @item.Start.ToString("dd/MM HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span> - @item.Subtitle</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.AssigneeName))
                                            {
                                                <span> - @item.AssigneeName</span>
                                            }
                                        </div>
                                    </div>
                                    @if (item.CanComplete)
                                    {
                                        <RadzenButton Icon="edit_calendar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => EditActivity(item))" title="@Localize["Modifica"]" />
                                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => Complete(item))" title="@Localize["Completa"]" />
                                    }
                                    else if (item.Source == CalendarItemSource.Ticket)
                                    {
                                        <RadzenButton Icon="more_vert" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => OpenTicketActions(item))" title="@Localize["Azioni rapide"]" />
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }
        </section>

        <section class="agenda-calendar">
            <div class="agenda-legend">
                <span><i style="background:#1976d2"></i> @Localize["Attività"]</span>
                <span><i style="background:#c62828"></i> @Localize["Scadute"]</span>
                <span><i style="background:#455a64"></i> @Localize["Ticket"]</span>
            </div>
            <RadzenScheduler @ref="_scheduler" TItem="CalendarItemDTO" Data="_filteredItems" class="agenda-scheduler"
                             StartProperty="Start" EndProperty="End" TextProperty="Title" SelectedIndex="0"
                             AppointmentSelect="OnAppointmentSelect" AppointmentRender="OnAppointmentRender">
                <RadzenMonthView />
                <RadzenWeekView />
                <RadzenDayView />
            </RadzenScheduler>
        </section>
    </div>
</div>

<style>
    .agenda-page {
        padding: 1.25rem;
    }

    .agenda-toolbar {
        align-items: center;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding: 1rem 1.25rem;
    }

    .agenda-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .agenda-metrics {
        display: grid;
        gap: .75rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 1rem;
    }

    .agenda-filters {
        align-items: end;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: 1rem;
    }

    .agenda-filter-field {
        flex: 1 1 150px;
        min-width: 140px;
    }

    .agenda-filter-search {
        flex: 2 1 220px;
    }

    .agenda-filter-field label {
        color: #4b5563;
        display: block;
        font-size: .76rem;
        font-weight: 700;
        margin-bottom: .25rem;
        text-transform: uppercase;
    }

    .agenda-filter-actions {
        align-items: center;
        display: flex;
        flex: 0 0 auto;
        gap: .5rem;
        justify-content: flex-end;
        margin-left: auto;
    }

    .agenda-filter-scope {
        flex: 1 1 100%;
        min-width: 0;
    }

    .agenda-metric {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: .85rem 1rem;
    }

    .agenda-metric span {
        color: #6b7280;
        display: block;
        font-size: .78rem;
        font-weight: 600;
    }

    .agenda-metric strong {
        color: #111827;
        display: block;
        font-size: 1.6rem;
        line-height: 1.1;
        margin-top: .2rem;
    }

    .agenda-metric-danger strong {
        color: #c62828;
    }

    .agenda-metric-primary strong {
        color: #1976d2;
    }

    .agenda-layout {
        align-items: start;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(320px, 440px) minmax(0, 1fr);
    }

    .agenda-list,
    .agenda-calendar {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
    }

    .agenda-section-title {
        color: #374151;
        font-size: .84rem;
        font-weight: 700;
        margin-bottom: .75rem;
        text-transform: uppercase;
    }

    .agenda-empty {
        color: #6b7280;
        padding: 2rem 1rem;
        text-align: center;
    }

    .agenda-group {
        margin-bottom: 1rem;
    }

    .agenda-group-title {
        align-items: center;
        display: flex;
        font-size: .78rem;
        font-weight: 800;
        gap: .4rem;
        margin-bottom: .35rem;
        text-transform: uppercase;
    }

    .agenda-group-title span {
        background: #f3f4f6;
        border-radius: 999px;
        color: #374151;
        font-size: .72rem;
        padding: .05rem .45rem;
    }

    .agenda-row {
        align-items: center;
        border-bottom: 1px solid #eef2f7;
        display: flex;
        gap: .65rem;
        min-height: 56px;
        padding: .55rem 0;
    }

    .agenda-row:last-child {
        border-bottom: 0;
    }

    .agenda-row-icon {
        flex: 0 0 auto;
        font-size: 22px;
    }

    .agenda-row-body {
        min-width: 0;
        flex: 1;
    }

    .agenda-row-title {
        color: #111827;
        display: block;
        font-weight: 700;
        overflow: hidden;
        text-decoration: none;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .agenda-row-title:hover {
        color: #1976d2;
    }

    .agenda-row-meta {
        color: #6b7280;
        font-size: .78rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .agenda-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .9rem;
        margin-bottom: .75rem;
    }

    .agenda-legend span {
        align-items: center;
        color: #6b7280;
        display: inline-flex;
        font-size: .78rem;
        gap: .35rem;
    }

    .agenda-legend i {
        border-radius: 3px;
        display: inline-block;
        height: 10px;
        width: 10px;
    }

    .agenda-scheduler {
        height: 640px;
    }

    @@media (max-width: 992px) {
        .agenda-layout,
        .agenda-metrics {
            grid-template-columns: 1fr;
        }

        .agenda-filter-field,
        .agenda-filter-search {
            flex: 1 1 100%;
        }

        .agenda-filter-actions {
            justify-content: flex-start;
            margin-left: 0;
            width: 100%;
        }

        .agenda-toolbar {
            justify-content: flex-start;
        }
    }
</style>

@code {
    private PageHeaderModel? _pageHeader;
    private RadzenScheduler<CalendarItemDTO>? _scheduler;
    private List<CalendarItemDTO> _items = new();
    private List<CalendarItemDTO> _filteredItems = new();
    private CalendarSummaryDTO _summary = new();
    private List<CalendarTeamMemberDTO> _users = new();
    private bool _loading = true;
    private bool _includeActivities = true;
    private bool _includeTickets = true;
    private bool _canViewTeam;
    private CalendarScope _scope = CalendarScope.Mine;
    private DateTime? _dateFrom = DateTime.Today.AddDays(-45);
    private DateTime? _dateTo = DateTime.Today.AddDays(120);
    private string? _idUser;
    private string? _searchText;
    private CalendarSourceFilter _sourceFilter = CalendarSourceFilter.All;
    private CalendarStateFilter _stateFilter = CalendarStateFilter.Open;

    private record Group(string Title, string Class, List<CalendarItemDTO> Items);
    private List<Group> _groups = new();

    private enum CalendarSourceFilter
    {
        All,
        Activities,
        Tickets
    }

    private enum CalendarStateFilter
    {
        Open,
        Overdue,
        Completed,
        All
    }

    private record FilterOption<T>(string Text, T Value);

    private List<FilterOption<CalendarSourceFilter>> SourceOptions => new()
    {
        new(Localize["Tutto"], CalendarSourceFilter.All),
        new(Localize["Attività"], CalendarSourceFilter.Activities),
        new(Localize["Ticket"], CalendarSourceFilter.Tickets)
    };

    private List<FilterOption<CalendarStateFilter>> StateOptions => new()
    {
        new(Localize["Aperte"], CalendarStateFilter.Open),
        new(Localize["Scadute"], CalendarStateFilter.Overdue),
        new(Localize["Completate"], CalendarStateFilter.Completed),
        new(Localize["Tutte"], CalendarStateFilter.All)
    };

    private string ListTitle => _scope == CalendarScope.Mine
        ? Localize["Le mie scadenze"]
        : _idUser == null ? Localize["Scadenze del team"] : Localize["Scadenze del responsabile"];

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;

        SyncSourceToggles();

        var agenda = await CalendarService.GetAgendaAsync(new CalendarFilter
        {
            DateFrom = _dateFrom,
            DateTo = _dateTo,
            IdUser = _idUser,
            Scope = _scope == CalendarScope.Team && !string.IsNullOrWhiteSpace(_idUser)
                ? CalendarScope.User
                : _scope,
            IncludeActivities = _includeActivities,
            IncludeTickets = _includeTickets
        });

        if (!string.IsNullOrWhiteSpace(agenda.ErrorMessage))
        {
            _items = new List<CalendarItemDTO>();
            _filteredItems = new List<CalendarItemDTO>();
            _groups = new List<Group>();
            _summary = new CalendarSummaryDTO();
            _loading = false;
            Notification.Notify(NotificationSeverity.Error, Localize["Agenda"], agenda.ErrorMessage);
            return;
        }

        _canViewTeam = agenda.CanViewTeam;
        _users = agenda.TeamMembers;
        if (!_canViewTeam)
        {
            _scope = CalendarScope.Mine;
            _idUser = null;
        }

        _items = agenda.Items;
        ApplyClientFilters();
        BuildGroups();

        _loading = false;
    }

    private void ApplyClientFilters()
    {
        var now = DateTime.Now;
        var items = _items.AsEnumerable();

        items = _stateFilter switch
        {
            CalendarStateFilter.Open => items.Where(i => !i.IsCompleted),
            CalendarStateFilter.Overdue => items.Where(i => !i.IsCompleted && i.Start < now),
            CalendarStateFilter.Completed => items.Where(i => i.IsCompleted),
            _ => items
        };

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var text = _searchText.Trim();
            items = items.Where(i =>
                Contains(i.Title, text) ||
                Contains(i.Subtitle, text) ||
                Contains(i.AssigneeName, text) ||
                Contains(i.StateText, text));
        }

        _filteredItems = items
            .OrderBy(i => i.Start)
            .ThenBy(i => i.Source)
            .ThenBy(i => i.SourceId)
            .ToList();

        _summary = BuildSummary(_filteredItems);
    }

    private void BuildGroups()
    {
        var now = DateTime.Now;
        var todayEnd = DateTime.Today.AddDays(1);

        _groups = new List<Group>
        {
            new(Localize["Scadute"], "text-danger", _filteredItems.Where(i => !i.IsCompleted && i.Start < now).OrderBy(i => i.Start).ToList()),
            new(Localize["Oggi"], "text-primary", _filteredItems.Where(i => !i.IsCompleted && i.Start >= now && i.Start < todayEnd).OrderBy(i => i.Start).ToList()),
            new(Localize["Prossimi giorni"], "text-body", _filteredItems.Where(i => !i.IsCompleted && i.Start >= todayEnd).OrderBy(i => i.Start).ToList()),
            new(Localize["Completate"], "text-success", _filteredItems.Where(i => i.IsCompleted).OrderByDescending(i => i.Start).ToList()),
        };
    }

    private void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<CalendarItemDTO> args)
    {
        args.Attributes["style"] = $"background: {args.Data.Color};";
    }

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<CalendarItemDTO> args)
    {
        if (args.Data.Source == CalendarItemSource.Ticket)
        {
            _ = OpenTicketActions(args.Data);
            return;
        }

        if (args.Data.Source == CalendarItemSource.Activity && args.Data.CanComplete)
        {
            _ = EditActivity(args.Data);
            return;
        }

        if (!string.IsNullOrEmpty(args.Data.Url))
            Nav.NavigateTo(args.Data.Url);
    }

    private async Task OpenTicketActions(CalendarItemDTO item)
    {
        if (item.Source != CalendarItemSource.Ticket)
            return;

        var changed = await DialogService.OpenAsync<TicketQuickActionsDialog>(
            $"Ticket #{item.SourceId}",
            new Dictionary<string, object?> { ["Item"] = item },
            new DialogOptions
            {
                Width = "560px",
                Height = "auto",
                Resizable = false,
                Draggable = true,
                CloseDialogOnEsc = true
            });

        if (changed == true)
            await Load();
    }

    private async Task Complete(CalendarItemDTO item)
    {
        if (item.Source != CalendarItemSource.Activity)
            return;

        ActivityCompletionRequest? completion = null;
        if (item.ActivityKind.HasValue && RequiresCompletionDetails(item.ActivityKind.Value))
        {
            completion = await DialogService.OpenAsync<ActivityCompleteDialog>(
                Localize["Completa attività"],
                new Dictionary<string, object?>
                {
                    ["Kind"] = item.ActivityKind.Value,
                    ["Subject"] = item.Title,
                    ["DefaultAssigneeId"] = item.IdAssignee
                },
                new DialogOptions
                {
                    Width = "680px",
                    Height = "auto",
                    Resizable = false,
                    Draggable = true
                }) as ActivityCompletionRequest;

            if (completion == null)
                return;
        }

        var resp = await ActivityService.CompleteAsync(item.SourceId, completion);
        if (resp.State)
            await Load();
        else
            Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"]);
    }

    private async Task NewActivity()
    {
        var saved = await DialogService.OpenAsync<ActivityAgendaDialog>(
            Localize["Nuova attività"],
            new Dictionary<string, object?>
            {
                ["DefaultDueDate"] = DateTime.Now.AddHours(1),
                ["DefaultAssigneeId"] = _idUser
            },
            ActivityDialogOptions());

        if (saved == true)
            await Load();
    }

    private async Task EditActivity(CalendarItemDTO item)
    {
        if (item.Source != CalendarItemSource.Activity)
            return;

        var saved = await DialogService.OpenAsync<ActivityAgendaDialog>(
            Localize["Modifica attività"],
            new Dictionary<string, object?>
            {
                ["ActivityId"] = item.SourceId
            },
            ActivityDialogOptions());

        if (saved == true)
            await Load();
    }

    private static DialogOptions ActivityDialogOptions()
    {
        return new DialogOptions
        {
            Width = "920px",
            Height = "auto",
            Resizable = true,
            Draggable = true
        };
    }

    private async Task ToggleActivities()
    {
        _includeActivities = !_includeActivities;
        if (!_includeActivities && !_includeTickets)
            _includeTickets = true;
        SyncSourceFilter();
        await Load();
    }

    private async Task ToggleTickets()
    {
        _includeTickets = !_includeTickets;
        if (!_includeActivities && !_includeTickets)
            _includeActivities = true;
        SyncSourceFilter();
        await Load();
    }

    private async Task ApplyFilters()
    {
        if (_dateFrom.HasValue && _dateTo.HasValue && _dateFrom.Value.Date > _dateTo.Value.Date)
        {
            Notification.Notify(NotificationSeverity.Warning, Localize["Filtri"], Localize["La data iniziale non può essere successiva alla data finale"]);
            return;
        }

        await Load();
    }

    private async Task ScopeChanged(CalendarScope scope)
    {
        _scope = scope;
        _idUser = null;
        await Load();
    }

    private async Task ResetFilters()
    {
        _dateFrom = DateTime.Today.AddDays(-45);
        _dateTo = DateTime.Today.AddDays(120);
        _idUser = null;
        _scope = CalendarScope.Mine;
        _searchText = null;
        _sourceFilter = CalendarSourceFilter.All;
        _stateFilter = CalendarStateFilter.Open;
        _includeActivities = true;
        _includeTickets = true;

        await Load();
    }

    private void SyncSourceToggles()
    {
        (_includeActivities, _includeTickets) = _sourceFilter switch
        {
            CalendarSourceFilter.Activities => (true, false),
            CalendarSourceFilter.Tickets => (false, true),
            _ => (true, true)
        };
    }

    private void SyncSourceFilter()
    {
        _sourceFilter = (_includeActivities, _includeTickets) switch
        {
            (true, false) => CalendarSourceFilter.Activities,
            (false, true) => CalendarSourceFilter.Tickets,
            _ => CalendarSourceFilter.All
        };
    }

    private static CalendarSummaryDTO BuildSummary(List<CalendarItemDTO> items)
    {
        var now = DateTime.Now;
        var todayEnd = DateTime.Today.AddDays(1);
        var weekEnd = DateTime.Today.AddDays(8);

        return new CalendarSummaryDTO
        {
            Overdue = items.Count(i => !i.IsCompleted && i.Start < now),
            Today = items.Count(i => !i.IsCompleted && i.Start >= now && i.Start < todayEnd),
            NextSevenDays = items.Count(i => !i.IsCompleted && i.Start >= todayEnd && i.Start < weekEnd)
        };
    }

    private static bool Contains(string? value, string text)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(text, StringComparison.OrdinalIgnoreCase);
    }

    private void GoToTicketPlanning()
    {
        Nav.NavigateTo("/Tickets/Schedule");
    }

    private static string Icon(CalendarItemDTO item)
    {
        if (item.Source == CalendarItemSource.Ticket)
            return "confirmation_number";

        return item.ActivityKind.HasValue ? ActivityUi.Icon(item.ActivityKind.Value) : "event";
    }

    private static bool RequiresCompletionDetails(ActivityKind kind)
        => kind is ActivityKind.Meeting or ActivityKind.Call or ActivityKind.Task;
}
