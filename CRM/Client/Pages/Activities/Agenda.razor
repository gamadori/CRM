@page "/Agenda"
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Client.Helpers
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IActivityService ActivityService
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject NotificationService Notification

<PageHeader Model="_pageHeader"></PageHeader>

<div class="row g-2 mb-3">
    <div class="col-auto"><div class="card border-0 shadow-sm"><div class="card-body py-2 px-3">
        <div class="small text-muted">Scadute</div><div class="fs-4 text-danger">@_overdue</div>
    </div></div></div>
    <div class="col-auto"><div class="card border-0 shadow-sm"><div class="card-body py-2 px-3">
        <div class="small text-muted">Oggi</div><div class="fs-4 text-primary">@_today</div>
    </div></div></div>
    <div class="col-auto"><div class="card border-0 shadow-sm"><div class="card-body py-2 px-3">
        <div class="small text-muted">Prossimi 7 giorni</div><div class="fs-4">@_week</div>
    </div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <h6 class="text-muted">Le mie scadenze</h6>
        @if (_items == null)
        {
            <Waiting></Waiting>
        }
        else if (!_items.Any())
        {
            <div class="text-muted text-center py-4">Nessuna attività in scadenza assegnata a te.</div>
        }
        else
        {
            @foreach (var group in _groups)
            {
                @if (group.Items.Any())
                {
                    <div class="mb-3">
                        <div class="fw-bold small text-uppercase @group.Class mb-1">@group.Title (@group.Items.Count)</div>
                        @foreach (var a in group.Items)
                        {
                            <div class="d-flex align-items-center gap-2 border-bottom py-2">
                                <span class="material-icons" style="@($"color:{ActivityUi.Color(a.Kind)}")">@ActivityUi.Icon(a.Kind)</span>
                                <div class="flex-grow-1">
                                    <a href="@EntityUrl(a)" class="text-decoration-none fw-semibold">@a.Subject</a>
                                    <div class="text-muted" style="font-size:0.78rem">
                                        @a.DueDate?.ToString("dd/MM HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(a.EntityName)) { <span> · @a.EntityName</span> }
                                    </div>
                                </div>
                                @if (a.Permits.Edit())
                                {
                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall"
                                                  Click="@(() => Complete(a))" title="Completa" />
                                }
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
    <div class="col-lg-7">
        <RadzenScheduler @ref="_scheduler" TItem="AgendaItem" Data="_appointments" style="height: 620px;"
                         StartProperty="Start" EndProperty="End" TextProperty="Text" SelectedIndex="0"
                         AppointmentSelect="OnAppointmentSelect" AppointmentRender="OnAppointmentRender">
            <RadzenMonthView />
            <RadzenWeekView />
            <RadzenDayView />
        </RadzenScheduler>
    </div>
</div>

@code {
    private PageHeaderModel? _pageHeader;
    private RadzenScheduler<AgendaItem>? _scheduler;
    private List<ActivityDTO>? _items;
    private List<AgendaItem> _appointments = new();
    private int _overdue, _today, _week;

    public class AgendaItem
    {
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public string Text { get; set; } = string.Empty;
        public ActivityDTO Activity { get; set; } = default!;
    }

    private record Group(string Title, string Class, List<ActivityDTO> Items);
    private List<Group> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();
        await Load();
    }

    private async Task Load()
    {
        _items = await ActivityService.GetMyAgendaAsync();

        var now = DateTime.Now;
        var todayEnd = DateTime.Today.AddDays(1);
        var weekEnd = DateTime.Today.AddDays(8);

        _overdue = _items.Count(a => a.DueDate < now);
        _today = _items.Count(a => a.DueDate >= now && a.DueDate < todayEnd);
        _week = _items.Count(a => a.DueDate >= todayEnd && a.DueDate < weekEnd);

        _groups = new List<Group>
        {
            new("Scadute", "text-danger", _items.Where(a => a.DueDate < now).OrderBy(a => a.DueDate).ToList()),
            new("Oggi", "text-primary", _items.Where(a => a.DueDate >= now && a.DueDate < todayEnd).OrderBy(a => a.DueDate).ToList()),
            new("Prossimi giorni", "text-body", _items.Where(a => a.DueDate >= todayEnd).OrderBy(a => a.DueDate).ToList()),
        };

        _appointments = _items.Where(a => a.DueDate != null).Select(a => new AgendaItem
        {
            Start = a.DueDate!.Value,
            End = a.DueDate.Value.AddMinutes(30),
            Text = a.Subject,
            Activity = a
        }).ToList();
    }

    private void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<AgendaItem> args)
    {
        var a = args.Data.Activity;
        if (a.DueDate < DateTime.Now)
            args.Attributes["style"] = "background: #c62828;";
        else
            args.Attributes["style"] = $"background: {ActivityUi.Color(a.Kind)};";
    }

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<AgendaItem> args)
    {
        var url = EntityUrl(args.Data.Activity);
        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url);
    }

    private async Task Complete(ActivityDTO a)
    {
        var resp = await ActivityService.CompleteAsync(a.Id);
        if (resp.State) await Load();
        else Notification.Notify(NotificationSeverity.Error, "Errore", resp.Message ?? "Operazione fallita");
    }

    private static string EntityUrl(ActivityDTO a) => a.EntityType switch
    {
        ActivityEntityType.Deal => $"/{ConstHelper.ClientDealPath}/{a.EntityId}",
        ActivityEntityType.Company => $"/{ConstHelper.ClientCompaniesPath}/{a.EntityId}",
        ActivityEntityType.Contact => $"/{ConstHelper.ClientContactsPath}/{a.EntityId}",
        _ => string.Empty
    };
}
