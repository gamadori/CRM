@using CRM.Client.Services
@using CRM.Shared.DTOs
@inject IProductCatalogService ProductCatalogService

@if (Images.Any())
{
    <section class="catalog-panel">
        <div class="catalog-panel-title">
            <div>
                <span class="material-icons">photo_library</span>
                <h3>Immagini</h3>
            </div>
            <small>@Images.Count elementi</small>
        </div>

        <div class="catalog-image-gallery">
            @foreach (var image in Images)
            {
                <figure class="catalog-image-tile @(image.IsCover ? "featured" : "")">
                    <button type="button" class="catalog-image-button" @onclick="@(() => OpenPreview(image))">
                        <img src="@ProductCatalogService.GetAssetFileUrl(image.Id)" alt="@AssetTitle(image)" loading="lazy" />
                    </button>
                    <figcaption>
                        <strong>@AssetTitle(image)</strong>
                        @if (!string.IsNullOrWhiteSpace(image.Description))
                        {
                            <span>@image.Description</span>
                        }
                    </figcaption>
                </figure>
            }
        </div>
    </section>
}

@if (_previewImage != null)
{
    <div class="catalog-lightbox" @onclick="ClosePreview">
        <div class="catalog-lightbox-panel" @onclick:stopPropagation="true">
            <div class="catalog-lightbox-header">
                <strong>@AssetTitle(_previewImage)</strong>
                <button type="button" @onclick="ClosePreview">
                    <span class="material-icons">close</span>
                </button>
            </div>
            <img src="@ProductCatalogService.GetAssetFileUrl(_previewImage.Id)" alt="@AssetTitle(_previewImage)" />
        </div>
    </div>
}

@code {
    private ProductCatalogAssetDTO? _previewImage;

    [Parameter]
    public List<ProductCatalogAssetDTO> Images { get; set; } = new();

    private void OpenPreview(ProductCatalogAssetDTO image)
    {
        _previewImage = image;
    }

    private void ClosePreview()
    {
        _previewImage = null;
    }

    private static string AssetTitle(ProductCatalogAssetDTO asset)
    {
        if (!string.IsNullOrWhiteSpace(asset.Title))
        {
            return asset.Title;
        }

        return string.IsNullOrWhiteSpace(asset.FileName) ? "Immagine catalogo" : asset.FileName;
    }
}
