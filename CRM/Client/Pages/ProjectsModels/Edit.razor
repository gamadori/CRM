@page "/ProjectsModels/New"
@page "/ProjectsModels/{Id:int}/Edit"

<h3>Progetto</h3>
<hr />

@if (_task == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="@_task" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <DisplayName For="@(()=>_task.Name)" />
                    <input id="Name" class="form-control" @bind-value="@_task.Name" />
                    <ValidationMessage For="@(() => _task.Name)" />
                </div>
                <div class="mb-3">
                    <DisplayName For="@(()=>_task.Description)" />
                    <input id="Description" class="form-control" @bind-value="@_task.Description" />
                    <ValidationMessage For="@(() => _task.Description)" />
                </div>
                               <BlazorButton Template="TemplateButton.Submit" Text="Salva" />
                <BlazorButton Template="TemplateButton.Cancel" OnClick="Annulla" Text="Annulla" />

            </div>
        </div>
    </EditForm>
}