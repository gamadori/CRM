@page "/ProjectsModels/Details/{Id:int}"

<BlazorHeader Header="Dettagli Modello Progetto" />

@if (_project == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="folder_special" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _project.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="description">
                <LabelContent><DisplayName For="@(() => _project.Description)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.Description</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person">
                <LabelContent><DisplayName For="@(() => _project.IdUser)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.IdUser</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="Lista Modelli Progetti" OnClick="Annulla" />
                <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
            </div>
        </div>
    </div>
}}