@page "/ProjectsModels/Details/{Id:int}"

<h3>Dettagli Progetto</h3>
<hr />
@if (_project == null)
{
    <Waiting></Waiting>
}
else
{

    <dl class="row">
        <dt class="col-sm-2">
            <DisplayName For="@(()=>_project.Name)" />
        </dt>
        <dd class="col-sm-10">
            <span>@_project.Name</span>
        </dd>

        <dt class="col-sm-2">
            <DisplayName For="@(()=>_project.Description)" />
        </dt>
        <dd class="col-sm-10">
            <span>@_project.Description</span>
        </dd>

        <dt class="col-sm-2">
            <DisplayName For="@(()=>_project.IdUser)" />
        </dt>
        <dd class="col-sm-10">
            <span>@_project.IdUser</span>
        </dd>

    </dl>
    <div>
        <BlazorButton Template="TemplateButton.Back" Text="Lista Tipo Prodotti" OnClick="Annulla" />
        <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />

    </div>
}