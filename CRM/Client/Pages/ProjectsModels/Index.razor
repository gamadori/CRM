
@page "/ProjectsModels"
@page "/ProjectsModels/Index"

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor

<h3>Modelli Progetti</h3>
<hr />
<div class="btn-toolbar" role="toolbar" aria-label="Comandi">
    <div class="btn-group mr-2" role="group" aria-label="First group">
        <BlazorButton Template="TemplateButton.New" OnClick="NewItem"></BlazorButton>
    </div>

</div>
<SfGrid @ref="GridProjects" TValue="ProjectModel" AllowPaging="true" AllowSorting="true" AllowFiltering="true">

    <GridEvents OnActionBegin="ActionBegin" CommandClicked="CommandClickHandler" TValue="ProjectModel" ></GridEvents>
    
    <SfDataManager Url="@ConstHelper.ProjectModelsPath" Adaptor="Adaptors.WebApiAdaptor"></SfDataManager>

    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
    <GridPageSettings PageSize="10"></GridPageSettings>

    <GridColumns>
        
        <GridColumn Field=@nameof(ProjectModel.Name) HeaderText="Nome"></GridColumn>
        <GridColumn Field=@nameof(ProjectModel.Description) HeaderText="Descrizione"></GridColumn>
        <GridColumn HeaderText="Navigation" Width="180">
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.None"
                                   ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-details", CssClass = "e-flat"})"
                                   Title="Dettagli" ID="details"></GridCommandColumn>

                <GridCommandColumn Type="CommandButtonType.Edit" Title="Edit"
                                   ButtonOption="@(new CommandButtonOptions()
                                    {
                                        IconCss = "e-icons e-edit"
                                    })" />

                <GridCommandColumn Type="CommandButtonType.Delete" Title="Elimina"
                                   ButtonOption="@(new CommandButtonOptions()
                                    {
                                        IconCss = "e-icons e-delete",
                                        CssClass = "e-flat"
                                    })" />

                <GridCommandColumn Type="CommandButtonType.None"
                                   ButtonOption="@(new CommandButtonOptions() {  IconCss="e-icons e-3DBar2", CssClass = "e-flat"})"
                                   Title="Gantt" ID="gantt"></GridCommandColumn>


            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>
<MsgBoxConfirm Id="dlgDelete" LabelBtnNo="No" LabelBtnYes="Yes" Header="Eliminazione del Progetto" Message="@_messageDelete" OnClick="Delete"></MsgBoxConfirm>
