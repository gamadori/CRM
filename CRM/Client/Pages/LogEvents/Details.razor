@page "/LogEvents/{Id:int}/Details"

<BlazorHeader Header="Dettagli Evento" />

@if (_logEvent == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="event" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _logEvent.DateEvent)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_logEvent.DateEvent</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="widgets">
                <LabelContent><DisplayName For="@(() => _logEvent.Module)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_logEvent.Module</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="code">
                <LabelContent><DisplayName For="@(() => _logEvent.Subroutine)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_logEvent.Subroutine</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person">
                <LabelContent><DisplayName For="@(() => _logEvent.User)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_logEvent.User</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="info">
                <LabelContent><DisplayName For="@(() => _logEvent.EventType)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_logEvent.EventType</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="message">
                <LabelContent>Messaggio</LabelContent>
                <ChildContent><p class="note-report mb-0">@_logEvent.Message</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="Lista Eventi" OnClick="Annulla" />
            </div>
        </div>
    </div>
}