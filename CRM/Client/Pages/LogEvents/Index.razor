@page "/Settings/LogEvents"

@if (_items == null)
{
    <Waiting></Waiting>
    return;
}
<PageHeader Model="@_pageHeader">
</PageHeader>

<RadzenDataGrid @ref="_grdLogs" IsLoading="@_isLoading" Count="@_totalCount" Responsive=true Data="@_items" LoadData="@LoadDataAsync" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="LogEvent" AllowAlternatingRows=false
                RowRender="@OnRowRender">

    <HeaderTemplate>
        <div class="d-flex align-items-center gap-5">
            <RedGTextBox @bind-Value="_searchText" Label="@Localize["search..."]" @oninput="@(args => OnSearchTextChanged(args?.Value?.ToString()))" Style="width: 300px; margin-left: 10px;">
                <End>
                    <RadzenIcon Icon="search" Style="color: #9e9e9e; font-size: 20px;" />
                </End>
            </RedGTextBox>

            <RedGSelectEnumGeneric TEnum="LogEvent.EventsTypes" Change=OnEventTypeChanged @bind-Value="@_eventType" Label="@Localize["EventTypes"]">
                 <End>
                    <RadzenIcon Icon="search" Style="color: #9e9e9e; font-size: 20px;" />
                </End>
            </RedGSelectEnumGeneric>
           
        </div>
            
    </HeaderTemplate>

    <Columns>
       
        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.DateEvent)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.DateEvent), typeof(LogEvent))  />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Module)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.Module), typeof(LogEvent)) />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Subroutine)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.Subroutine), typeof(LogEvent)) />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Subroutine)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.EventType), typeof(LogEvent))>
            <Template Context="data">
                @Localize[$"EventType.{data.EventType}"]
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item" TItem="LogEvent" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
            <Template Context="item">

                <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="format_list_bulleted" Size="Radzen.ButtonSize.Medium" title="Edit" Click="@(args => OnDetails(item.Id))">
                </RadzenButton>
                
            </Template>
        </RadzenDataGridColumn>

    </Columns>
</RadzenDataGrid>


