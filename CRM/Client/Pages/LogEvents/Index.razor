@page "/Settings/LogEvents"

@if (_items == null)
{
    <Waiting></Waiting>
    return;
}
<PageHeader Model="@_pageHeader">
</PageHeader>

<RadzenDataGrid class="log-events-grid" @ref="_grdLogs" IsLoading="@_isLoading" Count="@_totalCount" Responsive=true Data="@_items" LoadData="@LoadDataAsync" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="LogEvent" AllowAlternatingRows=false
                RowRender="@OnRowRender">

    <HeaderTemplate>
        <div class="d-flex align-items-center gap-5">
            <RedGTextBox @bind-Value="_searchText" Label="@Localize["search..."]" @oninput="@(args => OnSearchTextChanged(args?.Value?.ToString()))" Style="width: 300px; margin-left: 10px;">
                <End>
                    <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                </End>
            </RedGTextBox>

            <RedGSelectEnumGeneric TEnum="LogEvent.EventsTypes" Change=OnEventTypeChanged @bind-Value="@_eventType" Label="@Localize["EventTypes"]">
                 <End>
                    <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                </End>
            </RedGSelectEnumGeneric>
           
        </div>
            
    </HeaderTemplate>

    <Columns>
       
        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.DateEvent)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.DateEvent), typeof(LogEvent))  />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Module)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.Module), typeof(LogEvent)) />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Subroutine)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.Subroutine), typeof(LogEvent)) />

        <RadzenDataGridColumn TItem="LogEvent" Property="@nameof(LogEvent.Subroutine)" Title=@TranslateHelper.GetDisplayName(nameof(LogEvent.EventType), typeof(LogEvent))>
            <Template Context="data">
                @Localize[$"EventType.{data.EventType}"]
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item" TItem="LogEvent" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
            <Template Context="item">

                <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="format_list_bulleted" Size="Radzen.ButtonSize.Medium" title="Edit" Click="@(args => OnDetails(item.Id))">
                </RadzenButton>
                
            </Template>
        </RadzenDataGridColumn>

    </Columns>
</RadzenDataGrid>

<style>
    .log-events-grid tr.log-event-info > td {
        color: #15528a !important;
        background: #e3f2fd !important;
    }

    .log-events-grid tr.log-event-warning > td {
        color: #8f3d00 !important;
        background: #fff3e0 !important;
    }

    .log-events-grid tr.log-event-error > td {
        color: #a61f2b !important;
        background: #ffebee !important;
    }

    .log-events-grid tr.log-event-permits > td {
        color: #662580 !important;
        background: #f3e5f5 !important;
    }

    body.dark-theme .log-events-grid tr.log-event-info > td {
        color: #c7e3ff !important;
        background: #172a3b !important;
        border-color: #304b62 !important;
    }

    body.dark-theme .log-events-grid tr.log-event-warning > td {
        color: #ffe0a3 !important;
        background: #322815 !important;
        border-color: #5e4b24 !important;
    }

    body.dark-theme .log-events-grid tr.log-event-error > td {
        color: #ffc4cb !important;
        background: #351d22 !important;
        border-color: #65313b !important;
    }

    body.dark-theme .log-events-grid tr.log-event-permits > td {
        color: #e9c9fb !important;
        background: #2e2135 !important;
        border-color: #594064 !important;
    }

    body.dark-theme .log-events-grid tr.log-event-info:hover > td {
        background: #1d354a !important;
    }

    body.dark-theme .log-events-grid tr.log-event-warning:hover > td {
        background: #3d311a !important;
    }

    body.dark-theme .log-events-grid tr.log-event-error:hover > td {
        background: #42242a !important;
    }

    body.dark-theme .log-events-grid tr.log-event-permits:hover > td {
        background: #392940 !important;
    }
</style>


