@page "/Settings/InterventionTypeLanguages/{IdInterventionType:int}"
@page "/Settings/InterventionTypeLanguages/Index/{IdInterventionType:int}"
@using CRM.Shared.DTOs

<PageHeader></PageHeader>

@if (_interventionTypeLangs != null && _languages != null)
{
<RadzenDataGrid @ref="_interventionGrid" AllowFiltering="true" AllowPaging="true" PageSize="5" AllowSorting="true" Responsive=true EditMode="DataGridEditMode.Single" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    Data="_interventionTypeLangs" TItem="InterventionTypeLangDTO" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" IsLoading=@_isLoading>
        <HeaderTemplate>
            <RedGButton RGButtonType="RGButtonType.New" Click="@InsertRow"></RedGButton>
        </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="InterventionTypeLangDTO" Property="Id" Title="ID" Width="120px" />
        
            <RadzenDataGridColumn TItem="InterventionTypeLangDTO" Property="Language.Name" Title="@Localize["Lingua"]" Width="220px">
            <Template Context="item">
                @if (item.Language != null)
                {
                    
                    <RadzenImage Path="@(GetFlag(item.IdLanguage))" style="width: 32px; height: 32px; border-radius: 16px; margin-right: 6px;" />
                    
                    @item?.Language
                }
            </Template>
            <EditTemplate Context="item">
                <RadzenDropDown @bind-Value="item.IdLanguage" Data="@_languages" ValueProperty="Id"  Style="width:100%; display: block;">
                    <Template>
                        <RadzenImage Path="@((context as Language).Flag)" style="width: 20px; height: 20px; border-radius: 16px; margin-right: 6px;" />
                         @((context as Language).Name)
                    </Template>
                </RadzenDropDown>
            </EditTemplate>
        </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="InterventionTypeLangDTO" Property="@nameof(InterventionTypeLanguage.Name)" Title="@Localize["Nome"]">
            <EditTemplate Context="item">
                <RadzenTextBox @bind-Value="item.Name" Style="width:100%; display: block" Name="Name" />
            </EditTemplate>
        </RadzenDataGridColumn>
       
        <RadzenDataGridColumn TItem="InterventionTypeLangDTO" Context="interventions" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px">
            <Template Context="item">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(item))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="item">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@((args) => SaveRow(item))">
                </RadzenButton>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@((args) => CancelEdit(item))">
                </RadzenButton>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InterventionTypeLangDTO" Context="interventions" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px">
            <Template Context="order">
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium" Class="m-1" Click="@(args => DeleteRow(order))" @onclick:stopPropagation="true">
                </RadzenButton>
            </Template>
            <EditTemplate Context="order">
               
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}

