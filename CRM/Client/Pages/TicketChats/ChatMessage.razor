<div class="row m-3">
    

    @if (TicketChat.TypeMessage == TypeMessage.Receved)
    {
        <div class="alert alert-info me-auto col-auto" role="alert" style="max-width:75%;">
            <div class="d-flex justify-content-between mb-3">
                <RedGAvatar IdUser="@TicketChat.IdUser"></RedGAvatar>
                <h6 class="alert-heading my-auto ms-2" style="color: black;">@TicketChat.UserName</h6>
            </div>
            @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
            {
                <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
            }
            @if (TicketChat.AttachmentFileId.HasValue)
            {
                <div class="mt-1">
                    <a href="/api/AttachmentFiles/@TicketChat.AttachmentFileId/download" target="_blank" class="d-inline-flex align-items-center gap-1 text-decoration-none">
                        <span class="material-icons" style="font-size:18px;">attach_file</span>
                        <span>@TicketChat.AttachmentFileName</span>
                    </a>
                </div>
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }
    else if (TicketChat.TypeMessage == TypeMessage.Sended)
    {
        <div class="alert alert-success ms-auto col-auto" style="max-width:75%;" role="alert">
            <h6 class="alert-heading" style="color: black;">@TicketChat.UserName</h6>
            @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
            {
                <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
            }
            @if (TicketChat.AttachmentFileId.HasValue)
            {
                <div class="mt-1">
                    <a href="/api/AttachmentFiles/@TicketChat.AttachmentFileId/download" target="_blank" class="d-inline-flex align-items-center gap-1 text-decoration-none text-success">
                        <span class="material-icons" style="font-size:18px;">attach_file</span>
                        <span>@TicketChat.AttachmentFileName</span>
                    </a>
                </div>
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }
    else if (TicketChat.TypeMessage == TypeMessage.TicketMsg)
    {
        <div class="alert alert-warning mx-auto col-auto" role="alert">
            <h6 class="alert-heading" style="color: black;">@TicketChat.UserName</h6>
            @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
            {
                <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
            }
            @if (TicketChat.AttachmentFileId.HasValue)
            {
                <div class="mt-1">
                    <a href="/api/AttachmentFiles/@TicketChat.AttachmentFileId/download" target="_blank" class="d-inline-flex align-items-center gap-1 text-decoration-none text-warning">
                        <span class="material-icons" style="font-size:18px;">attach_file</span>
                        <span>@TicketChat.AttachmentFileName</span>
                    </a>
                </div>
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }
   
    
</div>