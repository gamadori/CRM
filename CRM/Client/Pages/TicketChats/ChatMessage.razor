<div class="row m-3">


    @if (TicketChat.TypeMessage == TypeMessage.Receved)
    {
        <div class="alert alert-info me-auto col-auto" role="alert" style="max-width:75%;">
            <div class="d-flex justify-content-between mb-3">
                <RedGAvatar IdUser="@TicketChat.IdUser"></RedGAvatar>
                <h6 class="alert-heading my-auto ms-2" style="color: inherit;">@TicketChat.UserName</h6>
            </div>
            @if (TicketChat.Deleted)
            {
                @DeletedContent
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
                {
                    <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
                }
                @if (TicketChat.AttachmentFileId.HasValue)
                {
                    <div class="mt-1">
                        <button type="button" class="btn btn-link p-0 d-inline-flex align-items-center gap-1 text-decoration-none" @onclick="DownloadFile" disabled="@_downloading">
                            <span class="material-icons" style="font-size:18px;">@(_downloading ? "hourglass_empty" : "attach_file")</span>
                            <span>@TicketChat.AttachmentFileName</span>
                        </button>
                    </div>
                }
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }
    else if (TicketChat.TypeMessage == TypeMessage.Sended)
    {
        <div class="alert alert-success ms-auto col-auto" style="max-width:75%;" role="alert">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="alert-heading mb-0" style="color: inherit;">@TicketChat.UserName</h6>
                @if (TicketChat.CanDelete)
                {
                    <button type="button" class="btn btn-link p-0 ms-2 text-danger" title="@Localize["Elimina messaggio"]"
                            @onclick="DeleteMessage" disabled="@_deleting">
                        <span class="material-icons" style="font-size:18px;">@(_deleting ? "hourglass_empty" : "delete")</span>
                    </button>
                }
            </div>
            @if (TicketChat.Deleted)
            {
                @DeletedContent
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
                {
                    <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
                }
                @if (TicketChat.AttachmentFileId.HasValue)
                {
                    <div class="mt-1">
                        <button type="button" class="btn btn-link p-0 d-inline-flex align-items-center gap-1 text-decoration-none text-success" @onclick="DownloadFile" disabled="@_downloading">
                            <span class="material-icons" style="font-size:18px;">@(_downloading ? "hourglass_empty" : "attach_file")</span>
                            <span>@TicketChat.AttachmentFileName</span>
                        </button>
                    </div>
                }
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }
    else if (TicketChat.TypeMessage == TypeMessage.TicketMsg)
    {
        <div class="alert alert-warning mx-auto col-auto" role="alert">
            <h6 class="alert-heading" style="color: inherit;">@TicketChat.UserName</h6>
            @if (!string.IsNullOrWhiteSpace(TicketChat.Message))
            {
                <p class="msg-chat"><pre>@TicketChat.Message</pre></p>
            }
            @if (TicketChat.AttachmentFileId.HasValue)
            {
                <div class="mt-1">
                    <button type="button" class="btn btn-link p-0 d-inline-flex align-items-center gap-1 text-decoration-none text-warning" @onclick="DownloadFile" disabled="@_downloading">
                        <span class="material-icons" style="font-size:18px;">@(_downloading ? "hourglass_empty" : "attach_file")</span>
                        <span>@TicketChat.AttachmentFileName</span>
                    </button>
                </div>
            }
            <hr>
            <p class="mb-0"><small>@TicketChat.Date.ToString("g")</small></p>
        </div>
    }


</div>

@code {
    private RenderFragment DeletedContent => __builder =>
    {
        <p class="msg-chat msg-deleted fst-italic text-muted mb-0 d-inline-flex align-items-center gap-1">
            <span class="material-icons" style="font-size:16px;">do_not_disturb</span>
            <span>@Localize["Questo messaggio è stato eliminato"]</span>
        </p>
    };
}
