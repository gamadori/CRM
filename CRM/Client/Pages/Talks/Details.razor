@page "/AccessoryTypes/Details/{Id:int}"
@using CRM.Shared.Helper

<BlazorHeader Header="@_header"></BlazorHeader>

@if (_talk == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="chat" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _talk.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="event">
                <LabelContent><DisplayName For="@(() => _talk.Date)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Date.ToString("d")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="business">
                <LabelContent><DisplayName For="@(() => _talk.Company)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Company</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person">
                <LabelContent><DisplayName For="@(() => _talk.Contact)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Contact</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="attach_money">
                <LabelContent><DisplayName For="@(() => _talk.Amount)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Amount.ToString("###,##0.00")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="flag">
                <LabelContent><DisplayName For="@(() => _talk.Target)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.Target.ToString("###,##0.00")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="pending">
                <LabelContent><DisplayName For="@(() => _talk.State)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@EnumService.Get(typeof(TalkStates), _talk.State)</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="layers">
                <LabelContent><DisplayName For="@(() => _talk.Phase)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@EnumService.Get(typeof(TalkPhases), _talk.Phase)</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="account_circle">
                <LabelContent><DisplayName For="@(() => _talk.IdUser)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_talk.User</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Lista Talks"]" OnClick="Annulla" />
                @if (_talk.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}