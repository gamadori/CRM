@page "/Talks"
@page "/Talks/Index"

@using Radzen
@using Radzen.Blazor
@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters



<BlazorHeader Header="@_header"></BlazorHeader>




@if (_talks != null)
{
    @if (IdProject == null && IdCompany == null)
    {
        <BlazorBreadCrumb Model=@_bread></BlazorBreadCrumb>
    }
    <BlazorFilter OnChangeFilter="OnChangeFilter" @bind-FilterState=@_filterState>
        <Filter>
            <div class="container m-3">
                <div class="form-floating">

                    <RadzenDropDownDataGrid class="form-control" @bind-value="@_idUser" TValue="string" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true" Change="OnChangeIdUser"
                                        Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />

                        </Columns>
                    </RadzenDropDownDataGrid>

                    <label>@Localize["Owner:"]</label>

                </div>
            </div>
        </Filter>
    </BlazorFilter>
    <div class=row>
        <div class="col">
            <BlazorButton Template="TemplateButton.New" Label=true OnClick="NewTicket"></BlazorButton>
        
        </div>
    </div>

    <RadzenDataGrid  @ref="grdTalks" Responsive=true IsLoading="@_isLoading" Count="@_talks.Items.Count" Data="@_talks.Items" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced" 
        AllowSorting="true" AllowFiltering="true" AllowPaging="true" 
        PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="TalkModel" EmptyText=@Localize["Nessun Talks"]>
        <Columns>


            <RadzenDataGridColumn TItem="TalkModel" Property="@nameof(TalkModel.Name)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.Name), typeof(Talk))" Width="10%" />

            <RadzenDataGridColumn TItem="TalkModel" Property="@nameof(TalkModel.Date)" FormatString="{0:d}" Title="@TranslateHelper.GetDisplayName(nameof(Talk.Date), typeof(Talk))" Width="10%"/>


            <RadzenDataGridColumn TItem="TalkModel" Property="@nameof(TalkModel.Company)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.IdCompany), typeof(Talk))" Type="typeof(string)"
                                FilterProperty="Company.RagioneSociale" SortProperty="Company.RagioneSociale"  Width="20%"  />

            <RadzenDataGridColumn TItem="TalkModel" Property="@nameof(TalkModel.Contact)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.Contact), typeof(Talk))" Type="typeof(string)"
                                FilterProperty="Product.Name" Width="10%" />

            
            <RadzenDataGridColumn Context="item" TItem="TalkModel" Property="@nameof(TalkModel.State)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.State), typeof(Talk))" Filterable="true" Sortable="true" TextAlign="Radzen.TextAlign.Center" Width="10%">
                <Template Context="item">
                    <span style="mix-blend-mode: difference; color: white">
                            @EnumService.Get(typeof(TalkStates), item.State)
                        </span>
                </Template>
                
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="item" TItem="TalkModel" Property="@nameof(TalkModel.Phase)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.Phase), typeof(Talk))" Filterable="true" Sortable="true" TextAlign="Radzen.TextAlign.Center" 
                Width="10%">
                <Template Context="item">
                    <span style="mix-blend-mode: difference; color: white">

                        @EnumService.Get(typeof(TalkPhases), item.Phase)
                    </span>
                </Template>

            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="TalkModel" Context="item" FormatString="{0:###,##0.00}" Property="@nameof(TalkModel.Amount)" Title="@TranslateHelper.GetDisplayName(nameof(Talk.Amount), typeof(Talk))" Width="10%">
            
                <FooterTemplate>
                        @Localize["Total Amount"]: <b> @_talks.Total.ToString("###,##0.00")</b>
                </FooterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Context="item" TItem="TalkModel" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                        <RadzenButton ButtonStyle="Radzen.ButtonStyle.Secondary" Icon="format_list_bulleted" title="Dettagli"  Size="Radzen.ButtonSize.Medium" Click="@(args => Details(item.Id))">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="edit" Size="Radzen.ButtonSize.Medium" title="Edit" Disabled=@(!item.Permits.Edit()) Click="@(args => Edit(item.Id))">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="Radzen.ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.Medium" title="Elimina" Disabled=@(!item.Permits.Delete()) Click="@(args => Delete(item.Id))">
                        </RadzenButton>
                </Template>
           
            </RadzenDataGridColumn>
       
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}

    
    