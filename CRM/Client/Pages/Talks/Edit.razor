@page "/Talks/Edit"
@page "/Talks/Edit/{Id:int}"
@using Radzen
@using Radzen.Blazor

<BlazorHeader Visible=@(PageMode != PageHelper.PageModality.Dialog)>@_header</BlazorHeader>

@if (_talk == null)
{
    <Waiting></Waiting>
}
else
{
    
    <div class="container m-3">
        <EditForm Model="@_talk" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
           
            <div class="row mb-3">
                <div class="col-md-6">            
                    <DisplayName For="@(()=>_talk.Name)" />
                    <input class="form-control" @bind-value="@_talk.Name" />
                    <ValidationMessage For="@(() => _talk.Name)" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.IdCompany)" />

                    <div class="input-group mb-3">
                        <RadzenDropDownDataGrid @ref=_ddCompany class="form-control" @bind-value="@_talk.IdCompany" TValue="int?" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    AllowClear="true" PageSize="@_pageSize"
                                            Data="@_companies" Count="@_companies.Count()" Change="OnChangeCompany" TextProperty="RagioneSociale" ValueProperty="Id"
                                            Disabled="@_lockCompany">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="RagioneSociale" Title=@TranslateHelper.GetDisplayName(nameof(Company.RagioneSociale), typeof(Company)) />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <BtnCompanies OnGetCompany="OnGetCompany"></BtnCompanies>
                    </div>
                    <ValidationMessage For="@(() => _talk.IdCompany)" />
                </div>
               
                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.IdContact)" />

                    <div class="input-group mb-3">
                        <RadzenDropDownDataGrid @ref=_ddContact class="form-control" @bind-value="@_talk.IdContact" TValue="int?" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowClear="true" PageSize="@_pageSize"
                                            Data="@_contacts" Count="@_contacts.Count()" TextProperty="NameComplete"  ValueProperty="Id">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="NameComplete" Title=@TranslateHelper.GetDisplayName(nameof(Contact.NameComplete), typeof(Contact)) />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <BtnContacts OnGetContacts="OnGetContact" IdCompany=@_talk?.IdCompany></BtnContacts>
                           
                    </div>
                    <ValidationMessage For="@(() => _talk.IdContact)" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.Amount)" />
                    <input class="form-control" @bind-value="@_talk.Amount" />
                    <ValidationMessage For="@(() => _talk.Amount)" />
                </div>
                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.Target)" />
                    <input class="form-control" @bind-value="@_talk.Target" />
                    <ValidationMessage For="@(() => _talk.Target)" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.State)" />

                    <RadzenDropDown class="form-control" @bind-value="@_talk.State" TValue="TalkStates" AllowFiltering="true" AllowSorting=false AllowClear="true" PageSize="@_pageSize"
                                        Data="@_talkStates" Count="@_talkStates.Count()"  TextProperty="Text" ValueProperty="Value" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                        
                    </RadzenDropDown>

                    <ValidationMessage For="@(() => _talk.State)" />
                </div>

                <div class="col-md-6">
                    <DisplayName For="@(()=>_talk.Phase)" />

                    <div class="input-group mb-3">
                        <RadzenDropDown class="form-control" @bind-value="@_talk.Phase" TValue="TalkPhases" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowClear="true" PageSize="@_pageSize"
                                            Data="@_talkPhases" Count="@_talkPhases.Count()" TextProperty="Text" ValueProperty="Value">

                           
                        </RadzenDropDown>

                    </div>
                    <ValidationMessage For="@(() => _talk.Phase)" />
                </div>
            </div>

            <div class="row mb-3">    
                <div class="col-md-12">
                    <DisplayName For="@(()=>_talk.Note)" />
                    <InputTextArea rows="8" class="form-control" @bind-Value="@_talk.Note" />
                    <ValidationMessage For="@(() => _talk.Note)" />
                </div>
            </div>

            

            <BlazorButton Type="BtnType.Submit" Style="BtnStyle.Primary" Text="Salva" Icon="save"></BlazorButton>
            <BlazorButton Style="BtnStyle.Secondary" OnClick="Annulla" Text="Annulla" Icon="cancel"></BlazorButton>

        </EditForm>
    </div>
}