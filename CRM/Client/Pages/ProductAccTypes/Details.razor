@page "/ProductAccTypes/{Id:int}/Details"
@using CRM.Shared.Helper


@if (_productAccessory == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model=@_pageHeader>
    </PageHeader>


    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="label" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _productAccessory.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_productAccessory.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="inventory">
                <LabelContent><DisplayName For="@(() => _productAccessory.ProdName)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_productAccessory.ProdName</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="category">
                <LabelContent><DisplayName For="@(() => _productAccessory.AccTypeName)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_productAccessory.AccTypeName</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="priority_high">
                <LabelContent><DisplayName For="@(() => _productAccessory.Necessary)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_productAccessory.Necessary</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="check_circle">
                <LabelContent><DisplayName For="@(() => _productAccessory.Enabled)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_productAccessory.Enabled</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Product Accessory List"]" OnClick="Annulla" />
                @if (_productAccessory.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}