@using CRM.Shared
@using Radzen
@using Radzen.Blazor

<div class="intervention-time-dialog">
    <EditForm Model="@Time" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <div class="form-section">
            <h6 class="section-title">
                <span class="material-icons">category</span>
                Tipo di Attività
            </h6>
            
            <div class="time-type-selector">
                @foreach (var type in _timeTypes)
                {
                    <div class="time-type-option @(Time.TimeType == type ? "active" : "")" 
                         @onclick="@(() => SelectTimeType(type))">
                        <span class="material-icons">@GetTimeTypeIcon(type)</span>
                        <span class="type-name">@GetTimeTypeText(type)</span>
                    </div>
                }
            </div>
        </div>

        <div class="form-section">
            <h6 class="section-title">
                <span class="material-icons">schedule</span>
                Orari
            </h6>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Inizio</label>
                    <RadzenDatePicker @bind-Value="Time.StartDateTime" 
                                      ShowTime="true" 
                                      DateFormat="dd/MM/yyyy HH:mm"
                                      Change="@CalculateDuration"
                                      Class="w-100" />
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fine</label>
                    <RadzenDatePicker @bind-Value="Time.EndDateTime" 
                                      ShowTime="true" 
                                      DateFormat="dd/MM/yyyy HH:mm"
                                      Change="@CalculateDuration"
                                      Class="w-100" />
                </div>
            </div>
            
            <div class="duration-display">
                <span class="material-icons">timer</span>
                <strong>Durata:</strong> @Time.DurationFormatted
            </div>
        </div>

        @if (Time.TimeType == InterventionTimeType.Travel)
        {
            <div class="form-section">
                <h6 class="section-title">
                    <span class="material-icons">directions_car</span>
                    Dettagli Viaggio
                </h6>
                
                <div class="mb-3">
                    <label class="form-label">@Localize["Distance Traveled"]</label>
                    <RadzenNumeric @bind-Value="Time.TravelKilometers" 
                                   ShowUpDown="false"
                                   Placeholder="Es: 50"
                                   Class="w-100" />
                </div>
            </div>
        }

        <div class="form-section">
            <h6 class="section-title">
                <span class="material-icons">description</span>
                Note
            </h6>
            
            <RadzenTextArea @bind-Value="Time.Notes" 
                            Rows="3"
                            Class="w-100" />
        </div>

        <div class="form-section">
            <div class="billable-toggle">
                <RadzenCheckBox @bind-Value="Time.IsBillable" Name="billable" />
                <label for="billable" class="ms-2">
                    <span class="material-icons">attach_money</span>
                    Tempo Fatturabile al Cliente
                </label>
            </div>
        </div>

        <div class="dialog-actions">
            <RadzenButton Text="Annulla" 
                          ButtonStyle="ButtonStyle.Light" 
                          Click="@Cancel" 
                          Style="width: 120px;" />
            <RadzenButton Text="@(IsNew ? Localize["Add"] : Localize["Save"])" 
                          ButtonStyle="ButtonStyle.Success" 
                          ButtonType="ButtonType.Submit"
                          Style="width: 120px;" />
        </div>
    </EditForm>
</div>

<style>
    .intervention-time-dialog {
        padding: 1rem;
        max-width: 600px;
    }

    .form-section {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        color: #495057;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .section-title .material-icons {
        font-size: 20px;
        color: #6c757d;
    }

    .time-type-selector {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .time-type-option {
        flex: 1;
        min-width: 120px;
        padding: 1rem;
        background: white;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .time-type-option:hover {
        border-color: #0d6efd;
        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.15);
    }

    .time-type-option.active {
        background: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .time-type-option .material-icons {
        font-size: 32px;
    }

    .time-type-option.active .material-icons {
        color: white;
    }

    .type-name {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .duration-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem;
        background: white;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        margin-top: 1rem;
    }

    .duration-display .material-icons {
        color: #0d6efd;
        font-size: 20px;
    }

    .billable-toggle {
        display: flex;
        align-items: center;
        padding: 0.75rem;
        background: white;
        border-radius: 6px;
        cursor: pointer;
    }

    .billable-toggle label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        cursor: pointer;
        font-weight: 500;
    }

    .billable-toggle .material-icons {
        color: #198754;
        font-size: 20px;
    }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding-top: 1rem;
        border-top: 1px solid #dee2e6;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.9rem;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .intervention-time-dialog {
            padding: 0.5rem;
        }

        .time-type-selector {
            flex-direction: column;
        }

        .time-type-option {
            min-width: 100%;
        }

        .dialog-actions {
            flex-direction: column-reverse;
        }

        .dialog-actions button {
            width: 100% !important;
        }
    }
</style>
