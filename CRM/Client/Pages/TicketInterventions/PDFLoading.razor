@page "/TicketInterventions/PDFLoading/{Id:int}"

@using Syncfusion.Blazor.SfPdfViewer
@using Syncfusion.Blazor.Navigations

<div class="row" style="z-index: 5">
    <div class="row mb-3">
        <div class="col-md-8">
            <button type="button" class="btn btn-light" @onclick="Close">
                <i class="material-icons middle  text-secondary">article</i>
                <span class="pl-2 text-secondary">Dati Intervento</span>
            </button>

            <button type="button" class="btn btn-light" @onclick="ReportUpload">
                <i class="material-icons middle  text-secondary">file_upload</i>
                <span class="pl-2 text-secondary">Carica Report</span>
            </button>
            <button type="button" class="btn btn-light" @onclick="ReportCreatePrepare">
                <i class="material-icons middle text-secondary">description</i>
                <span class="pl-2 text-secondary">Ricrea il Report</span>
            </button>
            <BlazorButton CssClass="btn-light text-secondary" OnClick="DownloadReport" Text=@Localize["Download Report"] Template="TemplateButton.Download"></BlazorButton>
            
            <div class="btn-group" role="group">
                <button id="btnGroupDrop1" type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="material-icons middle text-secondary">attach_email</i>
                    <span class="pl-2 text-secondary">Email</span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="btnGroupDrop1">
                    <li>
                        <button class="dropdown-item" @onclick="OpenSendEmail">
                            <i class="material-icons middle text-secondary">send</i>
                            <span class="pl-2 text-secondary">Invia per Email</span>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" @onclick="OpenEmailSent">
                            <i class="material-icons middle text-secondary">all_inbox</i>
                            <span class="pl-2 text-secondary">Storico Email</span>
                        </button>
                    </li>
                </ul>
            </div>

        </div>
    </div>

</div>

<div class="form-group row" style="margin: 0px; padding: 0px; height: 100%;">

    <div class="row" style="position:relative">
   
        

        <div style="position:absolute;top:0px;width:100%;height:100%;">
            <SfPdfViewer2 @ref="_pdfViewer" DocumentPath="@_document" Height="100%">
        
            </SfPdfViewer2>
            
        </div>
    </div>
</div>


<MsgBoxConfirm Id="dlgMsgBox" LabelBtnNo="No" LabelBtnYes="Yes" Header="Report" Message="@_msgBox" OnClick="ReportCreate"></MsgBoxConfirm>
<MsgWaitingSpinner id="dlgWaitingBox" Header="Creazione del Report in corso..." ></MsgWaitingSpinner>
<DialogUpload Id=dlgUploadFile LabelBtnNo="Annulla" LabelBtnYes="Upload" OnUploaded=OnUploaded OnClickNo="CloseUploadReport" OnUpload="UploadReport" Message="Upload del Verbale di Intervento"></DialogUpload>
