@page "/TicketInterventions/Details/{Id:int}"
@page "/TicketInterventions/{Id:int}"

@using BlazoringComponents.DropDownButton
@using CRM.Shared.Helper

@if (_ticketIntervention == null || _creatingReport)
{
    <Waiting></Waiting>
}
else
{

    @if (PageMode != CRM.Client.Helpers.PageHelper.PageModality.Child)
    {
        <PageHeader PageMode="@PageMode">
        </PageHeader>
    }

    @if (_message != null)
    {

        <div class="alert @_typeMessage">@_message</div>
    }
    <div class="ticket-intervention-details">
        <div class="ticket-intervention-content">

            <div class="row g-3">
                <div class="col">
                    <table class="table table-striped intervention-summary-table">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>

                            
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.AssignedUsers)" />
                                </th>
                                <td>
                                    <!-- ✅ NUOVO: Visualizza utenti multipli invece di solo uno -->
                                    @if (_isLoadingUsers)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        <span class="ms-2">Caricamento...</span>
                                    }
                                    else if (_assignedUsers != null && _assignedUsers.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var user in _assignedUsers)
                                            {
                                                var isMain = _assignedUsers.IndexOf(user) == 0;
                                                <div class="badge bg-@(isMain ? "primary" : "secondary") p-2 d-flex align-items-center gap-1">
                                                    <span class="user-avatar-small">@GetUserInitials(user.NameComplete)</span>
                                                    <span>@user.NameComplete</span>
                                                    @if (isMain)
                                                    {
                                                        <span title="Utente principale">★</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.SupportType)" />
                                </th>

                                <td>
                                    <span>@Helpers.UtilityHelper.GetDisplayName((TypesSupport)_ticketIntervention.SupportType)</span>
                                </td>
                            </tr>
                           
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.Minute)" />
                                </th>

                                <td>
                                    <span>@_ticketIntervention.Minute</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.TicketInterventionsTypes)" />
                                </th>

                                <td>
                                    @if (_ticketIntervention.TicketInterventionsTypes != null)
                                    {
                                        @foreach (var item in _ticketIntervention.TicketInterventionsTypes)
                                        {
                                            <div>@item.Name</div>
                                        }
                                    }

                                </td>
                            </tr>

                        </tbody>
                    </table>
                   
                    <div class="accordion intervention-details-accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-heading0">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse0" aria-expanded="true" aria-controls="panelsStayOpen-collapse0">
                                    <DisplayName For="@(() => _ticketIntervention.TicketInterventionArticles)">
                                        @if (_ticketIntervention.InterventionArticles.Any())
                                        {
                                            <span class="badge text-bg-primary">@_ticketIntervention.InterventionArticles.Count()</span>
                                        }
                                    </DisplayName>
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapse0" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                                <div class="accordion-body">
                                 <ArticlesDetails Articles="@_ticketIntervention.InterventionArticles" ></ArticlesDetails>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                                    <DisplayName For="@(() => _ticketIntervention.Activities)" />
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.Activities</p>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="true" aria-controls="panelsStayOpen-collapseTwo">
                                    <p><DisplayName For="@(() => _ticketIntervention.MountedParts)" /></p>
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.MountedParts</p>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="true" aria-controls="panelsStayOpen-collapseThree">
                                    <DisplayName For="@(() => _ticketIntervention.Note)" />
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingThree">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.Note</p>
                                </div>
                            </div>
                        </div>
                        <!-- ✅ NUOVO: Orari di Lavoro e Viaggio -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingTimes">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTimes" aria-expanded="true" aria-controls="panelsStayOpen-collapseTimes">
                                    <i class="material-icons me-2">schedule</i>
                                    Orari di Lavoro e Viaggio
                                    @if (_interventionTimes != null && _interventionTimes.Any())
                                    {
                                        <span class="badge bg-primary ms-2">@_interventionTimes.Count periodi</span>
                                    }
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseTimes" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTimes">
                                <div class="accordion-body">
                                    <InterventionTimesViewer Times="@_interventionTimes" AssignedUsersCount="@(_assignedUsers?.Count ?? 0)" />
                                </div>
                            </div>
                        </div>

                        <!-- ✅ NUOVO: Note Spese (Sistema Multiplo) -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingExpenses">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseExpenses" aria-expanded="false" aria-controls="panelsStayOpen-collapseExpenses">
                                    <i class="material-icons me-2">receipt_long</i>
                                    Note Spese
                                    @if (_expenseReceiptSummary != null && _expenseReceiptSummary.TotalReceiptsCount > 0)
                                    {
                                        <span class="badge bg-success ms-2">@_expenseReceiptSummary.TotalReceiptsCount</span>
                                        <span class="text-success ms-2 fw-bold" style="font-size: 0.9rem;">
                                            € @_expenseReceiptSummary.TotalExpenses.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2">0</span>
                                    }
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseExpenses" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingExpenses">
                                <div class="accordion-body">
                                    @if (_isLoadingExpenseReceipts)
                                    {
                                        <div class="text-center py-3">
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            <span class="ms-2">Caricamento...</span>
                                        </div>
                                    }
                                    else if (_expenseReceiptSummary != null && _expenseReceiptSummary.TotalReceiptsCount > 0)
                                    {
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-4">
                                                <div class="card border-0 bg-light">
                                                    <div class="card-body text-center">
                                                        <div class="text-muted small">Totale Spese</div>
                                                        <div class="h4 mb-0 text-success">€ @_expenseReceiptSummary.TotalExpenses.ToString("N2")</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card border-0 bg-light">
                                                    <div class="card-body text-center">
                                                        <div class="text-muted small">IVA/Tasse</div>
                                                        <div class="h4 mb-0 text-info">€ @_expenseReceiptSummary.TotalTaxes.ToString("N2")</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card border-0 bg-light">
                                                    <div class="card-body text-center">
                                                        <div class="text-muted small">Netto</div>
                                                        <div class="h4 mb-0">€ @_expenseReceiptSummary.TotalNet.ToString("N2")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="alert alert-info mb-3">
                                            <i class="material-icons align-middle" style="font-size:18px;">info</i>
                                            <strong>@_expenseReceiptSummary.ConfirmedReceiptsCount</strong> nota/e confermata/e &bull; 
                                            <strong>@_expenseReceiptSummary.PendingReceiptsCount</strong> in attesa di conferma
                                        </div>

                                        <div class="d-flex gap-2">
                                            <a href="/TicketInterventions/@Id/ExpenseReceipts" class="btn btn-primary">
                                                <i class="material-icons align-middle" style="font-size:18px;">receipt_long</i>
                                                Visualizza Tutte le Note Spese
                                            </a>
                                            <a href="/TicketInterventions/@Id/ExpenseReceipts/Create" class="btn btn-success">
                                                <i class="material-icons align-middle" style="font-size:18px;">add</i>
                                                Aggiungi Nota Spese
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4">
                                            <i class="material-icons text-muted" style="font-size: 48px;">receipt_long</i>
                                            <p class="text-muted mt-2 mb-3">Nessuna nota spese presente per questo intervento</p>
                                            <a href="/TicketInterventions/@Id/ExpenseReceipts/Create" class="btn btn-primary">
                                                <i class="material-icons align-middle" style="font-size:18px;">add</i>
                                                Aggiungi Prima Nota Spese
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Scontrini / Note Spese (LEGACY - Da Deprecare) -->
                        @if (_ticketIntervention.ExtractionConfirmed || _ticketIntervention.ExtractedTotalAmount.HasValue)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="panelsStayOpen-headingReceipt">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseReceipt" aria-expanded="false" aria-controls="panelsStayOpen-collapseReceipt">
                                        <i class="material-icons me-2">receipt_long</i>
                                        Note Spese &amp; Scontrini
                                        @if (_ticketIntervention.ExtractedTotalAmount.HasValue)
                                        {
                                            <span class="badge bg-success ms-2">
                                                @_ticketIntervention.ExtractedTotalAmount.Value.ToString("C2")
                                            </span>
                                        }
                                    </button>
                                </h2>
                                <div id="panelsStayOpen-collapseReceipt" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingReceipt">
                                    <div class="accordion-body">
                                        <div class="row g-3">
                                            @if (_ticketIntervention.ExtractedTotalAmount.HasValue)
                                            {
                                                <div class="col-6 col-md-4">
                                                    <div class="receipt-detail-field">
                                                        <span class="receipt-detail-label">💶 Totale</span>
                                                        <span class="receipt-detail-value text-success fw-bold">
                                                            @_ticketIntervention.ExtractedTotalAmount.Value.ToString("C2")
                                                            @if (!string.IsNullOrEmpty(_ticketIntervention.ExtractedCurrency) && _ticketIntervention.ExtractedCurrency != "EUR")
                                                            {
                                                                <small class="text-muted ms-1">@_ticketIntervention.ExtractedCurrency</small>
                                                            }
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                            @if (_ticketIntervention.ExtractedTaxAmount.HasValue)
                                            {
                                                <div class="col-6 col-md-4">
                                                    <div class="receipt-detail-field">
                                                        <span class="receipt-detail-label">🧾 IVA</span>
                                                        <span class="receipt-detail-value">@_ticketIntervention.ExtractedTaxAmount.Value.ToString("C2")</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (_ticketIntervention.ExtractedTransactionDate.HasValue)
                                            {
                                                <div class="col-6 col-md-4">
                                                    <div class="receipt-detail-field">
                                                        <span class="receipt-detail-label">📅 Data</span>
                                                        <span class="receipt-detail-value">@_ticketIntervention.ExtractedTransactionDate.Value.ToString("dd/MM/yyyy")</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(_ticketIntervention.ExtractedMerchantName))
                                            {
                                                <div class="col-6 col-md-4">
                                                    <div class="receipt-detail-field">
                                                        <span class="receipt-detail-label">🏪 Commerciante</span>
                                                        <span class="receipt-detail-value">@_ticketIntervention.ExtractedMerchantName</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(_ticketIntervention.ExtractedDescription))
                                            {
                                                <div class="col-12">
                                                    <div class="receipt-detail-field">
                                                        <span class="receipt-detail-label">📝 Descrizione</span>
                                                        <span class="receipt-detail-value">@_ticketIntervention.ExtractedDescription</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (_ticketIntervention.ReceiptProcessedDate.HasValue)
                                            {
                                                <div class="col-12">
                                                    <small class="text-muted">
                                                        <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                                        Elaborato il @_ticketIntervention.ReceiptProcessedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.CustomerSignature))
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="panelsStayOpen-headingFour">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="true" aria-controls="panelsStayOpen-collapseFour">
                                        Customer Signature 
                                        
                                        @* Badge stato firma *@
                                        @if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Pending)
                                        {
                                            <span class="badge text-bg-warning ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                                In Attesa di Conferma
                                            </span>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Verified)
                                        {
                                            <span class="badge text-bg-success ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">verified</i>
                                                Confermata
                                            </span>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Rejected)
                                        {
                                            <span class="badge text-bg-danger ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">cancel</i>
                                                Rifiutata
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success ms-2">Signed</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.SignatureName))
                                        {
                                            <span class="text-primary ms-2" style="font-size: 0.85rem; font-weight: 600;">
                                                (@_ticketIntervention.SignatureName)
                                            </span>
                                        }
                                        @if (_ticketIntervention.SignatureDate.HasValue)
                                        {
                                            <span class="text-muted ms-2" style="font-size: 0.75rem;">
                                                - @_ticketIntervention.SignatureDate.Value.ToString("g")
                                            </span>
                                        }
                                    </button>
                                </h2>
                                <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingFour">
                                    <div class="accordion-body bg-light">
                                        @* Alert conferma in attesa *@
                                        @if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Pending)
                                        {
                                            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">warning</i>
                                                <div class="flex-grow-1">
                                                    <strong>Firma in Attesa di Conferma</strong>
                                                    <p class="mb-2">
                                                        Email di conferma inviata a: <strong>@_ticketIntervention.SignatureEmail</strong>
                                                    </p>
                                                    <p class="mb-0 small text-muted">
                                                        La firma diventerà valida solo dopo la conferma tramite email.
                                                    </p>
                                                </div>
                                                @if (_ticketIntervention.Permits.Edit())
                                                {
                                                    <button type="button" class="btn btn-sm btn-warning" @onclick="OpenResendConfirmationDialog" disabled="@_isSendingEmail">
                                                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">forward_to_inbox</i>
                                                        @(_isSendingEmail ? "Invio..." : "Rinvia Email")
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Verified && _ticketIntervention.SignatureConfirmedDate.HasValue)
                                        {
                                            <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">check_circle</i>
                                                <div>
                                                    <strong>Firma Confermata</strong>
                                                    <p class="mb-0 small">
                                                        Confermata il @_ticketIntervention.SignatureConfirmedDate.Value.ToString("g")
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Rejected)
                                        {
                                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">error</i>
                                                <div>
                                                    <strong>Firma Rifiutata</strong>
                                                    <p class="mb-0 small">
                                                        Il cliente ha rifiutato la firma tramite email.
                                                    </p>
                                                </div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.SignatureName))
                                        {
                                            <div class="text-center mb-3">
                                                <span class="badge bg-primary" style="font-size: 14px; padding: 8px 16px;">
                                                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">person</i>
                                                    @_ticketIntervention.SignatureName
                                                </span>
                                            </div>
                                        }
                                        <img src="data:image/png;base64,@_ticketIntervention.CustomerSignature" 
                                             alt="Customer Signature" 
                                             style="max-width: 100%; border: 1px solid #dee2e6; border-radius: 0.375rem;" />
                                        @if (_ticketIntervention.SignatureDate.HasValue)
                                        {
                                            <div class="text-center mt-2 text-muted small">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                                Firmato digitalmente il @_ticketIntervention.SignatureDate.Value.ToString("g")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <br>

                    <div>

                        <BlazorButton Template="TemplateButton.Back" OnClick="Annulla" Text="Interventi" />

                        @if (_ticketIntervention.Permits.Edit())
                        {
                            <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                        }

                       @*  @if (_ticketIntervention.Permits.Edit())
                        {
                            <a class="btn btn-outline-warning btn-sm ms-1"
                               href="/TicketInterventions/@_ticketIntervention.Id/Receipts">
                                <i class="material-icons" style="font-size: 16px; vertical-align: middle;">receipt_long</i>
                                Note Spese
                                @if (_ticketIntervention.ExtractedTotalAmount.HasValue)
                                {
                                    <span class="badge bg-success ms-1">@_ticketIntervention.ExtractedTotalAmount.Value.ToString("C2")</span>
                                }
                            </a>
                        } *@

                        @if (_ticketIntervention.HasAttachments)
                        {

                            @if (_ticketIntervention.Permits.Edit())
                            {
                                <DropDownBtn Text="@Localize["Report"]" CssClass="btn-success" IconMaterial="picture_as_pdf">
                                    <DropDownBrnItem Text="@Localize["View Report"]"  IconMaterial="visibility" OnClickEvent="ReportView" />
                                    <DropDownBrnItem Text="@Localize["Download Report"]" IconMaterial="file_download" OnClickEvent="DownloadReport" />
                                </DropDownBtn>
                            }
                            else
                            {
                                
                                <BlazorButton CssClass="btn-success" OnClick="DownloadReport" Text=@Localize["Download Report"] Template="TemplateButton.Download"></BlazorButton>
                            }

                        }

                        else if (_ticketIntervention.Permits.Edit() && (!_ticketIntervention.HasAttachments || !_ticketIntervention.AttachmentExist))
                        {
                                <DropDownBtn Text="@Localize["Report"]" CssClass="btn-success" IconMaterial="picture_as_pdf">
                                <DropDownBrnItem Text="@Localize["Create Report"]" IconMaterial="create" OnClickEvent="CreateReportPrepare" />
                                <DropDownBrnItem Text="@Localize["Upload Report"]" IconMaterial="file_upload" OnClickEvent="ReportUploadDialog" />
                            </DropDownBtn>

                        }
                      

                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <MsgWaitingSpinner Id="dlgWaitingBox" Header="Creazione del Report in corso..."></MsgWaitingSpinner>
}

<style>
    .ticket-intervention-details {
        margin-top: 1rem;
        padding: 1rem;
        border: 1px solid var(--border-color, #dee2e6);
        border-radius: 0.5rem;
        background: var(--card-bg, #ffffff);
        color: var(--text-primary, #212529);
    }

    .ticket-intervention-content {
        width: min(100%, 1380px);
    }

    .intervention-summary-table {
        margin-bottom: 0.9rem;
        color: inherit;
    }

    .intervention-summary-table thead {
        display: none;
    }

    .intervention-summary-table th,
    .intervention-summary-table td {
        padding: 0.7rem 0.85rem;
        vertical-align: middle;
        border-color: var(--border-color, #dee2e6);
    }

    .intervention-summary-table th {
        width: 46%;
        color: var(--text-secondary, #52606d);
        font-weight: 700;
    }

    .intervention-summary-table td {
        color: var(--text-primary, #212529);
        font-weight: 500;
    }

    .intervention-details-accordion .accordion-item {
        overflow: hidden;
        border-color: var(--border-color, #dee2e6);
    }

    .intervention-details-accordion .accordion-button {
        min-height: 2.9rem;
        color: var(--text-primary, #212529);
        font-weight: 650;
        background: var(--card-bg, #ffffff);
    }

    .intervention-details-accordion .accordion-button:not(.collapsed) {
        color: var(--rz-primary, #0d6efd);
        background: var(--hover-bg, #f4f7fb);
        box-shadow: inset 0 -1px 0 var(--border-color, #dee2e6);
    }

