@page "/TicketInterventions/Details/{Id:int}"
@page "/TicketInterventions/{Id:int}"
@using Syncfusion.Blazor.SplitButtons
@using BlazoringComponents.DropDownButton
@using CRM.Shared.Helper

<h3>Intervento</h3>
<hr />
@if (_ticketIntervention == null || _creatingReport)
{
    <Waiting></Waiting>
}
else
{
    @if (_message != null)
    {

        <div class="alert @_typeMessage">@_message</div>
    }
    <div class="row rounded-3 bg-light">
        <div class="col-md-8">

            <div class="row g-3">
                <div class="col">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.StartDateTime)" />
                                </th>
                                <td>
                                    <span>@_ticketIntervention.StartDateTime.ToString("g")</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.EndDateTime)" />
                                </th>
                                <td>
                                    <span>@_ticketIntervention.EndDateTime.ToString("g")</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.User.NameComplete)" />
                                </th>
                                <td>
                                    <span>@_ticketIntervention.User?.NameComplete</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.SupportType)" />
                                </th>

                                <td>
                                    <span>@Helpers.UtilityHelper.GetDisplayName((TypesSupport)_ticketIntervention.SupportType)</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.IdUser)" />
                                </th>

                                <td>
                                    <span>@_ticketIntervention.User?.NameComplete</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.Minute)" />
                                </th>

                                <td>
                                    <span>@_ticketIntervention.Minute</span>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <DisplayName For="@(() => _ticketIntervention.TicketInterventionsTypes)" />
                                </th>

                                <td>
                                    @if (_ticketIntervention.TicketInterventionsTypes != null)
                                    {
                                        @foreach (var item in _ticketIntervention.TicketInterventionsTypes)
                                        {
                                            <div>@item.Name</div>
                                        }
                                    }

                                </td>
                            </tr>

                        </tbody>
                    </table>
                   
                    <div class="accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-heading0">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse0" aria-expanded="true" aria-controls="panelsStayOpen-collapse0">
                                    <DisplayName For="@(() => _ticketIntervention.TicketInterventionArticles)">
                                        @if (_ticketIntervention.InterventionArticles.Any())
                                        {
                                            <span class="badge text-bg-primary">@_ticketIntervention.InterventionArticles.Count()</span>
                                        }
                                    </DisplayName>
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapse0" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                                <div class="accordion-body">
                                 <ArticlesDetails Articles="@_ticketIntervention.InterventionArticles" ></ArticlesDetails>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                                    <DisplayName For="@(() => _ticketIntervention.Activities)" />
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.Activities</p>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="true" aria-controls="panelsStayOpen-collapseTwo">
                                    <p><DisplayName For="@(() => _ticketIntervention.MountedParts)" /></p>
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.MountedParts</p>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="panelsStayOpen-headingThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="true" aria-controls="panelsStayOpen-collapseThree">
                                    <DisplayName For="@(() => _ticketIntervention.Note)" />
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingThree">
                                <div class="accordion-body bg-warning bg-opacity-10">
                                    <p class="note-report">@_ticketIntervention.Note</p>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.CustomerSignature))
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="panelsStayOpen-headingFour">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="true" aria-controls="panelsStayOpen-collapseFour">
                                        Customer Signature 
                                        
                                        @* Badge stato firma *@
                                        @if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Pending)
                                        {
                                            <span class="badge text-bg-warning ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                                In Attesa di Conferma
                                            </span>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Verified)
                                        {
                                            <span class="badge text-bg-success ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">verified</i>
                                                Confermata
                                            </span>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Rejected)
                                        {
                                            <span class="badge text-bg-danger ms-2">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">cancel</i>
                                                Rifiutata
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success ms-2">Signed</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.SignatureName))
                                        {
                                            <span class="text-primary ms-2" style="font-size: 0.85rem; font-weight: 600;">
                                                (@_ticketIntervention.SignatureName)
                                            </span>
                                        }
                                        @if (_ticketIntervention.SignatureDate.HasValue)
                                        {
                                            <span class="text-muted ms-2" style="font-size: 0.75rem;">
                                                - @_ticketIntervention.SignatureDate.Value.ToString("g")
                                            </span>
                                        }
                                    </button>
                                </h2>
                                <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingFour">
                                    <div class="accordion-body bg-light">
                                        @* Alert conferma in attesa *@
                                        @if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Pending)
                                        {
                                            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">warning</i>
                                                <div class="flex-grow-1">
                                                    <strong>Firma in Attesa di Conferma</strong>
                                                    <p class="mb-2">
                                                        Email di conferma inviata a: <strong>@_ticketIntervention.SignatureEmail</strong>
                                                    </p>
                                                    <p class="mb-0 small text-muted">
                                                        La firma diventerà valida solo dopo la conferma tramite email.
                                                    </p>
                                                </div>
                                                @if (_ticketIntervention.Permits.Edit())
                                                {
                                                    <button type="button" class="btn btn-sm btn-warning" @onclick="OpenResendConfirmationDialog" disabled="@_isSendingEmail">
                                                        <i class="material-icons" style="font-size: 16px; vertical-align: middle;">forward_to_inbox</i>
                                                        @(_isSendingEmail ? "Invio..." : "Rinvia Email")
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Verified && _ticketIntervention.SignatureConfirmedDate.HasValue)
                                        {
                                            <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">check_circle</i>
                                                <div>
                                                    <strong>Firma Confermata</strong>
                                                    <p class="mb-0 small">
                                                        Confermata il @_ticketIntervention.SignatureConfirmedDate.Value.ToString("g")
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                        else if (_ticketIntervention.SignatureStatus == CRM.Shared.SignatureStatus.Rejected)
                                        {
                                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                                                <i class="material-icons" style="font-size: 24px;">error</i>
                                                <div>
                                                    <strong>Firma Rifiutata</strong>
                                                    <p class="mb-0 small">
                                                        Il cliente ha rifiutato la firma tramite email.
                                                    </p>
                                                </div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_ticketIntervention.SignatureName))
                                        {
                                            <div class="text-center mb-3">
                                                <span class="badge bg-primary" style="font-size: 14px; padding: 8px 16px;">
                                                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">person</i>
                                                    @_ticketIntervention.SignatureName
                                                </span>
                                            </div>
                                        }
                                        <img src="data:image/png;base64,@_ticketIntervention.CustomerSignature" 
                                             alt="Customer Signature" 
                                             style="max-width: 100%; border: 1px solid #dee2e6; border-radius: 0.375rem;" />
                                        @if (_ticketIntervention.SignatureDate.HasValue)
                                        {
                                            <div class="text-center mt-2 text-muted small">
                                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                                Firmato digitalmente il @_ticketIntervention.SignatureDate.Value.ToString("g")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <br>

                    <div>

                        <BlazorButton Template="TemplateButton.Back" OnClick="Annulla" Text="Interventi" />

                        @if (_ticketIntervention.Permits.Edit())
                        {
                            <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                        }

                        @if (_ticketIntervention.HasAttachments)
                        {

                            @if (_ticketIntervention.Permits.Edit())
                            {
                                <DropDownBtn Text="@Localize["Report"]" CssClass="btn-success" IconMaterial="picture_as_pdf">
                                    <DropDownBrnItem Text="@Localize["View Report"]"  IconMaterial="visibility" OnClickEvent="ReportView" />
                                    <DropDownBrnItem Text="@Localize["Download Report"]" IconMaterial="file_download" OnClickEvent="DownloadReport" />
                                </DropDownBtn>
                            }
                            else
                            {
                                
                                <BlazorButton CssClass="btn-success" OnClick="DownloadReport" Text=@Localize["Download Report"] Template="TemplateButton.Download"></BlazorButton>
                            }

                        }

                        else if (_ticketIntervention.Permits.Edit() && (!_ticketIntervention.HasAttachments || !_ticketIntervention.AttachmentExist))
                        {
                                <DropDownBtn Text="@Localize["Report"]" CssClass="btn-success" IconMaterial="picture_as_pdf">
                                <DropDownBrnItem Text="@Localize["Create Report"]" IconMaterial="create" OnClickEvent="CreateReportPrepare" />
                                <DropDownBrnItem Text="@Localize["Upload Report"]" IconMaterial="file_upload" OnClickEvent="ReportUploadDialog" />
                            </DropDownBtn>

                        }
                      

                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <MsgWaitingSpinner Id="dlgWaitingBox" Header="Creazione del Report in corso..."></MsgWaitingSpinner>
    <DialogUpload Id=dlgUploadFile LabelBtnNo="Annulla" LabelBtnYes="Upload" OnUploaded=OnUploaded OnClickNo="CloseUploadReport" OnUpload="UploadReport" Message="Upload del Verbale di Intervento"></DialogUpload>
}
