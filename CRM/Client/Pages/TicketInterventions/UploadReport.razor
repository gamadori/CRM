@page "/TicketInterventions/UploadReport/{Id:int}"
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using CRM.Client.Helpers
@using CRM.Shared
@using static CRM.Client.Helpers.PageHelper
@attribute [Authorize]

<style>
    .upload-dropzone {
        border: 3px dashed #cbd5e1;
        border-radius: 0.75rem;
        padding: 4rem 2rem;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
    }

    .upload-dropzone:hover {
        border-color: #0d6efd;
        background: #e7f3ff;
    }

    .upload-dropzone input[type="file"] {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        opacity: 0;
        cursor: pointer;
    }

    .upload-icon {
        font-size: 72px;
        color: #0d6efd;
    }
</style>

<PageHeader Visible="@(PageMode != PageHelper.PageModality.Dialog)" Model="_pageHeader">
</PageHeader>

@if (_intervention == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="row justify-content-center ticket-interventions-page upload-report-page">
        <div class="col-md-8">
            <!-- Info Intervento -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="material-icons" style="vertical-align: middle;">description</i>
                        Upload Report Intervento #@_intervention.Id
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="fw-semibold mb-2 d-flex align-items-center">
                            <span class="material-icons me-2 text-primary" style="font-size: 20px;">info</span>
                            Dettagli Intervento
                        </h6>
                        <div class="p-3 bg-light rounded">
                            <p class="mb-1"><strong>ID:</strong> @_intervention.Id</p>
                            <p class="mb-1"><strong>Data:</strong> @_intervention.StartDateTime.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-0"><strong>Ticket:</strong> #@_intervention.IdTicket</p>
                        </div>
                    </div>

                    <!-- Upload Area -->
                    <div class="mb-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="mb-3">
                                    <i class="material-icons" style="vertical-align: middle;">cloud_upload</i>
                                    Carica Report PDF
                                </h6>
                                <div class="upload-dropzone">
                                    <InputFile OnChange="@OnInputFileChange" accept=".pdf" id="fileUpload" />
                                    <div class="upload-icon-container">
                                        <span class="material-icons upload-icon">picture_as_pdf</span>
                                        <p class="mt-3 mb-2"><strong>Trascina qui il file PDF o clicca per selezionare</strong></p>
                                        <p class="text-muted small mb-0">Solo file PDF (Max 20MB)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- File Selected -->
                    @if (_selectedFile != null)
                    {
                        <div class="card border-success mb-3">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <i class="material-icons text-success" style="font-size: 48px;">check_circle</i>
                                    </div>
                                    <div class="col">
                                        <h6 class="mb-1">@_selectedFile.Name</h6>
                                        <p class="text-muted small mb-0">@FormatFileSize(_selectedFile.Size) - @_selectedFile.ContentType</p>
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="RemoveFile">
                                            <i class="material-icons" style="font-size: 18px; vertical-align: middle;">delete</i>
                                            Rimuovi
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="material-icons" style="vertical-align: middle;">error</i>
                            @_errorMessage
                        </div>
                    }

                    <!-- Success Message -->
                    @if (_uploadSuccess)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="material-icons" style="vertical-align: middle;">check_circle</i>
                            Report caricato con successo!
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-4">
                        <RedGButton 
                            RGButtonType="RGButtonType.Save" 
                            Text="Carica Report" 
                            Click="HandleUpload" 
                            Disabled="@(_selectedFile == null || _uploading)" 
                            Loading="@_uploading" />
                        
                        <RedGButton 
                            RGButtonType="RGButtonType.Back" 
                            Text="Annulla" 
                            Click="Cancel" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
