@using Radzen
@using Radzen.Blazor
@using CRM.Shared

<div class="language-selection-dialog ticket-interventions-dialog">
    <div class="dialog-header mb-4">
        <h5 class="mb-2">
            <i class="material-icons me-2" style="vertical-align: middle;">language</i>
            @Localize["Select Report Language"]
        </h5>
        <p class="text-muted small mb-0">
            @Localize["Choose the language for the intervention report PDF"]
        </p>
    </div>

    @if (_languages != null && _languages.Any())
    {
        <div class="languages-grid">
            @foreach (var language in _languages)
            {
                var isSelected = _selectedLanguageCode == language.LanguageCode;
                
                <div class="language-card @(isSelected ? "selected" : "")" 
                     @onclick="() => SelectLanguage(language.LanguageCode)">
                    <div class="language-card-content">
                        @if (!string.IsNullOrWhiteSpace(language.Flag))
                        {
                            <img src="@language.Flag" 
                                 alt="@language.Name" 
                                 class="language-flag" />
                        }
                        <div class="language-info">
                            <div class="language-name">@language.Name</div>
                            <div class="language-code">@language.LanguageCode</div>
                        </div>
                        @if (isSelected)
                        {
                            <i class="material-icons check-icon">check_circle</i>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_loading)
    {
        <div class="text-center py-4">
            <Waiting></Waiting>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="material-icons me-2">warning</i>
            @Localize["No languages available"]
        </div>
    }

    <div class="dialog-footer mt-4 d-flex gap-2 justify-content-end">
        <RadzenButton 
            Click="Cancel" 
            ButtonStyle="ButtonStyle.Light" 
            Icon="close"
            Text="@Localize["Cancel"]" />
        
        <RadzenButton 
            Click="Confirm" 
            ButtonStyle="ButtonStyle.Primary" 
            Icon="check"
            Text="@Localize["Confirm"]"
            Disabled="string.IsNullOrEmpty(_selectedLanguageCode)" />
    </div>
</div>

<style>
    .language-selection-dialog {
        min-width: 500px;
        padding: 1rem;
    }

    .languages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .language-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
    }

    .language-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.15);
    }

    .language-card.selected {
        border-color: #0d6efd;
        background: #f8f9fa;
        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.25);
    }

    .language-card-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
    }

    .language-flag {
        width: 40px;
        height: 30px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #dee2e6;
    }

    .language-info {
        flex: 1;
    }

    .language-name {
        font-weight: 600;
        color: #212529;
        margin-bottom: 0.25rem;
    }

    .language-code {
        font-size: 0.875rem;
        color: #6c757d;
        text-transform: uppercase;
    }

    .check-icon {
        color: #0d6efd;
        font-size: 24px;
    }

    .dialog-header h5 {
        display: flex;
        align-items: center;
        color: #212529;
        font-weight: 600;
    }
</style>
