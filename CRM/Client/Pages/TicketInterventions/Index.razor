@page "/TicketInterventions"
@page "/TicketInterventions/Index"
@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters

<BlazorHeader Header="@Localize["Interventi"]"></BlazorHeader>



@if (_user != null && _user.CompanyPermits.Insert())
{
    <div class=row>
        <div class="col">
            <BlazorButton Template="TemplateButton.New" Text="Nuovo" OnClick="NewItem"></BlazorButton>
           
        </div>
    </div>
}
@if (_ticketInterventions != null)
{
    <RadzenDataGrid @ref="grdInterventions"  IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_ticketInterventions" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true" Responsive="true"
    PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="TicketIntervention">
    <Columns>
        <RadzenDataGridColumn TItem="TicketIntervention" Property="@nameof(TicketIntervention.StartDateTime)" Title="@Localize["Data Inizio"]"  />
       
        <RadzenDataGridColumn TItem="TicketIntervention" Property="@nameof(TicketIntervention.EndDateTime)" Title="@Localize["Data Fine"]" />
        <RadzenDataGridColumn  TItem="TicketIntervention"  Property="UserName" Title="@Localize["User Name"]"  Filterable="true" FilterProperty="User.UserName" FilterValue="@_filterUserName" FilterOperator="FilterOperator.Contains"  
            SortProperty="User.UserName">
        
        </RadzenDataGridColumn>
         
        <RadzenDataGridColumn  Context="item"  TItem="TicketIntervention" Property="@nameof(TicketIntervention.SupportType)" Title="@Localize["Tipo Intervento"]"  Filterable="true" Sortable="true" TextAlign="Radzen.TextAlign.Left" 
            FilterProperty="@nameof(TicketIntervention.SupportType)" FilterValue="@_supportTypes">
            <Template Context="item">
                @(UtilityHelper.GetDisplayName(((TypesSupport)item.SupportType)))
               
            </Template>
            <FilterTemplate> 
               
               <FilterEnum TItem="TypesSupport" @bind-Value=@_supportTypes OnClickClose="OnCloseFilter" UniqueID="@grdInterventions.UniqueID" Property=@nameof(TicketIntervention.SupportType) ></FilterEnum>
            </FilterTemplate>
            
        </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TicketIntervention" Context="item" Title="@TranslateHelper.GetDisplayName(nameof(TicketModel.MinuteWorkFormatted), typeof(TicketModel))" Filterable=false>
            <Template>
                <span>@DateTimeHelper.MinuteFormat(item.Minute)</span>
            </Template>
            @*<FooterTemplate>
                @Localize["Total Intervention Time"]: <b> @_ticketView.Total</b>
            </FooterTemplate>*@
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item" TItem="TicketIntervention"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
            <Template Context="item">
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Secondary" Icon="format_list_bulleted" title="Dettagli" Disabled=@(!item.Permits.Read())  Size="Radzen.ButtonSize.Medium" Click="@(args => Details(item.Id))">
                    </RadzenButton>
                     <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="edit" Size="Radzen.ButtonSize.Medium" title="Edit" Disabled=@(!item.Permits.Edit()) Click="@(args => Edit(item.Id))">
                    </RadzenButton>
                     <RadzenButton ButtonStyle="Radzen.ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.Medium" title="Elimina" Disabled=@(!item.Permits.Delete()) Click="@(args => Delete(item.Id))">
                    </RadzenButton>
                    
                                   
            </Template>
        </RadzenDataGridColumn>
       
    </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}