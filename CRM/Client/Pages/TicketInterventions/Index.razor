@page "/TicketInterventions"
@page "/TicketInterventions/Index"
@page "/Tickets/{IdTicket:int}/interventions"
@page "/Projects/{IdProject:int}/Tickets/{IdTicket:int}/interventions"
@page "/Companies/{IdCompany:int}/Tickets/{IdTicket:int}/interventions"

@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters

<PageHeader PageMode=@PageMode>
</PageHeader>
@if (_ticketInterventions != null)
{
    <RadzenDataGrid class="ticket-interventions-grid" @ref="grdInterventions"  IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_ticketInterventions" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true" Responsive="true"
    PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="TicketIntervention">

        <HeaderTemplate>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                @if (_user != null && _user.CompanyPermits.Insert())
                {
                    <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
                }

                @* Chi e quando: la domanda "cosa ha fatto Tizio quel giorno" si pone qui, non
                   aprendo due filtri di colonna. Dentro un ticket non servono. *@
                @if (IdTicket == null)
                {
                    <RadzenDropDown TValue="string" @bind-Value="_idUserFiltro" Data="@_utenti"
                                    TextProperty="NameComplete" ValueProperty="Id" AllowClear="true"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@Localize["Chi"]" Style="width: 220px;"
                                    Change="@(async _ => await CambiaFiltroLavoro())" />

                    <RadzenDatePicker TValue="DateTime?" @bind-Value="_giornoFiltro" DateFormat="dd/MM/yyyy"
                                      AllowClear="true" Placeholder="@Localize["Giorno"]" Style="width: 170px;"
                                      Change="@(async _ => await CambiaFiltroLavoro())" />

                    @if (_idUserFiltro != null || _giornoFiltro != null)
                    {
                        <RadzenButton Icon="close" Text="@Localize["Azzera"]" ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small" Click="@AzzeraFiltroLavoro" />
                        <span class="ms-2">@_paging.TotalCount @Localize["interventi"]</span>
                    }
                }
            </div>
        </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="TicketIntervention" Property="@nameof(TicketIntervention.StartDateTime)" Title="@Localize["Date"]"  />

        @* Su cosa ha lavorato. Senza queste, l'elenco dice quante ore ma non su quale macchina.
           Non ordinabili ne' filtrabili: sono campi di comodo, sull'entita' non esistono e
           l'ordinamento del server lavora sull'entita'. *@
        @if (IdTicket == null)
        {
            <RadzenDataGridColumn TItem="TicketIntervention" Context="item" Title="@Localize["Ticket"]"
                                  Sortable="false" Filterable="false" Width="220px">
                <Template Context="item">
                    <a href="@($"/Tickets/{item.IdTicket}/Info")">@item.TicketNumero</a>
                    @if (!string.IsNullOrWhiteSpace(item.Cliente))
                    {
                        <div style="font-size:.85em;color:var(--crm-text-muted,#9e9e9e);">@item.Cliente</div>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="TicketIntervention" Context="item" Title="@Localize["Commessa"]"
                                  Sortable="false" Filterable="false" Width="150px">
                <Template Context="item">
                    @item.Commessa
                </Template>
            </RadzenDataGridColumn>
        }
       
        @* <RadzenDataGridColumn TItem="TicketIntervention" Property="@nameof(TicketIntervention.EndDateTime)" Title="@Localize["Data Fine"]" /> *@
        <RadzenDataGridColumn  TItem="TicketIntervention"  Property="UserName" Title="@Localize["User Name"]"  Filterable="true" FilterProperty="User.UserName" FilterValue="@_filterUserName" FilterOperator="FilterOperator.Contains"  
            SortProperty="User.UserName">
        
        </RadzenDataGridColumn>
         
        <RadzenDataGridColumn  Context="item"  TItem="TicketIntervention" Property="@nameof(TicketIntervention.SupportType)" Title="@Localize["Tipo Intervento"]"  Filterable="true" Sortable="true" TextAlign="Radzen.TextAlign.Left" 
            FilterProperty="@nameof(TicketIntervention.SupportType)" FilterValue="@_supportTypes">
            <Template Context="item">
                @(UtilityHelper.GetDisplayName(((TypesSupport)item.SupportType)))
               
            </Template>
            <FilterTemplate> 
               
               <FilterEnum TItem="TypesSupport" @bind-Value=@_supportTypes OnClickClose="OnCloseFilter" UniqueID="@grdInterventions.UniqueID" Property=@nameof(TicketIntervention.SupportType) ></FilterEnum>
            </FilterTemplate>
            
        </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TicketIntervention" Context="item" Title="@TranslateHelper.GetDisplayName(nameof(TicketDTO.MinuteWorkFormatted), typeof(TicketDTO))" Filterable=false>
            <Template>
                <span>@DateTimeHelper.MinuteFormat(item.Minute)</span>
            </Template>
            @*<FooterTemplate>
                @Localize["Total Intervention Time"]: <b> @_ticketView.Total</b>
            </FooterTemplate>*@
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item" TItem="TicketIntervention"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id)) Disabled=@(!item.Permits.Edit())></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item.Id)) Disabled=@(!item.Permits.Delete())></RedGButton>

                </Template>
        </RadzenDataGridColumn>
       
    </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}
