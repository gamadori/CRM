
@if (Articles != null && Articles.Any())
{
    <RadzenDataGrid class="ticket-interventions-grid" @ref="_articlesGrid" AllowFiltering="true"  AllowSorting="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"  EmptyText="@Localize["Nessun Dispositivo"]"
                    Data="@Articles" TItem="TicketInterventionArticleModel">
        <Columns>
            <RadzenDataGridColumn TItem="TicketInterventionArticleModel" Property="@nameof(TicketInterventionArticleModel.Product)" Title="@Localize["Tipo Prodotto"]" />

            <RadzenDataGridColumn TItem="TicketInterventionArticleModel" Property="@nameof(TicketInterventionArticleModel.Article)" Title="@Localize["Article"]" />
            
            <RadzenDataGridColumn TItem="TicketInterventionArticleModel" Property="@nameof(TicketInterventionArticleModel.Description)" Title="@Localize["Descrizione"]" />


        </Columns>
</RadzenDataGrid>
}
