@page "/TicketInterventions/ReportViewer/{Id:int}"
@layout EmptyLayout

<div class="card shadow-sm" style="display:flex; flex-direction:column; height:100vh; margin:0; box-sizing:border-box;">
    
    <!-- Toolbar -->
    <div class="card-header d-flex flex-wrap gap-2 align-items-center" style="flex:0 0 auto; background-color: #f8f9fa;">
        <button type="button" class="btn btn-sm btn-light" @onclick="GoToDetails">
            <i class="material-icons middle text-secondary">article</i>
            <span class="ps-2 text-secondary">Dati Intervento</span>
        </button>

        <!-- ? NUOVO: Bottone Firma -->
        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenSignatureOverlay" disabled="@_isSigning">
            <i class="material-icons middle">draw</i>
            <span class="ps-2">@(_hasSignature ? "Rifirma Documento" : "Firma Documento")</span>
        </button>

        <!-- ? NUOVO: Bottone Rinvio Email (visibile solo se firma PENDING) -->
        @if (_signatureStatus == "Pending" && !string.IsNullOrEmpty(_signatureEmail))
        {
            <button type="button" class="btn btn-sm btn-warning" @onclick="OpenResendConfirmationDialog" disabled="@_isSending">
                <i class="material-icons middle">forward_to_inbox</i>
                <span class="ps-2">@(_isSending ? "Invio..." : "Rinvia Email Conferma")</span>
            </button>
            <small class="text-muted">
                <i class="material-icons" style="font-size:14px; vertical-align:middle;">schedule</i>
                Conferma firma in attesa per: @_signatureEmail
            </small>
        }

        <button type="button" class="btn btn-sm btn-light" @onclick="ReportUploadDialog">
            <i class="material-icons middle text-secondary">file_upload</i>
            <span class="ps-2 text-secondary">Carica Report</span>
        </button>

        <button type="button" class="btn btn-sm btn-light" @onclick="ReportCreatePrepare">
            <i class="material-icons middle text-secondary">description</i>
            <span class="ps-2 text-secondary">Ricrea Report</span>
        </button>

        <button type="button" class="btn btn-sm btn-light" @onclick="DownloadReport">
            <i class="material-icons middle text-secondary">download</i>
            <span class="ps-2 text-secondary">Download</span>
        </button>

        <div class="btn-group" role="group">
            <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="material-icons middle text-secondary">attach_email</i>
                <span class="ps-2 text-secondary">Email</span>
            </button>
            <ul class="dropdown-menu">
                <li>
                    <button class="dropdown-item" @onclick="OpenSendEmail">
                        <i class="material-icons middle text-secondary">send</i>
                        <span class="ps-2 text-secondary">Invia per Email</span>
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" @onclick="OpenEmailSent">
                        <i class="material-icons middle text-secondary">all_inbox</i>
                        <span class="ps-2 text-secondary">Storico Email</span>
                    </button>
                </li>
            </ul>
        </div>

        <button type="button" class="btn btn-sm btn-secondary ms-auto" @onclick="Close">
            <i class="material-icons middle">close</i>
            <span class="ps-2">Chiudi</span>
        </button>
    </div>

    <!-- PDF Viewer Area -->
    <div @ref="containerRef" class="card-body" style="flex:1 1 auto; padding:0; overflow:hidden; position:relative;">
        
        @if (!_loaded)
        {
            <!-- Spinner di caricamento -->
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.9); z-index:1000;">
                <div style="text-align:center;">
                    <div class="spinner-border text-primary" role="status" style="width:3rem; height:3rem;">
                        <span class="visually-hidden">@_loadingMessage</span>
                    </div>
                    <div class="mt-3 text-muted">@_loadingMessage</div>
                </div>
            </div>
        }

        <!-- Contenitore PDF -->
        <div id="pdfHost" @ref="pdfHostRef" style="width:100%; height:100%;"></div>
    </div>
</div>

<!-- ? NUOVO: Overlay Firma SENZA OTP (Conferma Email) -->
<SignatureOverlay Visible="@_showSignatureOverlay"
                  Title="Firma del Cliente"
                  Width="700"
                  Height="300"
                  RequireOtp="true"
                  OnOtpRequired="OnSignatureWithEmailConfirmation"
                  OnCancelled="@(() => _showSignatureOverlay = false)" IdCompany="_ticketIntervention?.Ticket?.IdCompany" />
