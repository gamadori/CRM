@page "/TicketsIntervention/PendingSignatures"
@using CRM.Client.Services
@using Radzen
@using Radzen.Blazor
@using Microsoft.Extensions.Localization
@using CRM.Shared
@using CRM.Client.Helpers
@using System.Net.Http.Json

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <span class="material-icons text-warning" style="font-size: 48px;">draw</span>
                <div>
                    <h2 class="fw-bold text-dark mb-1">Interventi con Firma in Attesa</h2>
                    <p class="text-muted mb-0">Interventi che richiedono conferma firma tramite email</p>
                </div>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <Waiting></Waiting>
    }
    else if (_interventions == null || !_interventions.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <span class="material-icons text-success" style="font-size: 64px;">check_circle</span>
                <h4 class="mt-3 text-muted">Nessun intervento in attesa di conferma firma</h4>
                <p class="text-muted">Tutti gli interventi firmati sono stati confermati!</p>
                <RedGButton Icon="arrow_back" Text="Torna alla Dashboard" Click="@(() => NavigationManager.NavigateTo("/"))" ButtonStyle="ButtonStyle.Secondary" class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <!-- Toolbar -->
        <div class="row mb-3">
            <div class="col-12">
                <RadzenCard>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-warning text-dark" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                @_interventions.Count interventi in attesa
                            </span>
                        </div>
                        <RedGButton Icon="refresh" Text="Aggiorna" Click="LoadData" ButtonStyle="ButtonStyle.Secondary" />
                    </div>
                </RadzenCard>
            </div>
        </div>

        <!-- Lista Interventi -->
        <div class="row g-4">
            @foreach (var intervention in _interventions)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <RadzenCard class="h-100 shadow-sm border-warning border-2" style="cursor: pointer;" @onclick="@(() => GoToDetails(intervention.IdTicket, intervention.Id))">
                        <!-- Header Card -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    <span class="material-icons" style="vertical-align: middle; font-size: 20px;">build</span>
                                    Intervento #@intervention.Id
                                </h5>
                                <small class="text-muted">Ticket #@intervention.IdTicket</small>
                            </div>
                            <span class="badge bg-warning text-dark">
                                <i class="material-icons" style="font-size: 14px; vertical-align: middle;">schedule</i>
                                Pending
                            </span>
                        </div>

                        <!-- Info Firma -->
                        <div class="alert alert-warning mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <i class="material-icons" style="font-size: 20px;">mail</i>
                                <div class="flex-grow-1">
                                    <strong class="d-block mb-1">@intervention.SignatureName</strong>
                                    <small class="d-block text-muted">@intervention.SignatureEmail</small>
                                    @if (intervention.SignatureDate.HasValue)
                                    {
                                        <small class="d-block mt-1">
                                            <i class="material-icons" style="font-size: 12px; vertical-align: middle;">schedule</i>
                                            Firmato: @intervention.SignatureDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Dettagli Intervento -->
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="material-icons text-primary" style="font-size: 18px;">calendar_today</i>
                                <span>@intervention.StartDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(intervention.UserName))
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="material-icons text-primary" style="font-size: 18px;">person</i>
                                    <span>@intervention.UserName</span>
                                </div>
                            }
                            <div class="d-flex align-items-center gap-2">
                                <i class="material-icons text-primary" style="font-size: 18px;">access_time</i>
                                <span>@intervention.Minute minuti</span>
                            </div>
                        </div>

                        <!-- Azioni -->
                        <div class="d-flex gap-2 mt-auto">
                            <RedGButton Icon="visibility" Text="Dettagli" Click="@(() => GoToDetails(intervention.IdTicket, intervention.Id))" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="flex-grow-1" />
                            <RedGButton Icon="forward_to_inbox" Text="Rinvia Email" Click="@(async () => await ResendEmail(intervention.Id))" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" />
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject]
    private IBaseRestService<TicketIntervention, TicketInterventionFilter, int> _service { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; } = default!;

    private List<TicketIntervention> _interventions = new();

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Ottieni tutti gli interventi con firma pending
            var filter = new TicketInterventionFilter
            {
                OrderBy = "StartDateTime desc",
                SignaturePending = true

            };

            var resp = await _service.GetList(filter);

            if (resp != null)
            {
                _interventions = resp.Items;

                
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore caricamento interventi: {ex.Message}");
            await DialogService.Alert("Errore durante il caricamento degli interventi", "Errore");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void GoToDetails(int idTicket, int id)
    {
        NavigationManager.NavigateTo($"/Tickets/{idTicket}/intervention/{id}");
    }

    private async Task ResendEmail(int id)
    {
        var intervention = _interventions.FirstOrDefault(x => x.Id == id);
        if (intervention == null) return;

        var result = await DialogService.OpenAsync<CRM.Client.Shared.Components.ResendConfirmationEmailDialog>(
            "Rinvia Email Conferma Firma",
            new Dictionary<string, object>
            {
                { "CurrentEmail", intervention.SignatureEmail ?? string.Empty },
                { "SignerName", intervention.SignatureName ?? string.Empty }
            },
            new DialogOptions { Width = "500px", Height = "auto" }
        );

        if (result is string newEmail && !string.IsNullOrWhiteSpace(newEmail))
        {
            try
            {
                var response = await Http.PostAsJsonAsync(
                    $"{ConstHelper.TicketsInterventionsPath}/ResendSignatureConfirmation/{id}",
                    new { Email = newEmail }
                );

                if (response.IsSuccessStatusCode)
                {
                    intervention.SignatureEmail = newEmail;
                    
                    await DialogService.Alert(
                        $"Email di conferma rinviata con successo a: {newEmail}",
                        "Successo",
                        new AlertOptions { OkButtonText = "OK" }
                    );
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    await DialogService.Alert($"Errore: {error}", "Errore");
                }
            }
            catch (Exception ex)
            {
                await DialogService.Alert($"Errore: {ex.Message}", "Errore");
            }
        }
    }
}
