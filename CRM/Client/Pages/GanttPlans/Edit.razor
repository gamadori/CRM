@page "/Settings/GanttPlans/New"
@page "/Settings/GanttPlans/{Id:int}/Edit"
@using CRM.Client.Helpers
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Client.Shared.Components
@using CRM.Shared
@using CRM.Shared.DTOs
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IGanttPlanService GanttPlanService
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject NotificationService Notification

<PageHeader Model="_pageHeader"></PageHeader>

@if (_plan == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="_plan" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0">Dati template</h6>
            </div>
            <div class="card-body">
                <div class="row g-3 plan-fields">
                    <div class="col-md-8">
                        <label class="form-label">Nome</label>
                        <input class="form-control" @bind="_plan.Name" />
                        <ValidationMessage For="@(() => _plan.Name)" />
                    </div>
                    <div class="col-md-4">
                        @* .rz-dropdown e' inline-flex e si dimensiona sul contenuto: la label d-block lo
                           manda a capo, la larghezza piena arriva dal CSS scoped (vedi .plan-fields). *@
                        <label class="form-label d-block">Stato</label>
                        <RadzenDropDown TValue="GanttPlanStates" @bind-Value="_plan.State" Data="_states"
                                        TextProperty="Text" ValueProperty="Value" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descrizione</label>
                        <textarea class="form-control" rows="3" @bind="_plan.Description"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <RedGDetailActions Class="mt-3">
            <RedGButton RGButtonType="RGButtonType.Back" Text="Annulla" Click="Cancel" />
            <RedGButton RGButtonType="RGButtonType.Save" ButtonType="ButtonType.Submit"
                        Text="@(_saving ? "Salvataggio..." : "Salva")" Disabled="@_saving" />
        </RedGDetailActions>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private PageHeaderModel? _pageHeader;
    private GanttPlanDTO? _plan;
    private bool _saving;

    private record StateOption(string Text, GanttPlanStates Value);
    private readonly List<StateOption> _states = new()
    {
        new("Bozza", GanttPlanStates.Draft),
        new("Attivo", GanttPlanStates.Active),
        new("Archiviato", GanttPlanStates.Archived),
    };

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();

        _plan = Id > 0
            ? await GanttPlanService.GetItemAsync(Id)
            : new GanttPlanDTO { State = GanttPlanStates.Draft };

        if (_plan == null)
        {
            Notification.Notify(NotificationSeverity.Error, "Errore", "Template Gantt non trovato");
            Nav.NavigateTo("/Settings/GanttPlans");
        }
    }

    private async Task Save()
    {
        if (_plan == null) return;

        _saving = true;
        try
        {
            var resp = await GanttPlanService.SaveAsync(_plan);
            if (!resp.State)
            {
                Notification.Notify(NotificationSeverity.Error, "Errore", resp.Message ?? "Salvataggio fallito");
                return;
            }

            // Dopo il salvataggio si torna al dettaglio, da cui si gestiscono le fasi.
            var savedId = resp.Data?.Id ?? Id;
            Nav.NavigateTo(savedId > 0 ? $"/Settings/GanttPlans/{savedId}/Details" : "/Settings/GanttPlans");
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
        => Nav.NavigateTo(Id > 0 ? $"/Settings/GanttPlans/{Id}/Details" : "/Settings/GanttPlans");
}
