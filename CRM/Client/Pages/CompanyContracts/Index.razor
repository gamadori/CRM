@page "/CompanyContracts"
@page "/CompanuContracts/Index"


@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters



@if (_companyContracts != null)
{

   
    <RadzenSelectBar @bind-Value="_selectView" TValue="CompanyContractsViews" Change="Change" Style="margin-bottom: 10px;">
        <Items>
            <RadzenSelectBarItem Text=@Localize["Contratti Attivi"] Value="CompanyContractsViews.Active" />
            <RadzenSelectBarItem Text=@Localize["Storico Contratti"] Value="CompanyContractsViews.Historic" />
            
        </Items>
    </RadzenSelectBar>

    
    <div class=row>

        
        <div class="col">
            <BlazorButton Template="TemplateButton.New" Label=true OnClick="NewItem"></BlazorButton>
        
        </div>
    </div>

    <RadzenDataGrid @ref="_grdProductTypeAccType" IsLoading="@_isLoading" Responsive=true Count="@_companyContracts.Items.Count" Data="@_companyContracts.Items" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode=@_filterMode
                AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="CompanyContract" EmptyText=@Localize["No Contracts"] CellRender="@CellRender">
        <Columns>


            <RadzenDataGridColumn Context="item" TItem="CompanyContract" Title="@TranslateHelper.GetDisplayName(nameof(CompanyContract.ContractName), typeof(CompanyContract))" Property="@nameof(CompanyContract.ContractName)" FilterProperty="Language" />

            <RadzenDataGridColumn TItem="CompanyContract" Property=@nameof(CompanyContract.DateFrom) Title="@TranslateHelper.GetDisplayName(nameof(CompanyContract.DateFrom), typeof(CompanyContract))" />
            <RadzenDataGridColumn TItem="CompanyContract" Property=@nameof(CompanyContract.DateTo) Title="@TranslateHelper.GetDisplayName(nameof(CompanyContract.DateTo), typeof(CompanyContract))" />

            <RadzenDataGridColumn TItem="CompanyContract" Filterable=false Property=@nameof(CompanyContract.Active) TextAlign="TextAlign.Center" Title="@TranslateHelper.GetDisplayName(nameof(CompanyContract.Active), typeof(CompanyContract))">
                <Template Context="data">
                    @if (data.Active)
                    {
                        if (data.Suspended)
                        {
                            <span style='color: var(--rz-text-contrast-color)'>
                                @Localize["Suspended"]
                            </span>
                        }
                        else
                        {
                            <span style='color: var(--rz-text-contrast-color)'>@Localize["Active"]</span>
                        }
                    }
                    else
                    {
                        <span style='color: var(--rz-text-contrast-color)'>@Localize["Expired"]</span>
                    }
                </Template>
            </RadzenDataGridColumn>

           

            <RadzenDataGridColumn Context="item" TItem="CompanyContract" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Secondary" Icon="format_list_bulleted" title="Dettagli"  Size="Radzen.ButtonSize.Medium" Click="@(args => Details(item.Id))">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="edit" Size="Radzen.ButtonSize.Medium" title="Edit" Visible=@_user.ArticlePermits.Edit() Click="@(args => Edit(item.Id))">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.Medium" title="Elimina" Visible=@_user.ArticlePermits.Delete() Click="@(args => Delete(item.Id))">
                    </RadzenButton>
                   
                </Template>
           
            </RadzenDataGridColumn>
       
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}

    
    