@page "/CompanyContracts/{Id:int}/Details"
@using CRM.Shared.Helper

<BlazorHeader Header="@_header"></BlazorHeader>

@if (_item == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="description" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _item.ContractName)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.ContractName</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="event">
                <LabelContent><DisplayName For="@(() => _item.DateFrom)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.DateFrom</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="event_available">
                <LabelContent><DisplayName For="@(() => _item.DateTo)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.DateTo</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="pause_circle">
                <LabelContent><DisplayName For="@(() => _item.Suspended)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Suspended</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="check_circle">
                <LabelContent><DisplayName For="@(() => _item.Active)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Active</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="euro">
                <LabelContent><DisplayName For="@(() => _item.Price)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Price</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Contracts List"]" OnClick="Annulla" />
                @if (_item.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}