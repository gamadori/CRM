@page "/"
@page "/DashBoard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Radzen
@using Radzen.Blazor

@if (_model == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="dashboard-page">

        <!-- Header -->
        <div class="dash-header">
            <div>
                <h2 class="dash-title">Dashboard</h2>
                <p class="dash-subtitle">Pannello di controllo</p>
            </div>
            <RedGButton Icon="refresh" Text="Aggiorna" Click="ReloadDashboard" ButtonStyle="ButtonStyle.Light" />
        </div>

        <!-- Toolbar: utente + azioni -->
        @if (!_model.IsClient && _users != null)
        {
            <div class="dash-toolbar">
                <div class="toolbar-user">
                    <RedGDropDownGrid Label="@Localize["User"]" TItem="ApplicationUser" @bind-value="@_userId" TValue="string" Data="@_users" Change="OnChangeIdUser" TextProperty="NameComplete" ValueProperty="Id">
                        <ChildColumns>
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />
                        </ChildColumns>
                    </RedGDropDownGrid>
                </div>
                <div class="toolbar-actions">
                    <RedGButton Icon="add_box" Text="@Localize["Nuovo Ticket"]" Click="AddTicket" ButtonStyle="ButtonStyle.Primary" class="tb-btn tb-primary" />
                    <RedGButton Icon="list" Text="@Localize["Storico TICKETS"]" Click="TicketAll" ButtonStyle="ButtonStyle.Light" class="tb-btn" />
                    <RedGButton Icon="event_note" Text="Pianificazione Ticket" Click="Schedule" ButtonStyle="ButtonStyle.Light" class="tb-btn" />
                    <RedGButton Icon="manage_search" Text=@Localize["Ricerca Ticket"] Click="TicketsSearch" ButtonStyle="ButtonStyle.Light" class="tb-btn" />
                    <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                        <RedGButton Icon="money" Text="@Localize["Ticket da Fatturare"]" Click="TicketsToInvoice" ButtonStyle="ButtonStyle.Light" class="tb-btn" />
                    </AuthorizeView>
                </div>
            </div>
        }

        <!-- Metriche -->
        <div class="metric-grid">
            <div class="metric-tile tile-warning" @onclick="TicketNotAssigned">
                <div class="metric-icon"><span class="material-icons">assignment_late</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.TicketsNotAssigned</div>
                    <div class="metric-label">Non assegnati</div>
                </div>
            </div>

            <div class="metric-tile tile-success" @onclick="TicketWorking">
                <div class="metric-icon"><span class="material-icons">engineering</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.TicketsWorking</div>
                    <div class="metric-label">In lavorazione</div>
                </div>
            </div>

            <div class="metric-tile tile-danger" @onclick="TicketExpired">
                <div class="metric-icon"><span class="material-icons">schedule</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.TicketsExpired</div>
                    <div class="metric-label">Scaduti</div>
                </div>
            </div>

            <div class="metric-tile tile-info" @onclick="TicketsNewMessage">
                <div class="metric-icon"><span class="material-icons">chat</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.ChatMessageToRead</div>
                    <div class="metric-label">Nuovi messaggi</div>
                </div>
            </div>

            @if (!_model.IsClient && _model.InboundEmailsToHandle > 0)
            {
                <div class="metric-tile tile-indigo" @onclick="InboundEmailsToHandle">
                    <div class="metric-icon"><span class="material-icons">move_to_inbox</span></div>
                    <div class="metric-text">
                        <div class="metric-value">@_model.InboundEmailsToHandle</div>
                        <div class="metric-label">Email in arrivo</div>
                    </div>
                </div>
            }

            @if (_model.InterventionsPendingSignature > 0)
            {
                <div class="metric-tile tile-orange" @onclick="InterventionsPendingSignature">
                    <div class="metric-icon"><span class="material-icons">draw</span></div>
                    <div class="metric-text">
                        <div class="metric-value">@_model.InterventionsPendingSignature</div>
                        <div class="metric-label">Firme pending</div>
                    </div>
                </div>
            }

            @if (_model.UsersNeedConfirm > 0)
            {
                <div class="metric-tile tile-violet" @onclick="UsersNeedConfirm">
                    <div class="metric-icon"><span class="material-icons">person_add</span></div>
                    <div class="metric-text">
                        <div class="metric-value">@_model.UsersNeedConfirm</div>
                        <div class="metric-label">Utenti da confermare</div>
                    </div>
                </div>
            }

            <div class="metric-tile tile-primary">
                <div class="metric-icon"><span class="material-icons">assignment_ind</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.TicketAssigned</div>
                    <div class="metric-label">Assegnati a me</div>
                </div>
            </div>

            <div class="metric-tile tile-teal">
                <div class="metric-icon"><span class="material-icons">assignment_turned_in</span></div>
                <div class="metric-text">
                    <div class="metric-value">@_model.TicketsClosed</div>
                    <div class="metric-label">Ticket chiusi</div>
                </div>
            </div>

            @if (_model.UnreadFeedbacksCount > 0)
            {
                <div class="metric-tile tile-warning clickable" @onclick="ViewAllFeedbacks">
                    <div class="metric-icon"><span class="material-icons">star_rate</span></div>
                    <div class="metric-text">
                        <div class="metric-value">@_model.UnreadFeedbacksCount</div>
                        <div class="metric-label">Feedback da leggere</div>
                    </div>
                </div>
            }
        </div>

        <!-- Media valutazioni clienti -->
        @if (_averageFeedback != null && _averageFeedback.Companies.Any())
        {
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">
                        <span class="material-icons" style="color:#f59e0b;">analytics</span>
                        <span>Media valutazioni clienti</span>
                    </div>
                    <div class="overall-rating">
                        <span class="overall-caption">Media globale</span>
                        <div class="overall-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var filled = i <= Math.Round(_averageFeedback.OverallAverage);
                                <span class="material-icons @(filled ? "star-filled" : "star-empty")">star</span>
                            }
                        </div>
                        <span class="overall-value">@_averageFeedback.OverallAverage.ToString("0.0")</span>
                        <span class="overall-count">(@_averageFeedback.TotalFeedbacks)</span>
                    </div>
                </div>

                <div class="dash-card-body">
                    <div class="company-ratings-grid">
                        @foreach (var company in _averageFeedback.Companies.OrderByDescending(c => c.Average).Take(6))
                        {
                            <div class="company-rating-card">
                                <div class="company-rating-header">
                                    <span class="company-name" title="@company.Name">@TruncateCompanyName(company.Name)</span>
                                    <span class="company-feedbacks">@company.TotalFeedbacks</span>
                                </div>
                                <div class="rating-bar-container">
                                    <div class="rating-bar" style="width: @(company.Average / 5 * 100)%; background: @GetRatingColor(company.Average);"></div>
                                </div>
                                <div class="rating-details">
                                    <div class="rating-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            var filled = i <= Math.Round(company.Average);
                                            <span class="material-icons star-sm @(filled ? "star-filled" : "star-empty")">star</span>
                                        }
                                    </div>
                                    <span class="rating-value">@company.Average.ToString("0.0")</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_averageFeedback.Companies.Count > 6)
                    {
                        <div class="dash-card-foot">
                            <RedGButton Icon="visibility" Text="@GetViewAllButtonText()" Click="ViewAllFeedbacks" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Feedback recenti -->
        @if (_model.UnreadFeedbacksCount > 0 || (_model.RecentFeedbacks != null && _model.RecentFeedbacks.Any()))
        {
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">
                        <span class="material-icons text-primary">rate_review</span>
                        <span>Feedback dai clienti</span>
                        @if (_model.UnreadFeedbacksCount > 0)
                        {
                            <span class="pill-new">@_model.UnreadFeedbacksCount nuovi</span>
                        }
                    </div>
                    <RedGButton Icon="visibility" Text="Vedi tutti" Click="ViewAllFeedbacks" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                </div>

                <div class="dash-card-body">
                    @if (_model.RecentFeedbacks != null && _model.RecentFeedbacks.Any())
                    {
                        <div class="feedback-list">
                            @foreach (var feedback in _model.RecentFeedbacks)
                            {
                                <div class="feedback-item @(feedback.IsRead ? "" : "unread")" @onclick="() => ViewTicketDetails(feedback.TicketId)">
                                    <div class="feedback-header">
                                        <div class="feedback-info">
                                            <span class="feedback-company">@feedback.CompanyName</span>
                                            <span class="feedback-ticket">Ticket #@feedback.TicketId</span>
                                        </div>
                                        <div class="feedback-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="material-icons star @(i <= feedback.Rating ? "filled" : "")">star</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(feedback.Comment))
                                    {
                                        <p class="feedback-comment">"@feedback.Comment"</p>
                                    }
                                    else
                                    {
                                        <p class="feedback-comment no-comment"><em>Nessun commento</em></p>
                                    }
                                    <div class="feedback-footer">
                                        <span class="feedback-meta">
                                            <span class="material-icons">person</span>@feedback.UserName
                                        </span>
                                        <span class="feedback-meta">
                                            <span class="material-icons">schedule</span>@feedback.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dash-empty">
                            <span class="material-icons">sentiment_satisfied</span>
                            <p>Nessun feedback recente</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
