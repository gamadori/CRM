@page "/"
@page "/DashBoard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@if (_model == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="container-fluid px-4 py-3 dashboard-page">
        <!-- Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-hero">
                    <h2 class="fw-bold text-dark mb-1 dashboard-title">Dashboard</h2>
                    <p class="text-muted dashboard-subtitle">Benvenuto nel tuo pannello di controllo</p>
                </div>
            </div>
        </div>

        <!-- User Selection -->
        @if (!_model.IsClient && _users != null)
        {
            <div class="row mb-4">
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm dashboard-toolbar">
                        <div class="card-body">
                            <label class="form-label fw-semibold text-dark mb-2">
                                <span class="material-icons me-2" style="font-size: 18px; vertical-align: middle;">person</span>
                                @Localize["User"]
                            </label>
                            <RadzenDropDownDataGrid class="w-100" @bind-value="@_userId" TValue="string" AllowFiltering="true" AllowClear="true" Change="OnChangeIdUser"
                                                Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                                    <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Toolbar -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-toolbar">
                    <div class="p-3">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary d-flex align-items-center" @onclick="AddTicket">
                                <span class="material-icons me-2" style="font-size: 20px;">add_box</span>
                                <span>@Localize["Nuovo Ticket"]</span>
                            </button>
                            <button type="button" class="btn btn-outline-primary d-flex align-items-center" @onclick="TicketAll">
                                <span class="material-icons me-2" style="font-size: 20px;">list</span>
                                <span>@Localize["Storico TICKETS"]</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary d-flex align-items-center" @onclick="Schedule">
                                <span class="material-icons me-2" style="font-size: 20px;">schedule</span>
                                <span>Scheduler</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary d-flex align-items-center" @onclick="TicketsSearch">
                                <span class="material-icons me-2" style="font-size: 20px;">manage_search</span>
                                <span>Ricerca Ticket</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4">
            <!-- Ticket Non Assegnati -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="TicketNotAssigned" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase small fw-semibold mb-2">TICKET @Localize[TicketTypeSearch.NotAssigned.ToString()]</p>
                                <h3 class="fw-bold mb-0 text-warning">@_model.TicketsNotAssigned</h3>
                            </div>
                            <div class="icon-box bg-warning bg-opacity-10 rounded-3 p-3">
                                <span class="material-icons text-warning" style="font-size: 32px;">support_agent</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ticket In Lavorazione -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="TicketWorking" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase small fw-semibold mb-2">TICKET @Localize[TicketTypeSearch.Working.ToString()]</p>
                                <h3 class="fw-bold mb-0 text-success">@_model.TicketsWorking</h3>
                            </div>
                            <div class="icon-box bg-success bg-opacity-10 rounded-3 p-3">
                                <span class="material-icons text-success" style="font-size: 32px;">support_agent</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ticket Scaduti -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="TicketExpired" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase small fw-semibold mb-2">TICKET @Localize[TicketTypeSearch.Expired.ToString()]</p>
                                <h3 class="fw-bold mb-0 text-danger">@_model.TicketsExpired</h3>
                            </div>
                            <div class="icon-box bg-danger bg-opacity-10 rounded-3 p-3">
                                <span class="material-icons text-danger" style="font-size: 32px;">support_agent</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nuovi Messaggi Chat -->
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="TicketsNewMessage" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase small fw-semibold mb-2">CHAT NUOVI MESSAGGI</p>
                                <h3 class="fw-bold mb-0 text-info">@_model.ChatMessageToRead</h3>
                            </div>
                            <div class="icon-box bg-info bg-opacity-10 rounded-3 p-3">
                                <span class="material-icons text-info" style="font-size: 32px;">chat</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ticket da Fatturare -->
            <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="TicketsToInvoice" style="cursor: pointer;">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="flex-grow-1">
                                    <p class="text-muted text-uppercase small fw-semibold mb-2">TICKET DA FATTURARE</p>
                                </div>
                                <div class="icon-box bg-secondary bg-opacity-10 rounded-3 p-3">
                                    <span class="material-icons text-secondary" style="font-size: 32px;">shopping_cart_checkout</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </AuthorizeView>

            <!-- Utenti da Confermare -->
            @if (_model.UsersNeedConfirm > 0)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 dashboard-card" @onclick="UsersNeedConfirm" style="cursor: pointer;">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="flex-grow-1">
                                    <p class="text-muted text-uppercase small fw-semibold mb-2">UTENTI DA CONFERMARE</p>
                                    <h3 class="fw-bold mb-0 text-info">@_model.UsersNeedConfirm</h3>
                                </div>
                                <div class="icon-box bg-info bg-opacity-10 rounded-3 p-3">
                                    <span class="material-icons text-info" style="font-size: 32px;">people</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}