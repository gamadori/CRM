@page "/TicketStates"
@page "/TicketStates/Index"


<style>
    .rz-grid-table {
        width: unset;
    }
</style>

<RadzenDataGrid @ref="_grdTicketState" AllowAlternatingRows="false" LoadData="@LoadData" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowPaging="true" PageSize="@ConstHelper.PageSize" AllowSorting="true" EditMode="DataGridEditMode.Single"
                Data="@_items" TItem="TicketState" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" Sort="@Reset" Page="@Reset" Filter="@Reset" ColumnWidth="200px">
    <HeaderTemplate>
        <RedGButton RGButtonType="RGButtonType.New" Click="@InsertRow" Disabled="@(_itemsToInsert.Count() > 0)"></RedGButton>
    </HeaderTemplate>

    <Columns>
        <RadzenDataGridColumn Property="@nameof(TicketState.State)" Title="Stato" Width="200px">
            <Template Context="state">
                @Localize[$"eTicketStates{((eTicketStates)state.State).ToString()}"]
            </Template>
            <EditTemplate Context="state">
                <RadzenDropDown TValue="eTicketStates?" @bind-Value="state.idState" Data="@(Enum.GetValues(typeof(eTicketStates)).Cast<eTicketStates>().Select(v => (eTicketStates?)v).ToList())" Name="StateSelect" Style="min-width: 280px; display: block">
                    <Template Context="enumValue">
                        @Localize[$"eTicketStates{((eTicketStates)enumValue).ToString()}"]
                    </Template>
                </RadzenDropDown>

                <RadzenRequiredValidator Text="@Localize["Required"]" Component="StateSelect" Popup="false" />
            </EditTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Property="@nameof(TicketState.Description)" Title="Descrizione" Width="300px">
            <EditTemplate Context="state">
                <RadzenTextBox @bind-Value="state.Description" Style="min-width:300px; display: block" Name="StateDesc" aria-label="Enter State Description" />
                <RadzenRequiredValidator Text="@Localize["Required"]" Component="StateDesc" Popup="false" />
            </EditTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Property="@nameof(TicketState.Color)" Title="Colore" Width="150px">
            <Template Context="state">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 24px; height: 24px; border-radius: 4px; background-color: @state.Color; border: 1px solid var(--crm-border, #ddd);"></div>
                    <span>@state.Color</span>
                </div>
            </Template>
            <EditTemplate Context="state">
                <RadzenColorPicker @bind-Value="state.Color" Style="width: 100%; display: block" ShowHSV="false" ShowRGBA="false" ShowColors="true" Name="StateColorPicker" />
            </EditTemplate>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="state" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="180px">
            <Template Context="state">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(state))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(state))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="state">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(state))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(state))" aria-label="Cancel" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(state))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>