@page "/Products/New"
@page "/Products/{Id:int}/Edit"

@using Radzen
@using Radzen.Blazor
@using CRM.Shared.DTOs



@if (_product == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>

    <EditForm Model="@_product" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_product.Name" For="@(() => _product.Name)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_product.Code" For="@(() => _product.Code)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGDropDown TItem="ProductTypeDTO" TValue="int?" ValueProperty="Id" TextProperty="Name" @bind-Value="@_product.IdProductType" For="@(() => _product.IdProductType)"
                                    Data="_productTypes" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextArea @bind-Value="@_product.Description" For="@(() => _product.Description)" Rows="5" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="Id" TextProperty="RagioneSociale" @bind-Value="@_product.IdCompany" For="@(() => _product.IdCompany)"
                                              Data="_companies" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RadzenLabel Text="Template Gantt produzione" />
                                <div class="d-flex gap-2 align-items-center">
                                    <RadzenDropDown TItem="GanttPlanDTO" TValue="int?" ValueProperty="Id" TextProperty="Display"
                                                    @bind-Value="@_product.IdGanttPlan"
                                                    Data="_ganttPlans"
                                                    AllowFiltering="true"
                                                    AllowClear="true"
                                                    Placeholder="Nessun template Gantt"
                                                    Style="width:100%" />
                                    <RadzenButton Icon="add"
                                                  Text="Crea"
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.Small"
                                                  Click="CreateGanttTemplate"
                                                  Disabled="@string.IsNullOrWhiteSpace(_product.Name)" />
                                </div>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="8">
                            <RadzenStack>
                                <RedGNumeric T="decimal" Format="c" @bind-Value="@_product.Price" For="@(() => _product.Price)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel=true  />
    </EditForm>

}
