@page "/Products/Edit"
@page "/Products/Edit/{Id:int}"

@using Syncfusion.Blazor.DropDowns
@using Radzen
@using Radzen.Blazor

<BlazorHeader Header="@_header"></BlazorHeader>

@if (_product == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="@_product" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <RedGTextBox @bind-Value="@_product.Name" For="@(() => _product.Name)" />

                    <RedGDropDown TItem="ProductType" TValue="int?" ValueProperty="Id" TextProperty="Name" @bind-Value="@_product.IdProductType" For="@(() => _product.IdProductType)"
                                  Data="_productTypes" AllowFiltering="true" />
                    <RedGTextArea @bind-Value="@_product.Description" For="@(() => _product.Description)" Rows="5" />
                    <RedGNumeric T="decimal" Format="c" @bind-Value="@_product.Price" For="@(() => _product.Price)" />

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
        <RedGButton RGButtonType="RGButtonType.Submit" />
    </EditForm>

}