@page "/Products/Import"
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using Radzen
@using Radzen.Blazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

<BlazorHeader Header="Importa Catalogo Prodotti da Excel"></BlazorHeader>
<BlazorBreadCrumb Model="@_bread"></BlazorBreadCrumb>

<content class="p-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center gap-2">
                    <span class="material-icons text-primary">upload_file</span>
                    <h5 class="mb-0">Importa da Excel</h5>
                </div>
                <div class="card-body">

                    <div class="alert alert-info small mb-3">
                        <span class="material-icons" style="font-size:16px;vertical-align:middle;">info</span>
                        <strong>Struttura attesa:</strong><br/>
                        Ogni <strong>foglio</strong> = Tipo Prodotto (ProductType)<br/>
                        Ogni <strong>riga</strong> = Prodotto (Product):<br/>
                        Colonna A = Codice · Colonna B = Nome · Colonna C = Descrizione supplementare
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">File Excel (.xlsx)</label>
                        <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" class="form-control" />
                        @if (_selectedFile != null)
                        {
                            <small class="text-muted mt-1 d-block">
                                <span class="material-icons" style="font-size:14px;vertical-align:middle;">description</span>
                                @_selectedFile.Name (@FormatSize(_selectedFile.Size))
                            </small>
                        }
                    </div>

                    <div class="mb-4 p-3 border border-danger rounded bg-danger bg-opacity-10">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="deleteAll" @bind="_deleteAll" />
                            <label class="form-check-label text-danger fw-semibold" for="deleteAll">
                                <span class="material-icons" style="font-size:16px;vertical-align:middle;">warning</span>
                                Pulisci tutto prima dell'importazione
                            </label>
                        </div>
                        @if (_deleteAll)
                        {
                            <div class="mt-2 small text-danger">
                                <strong>Attenzione:</strong> verranno eliminati tutti gli Articoli, Prodotti e Tipi Prodotto.
                                I Ticket collegati manterranno la storia ma perderanno il collegamento alla macchina/modello.
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <RadzenButton Text="Importa"
                                      Icon="upload"
                                      ButtonStyle="@(_deleteAll ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                      Click="ImportAsync"
                                      Disabled="@(_selectedFile == null || _importing)"
                                      IsBusy="_importing" />
                        <RadzenButton Text="@Localize["Cancel"]"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => NavigationManager.NavigateTo("/Products"))"
                                      Disabled="_importing" />
                    </div>
                </div>
            </div>
        </div>

        @if (_result != null)
        {
            <div class="col-md-6">
                <div class="card shadow-sm @(_result.Success ? "border-success" : "border-danger")">
                    <div class="card-header d-flex align-items-center gap-2 @(_result.Success ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10")">
                        <span class="material-icons @(_result.Success ? "text-success" : "text-danger")">
                            @(_result.Success ? "check_circle" : "error")
                        </span>
                        <h5 class="mb-0">@(_result.Success ? "Importazione completata" : "Importazione fallita")</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Tipi prodotto creati</span>
                                <span class="badge bg-info rounded-pill">@_result.ProductTypesCreated</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Prodotti creati</span>
                                <span class="badge bg-success rounded-pill">@_result.ProductsCreated</span>
                            </li>
                            @if (_result.ProductsUpdated > 0)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Prodotti aggiornati</span>
                                    <span class="badge bg-primary rounded-pill">@_result.ProductsUpdated</span>
                                </li>
                            }
                            @if (_result.RowsSkipped > 0)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Righe saltate</span>
                                    <span class="badge bg-warning rounded-pill">@_result.RowsSkipped</span>
                                </li>
                            }
                        </ul>

                        @if (_result.Errors.Any())
                        {
                            <p class="fw-semibold text-danger mb-1">Dettaglio righe saltate:</p>
                            <ul class="small text-danger" style="max-height:200px;overflow-y:auto;">
                                @foreach (var err in _result.Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</content>

@code {
    [Inject] IBreadCrumbService Bread { get; set; }

    private List<BreadcrumbModel> _bread = new();
    private IBrowserFile? _selectedFile;
    private bool _deleteAll;
    private bool _importing;
    private ProductImportResult? _result;

    protected override async Task OnInitializedAsync()
    {
        _bread = await Bread.Home();
        _bread.Add(new BreadcrumbModel { Title = "Prodotti", Url = "/Products" });
        _bread.Add(new BreadcrumbModel { Title = "Importa Excel", Url = null });
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _result = null;
    }

    private async Task ImportAsync()
    {
        if (_selectedFile == null) return;
        _importing = true;
        _result = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = _selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _selectedFile.Name);
            content.Add(new StringContent(_deleteAll.ToString().ToLower()), "deleteAll");

            var response = await Http.PostAsync("api/Products/import-excel", content);
            if (response.IsSuccessStatusCode)
                _result = await response.Content.ReadFromJsonAsync<ProductImportResult>();
            else
                _result = new ProductImportResult { Success = false, Errors = { $"Errore HTTP {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}" } };
        }
        catch (Exception ex)
        {
            _result = new ProductImportResult { Success = false, Errors = { ex.Message } };
        }
        finally
        {
            _importing = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        var value = (double)bytes;
        var index = 0;
        while (value >= 1024 && index < units.Length - 1) { value /= 1024; index++; }
        return $"{value:0.#} {units[index]}";
    }
}
