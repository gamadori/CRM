@page "/Products"
@page "/Products/Index"
@using Radzen
@using Radzen.Blazor
@using BlazoringComponents.DropDownButton
@using CRM.Client.Shared

<div class="container-fluid px-4 py-3">
    
    @if (IdParent == null)
    {
        <PageHeader 
            Model=@_pageHeader>
        </PageHeader>
    }
    <!-- Products Grid -->
    @if (_products != null)
    {
        <div class="card border-0 shadow-sm">
            
            <div class="card-body p-0">
                <RadzenDataGrid @ref="grdProducts" 
                                Responsive="true" 
                                IsLoading="@_isLoading" 
                                Count="@_paging.TotalCount" 
                                Data="@_products" 
                                LoadData="@LoadData" 
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                                FilterMode="FilterMode.Advanced" 
                                AllowSorting="true" 
                                AllowFiltering="true" 
                                AllowPaging="true" 
                                PageSize="@_productPageSize" 
                                PagerHorizontalAlign="Radzen.HorizontalAlign.Center" 
                                TItem="ProductDTO"
                                class="modern-grid">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center gap-5">
                            <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
                            <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                <Authorized>
                                    <RadzenButton Icon="upload_file" Text="Importa Excel" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo("/Products/Import"))" />
                                </Authorized>
                            </AuthorizeView>
                            <RedGTextBox @bind-Value="@_filter.Name" Label="@Localize["search..."]" @oninput="@OnChangeNameFilter" Style="width: 300px; margin-left: 10px;">
                                <End>
                                    <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                                </End>
                            </RedGTextBox>
                        </div>
            
                    </HeaderTemplate>

                    <Columns>
                        
                        <RadzenDataGridColumn TItem="ProductDTO"
                                            Property="@nameof(ProductDTO.Name)"
                                            Title="@Localize["Name"]">
                            <Template Context="item">
                                <span class="fw-semibold text-dark">@item.Name</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ProductDTO"
                                            Property="@nameof(ProductDTO.Code)"
                                            Title="@TranslateHelper.GetDisplayName(nameof(ProductDTO.Code), typeof(ProductDTO))"
                                            Width="130px">
                            <Template Context="item">
                                @if (!string.IsNullOrWhiteSpace(item.Code))
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">@item.Code</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ProductDTO"
                                            Property="@nameof(ProductDTO.Description)"
                                            Title="@Localize["Description"]">
                            <Template Context="item">
                                <span class="text-muted">@item.Description</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="ProductDTO" 
                                            Property="@nameof(ProductDTO.ProductTypeName)" 
                                            Title="@Localize["ProductType"]"
                                            Width="260px">
                            <Template Context="item">
                                @if (item.ProductTypeName != null)
                                {
                                    <span class="product-type-badge badge bg-info bg-opacity-10 text-info px-3 py-2"
                                          title="@item.ProductTypeName">
                                        <span class="material-icons product-type-icon">@MaterialIcons.ProductType</span>
                                        <span>@item.ProductTypeName</span>
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProductDTO"
                                              Property="@nameof(ProductDTO.CompanyName)"
                                              Title="@Localize["Company"]">
                           
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Context="item" 
                                            TItem="ProductDTO"  
                                            Filterable="false" 
                                            Sortable="false" 
                                            TextAlign="Radzen.TextAlign.Center"
                                            Width="200px"
                                            Title="Azioni">
                            <Template Context="item">
                                    <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                                    <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                                    <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>
                                   
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <Waiting></Waiting>
                <p class="text-muted mt-3">Caricamento prodotti in corso...</p>
            </div>
        </div>
    }
</div>

<style>
    .product-type-badge {
        display: inline-flex;
        align-items: flex-start;
        gap: 0.375rem;
        max-width: 100%;
        white-space: normal;
        line-height: 1.25;
        text-align: left;
        overflow-wrap: anywhere;
    }

    .product-type-icon {
        flex: 0 0 auto;
        margin-top: 1px;
        font-size: 14px;
    }
</style>





