@page "/Settings/ContractTypes/{Id:int}/Details"
@using CRM.Shared.Helper


<PageHeader Model="_pageHeader" Visible=@(OnClickEdit == null)></PageHeader>

@if (_item == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            
            <RedGDetailField Icon="description" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _item.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="check_circle">
                <LabelContent><DisplayName For="@(() => _item.Enabled)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Enabled</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="euro">
                <LabelContent><DisplayName For="@(() => _item.Price)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Price.ToString("C")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="percent">
                <LabelContent><DisplayName For="@(() => _item.Discount)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Discount%</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="sell">
                <LabelContent><DisplayName For="@(() => _item.DiscountedPrice)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.DiscountedPrice.ToString("C")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="schedule">
                <LabelContent><DisplayName For="@(() => _item.Duration)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.Duration</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="notes">
                <LabelContent><DisplayName For="@(() => _item.Description)" /></LabelContent>
                <ChildContent><pre class="mb-0">@_item.Description</pre></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Lista Contract"]" OnClick="Annulla" />
                @if (_item.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}