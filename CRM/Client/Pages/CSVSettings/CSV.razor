@page "/CSVSettings/CSV/{TableName}"

@using BlazoringComponents.ImportDataFile

<BlazorHeader Header="@($"{TableName} CSV Mapping")"></BlazorHeader>

@if (_csvMapping == null)
{
    <Waiting></Waiting>
}
else
{
<CascadingValue Value="_csvMapping" TValue="List<CSVMapping>">
   
    @switch (TableName)
    {
        case "Company":
           <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" TItem="Company" Mapping=true Delimiter="|" OnSubmit="OnSubmit"></CSVImport>
            break;

        case "Category":
            <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" TItem="Product" Mapping=true Delimiter="|" OnSubmit="OnSubmit"></CSVImport>
            break;
        case "Article":
            <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" TItem="Article" Mapping=true Delimiter="|" OnSubmit="OnSubmit"></CSVImport>
            break;
    }
</CascadingValue>
}

