@page "/CSVSettings/CSVData/{TableName}"

@using BlazoringComponents.ImportDataFile

<div class="row">
    <BlazorHeader Header="@($"Importazione {TableName} CSV")"></BlazorHeader>

    @if (_csvMapping == null)
    {
        <Waiting></Waiting>
    }
    else
    {
        @if (_msgError != null)
        {
            <div class="alert alert-danger">
                @_msgError
            </div>
        }
        <div mb-3>
            <CascadingValue Value="_csvMapping" TValue="List<CSVMapping>">
            @switch (TableName)
            {
                case "Company":
                    <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" UrlImport="@($"{ConstHelper.CompaniesPath}/CSV")" TItem="Company" Delimiter="|" OnUploaded="OnUpload" Mapping="false"></CSVImport>
                    break;

                case "Category":
                    <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" UrlImport="@($"{ConstHelper.Products}/CSV")" TItem="Product" Delimiter="|" OnUploaded="OnUpload" Mapping="false"></CSVImport>
                    break;
                case "Article":
                    <CSVImport Url="@($"{ConstHelper.CSVPath}/Preview")" UrlImport="@($"{ConstHelper.ArticlesPath}/CSV")" TItem="Article" Delimiter="|" OnUploaded="OnUpload" Mapping="false"></CSVImport>
                    break;
            }
            </CascadingValue>
        </div>
    }

</div>