@page "/Settings/ContractTypeTicketTypes/{Id:int}/Details"
@using CRM.Shared.Helper

<BlazorHeader Header="@_header" />

@if (_item == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="confirmation_number" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _item.TicketTypeName)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_item.TicketTypeName</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="numbers">
                <LabelContent><DisplayName For="@(() => _item.NumIntervention)" /></LabelContent>
                <ChildContent>
                    @if (_item.Unlimited)
                    {
                        <p class="mb-0 text-dark">@Localize["Unlimited"]</p>
                    }
                    else
                    {
                        <p class="mb-0 text-dark">@_item.NumIntervention</p>
                    }
                </ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Contracts Details"]" OnClick="Annulla" />
                @if (_item.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}