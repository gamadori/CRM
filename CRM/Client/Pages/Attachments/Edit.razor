@page "/Attachments/New"
@page "/Attachments/{Id:int}/Edit"
@using System.IO
@using Microsoft.AspNetCore.Components.Forms

<style>
    .upload-dropzone {
        border: 3px dashed #cbd5e1;
        border-radius: 0.75rem;
        padding: 4rem 2rem;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
    }

    .upload-dropzone:hover {
        border-color: #0d6efd;
        background: #e7f3ff;
    }

    .upload-dropzone input[type="file"] {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        opacity: 0;
        cursor: pointer;
    }

    .upload-icon {
        font-size: 72px;
        color: #0d6efd;
    }

    .file-list-card {
        margin-bottom: 0.5rem;
        padding: 0.5rem;
    }
</style>

<div class="containerleft">
    @if (Id != null)
    {
        <BlazorHeader>@Localize["Edit Attachment"]</BlazorHeader>
    }
    else
    {
        <BlazorHeader>@Localize["New Attachment"]</BlazorHeader>
    }
    @if (_attachment == null)
    {
        <Waiting></Waiting>
    }
    else
    {
        @if (_errorMessage != null)
        {
        <div class="alert alert-danger" role="alert">
           @_errorMessage
        </div>
        }
        <EditForm Model="@_attachment" OnValidSubmit="HandleValidSubmit">
            <RadzenStack Gap="1rem" class="mb-3">
                <RadzenColumn Size="12" SizeSM="8">
                    <RadzenStack>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack>
                                        <RedGTextBox @bind-Value="@_attachment.Name" For="@(() => _attachment.Name)" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="12" >
                                <RadzenStack>
                                    <RedGTextArea @bind-Value="@_attachment.Description" For="@(() => _attachment.Description)" Rows="3" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        @if (Id == null)
                        {
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Orientation="Orientation.Vertical">
                                    
                                    <div class="mb-3">
                                        <div class="card border-0 shadow-sm">
                                            <div class="card-body">
                                                <h6 class="mb-3">Drag and drop files to upload</h6>
                                                <div class="upload-dropzone">
                                                    <InputFile OnChange="@OnInputFileChange" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.dxf" id="fileUploadEdit" />
                                                    <div class="upload-icon-container">
                                                        <span class="material-icons upload-icon">cloud_upload</span>
                                                        <p class="mt-3 mb-2"><strong>@Localize["Drag and drop qui o click Selezionare Files"]</strong></p>
                                                        <p class="text-muted small mb-0">PDF, DOC, DOCX, XLS, XLSX, DXF, Images (Max 20MB)</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (_filesWithNames != null && _filesWithNames.Any())
                                    {
                                        <div class="mb-3">
                                            <h6 class="mb-2">File selezionati</h6>
                                            @foreach (var fileItem in _filesWithNames)
                                            {
                                                <div class="card file-list-card">
                                                    <div class="card-body">
                                                        <div class="row align-items-center g-2">
                                                            <div class="col-md-6">
                                                                <input type="text" class="form-control" @bind="fileItem.NewName" placeholder="Nome file" />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <small class="text-muted">@fileItem.Extension (@FormatFileSize(fileItem.FileBytes.Length))</small>
                                                            </div>
                                                            <div class="col-md-2 text-end">
                                                                <button class="btn btn-sm btn-danger" @onclick="@(() => RemoveFile(fileItem))">
                                                                    <span class="material-icons" style="font-size: 16px;">delete</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        }
                    </RadzenStack>
                </RadzenColumn>
            </RadzenStack>
            <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
            <RedGButton RGButtonType="RGButtonType.Submit" />
        </EditForm>
    }
</div>