@page "/Attachments/Upload/{Id:int}"
@using System.IO
@using Microsoft.AspNetCore.Components.Forms

<style>
    .upload-dropzone {
        border: 3px dashed #cbd5e1;
        border-radius: 0.75rem;
        padding: 4rem 2rem;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
    }

    .upload-dropzone:hover {
        border-color: #0d6efd;
        background: #e7f3ff;
    }

    .upload-dropzone input[type="file"] {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        opacity: 0;
        cursor: pointer;
    }

    .upload-icon {
        font-size: 72px;
        color: #0d6efd;
    }

    .file-list-card {
        margin-bottom: 0.5rem;
        padding: 0.5rem;
    }
</style>

<BlazorHeader Header="@Localize["Add Files"]"></BlazorHeader>

@if (_attachment == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <!-- Nome Allegato -->
            <div class="mb-3">
                <h6 class="text-dark fw-semibold mb-2 d-flex align-items-center">
                    <span class="material-icons me-2 text-primary" style="font-size: 20px;">label</span>
                    <DisplayName For="@(() => _attachment.Name)" />
                </h6>
                <div class="p-3 bg-light rounded border-start border-primary border-4">
                    <p class="mb-0 text-dark">@_attachment.Name</p>
                </div>
            </div>
            
            <div class="mb-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3">Drag and drop files to upload</h6>
                        <div class="upload-dropzone">
                            <InputFile OnChange="@OnInputFileChange" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.dxf" id="fileUpload" />
                            <div class="upload-icon-container">
                                <span class="material-icons upload-icon">cloud_upload</span>
                                <p class="mt-3 mb-2"><strong>@Localize["Drag and drop qui o click Selezionare Files"]</strong></p>
                                <p class="text-muted small mb-0">PDF, DOC, DOCX, XLS, XLSX, DXF, Images (Max 20MB)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (_filesWithNames != null && _filesWithNames.Any())
            {
                <div class="mb-3">
                    <h6 class="mb-2">File selezionati</h6>
                    @foreach (var fileItem in _filesWithNames)
                    {
                        <div class="card file-list-card">
                            <div class="card-body">
                                <div class="row align-items-center g-1">
                                    <div class="col-md-6">
                                        <input type="text" class="form-control" @bind="fileItem.NewName" placeholder="Nome file" />
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted">@fileItem.Extension (@FormatFileSize(fileItem.FileBytes.Length))</small>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <button class="btn btn-sm btn-danger" @onclick="@(() => RemoveFile(fileItem))">
                                            <span class="material-icons" style="font-size: 16px;">delete</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
                
            <BlazorButton Type="BtnType.Button" Style="BtnStyle.Primary" Text="Salva" Icon="save" Disabled="_waitingUpload" LabelWaiting="Upload..." OnClick="HandleValidSubmit"> </BlazorButton>
            <BlazorButton Style="BtnStyle.Secondary" OnClick="Annulla" Text="Annulla" Icon="cancel"></BlazorButton>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-3">@_errorMessage</div>
            }
        </div>
    </div>
}