@page "/Attachments"
@page "/Attachments/Index"
@using CRM.Client.Shared.Filters
@using CRM.Shared.DTOs

@if (_attachments == null)
{
    <Waiting></Waiting>
}
else
{
  
    <RadzenDataGrid @ref="_grdAttachment" IsLoading="@_isLoading" Count="@_paging.TotalCount" Data="@_attachments?.Items" Responsive="true" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
            AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="@_pageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="AttachmentDTO" EmptyText="@Localize["Nessun Allegato"]">

        <HeaderTemplate>

            <div class="d-flex align-items-center gap-5">
                @if (!ReadOnly)
                {
                    <RedGButton RGButtonType="RGButtonType.New" Click="@NewAttachment"></RedGButton>
                }
                <RedGDropDown  TValue="int?" TItem="FolderDTO" Data="@_folders" TextProperty="Translate" Change="OnChangeFolder" ValueProperty="Id" @bind-Value="@_folderId" Label="@Localize["Tipo"]" ></RedGDropDown>

                
            </div>

        </HeaderTemplate>
        <Columns>


            <RadzenDataGridColumn TItem="AttachmentDTO" Property="@nameof(AttachmentDTO.Name)" Title="@Localize["Nome"]" TextAlign="Radzen.TextAlign.Left" />

            <RadzenDataGridColumn TItem="AttachmentDTO" Property="@nameof(AttachmentDTO.Description)" Title="@Localize["Descrizione"]" TextAlign="Radzen.TextAlign.Left" />

            <RadzenDataGridColumn TItem="AttachmentDTO" Property="@nameof(AttachmentDTO.CreatedOn)" Title="@Localize["Data"]" FormatString="{0:d}" TextAlign="Radzen.TextAlign.Left" />

            <RadzenDataGridColumn TItem="AttachmentDTO" Property="@nameof(AttachmentDTO.IdUser)" Title="@Localize["User"]" FilterProperty="@nameof(Attachment.IdUser)" FilterValue="@_userFilter" FilterOperator="FilterOperator.Equals">
                <Template Context="item">
                    <UserData IdUser="@item.IdUser"></UserData>
                </Template> 
                <FilterTemplate>
                    @* <UserDropDown @bind-Value="@_userFilter" Changed="OnFilterUserChanged"></UserDropDown> *@
                    <FilterDropDown Items="@_users" TItem="ApplicationUser" TValue="string" @bind-Value=@_userFilter OnClickClose="OnCloseFilter" UniqueID="@_grdAttachment.UniqueID" Property=@nameof(Attachment.IdUser) TextProperty="@nameof(ApplicationUser.NameComplete)"
                                    ValueProperty="Id"></FilterDropDown>
                </FilterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AttachmentDTO" Title="@Localize["Visibility"]"  TextAlign="Radzen.TextAlign.Left">
                <Template Context="item">
                    @Localize[$"{item.Visibility.ToString()}"]
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="item"
                                  TItem="AttachmentDTO"
                                  Filterable="false"
                                  Sortable="false"
                                  TextAlign="Radzen.TextAlign.Center"
                                  Width="200px"
                                  >
                <Template Context="item">
                    <RedGButton RGButtonType="RGButtonType.Download" Click=@(() => Download(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Edit" Visible="@item.CanEdit" Click=@(() => Edit(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Delete" Visible="@item.CanDelete" Click=@(() => Delete(item.Id))></RedGButton>

                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
 }   