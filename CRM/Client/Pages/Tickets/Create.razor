@page "/Tickets/Create"
@using Radzen
@using Radzen.Blazor
@using CRM.Shared

<PageHeader Model="@_pageHeader"></PageHeader>

<div class="ticket-create-page">
    <div class="modern-preview-container">

        <!-- Intestazione + avanzamento della procedura -->
        <div class="preview-header-card">
            <div class="header-content">
                <div class="ticket-number">
                    <span class="material-icons">confirmation_number</span>
                    <h3>@Localize["Nuovo ticket"]</h3>
                </div>
                @if (IsWizardStep && CurrentStepIndex >= 0)
                {
                    <span class="step-counter">
                        @Localize["Passo"] @(CurrentStepIndex + 1) @Localize["di"] @_steps.Count
                    </span>
                }
            </div>

            @if (IsWizardStep && CurrentStepIndex >= 0)
            {
                // catturato una volta sola: l'elenco si ricostruisce a ogni accesso
                var steps = _steps;
                var corrente = CurrentStepIndex;
                <ol class="wizard-steps">
                    @for (var i = 0; i < steps.Count; i++)
                    {
                        var s = steps[i];
                        var stato = i < corrente ? "done" : (i == corrente ? "current" : "todo");
                        <li class="wizard-step @stato" title="@s.Label">
                            <span class="wizard-dot">
                                @if (i < CurrentStepIndex)
                                {
                                    <span class="material-icons">check</span>
                                }
                                else
                                {
                                    <span class="material-icons">@s.Icon</span>
                                }
                            </span>
                            <span class="wizard-label">@s.Label</span>
                        </li>
                    }
                </ol>
            }
        </div>

        <!-- Riepilogo di quanto già scelto: cresce passo dopo passo -->
        @if (HasRecap)
        {
            <div class="description-card">
                <div class="card-header-modern">
                    <span class="material-icons">@(_stepTicket == TicketCreateSteps.DataConfirm ? "fact_check" : "summarize")</span>
                    <h5>@(_stepTicket == TicketCreateSteps.DataConfirm ? Localize["Conferma i dati del ticket"] : Localize["Riepilogo"])</h5>
                </div>
                <div class="card-body-modern">
                    <dl class="recap-list">
                        @if (_stepTicket > TicketCreateSteps.CompanyTicket && !string.IsNullOrWhiteSpace(_ragionaSociale))
                        {
                            <dt><DisplayName For="@(() => _ticket.Company)" /></dt>
                            <dd>@_ragionaSociale</dd>
                        }
                        @if (_stepTicket > TicketCreateSteps.TypeTicket && _ticketType != null)
                        {
                            <dt><DisplayName For="@(() => _ticket.IdType)" /></dt>
                            <dd>@_ticketType.Desc</dd>
                        }
                        @if (_stepTicket > TicketCreateSteps.ProductTicket && _ticketType != null)
                        {
                            @if (PropertyVisible(_ticketType.IdProdotto) && _product != null && _ticket.IdProduct != null)
                            {
                                <dt><DisplayName For="@(() => _ticket.IdProduct)" /></dt>
                                <dd>@_product.Name</dd>
                            }
                            @if (PropertyVisible(_ticketType.IdArticolo) && _article != null)
                            {
                                <dt><DisplayName For="@(() => _ticket.IdArticle)" /></dt>
                                <dd>@_article.CompleteName</dd>
                            }
                        }
                        @if (_stepTicket > TicketCreateSteps.DateTicket && _ticketType != null)
                        {
                            @if (PropertyVisible(_ticketType.Date) && _ticket.Date != null)
                            {
                                <dt><DisplayName For="@(() => _ticket.Date)" /></dt>
                                <dd>@_ticket.Date?.ToString("d")</dd>

                                <dt><DisplayName For="@(() => _ticket.Time)" /></dt>
                                <dd>@_ticket.Time?.ToString("t")</dd>
                            }
                            @if (PropertyVisible(_ticketType.DateEnd) && _ticket.DateEnd != null)
                            {
                                <dt><DisplayName For="@(() => _ticket.DateEnd)" /></dt>
                                <dd>@_ticket.DateEnd?.ToString("d")</dd>
                            }
                        }
                        @if (_stepTicket > TicketCreateSteps.Expired && _ticketType != null && PropertyVisible(_ticketType.ExpiredDate))
                        {
                            <dt><DisplayName For="@(() => _ticket.DateExpired)" /></dt>
                            <dd>@_ticket.DateExpired</dd>
                        }
                        @if (_stepTicket > TicketCreateSteps.Assign && _user.CanTicketAssign && !string.IsNullOrWhiteSpace(_userAssigned?.NameComplete))
                        {
                            <dt><DisplayName For="@(() => _ticket.IdUserAssigned)" /></dt>
                            <dd>@_userAssigned.NameComplete</dd>
                        }
                        @if (_stepTicket > TicketCreateSteps.DescriptionTicket && !string.IsNullOrWhiteSpace(_ticket.Description))
                        {
                            <dt><DisplayName For="@(() => _ticket.Description)" /></dt>
                            <dd class="recap-text">@_ticket.Description</dd>
                        }
                    </dl>
                </div>
            </div>
        }

        <!-- Esito -->
        @if (_stepTicket == TicketCreateSteps.Result)
        {
            <div class="description-card result-card">
                <div class="card-body-modern result-body">
                    <span class="material-icons result-icon">check_circle</span>
                    <div class="result-text">
                        <h5>@Localize["Il Ticket è stato Creato."]</h5>
                        @if (_ticket.Id > 0)
                        {
                            <span class="result-meta">#@_ticket.Id</span>
                        }
                    </div>
                    <div class="result-actions">
                        <RadzenButton Click="@(args => OpenAttachmentPage())" Text="@Localize["Allega Documento"]" Icon="attach_file"
                                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                        <RadzenButton Click="ListaTickets" Text="@Localize["Lista Ticket"]" Icon="list"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                    </div>
                </div>
            </div>
        }

        @if (_stepTicket == TicketCreateSteps.Attachment)
        {
            <div class="description-card">
                <div class="card-header-modern">
                    <span class="material-icons">attach_file</span>
                    <h5>@Localize["Allega Documento"]</h5>
                </div>
                <div class="card-body-modern">
                    <CRM.Client.Pages.Attachments.Edit IdParent="@_ticket.Id" AttachmentType="AttachmentTypes.Ticket" OnClickClose="OpenTicket" />
                </div>
            </div>
        }

        <!-- Passo corrente -->
        @if (IsWizardStep)
        {
            <EditForm Model="_ticket" OnValidSubmit="NextStep">
                <BlazoringComponents.Validators.FluentValidationValidator ValidatorType="typeof(Validators.TicketValidator)" />

                @if (_stepTicket != TicketCreateSteps.DataConfirm)
                {
                    <div class="description-card">
                        <div class="card-header-modern">
                            <span class="material-icons">@CurrentStepIcon</span>
                            <h5>@CurrentStepTitle</h5>
                        </div>
                        <div class="card-body-modern">
                            <ValidationSummary />

                            @if (_stepTicket == TicketCreateSteps.CompanyTicket)
                            {
                                <div class="field">
                                    <DisplayName For="@(() => _ticket.IdCompany)" />
                                    <RadzenDropDownDataGrid @bind-value="@_ticket.IdCompany" TValue="int" AllowFiltering="true" ShowPagingSummary="true"
                                                            AllowClear="true" PageSize="@_pageSize" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            LoadData="LoadCompanies" Data="@_companies" Count="@_companyCount"
                                                            TextProperty="RagioneSociale" ValueProperty="Id" Change="(arg => OnChangeCompany(arg))"
                                                            Style="width:100%" />
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.TypeTicket)
                            {
                                <div class="field">
                                    <DisplayName For="@(() => _ticket.IdType)" />
                                    <RadzenDropDown @bind-Value="@_ticket.IdType" AllowClear="true" TValue="int" Change="OnChangeTicketType"
                                                    AllowFiltering="true" PageSize="@_pageSize" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Data="@_ticketTypes" TextProperty="Language" ValueProperty="Id" Style="width:100%" />
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.ProductTicket)
                            {
                                <div class="field-grid">
                                    <div class="field">
                                        <DisplayName For="@(() => _ticket.IdProduct)" />
                                        <RadzenDropDown @bind-Value="@_ticket.IdProduct" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Change="OnChangeIdProduct"
                                                        Data="@_products" Count="@_products.Count()" TextProperty="Name" ValueProperty="Id"
                                                        Style="width:100%" />
                                    </div>
                                    <div class="field">
                                        <DisplayName For="@(() => _ticket.IdArticle)" />
                                        <RadzenDropDownDataGrid @bind-value="@_ticket.IdArticle" TValue="int?" AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                AllowClear="true" Change="OnChangeIdArticle" PageSize="10"
                                                                Data="@_articles" Count="@_articles.Count()" TextProperty="SerialNumber" ValueProperty="Id"
                                                                Style="width:100%">
                                            <Columns>
                                                @* ArticleDTO e' piatto: il nome del prodotto sta in ProductName, non in una
                                                   navigazione Product. Qui il binding e' lato client sull'item, quindi il
                                                   percorso deve essere quello del DTO (diverso dalle colonne della lista
                                                   ticket, dove Filter/Sort viaggiano al server sull'entita' Ticket). *@
                                                <RadzenDropDownDataGridColumn Property="ProductName" Title="@Localize["Tipo Prodotto"]" Width="200px" />
                                                <RadzenDropDownDataGridColumn Property="SerialNumber" Title="@Localize["Numero Seriale"]" Width="200px" />
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </div>
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.DateTicket)
                            {
                                <div class="field-grid">
                                    <div class="field">
                                        <RedGDateTimePicker @bind-Value="_ticket.Date" For="@(() => _ticket.Date)" />
                                    </div>
                                    @if (PropertyVisible(_ticketType.Time))
                                    {
                                        <div class="field">
                                            <RedGDateTimePicker @bind-Value="_ticket.Time" ShowTime="true" For="@(() => _ticket.Time)" DateFormat="HH:mm" TodayButton="false" />
                                        </div>
                                    }
                                    @if (PropertyVisible(_ticketType.DateEnd))
                                    {
                                        <div class="field">
                                            <RedGDateTimePicker @bind-Value="_ticket.DateEnd" For="@(() => _ticket.DateEnd)" />
                                        </div>
                                    }
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.DescriptionTicket)
                            {
                                <div class="field">
                                    <DisplayName For="@(() => _ticket.Description)" />
                                    <RadzenTextArea @bind-value="@_ticket.Description" Rows="8" Style="width:100%"
                                                    Placeholder="@Localize["Descrivi il problema o la richiesta."]" />
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.Expired)
                            {
                                <div class="field">
                                    <DisplayName For="@(() => _ticket.DateExpired)" />
                                    <InputDate class="form-control" @bind-Value="@_ticket.DateExpired" />
                                </div>
                            }
                            else if (_stepTicket == TicketCreateSteps.Assign)
                            {
                                <div class="field">
                                    <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                    <RadzenDropDownDataGrid @bind-value="@_ticket.IdUserAssigned" TValue="string" LoadData="@LoadUsers" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            AllowClear="true" Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id"
                                                            Change="@OnChangeIdUser" Style="width:100%" />
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="wizard-actions">
                    <RadzenButton ButtonType="ButtonType.Button" Click="PreviousStep" Disabled="@_backDisabled"
                                  Text="@Localize["Indietro"]" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                    <RadzenButton ButtonType="ButtonType.Button" Click="PrepareCancel"
                                  Text="@Localize["Cancel"]" Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />

                    <div class="wizard-actions-end">
                        @if (_stepTicket == TicketCreateSteps.DataConfirm)
                        {
                            <RadzenButton ButtonType="ButtonType.Button" Click="Submit" Text="@Localize["Conferma"]" Icon="check"
                                          ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" />
                        }
                        else
                        {
                            <RadzenButton ButtonType="ButtonType.Submit" Text="@Localize["Prosegui"]" Icon="arrow_forward"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                        }
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

<MsgBoxConfirm Id="dlgCancel" LabelBtnNo="No" LabelBtnYes="Yes" Header="Annulla Inserimento Ticket" Message="@_messageCancel" OnClick="Cancel"></MsgBoxConfirm>
<MsgBoxConfirm Id="dlgError" LabelBtnNo="" LabelBtnYes="OK" Header="Errore durante Inserimento Ticket" Message="@_messageError" OnClick="Close"></MsgBoxConfirm>
