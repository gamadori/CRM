@page "/Tickets/Close/{Id:int}"
@using Radzen
@using Radzen.Blazor
@using CRM.Shared
@using CRM.Shared.Helper

@if (_ticket == null || Id <= 0)
{
    <div class="preview-loading">
        <Waiting></Waiting>
    </div>
}
else
{
    <div class="ticket-details-page">
        <div class="modern-preview-container">

            <!-- Header -->
            <div class="preview-header-card">
                <div class="header-content">
                    <div class="ticket-number">
                        <span class="material-icons">task_alt</span>
                        <h3>Chiusura ticket #@_ticket.Id</h3>
                    </div>
                    <div class="ticket-status priority-@GetPriorityKey()">
                        <span class="material-icons">flag</span>
                        Priorità @GetPriorityLabel()
                    </div>
                </div>
            </div>

            <!-- Contesto: il problema -->
            <div class="description-card">
                <div class="card-header-modern">
                    <span class="material-icons">description</span>
                    <h5>Il problema</h5>
                    @if (!string.IsNullOrWhiteSpace(_ticket.Company?.RagioneSociale))
                    {
                        <span class="header-meta">@_ticket.Company.RagioneSociale</span>
                    }
                </div>
                <div class="card-body-modern">
                    <p class="description-text">@_ticket.Description</p>
                </div>
            </div>

            <EditForm Model="@_ticketClose" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <!-- Riepilogo operativo (riutilizzabile) -->
                @if (_hasOperationalSummary)
                {
                    <div class="description-card">
                        <div class="card-header-modern summary-header">
                            <div class="summary-title">
                                <span class="material-icons">summarize</span>
                                <h5>Riepilogo operativo</h5>
                            </div>
                            <button type="button" class="btn-use-summary" @onclick="UseOperationalSummary">
                                <span class="material-icons">south</span>Usa come soluzione
                            </button>
                        </div>
                        <div class="card-body-modern">
                            <div class="summary-readonly">@_ticket.OperationalSummary</div>
                        </div>
                    </div>
                }

                <!-- Soluzione (visibile al cliente) -->
                <div class="description-card">
                    <div class="card-header-modern summary-header">
                        <div class="summary-title">
                            <span class="material-icons text-success">check_circle</span>
                            <h5>Soluzione applicata <span class="req-dot">*</span></h5>
                        </div>
                        <span class="visibility-badge visible">
                            <span class="material-icons">visibility</span>Visibile al cliente
                        </span>
                    </div>
                    <div class="card-body-modern">
                        <RadzenTextArea @bind-Value="@_ticketClose.Description" Rows="7" Style="width: 100%;"
                                        Placeholder="Descrivi come è stato risolto il problema." />
                        <ValidationMessage For="@(() => _ticketClose.Description)" />
                    </div>
                </div>

                <!-- Info grid: modalità intervento (solo dove nessun intervento la porta) + note interne -->
                <div class="info-grid @(_showSupportField ? "" : "info-grid-single")">
                    @if (_showSupportField)
                    {
                        <div class="description-card">
                            <div class="card-header-modern">
                                <span class="material-icons">support_agent</span>
                                <h5>Modalità di intervento</h5>
                            </div>
                            <div class="card-body-modern">
                                <RedGSelectEnum TEnum="TypesSupport" TValue="TypesSupport" @bind-Value="@_ticketClose.Support"
                                                For="@(() => _ticketClose.Support)" AllowClear="false" Style="width: 100%;" />
                            </div>
                        </div>
                    }

                    <div class="description-card">
                        <button type="button" class="card-header-modern note-toggle @(_showNotes ? "" : "collapsed")" @onclick="ToggleNotes">
                            <span class="material-icons">lock</span>
                            <h5>Note interne</h5>
                            <span class="note-toggle-right">
                                <span class="visibility-badge hidden">
                                    <span class="material-icons">visibility_off</span>Solo staff
                                </span>
                                <span class="material-icons chevron @(_showNotes ? "open" : "")">expand_more</span>
                            </span>
                        </button>
                        @if (_showNotes)
                        {
                            <div class="card-body-modern">
                                <RadzenTextArea @bind-Value="@_ticketClose.Note" Rows="5" Style="width: 100%;"
                                                Placeholder="Annotazioni riservate al team (non compaiono nel report cliente)." />
                                <ValidationMessage For="@(() => _ticketClose.Note)" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Azioni -->
                @if (!_ticket.Closed && _ticket.Permits.Close())
                {
                    @* L'ostacolo si dichiara prima del pulsante: scoprire il vincolo dopo aver
                       scritto la soluzione e premuto Chiudi e' lavoro buttato. *@
                    @if (_closeBlocked)
                    {
                        <div class="close-blocked">
                            <span class="material-icons">block</span>
                            <div>
                                <div class="close-blocked-title">Chiusura non disponibile</div>
                                <div class="close-blocked-text">@_precondition!.BlockReason</div>
                                @if (_precondition.RequiresIntervention && _precondition.InterventionCount == 0 && !_precondition.IsBlocked)
                                {
                                    <a class="close-blocked-link" href="@($"/Tickets/{Id}")">
                                        <span class="material-icons">build</span>Vai al ticket e registra l'intervento
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="close-actions-card">
                        <BlazorButton Type="BtnType.Submit" Style="@(_closeBlocked ? BtnStyle.Secondary : BtnStyle.Success)"
                                      Text="Chiudi ticket" Icon="task_alt"></BlazorButton>
                        <BlazorButton Style="BtnStyle.Light" Text="Annulla" Icon="close" OnClick="Cancel"></BlazorButton>
                    </div>
                }
            </EditForm>
        </div>
    </div>
}
