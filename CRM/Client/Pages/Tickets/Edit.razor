@page "/Tickets/New"
@page "/Tickets/{Id:int}/Edit"
@page "/Tickets/{Id:int}/Edit/{BackUrl}"

@using Radzen
@using Radzen.Blazor



@if (_ticket == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>


    <EditForm Model="@_ticket" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <BlazoringComponents.Validators.FluentValidationValidator ValidatorType="typeof(Validators.TicketEditValidator)" />
                    <ValidationSummary />

                    <!-- Company and Contact -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown Change=OnChangeCompany TItem="Company"   TValue="int" ValueProperty="Id" TextProperty="@nameof(Company.RagioneSociale)" @bind-Value="@_ticket.IdCompany" For="@(() => _ticket.IdCompany)"
                                              Data="_companies" AllowFiltering="true">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                        
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>

                        @if (_ticket?.IdCompany != null && _ticket.IdCompany > 0)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="Contact" @bind-value="@_ticket.IdContact" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                                    Data="@_contactsCustomer" Count="@_contactsCustomer.Count" TextProperty="@nameof(Contact.NameComplete)"
                                                            For="@(() => _ticket.IdContact)" ValueProperty ="Id">
                                            <ChildColumns>
                                               
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Surname)" Title="@Localize[nameof(Contact.Surname)]" Width="auto" />
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Name)" Title="@Localize[nameof(Contact.Name)]" Width="auto" />
                                            </ChildColumns>
                                    </RedGDropDownGrid>
                                  
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>

                    <!-- Ticket Type -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="TicketType" TValue="int" ValueProperty="Id" TextProperty="Language"
                                              @bind-Value="@_ticket.IdType" For="@(() => _ticket.IdType)"
                                              Data="@_ticketTypes" AllowFiltering="true" PageSize="10"
                                              Change="OnChangeTicketType" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Date and Time -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDateTimePicker @bind-Value="@_ticket.Date" For="@(() => _ticket.Date)" 
                                        Change="DateOnChange">
                                        <End>
                                            @if (Scheduler)
                                            {
                                                <BtnScheduler OnGetItem="OnGetScheduler" Date=@(_ticket.Date??DateTime.Today) 
                                                IdTicket=@Id IdTicketType=@_ticket.IdType IdUser=@_ticket?.IdUserAssigned></BtnScheduler>
                                            }
                                        </End>
                                    </RedGDateTimePicker>
                                </RadzenStack>
                            </RadzenColumn>

                            @if (_timeProperty != PropertyStates.No)
                            {
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_ticket.Time" For="@(() => _ticket.Time)"
                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>


                        <!-- Date End -->
                        @if (_dateEndProperty != PropertyStates.No)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker @bind-Value="@_ticket.DateEnd" For="@(() => _ticket.DateEnd)" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        }
                    }
                    <!-- Assigned Users (Multi-Select) -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack>
                                    <RadzenLabel style="margin-bottom: 0.5rem; font-weight: 500;">
                                        <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                    </RadzenLabel>

                                    <!-- ✅ Selected Users Badges -->
                                    @if (_selectedUserIds.Any())
                                    {
                                        <div class="selected-users-container">
                                            @foreach (var userId in _selectedUserIds.ToList())
                                            {
                                                var user = _users.FirstOrDefault(u => u.Id == userId);
                                                if (user != null)
                                                {
                                                    var isMain = _selectedUserIds.ToList().IndexOf(userId) == 0;
                                                    <div class="selected-user-badge @(isMain ? "main-user" : "")">
                                                        <span class="user-avatar">@GetInitials(user.NameComplete)</span>
                                                        <span class="user-name">@user.NameComplete</span>
                                                        @if (isMain)
                                                        {
                                                            <span class="main-label">★</span>
                                                        }
                                                        <button type="button" class="remove-btn" @onclick="() => RemoveUser(userId)">×</button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-users-selected">
                                            <span class="material-icons">person_off</span>
                                            <em>@Localize["No users assigned"]</em>
                                        </div>
                                    }

                                    <!-- ✅ Search and User List -->
                                    <div class="user-selection-panel">
                                        <RadzenTextBox Placeholder="@Localize["Search users..."]" 
                                                       @bind-Value="_searchQuery" 
                                                       @oninput="@(args => OnSearchChanged(args.Value?.ToString()))"
                                                       class="user-search-input" />

                                        <div class="user-list">
                                            @foreach (var user in _filteredUsers.Take(10))
                                            {
                                                var isSelected = _selectedUserIds.Contains(user.Id);
                                                <div class="user-item @(isSelected ? "selected" : "")" 
                                                     @onclick="() => ToggleUser(user.Id)">
                                                    <span class="user-avatar-small">@GetInitials(user.NameComplete)</span>
                                                    <div class="user-info">
                                                        <span class="user-name">@user.NameComplete</span>
                                                        <span class="user-email">@user.Email</span>
                                                    </div>
                                                    @if (isSelected)
                                                    {
                                                        <span class="material-icons check-icon">check_circle</span>
                                                    }
                                                </div>
                                            }
                                            @if (!_filteredUsers.Any())
                                            {
                                                <div class="no-results">
                                                    <em>@Localize["No users found"]</em>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    <!-- Product and Article -->
                    <RadzenRow>
                        @if (_productProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDown TItem="Product" TValue="int?" ValueProperty="Id" TextProperty="Name"
                                                  @bind-Value="@_ticket.IdProduct" For="@(() => _ticket.IdProduct)"
                                                  Data="@_products" AllowFiltering="true" PageSize="10"
                                                  Change="ProductChange" />
                                </RadzenStack>
                            </RadzenColumn>
                        }

                        @if (_articleProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="Article" @bind-value="@_ticket.IdArticle" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                      Data="@_articles" Count="@_articles.Count" TextProperty="@nameof(Article.CompleteName)"
                                                      For="@(() => _ticket.IdArticle)" ValueProperty="Id">
                                        <ChildColumns>

                                            <RadzenDropDownDataGridColumn Property="Product.Name" Title="@Localize["Product"]" Width="200px" />
                                            <RadzenDropDownDataGridColumn Property="SerialNumber" Title="@Localize["SerialNumber"]" Width="200px" />
                                        </ChildColumns>
                                    </RedGDropDownGrid>

                                    
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>

                    <!-- Priority and Project -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="TicketPriorities" TValue="TicketPriorities" @bind-Value="@_ticket.Priority" 
                                                For="@(() => _ticket.Priority)" AllowClear="false" />
                            </RadzenStack>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="Project" TValue="int?" ValueProperty="Id" TextProperty="Name"
                                              @bind-Value="@_ticket.IdProject" For="@(() => _ticket.IdProject)"
                                              Data="@_projects" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Description -->
                    <RedGTextArea @bind-Value="@_ticket.Description" For="@(() => _ticket.Description)" Rows="8" />

                    <!-- Invoiced -->
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RadzenFormField>
                                    <ChildContent>
                                        <RadzenLabel Component="swInvoice">
                                            <DisplayName For="@(() => _ticket.Invoiced)" />
                                        </RadzenLabel>
                                    </ChildContent>
                                    <Helper>
                                        <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                            <Authorized Context="AuthorizeRole">
                                                <RadzenSwitch @bind-Value=@_ticket.Invoiced Name="swInvoice" />
                                                <ValidationMessage For="@(() => _ticket.Invoiced)" />
                                            </Authorized>
                                            <NotAuthorized Context="AuthorizeRole">
                                                <RadzenLabel>@_ticket.Invoiced</RadzenLabel>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" Text=@Localize["Cancel"] />
            <RedGButton RGButtonType="RGButtonType.Submit" Text="@Localize["Save"]" />
        </RadzenStack>

    </EditForm>
}
<style>
    /* ✅ Selected Users Container */
    .selected-users-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .selected-user-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .selected-user-badge.main-user {
        background: linear-gradient(90deg, #dbeafe 0%, white 100%);
        border-color: #667eea;
    }

    .selected-user-badge:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transform: translateY(-1px);
    }

    .user-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        font-size: 0.8rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .user-name {
        font-weight: 500;
        color: #374151;
        font-size: 0.9rem;
    }

    .main-label {
        color: #667eea;
        font-size: 1rem;
        margin-left: 0.25rem;
    }

    .remove-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: all 0.2s ease;
        margin-left: 0.25rem;
    }

    .remove-btn:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    /* ✅ No Users Selected */
    .no-users-selected {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.5rem;
        color: #9ca3af;
        background: #f9fafb;
        border-radius: 8px;
        border: 2px dashed #e5e7eb;
        margin-bottom: 1rem;
    }

    .no-users-selected .material-icons {
        font-size: 1.5rem;
    }

    /* ✅ User Selection Panel */
    .user-selection-panel {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .user-search-input {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .user-search-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    /* ✅ User List */
    .user-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-height: 300px;
        overflow-y: auto;
        padding: 0.5rem;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .user-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: white;
        border: 2px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .user-item:hover {
        border-color: #667eea;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15);
    }

    .user-item.selected {
        background: linear-gradient(90deg, #dbeafe 0%, white 100%);
        border-color: #667eea;
    }

    .user-avatar-small {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        font-size: 0.85rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        flex: 1;
    }

    .user-email {
        font-size: 0.8rem;
        color: #9ca3af;
    }

    .check-icon {
        color: #10b981;
        font-size: 1.5rem;
    }

    .no-results {
        text-align: center;
        padding: 2rem;
        color: #9ca3af;
    }

    /* ✅ Scrollbar Styling */
    .user-list::-webkit-scrollbar {
        width: 6px;
    }

    .user-list::-webkit-scrollbar-track {
        background: #f3f4f6;
        border-radius: 3px;
    }

    .user-list::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    .user-list::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    /* ✅ Responsive */
    @@media (max-width: 768px) {
        .selected-users-container {
            flex-direction: column;
        }

        .selected-user-badge {
            width: 100%;
            justify-content: space-between;
        }

        .user-list {
            max-height: 200px;
        }
    }
</style>