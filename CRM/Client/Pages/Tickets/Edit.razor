@page "/Tickets/New"
@page "/Tickets/{Id:int}/Edit"
@page "/Tickets/{Id:int}/Edit/{BackUrl}"

@using Radzen
@using Radzen.Blazor



@if (_ticket == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="ticket-edit-page">
    @if (PageMode == CRM.Client.Helpers.PageHelper.PageModality.Visualization)
    {
        <PageHeader Model="@_pageHeader">
        </PageHeader>
    }

    <EditForm class="ticket-edit-container" Model="@_ticket" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12">
                <RadzenStack>
                    <BlazoringComponents.Validators.FluentValidationValidator ValidatorType="typeof(Validators.TicketEditValidator)" />
                    <ValidationSummary />

                    <!-- Company and Contact -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown Change=OnChangeCompany TItem="CompanyDTO"   TValue="int" ValueProperty="Id" TextProperty="@nameof(CompanyDTO.RagioneSociale)" @bind-Value="@_ticket.IdCompany" For="@(() => _ticket.IdCompany)"
                                              Data="_companies" AllowFiltering="true">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                        
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>

                       
                    </RadzenRow>
                    <RadzenRow>
                        @if (_ticket?.IdCompany != null && _ticket.IdCompany > 0)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="ContactDTO" @bind-value="@_ticket.IdContact" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                      Data="@_contactsCustomer" Count="@_contactsCustomer.Count" TextProperty="@nameof(ContactDTO.NameComplete)"
                                                      For="@(() => _ticket.IdContact)" ValueProperty="Id" Label="@Localize["Richiedente"]">
                                        <ChildColumns>
                                            <RadzenDropDownDataGridColumn Property="@nameof(ContactDTO.Surname)" Title="@Localize[nameof(ContactDTO.Surname)]" Width="auto" />
                                            <RadzenDropDownDataGridColumn Property="@nameof(ContactDTO.Name)" Title="@Localize[nameof(ContactDTO.Name)]" Width="auto" />
                                        </ChildColumns>
                                        <End>
                                            <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetContact DialogType="RedGDialog.DialogType.Contacts" IdParent=@_ticket?.IdCompany></RedGButtonDialog>
                                        </End>
                                    </RedGDropDownGrid>
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>
                    <!-- Ticket Type -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="TicketType" TValue="int" ValueProperty="Id" TextProperty="Language"
                                              @bind-Value="@_ticket.IdType" For="@(() => _ticket.IdType)"
                                              Data="@_ticketTypes" AllowFiltering="true" PageSize="10"
                                              Change="OnChangeTicketType" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Date and Time -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDateTimePicker @bind-Value="@_ticket.Date" For="@(() => _ticket.Date)" 
                                        Change="DateOnChange">
                                        <End>
                                            @if (ShowPlanningPicker)
                                            {
                                                <TicketPlanningPickerButton SelectionChanged="ApplyPlanningSelection"
                                                                             Date="@(_ticket.Date ?? DateTime.Today)"
                                                                             IdTicket="@Id"
                                                                             IdTicketType="@_ticket.IdType"
                                                                             IdUser="@_ticket?.IdUserAssigned" />
                                            }
                                        </End>
                                    </RedGDateTimePicker>
                                </RadzenStack>
                            </RadzenColumn>

                            @if (_timeProperty != PropertyStates.No)
                            {
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_ticket.Time" For="@(() => _ticket.Time)"
                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>


                        <!-- Date End -->
                        @if (_dateEndProperty != PropertyStates.No)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker @bind-Value="@_ticket.DateEnd" For="@(() => _ticket.DateEnd)" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        }
                    }
                    <!-- Assigned Users (Multi-Select) -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack>
                                    <RadzenLabel class="ticket-edit-section-label">
                                        <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                    </RadzenLabel>

                                    <!-- ✅ Selected Users Display -->
                                    @if (_selectedUserIds.Any())
                                    {
                                        <div class="selected-users-display">
                                            @foreach (var userId in _selectedUserIds.Take(3).ToList())
                                            {
                                                var user = _users.FirstOrDefault(u => u.Id == userId);
                                                if (user != null)
                                                {
                                                    var isMain = _selectedUserIds.ToList().IndexOf(userId) == 0;
                                                    <div class="user-badge-compact @(isMain ? "main-user" : "")">
                                                        <span class="user-avatar-compact">@GetInitials(user.NameComplete)</span>
                                                        <span class="user-name-compact">@user.NameComplete</span>
                                                        @if (isMain)
                                                        {
                                                            <span class="main-star">★</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                            @if (_selectedUserIds.Count > 3)
                                            {
                                                <div class="more-users">+@(_selectedUserIds.Count - 3) @Localize["more"]</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-users-compact">
                                            <em>@Localize["No users assigned"]</em>
                                        </div>
                                    }

                                    <!-- ✅ Button to Open Assign Dialog -->
                                    <RadzenButton Text="@(_selectedUserIds.Any() ? Localize["Manage Assignments"] : Localize["Assign Users"])" 
                                                  Icon="@(_selectedUserIds.Any() ? "edit" : "group_add")" 
                                                  Click="OpenUserSelectionDialog" 
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Style="margin-top: 0.5rem;" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    <!-- Product and Article -->
                    <RadzenRow>
                        @if (_productProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDown TItem="ProductDTO" TValue="int?" ValueProperty="Id" TextProperty="@nameof(ProductDTO.Name)"
                                                  @bind-Value="@_ticket.IdProduct" For="@(() => _ticket.IdProduct)"
                                                  Data="@_products" AllowFiltering="true" PageSize="10"
                                                  Change="ProductChange" />
                                </RadzenStack>
                            </RadzenColumn>
                        }

                        @if (_articleProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="ArticleDTO" @bind-value="@_ticket.IdArticle" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                      Data="@_articles" Count="@_articles.Count" TextProperty="@nameof(ArticleDTO.CompleteName)"
                                                      For="@(() => _ticket.IdArticle)" ValueProperty="Id">
                                        <ChildColumns>

                                            <RadzenDropDownDataGridColumn Property="@nameof(ArticleDTO.ProductName)" Title="@Localize["Product"]" Width="200px" />
                                            <RadzenDropDownDataGridColumn Property="@nameof(ArticleDTO.SerialNumber)" Title="@Localize["SerialNumber"]" Width="200px" />
                                        </ChildColumns>
                                    </RedGDropDownGrid>

                                    
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>

                    <!-- Priority and Project -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="TicketPriorities" TValue="TicketPriorities" @bind-Value="@_ticket.Priority" 
                                                For="@(() => _ticket.Priority)" AllowClear="false" />
                            </RadzenStack>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="Project" TValue="int?" ValueProperty="Id" TextProperty="Name"
                                              @bind-Value="@_ticket.IdProject" For="@(() => _ticket.IdProject)"
                                              Data="@_projects" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Description -->
                    <RedGTextArea @bind-Value="@_ticket.Description" For="@(() => _ticket.Description)" Rows="8" />

                    <!-- Invoiced -->
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <div class="ticket-invoiced-field">
                                    <RadzenLabel Component="swInvoice" class="ticket-edit-section-label">
                                        <DisplayName For="@(() => _ticket.Invoiced)" />
                                    </RadzenLabel>
                                    <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                        <Authorized Context="AuthorizeRole">
                                            <RadzenSwitch @bind-Value=@_ticket.Invoiced Name="swInvoice" />
                                            <ValidationMessage For="@(() => _ticket.Invoiced)" />
                                        </Authorized>
                                        <NotAuthorized Context="AuthorizeRole">
                                            <RadzenLabel>@_ticket.Invoiced</RadzenLabel>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                </div>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
            <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
        </RadzenStack>

    </EditForm>
    </div>
}
<style>
    /* ✅ Compact Selected Users Display */
    .selected-users-display {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        margin-bottom: 0.5rem;
    }

    .user-badge-compact {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.6rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .user-badge-compact.main-user {
        background: linear-gradient(90deg, #dbeafe 0%, white 100%);
        border-color: #667eea;
    }

    .user-avatar-compact {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .user-name-compact {
        font-weight: 500;
        color: #374151;
        font-size: 0.85rem;
    }

    .main-star {
        color: #667eea;
        font-size: 0.9rem;
    }

    .more-users {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.6rem;
        background: #e5e7eb;
        border-radius: 8px;
        font-size: 0.85rem;
        color: #6b7280;
        font-weight: 500;
    }

    .no-users-compact {
        padding: 0.75rem;
        color: #9ca3af;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px dashed #e5e7eb;
        text-align: center;
        font-size: 0.9rem;
    }

    .ticket-edit-page {
        background: #fafbfc;
        min-height: 100vh;
        padding-bottom: 2rem;
        color: var(--text-primary, #1f2937);
    }

    .ticket-edit-container {
        max-width: 1200px;
        margin: 0;
        padding: 1.5rem;
    }

    .ticket-edit-section-label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--text-secondary, #52606d);
        font-weight: 650;
    }

    .ticket-invoiced-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border-color, #d9e1e8);
        border-radius: 0.45rem;
        background: var(--card-bg, #ffffff);
    }

    .ticket-invoiced-field .ticket-edit-section-label {
        margin: 0;
    }

    body.dark-theme .ticket-edit-page {
        background: #141a1f;
    }

    body.dark-theme .ticket-edit-page .ticket-edit-section-label,
    body.dark-theme .ticket-edit-page .ticket-edit-section-label .label-floating,
    body.dark-theme .ticket-edit-page .label-floating {
        color: #c7d3dd !important;
    }

    body.dark-theme .ticket-edit-page .selected-users-display,
    body.dark-theme .ticket-edit-page .no-users-compact {
        color: #edf2f7 !important;
        background: #20272d !important;
        border-color: #46515b !important;
    }

    body.dark-theme .ticket-edit-page .user-badge-compact {
        color: #edf2f7 !important;
        background: #293139 !important;
        border-color: #52616f !important;
    }

    body.dark-theme .ticket-edit-page .user-badge-compact.main-user {
        background: #173554 !important;
        border-color: #5aa7ff !important;
    }

    body.dark-theme .ticket-edit-page .user-name-compact {
        color: #f7f9fb !important;
    }

    body.dark-theme .ticket-edit-page .main-star {
        color: #9dcbff !important;
    }

    body.dark-theme .ticket-edit-page .more-users {
        color: #d6e0e9 !important;
        background: #303942 !important;
    }

    body.dark-theme .ticket-edit-page .ticket-invoiced-field {
        color: #edf2f7;
        background: #1d2329;
        border-color: #46515b;
    }

    /* ✅ Responsive */
    @@media (max-width: 768px) {
        .selected-users-display {
            flex-direction: column;
        }

        .user-badge-compact {
            width: 100%;
        }
    }
</style>
