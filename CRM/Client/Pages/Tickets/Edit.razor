@page "/Tickets/New"
@page "/Tickets/{Id:int}/Edit"
@page "/Tickets/{Id:int}/Edit/{BackUrl}"

@using Radzen
@using Radzen.Blazor



@if (_ticket == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>


    <EditForm Model="@_ticket" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <BlazoringComponents.Validators.FluentValidationValidator ValidatorType="typeof(Validators.TicketEditValidator)" />
                    <ValidationSummary />

                    <!-- Company and Contact -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown Change=OnChangeCompany TItem="Company"   TValue="int" ValueProperty="Id" TextProperty="@nameof(Company.RagioneSociale)" @bind-Value="@_ticket.IdCompany" For="@(() => _ticket.IdCompany)"
                                              Data="_companies" AllowFiltering="true">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                        
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>

                        @if (_ticket?.IdCompany != null && _ticket.IdCompany > 0)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="Contact" @bind-value="@_ticket.IdContact" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                                    Data="@_contactsCustomer" Count="@_contactsCustomer.Count" TextProperty="@nameof(Contact.NameComplete)"
                                                            For="@(() => _ticket.IdContact)" ValueProperty ="Id">
                                            <ChildColumns>
                                               
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Surname)" Title="@Localize[nameof(Contact.Surname)]" Width="auto" />
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Name)" Title="@Localize[nameof(Contact.Name)]" Width="auto" />
                                            </ChildColumns>
                                    </RedGDropDownGrid>
                                  
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>

                    <!-- Ticket Type -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="TicketType" TValue="int" ValueProperty="Id" TextProperty="Language"
                                              @bind-Value="@_ticket.IdType" For="@(() => _ticket.IdType)"
                                              Data="@_ticketTypes" AllowFiltering="true" PageSize="10"
                                              Change="OnChangeTicketType" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Date and Time -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDateTimePicker @bind-Value="@_ticket.Date" For="@(() => _ticket.Date)" 
                                        Change="DateOnChange">
                                        <End>
                                            @if (Scheduler)
                                            {
                                                <BtnScheduler OnGetItem="OnGetScheduler" Date=@(_ticket.Date??DateTime.Today) 
                                                IdTicket=@Id IdTicketType=@_ticket.IdType IdUser=@_ticket?.IdUserAssigned></BtnScheduler>
                                            }
                                        </End>
                                    </RedGDateTimePicker>
                                </RadzenStack>
                            </RadzenColumn>

                            @if (_timeProperty != PropertyStates.No)
                            {
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker TValue="TimeOnly?" @bind-Value="@_ticket.Time" For="@(() => _ticket.Time)"
                                        DateFormat="HH:mm" ShowTime="true" TodayButton="false" />
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>


                        <!-- Date End -->
                        @if (_dateEndProperty != PropertyStates.No)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="12" SizeSM="6">
                                    <RadzenStack>
                                        <RedGDateTimePicker @bind-Value="@_ticket.DateEnd" For="@(() => _ticket.DateEnd)" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        }
                    }
                    <!-- Assigned User -->
                    @if (_ticket.IdType > 0)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="ApplicationUser" @bind-value="@_ticket.IdUserAssigned" TValue="string" AllowFiltering="true" AllowClear="true"
                                                                    Data="@_users" Count="@_users.Count" TextProperty="@nameof(Contact.NameComplete)"
                                                            For="@(() => _ticket.IdUserAssigned)" ValueProperty ="Id">
                                            <ChildColumns>
                                               
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Surname)" Title="@Localize[nameof(Contact.Surname)]" Width="auto" />
                                                <RadzenDropDownDataGridColumn Property="@nameof(Contact.Name)" Title="@Localize[nameof(Contact.Name)]" Width="auto" />
                                            </ChildColumns>
                                    </RedGDropDownGrid>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    <!-- Product and Article -->
                    <RadzenRow>
                        @if (_productProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDown TItem="Product" TValue="int?" ValueProperty="Id" TextProperty="Name"
                                                  @bind-Value="@_ticket.IdProduct" For="@(() => _ticket.IdProduct)"
                                                  Data="@_products" AllowFiltering="true" PageSize="10"
                                                  Change="ProductChange" />
                                </RadzenStack>
                            </RadzenColumn>
                        }

                        @if (_articleProperty != PropertyStates.No)
                        {
                            <RadzenColumn Size="12" SizeSM="6">
                                <RadzenStack>
                                    <RedGDropDownGrid TItem="Article" @bind-value="@_ticket.IdArticle" TValue="int?" AllowFiltering="true" AllowClear="true"
                                                      Data="@_articles" Count="@_articles.Count" TextProperty="@nameof(Article.CompleteName)"
                                                      For="@(() => _ticket.IdArticle)" ValueProperty="Id">
                                        <ChildColumns>

                                            <RadzenDropDownDataGridColumn Property="Product.Name" Title="@Localize["Product"]" Width="200px" />
                                            <RadzenDropDownDataGridColumn Property="SerialNumber" Title="@Localize["SerialNumber"]" Width="200px" />
                                        </ChildColumns>
                                    </RedGDropDownGrid>

                                    
                                </RadzenStack>
                            </RadzenColumn>
                        }
                    </RadzenRow>

                    <!-- Priority and Project -->
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGSelectEnum TEnum="TicketPriorities" TValue="TicketPriorities" @bind-Value="@_ticket.Priority" 
                                                For="@(() => _ticket.Priority)" AllowClear="false" />
                            </RadzenStack>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="Project" TValue="int?" ValueProperty="Id" TextProperty="Name"
                                              @bind-Value="@_ticket.IdProject" For="@(() => _ticket.IdProject)"
                                              Data="@_projects" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Description -->
                    <RedGTextArea @bind-Value="@_ticket.Description" For="@(() => _ticket.Description)" Rows="8" />

                    <!-- Invoiced -->
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RadzenFormField>
                                    <ChildContent>
                                        <RadzenLabel Component="swInvoice">
                                            <DisplayName For="@(() => _ticket.Invoiced)" />
                                        </RadzenLabel>
                                    </ChildContent>
                                    <Helper>
                                        <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                                            <Authorized Context="AuthorizeRole">
                                                <RadzenSwitch @bind-Value=@_ticket.Invoiced Name="swInvoice" />
                                                <ValidationMessage For="@(() => _ticket.Invoiced)" />
                                            </Authorized>
                                            <NotAuthorized Context="AuthorizeRole">
                                                <RadzenLabel>@_ticket.Invoiced</RadzenLabel>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" Text=@Localize["Cancel"] />
            <RedGButton RGButtonType="RGButtonType.Submit" Text="@Localize["Save"]" />
        </RadzenStack>

    </EditForm>
}