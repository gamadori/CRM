@page "/Lavori"
@using CRM.Client.Helpers
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@inject ITicketsService TicketsService
@inject NavigationManager Nav
@inject NotificationService Notification
@inject IHeaderService HeaderService
@inject Microsoft.Extensions.Localization.IStringLocalizer<CRM.Shared.Resources.App> Localize

@* La schermata che il tecnico apre la mattina: cosa deve fare, in ordine.
   Non e' una griglia con i filtri, e' un elenco che si legge dall'alto. L'ordine lo decide il
   server, perche' e' a due livelli: prima il gruppo, poi la data dentro il gruppo. *@

<PageHeader Model="@_pageHeader"></PageHeader>

<div class="work-page">
    <div class="work-head">
        <div class="work-head-title">
            <span class="work-head-icon"><span class="material-icons">assignment_turned_in</span></span>
            <div>
                <h2>@Localize["I miei lavori"]</h2>
                <p>@Sottotitolo</p>
            </div>
        </div>

        <div class="work-head-side">
            @if (!_loading && _items.Count > 0)
            {
                @if (InRitardo > 0)
                {
                    <span class="work-stat stat-late">
                        <span class="material-icons">error_outline</span>
                        <strong>@InRitardo</strong> @Localize["in ritardo"]
                    </span>
                }
                @if (DaPrendere > 0)
                {
                    <span class="work-stat stat-free">
                        <span class="material-icons">front_hand</span>
                        <strong>@DaPrendere</strong> @Localize["da prendere"]
                    </span>
                }
            }
            <RadzenButton Icon="refresh" Text="@Localize["Aggiorna"]" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Disabled="@_loading" Click="@Carica" />
        </div>
    </div>

    @if (_loading)
    {
        <Waiting />
    }
    else if (!string.IsNullOrWhiteSpace(_errore))
    {
        <div class="work-error">
            <span class="material-icons">report_problem</span>
            <span>@_errore</span>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="work-empty">
            <span class="material-icons">check_circle</span>
            <strong>@Localize["Non hai lavori aperti."]</strong>
            <span>@Localize["Quando ti assegnano qualcosa lo trovi qui."]</span>
        </div>
    }
    else
    {
        @foreach (var gruppo in Gruppi)
        {
            var righe = _items.Where(i => i.Group == gruppo).ToList();
            if (righe.Count == 0)
            {
                continue;
            }

            <div class="work-group @ClasseGruppo(gruppo)">
                <div class="work-group-head">
                    <span class="work-group-icon"><span class="material-icons">@IconaGruppo(gruppo)</span></span>
                    <span class="work-group-name">@TitoloGruppo(gruppo)</span>
                    <span class="work-group-count">@righe.Count</span>
                    @if (gruppo == WorkListGroup.CommessaBloccata)
                    {
                        <span class="work-group-note">@Localize["Aspettano un'altra fase"]</span>
                    }
                </div>

                @foreach (var item in righe)
                {
                    <div class="work-row @(item.InRitardo ? "in-ritardo" : "")" @onclick="@(() => Apri(item))">
                        <span class="work-row-bar"></span>
                        <span class="work-num">@item.Numero</span>

                        <div class="work-row-main">
                            <div class="work-row-title">@Descrizione(item)</div>
                            <div class="work-row-meta">
                                @if (!string.IsNullOrWhiteSpace(item.Cliente))
                                {
                                    <span class="work-tag">
                                        <span class="material-icons">business</span>
                                        <span>@item.Cliente</span>
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.CommessaCode))
                                {
                                    <span class="work-tag tag-commessa">
                                        <span class="material-icons">precision_manufacturing</span>
                                        <span>@item.CommessaCode@(string.IsNullOrWhiteSpace(item.FaseName) ? "" : $" · {item.FaseName}")</span>
                                    </span>
                                }
                                @if (item.BloccatoDa.Count > 0)
                                {
                                    <span class="work-tag tag-blocco">
                                        <span class="material-icons">hourglass_top</span>
                                        <span>@Localize["Aspetta"]: @string.Join(", ", item.BloccatoDa)</span>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="work-row-side">
                            @if (item.Scadenza != null)
                            {
                                <span class="work-scadenza">
                                    <span class="material-icons">@(item.InRitardo ? "event_busy" : "event")</span>
                                    @Localize["entro"] @item.Scadenza.Value.ToString("dd/MM")
                                </span>
                            }
                            @if (item.DaPrendere)
                            {
                                <RadzenButton Text="@Localize["Prendi"]" Icon="front_hand" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Primary" Disabled="@(_prendendo == item.IdTicket)"
                                              Click="@(async args => await Prendi(item))" @onclick:stopPropagation="true" />
                            }
                            <span class="material-icons work-arrow">chevron_right</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<WorkListItemDTO> _items = new();
    private bool _loading = true;
    private string? _errore;
    private int? _prendendo;
    private PageHeaderModel? _pageHeader;

    private static readonly WorkListGroup[] Gruppi =
    {
        WorkListGroup.Assistenza,
        WorkListGroup.Commessa,
        WorkListGroup.CommessaBloccata
    };

    private string Sottotitolo => _loading
        ? string.Empty
        : $"{_items.Count} {Localize["lavori aperti"]}";

    /// <summary>Quanti sono gia' fuori tempo: e' il numero che si guarda per primo.</summary>
    private int InRitardo => _items.Count(i => i.InRitardo);

    /// <summary>Quanti sono del gruppo e non li ha ancora presi nessuno.</summary>
    private int DaPrendere => _items.Count(i => i.DaPrendere);

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();
        await Carica();
    }

    private async Task Carica()
    {
        _loading = true;
        _errore = null;

        var risposta = await TicketsService.GetWorkListAsync();
        _items = risposta.Items;
        _errore = risposta.ErrorMessage;

        _loading = false;
    }

    private string TitoloGruppo(WorkListGroup gruppo) => gruppo switch
    {
        WorkListGroup.Assistenza => Localize["Assistenza"],
        WorkListGroup.Commessa => Localize["Commesse"],
        _ => Localize["Da fare piu' avanti"]
    };

    private static string IconaGruppo(WorkListGroup gruppo) => gruppo switch
    {
        WorkListGroup.Assistenza => "support_agent",
        WorkListGroup.Commessa => "precision_manufacturing",
        _ => "hourglass_top"
    };

    /// <summary>La classe porta il colore del gruppo: le righe dentro lo ereditano.</summary>
    private static string ClasseGruppo(WorkListGroup gruppo) => gruppo switch
    {
        WorkListGroup.Assistenza => "group-assistenza",
        WorkListGroup.Commessa => "group-commessa",
        _ => "group-bloccate"
    };

    /// <summary>
    /// Prima riga della descrizione: in elenco serve il titolo, non il testo intero.
    /// <para>
    /// I ticket generati da una fase hanno la descrizione gia' composta come
    /// "COMMESSA - Fase - Titolo". Commessa e fase stanno anche nella riga sotto, quindi qui si
    /// tolgono: altrimenti la stessa cosa si legge tre volte.
    /// </para>
    /// </summary>
    private static string Descrizione(WorkListItemDTO item)
    {
        var testo = (item.Descrizione ?? string.Empty).Trim();
        if (testo.Length == 0)
            return "-";

        var fine = testo.IndexOfAny(new[] { '\r', '\n' });
        if (fine > 0)
            testo = testo[..fine];

        foreach (var prefisso in new[] { $"{item.CommessaCode} - {item.FaseName} - ", $"{item.CommessaCode} - " })
        {
            if (prefisso.Length > 3 && testo.StartsWith(prefisso, StringComparison.OrdinalIgnoreCase))
            {
                testo = testo[prefisso.Length..].Trim();
                break;
            }
        }

        if (testo.Length == 0)
            testo = item.FaseName;

        return testo.Length > 120 ? testo[..120] + "…" : testo;
    }

    /// <summary>
    /// Apre la scheda Info, la stessa a cui porta l'elenco ticket. Le schede del ticket sono due,
    /// Info e Details: da qui si va dove va anche il percorso principale, cosi' chi lavora vede
    /// sempre la stessa pagina.
    /// </summary>
    private void Apri(WorkListItemDTO item) => Nav.NavigateTo($"/Tickets/{item.IdTicket}/Info");

    private async Task Prendi(WorkListItemDTO item)
    {
        _prendendo = item.IdTicket;
        var esito = await TicketsService.ClaimAsync(item.IdTicket);
        _prendendo = null;

        if (esito?.State == true)
        {
            Notification.Notify(NotificationSeverity.Success, Localize["Ticket"], Localize["Preso in carico"]);
            await Carica();
            return;
        }

        Notification.Notify(NotificationSeverity.Error, Localize["Ticket"],
            esito?.Message ?? Localize["Impossibile prendere il ticket"]);
    }
}
