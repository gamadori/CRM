@page "/Tickets/Search"


<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">Ricerca Intelligente Ticket</h2>
            <p class="text-muted">Trova ticket simili usando l'intelligenza artificiale</p>
        </div>
    </div>

    <!-- Ricerca AI -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        <span class="material-icons me-2" style="font-size: 18px; vertical-align: middle;">search</span>
                        Descrivi il problema
                    </label>
                    <div class="input-group">
                        <RadzenSpeechToTextButton Change="@(args => OnSpeechCaptured(args, true, "SearchAI"))" />
                        <RadzenTextArea class="form-control" 
                                      Placeholder="Es: Il sistema non invia email dopo l'aggiornamento..." 
                                      @bind-Value="@_searchRequest.ProblemDescription" 
                                      @onkeyup="@SearchInputKeyPressed"
                                      Rows="3" 
                                      Style="resize: vertical;" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Risultati massimi</label>
                    <RadzenNumeric @bind-Value="@_searchRequest.TopResults" Min="5" Max="50" TValue="int" class="w-100" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Similarità minima (%)</label>
                    <RadzenNumeric @bind-Value="@_searchRequest.MinSimilarityThreshold" Min="0" Max="100" TValue="double" class="w-100" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <RadzenButton Click="@OnClickAISearch" 
                                Icon="psychology" 
                                Text="Ricerca AI" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Disabled="@_loading"
                                class="w-100 py-2" />
                </div>
            </div>
        </div>
    </div>

    <!-- Risultati AI -->
    @if (_searchResponse != null && _searchResponse.Results.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <span class="material-icons me-2" style="font-size: 20px; vertical-align: middle;">auto_awesome</span>
                        Ticket Simili Trovati
                    </h5>
                    <span class="badge bg-primary">@_searchResponse.Results.Count risultati in @_searchResponse.ProcessingTimeMs ms</span>
                </div>
            </div>
            <div class="card-body p-0">
                @foreach (var result in _searchResponse.Results)
                {
                    <div class="border-bottom p-3 similarity-result" @onclick="@(async () => await OpenTicket(result.TicketId))" style="cursor: pointer;">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="flex-grow-1">
                                <h6 class="mb-1">
                                    <span class="badge bg-secondary me-2">@result.TicketNumber</span>
                                    @result.Title
                                </h6>
                                <p class="text-muted small mb-2">
                                    <span class="material-icons me-1" style="font-size: 14px; vertical-align: middle;">business</span>
                                    @result.CustomerName
                                    @if (result.ClosedDate.HasValue)
                                    {
                                        <span class="ms-2">
                                            <span class="material-icons me-1" style="font-size: 14px; vertical-align: middle;">event</span>
                                            Chiuso: @result.ClosedDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </p>
                            </div>
                            <div class="text-end">
                                <div class="similarity-badge mb-2" style="background: linear-gradient(135deg, @GetSimilarityColor(result.SimilarityPercentage) 0%, @GetSimilarityColor(result.SimilarityPercentage, true) 100%); color: white; padding: 8px 16px; border-radius: 20px; font-weight: bold;">
                                    @result.SimilarityPercentage.ToString("F1")%
                                </div>
                                <small class="text-muted">Match</small>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(result.Solution))
                        {
                            <div class="alert alert-success mb-0 mt-2" style="background-color: #f0f9ff; border-color: #3b82f6;">
                                <strong><span class="material-icons me-1" style="font-size: 16px; vertical-align: middle;">lightbulb</span>Soluzione:</strong>
                                <p class="mb-0 mt-1">@result.Solution.Substring(0, Math.Min(200, result.Solution.Length))@(result.Solution.Length > 200 ? "..." : "")</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (_loading)
    {
        <div class="text-center py-5">
            <Waiting></Waiting>
            <p class="text-muted mt-3">Analizzando i ticket con AI...</p>
        </div>
    }
    else if (_searchResponse != null && !_searchResponse.Results.Any())
    {
        <div class="alert alert-info">
            <span class="material-icons me-2" style="vertical-align: middle;">info</span>
            Nessun ticket simile trovato con la soglia di similarità specificata. Prova a ridurre la soglia o modificare la descrizione.
        </div>
    }

    <!-- Ricerca tradizionale (opzionale) -->
    @if (_showTraditionalSearch)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Ricerca Tradizionale</h5>
            </div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <RadzenSpeechToTextButton class="col-auto" Change="@(args => OnSpeechCaptured(args, false, "Traditional"))" />
                    <RadzenTextBox class="col" Placeholder="Cerca..." @bind-Value="@_ticketFilter.Search" @onkeyup="@SearchInputKeyPressed" />
                    <RadzenButton Click="@OnClick" Icon="search" ButtonStyle="ButtonStyle.Light"></RadzenButton>
                </div>

                @if (_tickets != null)
                {
                    <RadzenDataGrid IsLoading="@_loading" Count="@_tickets.MetaData.TotalCount" Data="@_tickets.Items" LoadData="@LoadData"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
                                AllowSorting="true" AllowFiltering="true" AllowPaging="true" AllowColumnResize="true"
                                PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center"
                                    TItem="TicketDTO" EmptyText="Nessun Ticket Trovato">
                        <Columns>
                            <RadzenDataGridColumn Context="item" TItem="TicketDTO" Property="@nameof(TicketDTO.Id)" FormatString="{0:000000}" Title="ID">
                                <Template>
                                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OpenTicket(item.Id)">@item.Id.ToString("000000")</a>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Date)" FormatString="{0:d}" Title="Data" />
                            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Description)" Title="Descrizione" />
                            <RadzenDataGridColumn Context="item" TItem="TicketDTO" Property="@nameof(TicketDTO.Rank)" Title="Rank" TextAlign="Radzen.TextAlign.Center">
                                <Template>
                                    <RadzenRating Value="@(item.Rank * 5 / 200)" Stars="5" ReadOnly="true" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </div>
    }
</div>

<style>
    .similarity-result {
        transition: all 0.2s ease;
    }

    .similarity-result:hover {
        background-color: #f8f9fa;
        transform: translateX(5px);
    }

    .similarity-badge {
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        font-size: 14px;
        min-width: 70px;
        text-align: center;
    }
</style>