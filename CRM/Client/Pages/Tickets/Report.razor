@page "/Tickets/Report/{Id:int}"
@using Syncfusion.Blazor.SfPdfViewer
@using Syncfusion.Blazor



<div style="height: @Height; width: @Width">

    @if (!string.IsNullOrEmpty(_data))
    {
       
       <SfPdfViewer2 @ref="pdfViewer" DocumentPath="@_data"             
        Height="100%" Width="100%"></SfPdfViewer2>

    }
    else
    {
        <Waiting></Waiting>
    }
</div>