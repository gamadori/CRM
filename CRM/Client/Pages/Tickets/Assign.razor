@* ✅ RIMOSSO @page - Ora è un componente dialog *@

@using Radzen
@using Radzen.Blazor

@if (!_isLoadingPage)
{
    <div class="assign-users-container">
        <!-- Header con titolo e badge count -->
        <div class="assign-header">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 d-flex align-items-center">
                    <span class="material-icons me-2 text-primary">groups</span>
                    @Localize["Assign Users"]
                </h5>
                <span class="badge bg-primary bg-opacity-75 rounded-pill px-3 py-2 fs-6">
                    <i class="bi bi-person-check me-1"></i>
                    @_selectedUserIds.Count @Localize["selected"]
                </span>
            </div>
        </div>

        @* Un ticket smistato a un gruppo non ha (ancora) responsabili: chi registra l'intervento
           lo prende in carico. L'effetto va dichiarato prima del salvataggio, non dopo. *@
        @if (_assignmentContext?.IdGroupAssigned != null)
        {
            var pendingClaim = PendingClaimUserIds;

            <div class="claim-notice @(pendingClaim.Any() ? "claim-notice-active" : "")">
                <span class="claim-notice-icon material-icons">groups</span>
                <div class="claim-notice-body">
                    <div class="claim-notice-title">
                        @Localize["Ticket assigned to group"]
                        <span class="group-pill">@_assignmentContext.GroupAssigned</span>
                    </div>
                    @if (pendingClaim.Any())
                    {
                        <div class="claim-notice-text">
                            @Localize["Saving will also take the ticket in charge for"]:
                            <strong>@string.Join(", ", pendingClaim.Select(id => GetSelectedUser(id)?.NameComplete ?? id))</strong>
                        </div>
                    }
                    else
                    {
                        <div class="claim-notice-text">
                            @Localize["Group members can be selected: recording the intervention takes the ticket in charge"]
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Sezione ricerca utenti -->
        <div class="search-section mb-4">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <RadzenTextBox 
                    @bind-Value="@_searchQuery" 
                    Placeholder="@Localize["Search users..."]"
                    class="form-control border-start-0"
                    @oninput="@(args => OnSearchChanged(args.Value?.ToString()))"
                    Style="padding: 0.75rem; border-left: none;">
                </RadzenTextBox>
            </div>
        </div>

        <!-- Utenti Selezionati -->
        <div class="selected-users-section mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label fw-semibold text-secondary mb-0">
                    <i class="bi bi-person-check-fill me-1 text-success"></i>
                    @Localize["Selected Users"] (@_selectedUserIds.Count)
                </label>
                @if (_selectedUserIds.Any())
                {
                    <button type="button" class="btn-clear-all" @onclick="ClearAllUsers">
                        <i class="bi bi-x-circle me-1"></i>@Localize["Remove all"]
                    </button>
                }
            </div>

            @if (_selectedUserIds.Any())
            {
                <div class="selected-users-container">
                    @foreach (var userId in _selectedUserIds.ToList())
                    {
                        var user = GetSelectedUser(userId);
                        if (user != null)
                        {
                            @* Il titolo parla di presa in carico solo dove ha senso: nel picker del
                               ticket non c'e' nessun gruppo di mezzo. *@
                            <div class="selected-user-chip @(IsGroupCandidate(userId) ? "from-group" : "")"
                                 title="@(_assignmentContext?.IdGroupAssigned == null
                                            ? null
                                            : IsGroupCandidate(userId)
                                                ? Localize["Will be taken in charge on save"].Value
                                                : Localize["Already assigned to the ticket"].Value)">
                                <span class="chip-avatar">@GetInitials(user.NameComplete)</span>
                                <span class="chip-name">@user.NameComplete</span>
                                @if (IsGroupCandidate(userId))
                                {
                                    <span class="chip-claim-icon material-icons">how_to_reg</span>
                                }
                                <button type="button"
                                        class="chip-remove" 
                                        @onclick="() => RemoveUser(userId)"
                                        title="@Localize["Remove"]">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="selected-user-chip unresolved">
                                <span class="chip-avatar">?</span>
                                <span class="chip-name">@Localize["User not available"]</span>
                                <button type="button" 
                                        class="chip-remove" 
                                        @onclick="() => RemoveUser(userId)"
                                        title="@Localize["Remove"]">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border d-flex align-items-start mb-0" role="alert">
                    <i class="bi bi-info-circle text-info me-2 fs-5"></i>
                    <div class="text-start">
                        <span class="fw-medium">@Localize["No users assigned"]</span>
                        <small class="d-block text-muted">@Localize["Click 'Save' to remove all assignments or select users below"]</small>
                    </div>
                </div>
            }
        </div>

        <!-- Lista utenti disponibili -->
        <div class="available-users-section">
            <label class="form-label fw-semibold text-secondary mb-2">
                <i class="bi bi-people me-1"></i>
                @Localize["Available Users"]
            </label>
            
            @if (_filteredUsers.Any())
            {
                <div class="users-list">
                    @foreach (var user in _filteredUsers)
                    {
                        var isSelected = _selectedUserIds.Contains(user.Id);
                        var workload = GetUserWorkload(user.Id);
                        var hasWorkloadData = _showWorkload;

                        <div class="user-card @(isSelected ? "selected" : "")"
                             @onclick="() => ToggleUser(user.Id)">
                            <div class="user-avatar-large @(isSelected ? "avatar-selected" : "")">
                                @GetInitials(user.NameComplete)
                            </div>

                            <div class="user-main">
                                <div class="user-name-line">
                                    <span class="user-name-full">@user.NameComplete</span>
                                    @if (IsGroupCandidate(user.Id))
                                    {
                                        <span class="group-badge" title="@Localize["Candidate from the assigned group: selecting them takes the ticket in charge"]">
                                            <span class="material-icons">groups</span>
                                            @_assignmentContext!.GroupAssigned
                                        </span>
                                    }
                                    else if (_assignmentContext?.IdGroupAssigned != null)
                                    {
                                        <span class="assigned-badge" title="@Localize["Already assigned to the ticket"]">
                                            <span class="material-icons">how_to_reg</span>
                                            @Localize["In charge"]
                                        </span>
                                    }
                                </div>

                                @if (hasWorkloadData)
                                {
                                    <div class="workload-track" title="@workload.LevelLabel">
                                        <div class="workload-fill @workload.BadgeClass"
                                             style="width: @workload.BarWidthPercentage%;"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="user-email">@user.Email</div>
                                }

                                @if (hasWorkloadData && workload.TicketCount > 0)
                                {
                                    <button type="button"
                                            class="btn-scheduler-link"
                                            @onclick:stopPropagation="true"
                                            @onclick="async () => await OpenSchedulerForUser(user.Id)"
                                            title="Vedi calendario completo in nuova scheda">
                                        <i class="bi bi-calendar3 me-1"></i>Vedi dettagli
                                    </button>
                                }
                            </div>

                            @if (hasWorkloadData)
                            {
                                <div class="user-trailing">
                                    <span class="workload-count @workload.BadgeClass"
                                          title="@workload.TicketCount ticket assegnati per questa giornata">
                                        <span class="workload-dot"></span>
                                        @workload.BadgeText
                                    </span>
                                    <span class="workload-level">@workload.LevelLabel</span>
                                </div>
                            }

                            @if (isSelected)
                            {
                                <div class="check-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (IsForIntervention && !_users.Any() && string.IsNullOrEmpty(_searchQuery))
            {
                @* Il vicolo cieco storico: nessun candidato e nessuna spiegazione. Almeno diciamo
                   all'operatore che cosa manca e dove sistemarlo. *@
                <div class="empty-candidates">
                    <span class="material-icons">person_off</span>
                    <div>
                        <div class="empty-candidates-title">@Localize["No candidate users for this ticket"]</div>
                        <div class="empty-candidates-text">
                            @Localize["Assign the ticket to a user or to a group to be able to record an intervention"]
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border d-flex align-items-center">
                    <i class="bi bi-search text-muted me-2 fs-5"></i>
                    @Localize["No users found"]
                </div>
            }
        </div>

        <!-- Footer con azioni -->
        <div class="assign-footer mt-4 pt-3 border-top">
            <div class="d-flex gap-2 justify-content-start">
                <RadzenButton 
                    Click="HandleValidSubmit" 
                    ButtonStyle="ButtonStyle.Primary" 
                    Icon="done"
                    Text="@Localize["Save Assignments"]"
                    class="px-4" />
                
                <RadzenButton 
                    Click="Cancel" 
                    ButtonStyle="ButtonStyle.Light" 
                    Icon="close"
                    Text="@Localize["Cancel"]"
                    class="px-4" />
            </div>
        </div>
    </div>
}
else
{
    <Waiting></Waiting>
}

<style>
    .assign-users-container {
        padding: 1rem;
        max-height: 80vh;
        overflow-y: auto;
        text-align: left;
    }

    /* Selected Users Chips */
    .selected-users-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.5rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 0.5rem;
        border: 1px solid #e9ecef;
    }

    .selected-user-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 2rem;
        font-size: 0.875rem;
        color: #ffffff;
        font-weight: 500;
        box-shadow: 0 2px 4px rgba(102, 126, 234, 0.3);
        transition: all 0.2s ease;
    }

    .selected-user-chip:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(102, 126, 234, 0.4);
    }

    .chip-avatar {
        width: 26px;
        height: 26px;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        color: #ffffff;
        text-transform: uppercase;
    }

    .chip-name {
        color: #ffffff;
        font-weight: 500;
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chip-remove {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #ffffff;
        transition: all 0.2s ease;
        padding: 0;
    }

    .chip-remove:hover {
        background: rgba(255, 255, 255, 0.4);
        transform: scale(1.1);
    }

    .chip-remove i {
        font-size: 0.75rem;
    }

    .selected-user-chip.unresolved {
        background: #6b7280;
        box-shadow: 0 2px 4px rgba(107, 114, 128, 0.25);
    }

    /* Selezionato che il salvataggio assegnera' anche al ticket */
    .selected-user-chip.from-group {
        background: linear-gradient(135deg, #0f766e 0%, #14a08a 100%);
        box-shadow: 0 2px 4px rgba(15, 118, 110, 0.3);
    }

    .selected-user-chip.from-group:hover {
        box-shadow: 0 4px 8px rgba(15, 118, 110, 0.4);
    }

    .chip-claim-icon {
        font-size: 1rem;
        opacity: 0.9;
    }

    /* ─── Presa in carico implicita: avviso e badge ────────────────────────── */

    .claim-notice {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        margin-bottom: 1.25rem;
        border: 1px solid var(--crm-border);
        border-left: 3px solid #0f766e;
        border-radius: 12px;
        background: color-mix(in srgb, #14a08a 6%, var(--crm-surface));
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    /* Con qualcuno da prendere in carico l'avviso smette di essere informativo e diventa un impegno */
    .claim-notice.claim-notice-active {
        border-left-color: #b45309;
        background: color-mix(in srgb, #f59e0b 10%, var(--crm-surface));
    }

    .claim-notice-icon {
        font-size: 1.35rem;
        color: #0f766e;
        flex-shrink: 0;
        line-height: 1.4;
    }

    .claim-notice.claim-notice-active .claim-notice-icon {
        color: #b45309;
    }

    .claim-notice-body {
        min-width: 0;
    }

    .claim-notice-title {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--crm-text);
    }

    .claim-notice-text {
        margin-top: 0.2rem;
        font-size: 0.82rem;
        line-height: 1.4;
        color: var(--crm-text-muted);
    }

    .claim-notice-text strong {
        color: var(--crm-text);
    }

    .group-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.1rem 0.6rem;
        border-radius: 2rem;
        background: color-mix(in srgb, #14a08a 18%, var(--crm-surface));
        border: 1px solid color-mix(in srgb, #0f766e 35%, transparent);
        color: var(--crm-text);
        font-size: 0.78rem;
        font-weight: 600;
    }

    .user-name-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .user-name-line .user-name-full {
        min-width: 0;
    }

    .group-badge,
    .assigned-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        flex-shrink: 0;
        padding: 0.1rem 0.5rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
        max-width: 11rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .group-badge .material-icons,
    .assigned-badge .material-icons {
        font-size: 0.85rem;
    }

    .group-badge {
        background: color-mix(in srgb, #14a08a 14%, var(--crm-surface));
        border: 1px solid color-mix(in srgb, #0f766e 30%, transparent);
        color: #0f766e;
    }

    .assigned-badge {
        background: color-mix(in srgb, #16a34a 12%, var(--crm-surface));
        border: 1px solid color-mix(in srgb, #16a34a 28%, transparent);
        color: #15803d;
    }

    .empty-candidates {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1.1rem;
        border: 1px dashed var(--crm-border-strong);
        border-radius: 12px;
        background: var(--crm-surface-muted);
    }

    .empty-candidates .material-icons {
        font-size: 1.5rem;
        color: var(--crm-text-muted);
        flex-shrink: 0;
    }

    .empty-candidates-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--crm-text);
    }

    .empty-candidates-text {
        margin-top: 0.2rem;
        font-size: 0.82rem;
        line-height: 1.4;
        color: var(--crm-text-muted);
    }

    /* Tema scuro (body.dark-theme, come il resto della shell): i toni scuri di verde e ambra
       sono illeggibili su fondo scuro, servono le varianti chiare. */
    body.dark-theme .claim-notice-icon,
    body.dark-theme .group-badge {
        color: #5eead4;
    }

    body.dark-theme .claim-notice.claim-notice-active .claim-notice-icon {
        color: #fbbf24;
    }

    body.dark-theme .assigned-badge {
        color: #86efac;
    }

    body.dark-theme .claim-notice {
        border-left-color: #14a08a;
    }

    body.dark-theme .claim-notice.claim-notice-active {
        border-left-color: #f59e0b;
    }

    /* Clear-all button */
    .btn-clear-all {
        background: none;
        border: none;
        color: #dc2626;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.15rem 0.35rem;
        cursor: pointer;
        border-radius: 0.35rem;
        transition: background-color 0.15s ease;
    }

    .btn-clear-all:hover {
        background: rgba(220, 38, 38, 0.08);
        text-decoration: underline;
    }

    /* User Cards List */
    .users-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        max-height: 340px;
        overflow-y: auto;
        padding: 0.5rem;
    }

    .user-card {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        background: #ffffff;
        border: 1px solid #eef0f3;
        border-radius: 14px;
        padding: 0.85rem 1.1rem;
        cursor: pointer;
        transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    .user-card:hover {
        border-color: #e4d0d8;
        box-shadow: 0 6px 18px rgba(122, 26, 61, 0.10);
        transform: translateY(-1px);
    }

    .user-card.selected {
        border-color: #a01f4c;
        box-shadow: 0 6px 18px rgba(160, 31, 76, 0.14);
    }

    .user-avatar-large {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, #7a1a3d 0%, #a01f4c 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: #ffffff;
        text-transform: uppercase;
        flex-shrink: 0;
        letter-spacing: 0.02em;
    }

    .user-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .user-name-full {
        font-weight: 700;
        color: #1f2430;
        font-size: 0.95rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .user-email {
        font-size: 0.8rem;
        color: #98a2b3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Trailing: count + level label, right aligned */
    .user-trailing {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.15rem;
        flex-shrink: 0;
        text-align: right;
    }

    .check-icon {
        flex-shrink: 0;
        color: #16a34a;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
    }

    /* Workload: ticket count (dark text + colored dot) */
    .workload-count {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: #1f2430;
        white-space: nowrap;
    }

    .workload-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* Workload: level label (muted) */
    .workload-level {
        font-size: 0.75rem;
        font-weight: 500;
        color: #98a2b3;
        white-space: nowrap;
    }

    /* Workload: progress bar */
    .workload-track {
        width: 100%;
        height: 7px;
        background: #eef0f3;
        border-radius: 4px;
        overflow: hidden;
    }

    .workload-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.35s ease;
    }

    /* Workload level colors (dot + bar fill share the tone) */
    .workload-free .workload-dot { background: #22c55e; }
    .workload-free.workload-fill { background: linear-gradient(90deg, #22c55e, #4ade80); }

    .workload-low .workload-dot { background: #eab308; }
    .workload-low.workload-fill { background: linear-gradient(90deg, #d97706, #f59e0b); }

    .workload-medium .workload-dot { background: #f97316; }
    .workload-medium.workload-fill { background: linear-gradient(90deg, #ea580c, #fb923c); }

    .workload-high .workload-dot { background: #ef4444; }
    .workload-high.workload-fill { background: linear-gradient(90deg, #be123c, #f43f5e); }

    /* Scheduler Link Button */
    .btn-scheduler-link {
        background: none;
        border: none;
        color: #667eea;
        font-size: 0.75rem;
        padding: 0.25rem 0;
        cursor: pointer;
        text-decoration: none;
        transition: color 0.2s;
        text-align: left;
    }

    .btn-scheduler-link:hover {
        color: #5a67d8;
        text-decoration: underline;
    }

    /* Footer - Allineato a sinistra */
    .assign-footer {
        background: #ffffff;
        position: sticky;
        bottom: 0;
    }

    /* Scrollbar styling */
    .users-list::-webkit-scrollbar,
    .assign-users-container::-webkit-scrollbar {
        width: 6px;
    }

    .users-list::-webkit-scrollbar-track,
    .assign-users-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .users-list::-webkit-scrollbar-thumb,
    .assign-users-container::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }

    .users-list::-webkit-scrollbar-thumb:hover,
    .assign-users-container::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
    }
</style>
