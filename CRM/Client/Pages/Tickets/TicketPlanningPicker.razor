@using BlazoringComponents.Scheduler;
@using Models
@using Radzen
@using Radzen.Blazor

@if (_ticket != null)
{
<BlazorHeader Header="@_header"></BlazorHeader>

   
    <Scheduler @bind-DateCurrent="@Date" @bind-IdUserAssigned="@IdUser" ViewMode="@SchedulerViewMode.Calendar"
               IdTicket="@IdTicket" IdTicketType="@IdTicketType" />
    <div class="mb-3">
        <BlazorButton Template="TemplateButton.Submit" Type=BtnType.Button Text="@Localize["OK"]" OnClick="HandleValidSubmit" />
        <BlazorButton Template="TemplateButton.Cancel" OnClick="Cancel" Text=@Localize["Cancel"] />
        
    </div>
}
else
{
    <Waiting></Waiting>
}
