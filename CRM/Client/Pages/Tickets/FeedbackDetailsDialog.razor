@using CRM.Shared.DTOs

<div style="padding: 20px; min-width: 350px;">
    <div style="text-align: center; margin-bottom: 20px;">
        <div style="font-size: 28px; letter-spacing: 2px;">
            @for (int i = 1; i <= 5; i++)
            {
                var filled = i <= Feedback?.Rating;
                <span class="material-icons @(filled ? "text-warning" : "text-muted")">@(filled ? "star" : "star_border")</span>
            }
        </div>
        <div style="font-size: 14px; color: var(--crm-text-muted, #6c757d); margin-top: 4px;">@(Feedback?.Rating ?? 0) su 5</div>
    </div>

    @if (Feedback != null && !string.IsNullOrWhiteSpace(Feedback.Comment))
    {
        <div class="feedback-details-comment" style="background: var(--crm-surface-muted, #f8f9fa); border-radius: 8px; padding: 16px; margin-bottom: 16px;">
            <div class="feedback-details-label" style="font-weight: 500; color: var(--crm-text, #495057); margin-bottom: 8px;">Commento:</div>
            <div class="feedback-details-text" style="font-style: italic; color: var(--crm-text, #212529); line-height: 1.5;">
                "@Feedback.Comment"
            </div>
        </div>
    }

    @if (Feedback != null)
    {
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--crm-text-muted, #6c757d); border-top: 1px solid var(--crm-border, #dee2e6); padding-top: 12px;">
            <span><strong>Da:</strong> @Feedback.UserName</span>
            <span>@Feedback.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public TicketFeedbackResponse Feedback { get; set; }
}
