@page "/Tickets/DataAssistant"

<div class="container-fluid px-4 py-3 d-flex flex-column" style="height: calc(100vh - 90px);">
    <!-- Header -->
    <div class="row mb-3 flex-shrink-0">
        <div class="col-12">
            <h2 class="fw-bold text-dark mb-1">
                <span class="material-icons me-2" style="vertical-align: middle;">storage</span>
                Assistente Dati
            </h2>
            <p class="text-muted mb-0">Interroga i dati del CRM: clienti, macchine e ticket. Es: "macchine del cliente Rossi", "quanti ticket aperti ha la ACME?"</p>
        </div>
    </div>

    <!-- Area messaggi -->
    <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body overflow-auto flex-grow-1" id="data-assistant-messages">
            @if (_turns.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <span class="material-icons" style="font-size: 48px; opacity: .4;">travel_explore</span>
                    <p class="mt-2 mb-0">Fai una domanda sui dati del CRM.</p>
                    <p class="small">Es: "elenca i ticket aperti del cliente Bianchi" · "che macchine ha la ditta Verdi?"</p>
                </div>
            }

            @foreach (var turn in _turns)
            {
                <div class="d-flex mb-3 @(turn.Role == "user" ? "justify-content-end" : "justify-content-start")">
                    <div class="@(turn.Role == "user" ? "chat-bubble-user" : "chat-bubble-assistant")">
                        @if (turn.Role == "assistant")
                        {
                            <div class="small fw-semibold text-primary mb-1">
                                <span class="material-icons" style="font-size: 14px; vertical-align: middle;">storage</span>
                                Assistente Dati
                            </div>
                        }
                        <div class="chat-content">@turn.Content</div>
                    </div>
                </div>
            }

            @if (_loading)
            {
                <div class="d-flex mb-3 justify-content-start">
                    <div class="chat-bubble-assistant">
                        <Waiting></Waiting>
                    </div>
                </div>
            }
        </div>

        <!-- Input -->
        <div class="card-footer bg-white border-top">
            <div class="input-group">
                <RadzenTextArea @bind-Value="@_input"
                                @onkeydown="@OnKeyDown"
                                Placeholder="Chiedi qualcosa sui dati del CRM..."
                                Rows="2"
                                Disabled="@_loading"
                                class="form-control"
                                Style="resize: none;" />
                <RadzenButton Click="@SendAsync"
                              Icon="send"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(_loading || string.IsNullOrWhiteSpace(_input))" />
            </div>
        </div>
    </div>
</div>

<style>
    .chat-bubble-user {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        padding: 10px 14px;
        border-radius: 16px 16px 4px 16px;
        max-width: 75%;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .chat-bubble-assistant {
        background-color: #f1f5f9;
        color: #1e293b;
        padding: 10px 14px;
        border-radius: 16px 16px 16px 4px;
        max-width: 80%;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>
