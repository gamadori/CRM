@page "/Tickets/Assistant"
@page "/Tickets/Assistant/{IdTicket:int}"
@page "/Tickets/DataAssistant"
@using CRM.Client.Helpers

<div class="container-fluid px-4 py-3 d-flex flex-column" style="height: calc(100vh - 90px);">
    <!-- Header -->
    <div class="row mb-3 flex-shrink-0">
        <div class="col-12">
            <h2 class="fw-bold mb-1" style="color: var(--crm-text);">
                <span class="material-icons me-2" style="vertical-align: middle;">auto_awesome</span>
                Assistente AI
            </h2>
            <p class="mb-0" style="color: var(--crm-text-muted);">
                Chiedi qualsiasi cosa: dati del CRM (clienti, macchine, ticket) oppure la soluzione a un problema tecnico.
            </p>
        </div>
    </div>

    <!-- Area messaggi -->
    <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="card-body overflow-auto flex-grow-1" id="assistant-messages">
            @if (_turns.Count == 0)
            {
                <div class="text-center py-5" style="color: var(--crm-text-muted);">
                    <span class="material-icons" style="font-size: 48px; opacity: .4;">forum</span>
                    <p class="mt-2 mb-3">Scrivi una domanda per iniziare, oppure prova un esempio:</p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @foreach (var s in Suggestions)
                        {
                            <button class="suggestion-chip" @onclick="() => SendSuggestion(s)">@s</button>
                        }
                    </div>
                </div>
            }

            @foreach (var turn in _turns)
            {
                <div class="d-flex mb-3 @(turn.Role == "user" ? "justify-content-end" : "justify-content-start")">
                    <div class="@(turn.Role == "user" ? "chat-bubble-user" : "chat-bubble-assistant")">
                        @if (turn.Role == "assistant")
                        {
                            <div class="small fw-semibold text-primary mb-1">
                                <span class="material-icons" style="font-size: 14px; vertical-align: middle;">auto_awesome</span>
                                Assistente
                            </div>
                        }

                        @if (turn.Role == "user")
                        {
                            <div class="chat-content-user">@turn.Content</div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(turn.Content))
                            {
                                <div class="chat-content">@MarkdownRenderer.ToHtml(turn.Content)</div>
                            }

                            @if (!string.IsNullOrEmpty(turn.Status))
                            {
                                <div class="tool-status">
                                    <span class="tool-status-dot"></span>
                                    @turn.Status
                                </div>
                            }
                            else if (string.IsNullOrEmpty(turn.Content))
                            {
                                <Waiting></Waiting>
                            }
                        }

                        @if (turn.Role == "assistant" && !string.IsNullOrEmpty(turn.Content) && turn.LogId != null)
                        {
                            <div class="feedback-row">
                                @if (turn.FeedbackSent)
                                {
                                    <span class="feedback-thanks">
                                        <span class="material-icons" style="font-size: 14px; vertical-align: middle;">check_circle</span>
                                        Grazie per il feedback
                                    </span>
                                }
                                else
                                {
                                    <span class="feedback-label">Risposta utile?</span>
                                    <button class="fb-btn @(turn.Feedback == 1 ? "up" : "")" title="Utile"
                                            @onclick="() => VoteUp(turn)">
                                        <span class="material-icons">thumb_up</span>
                                    </button>
                                    <button class="fb-btn @(turn.Feedback == -1 ? "down" : "")" title="Non utile"
                                            @onclick="() => VoteDown(turn)">
                                        <span class="material-icons">thumb_down</span>
                                    </button>
                                }
                            </div>

                            @if (turn.ShowComment && !turn.FeedbackSent)
                            {
                                <div class="feedback-comment">
                                    <RadzenTextArea @bind-Value="turn.CommentDraft" Rows="2" Style="width: 100%;"
                                                    Placeholder="Cosa non andava nella risposta? (facoltativo)" />
                                    <div class="d-flex gap-2 mt-1">
                                        <RadzenButton Text="Invia feedback" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                      Click="() => SubmitDownWithComment(turn)" />
                                        <RadzenButton Text="Annulla" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                      Click="@(() => turn.ShowComment = false)" />
                                    </div>
                                </div>
                            }
                        }

                        @if (turn.Tickets != null && turn.Tickets.Any())
                        {
                            <div class="mt-2 pt-2 border-top">
                                <div class="small mb-1" style="color: var(--crm-text-muted);">Ticket di riferimento:</div>
                                @foreach (var t in turn.Tickets)
                                {
                                    @if (t.CanAccess)
                                    {
                                        <div class="ticket-ref d-flex align-items-center justify-content-between"
                                             @onclick="@(async () => await OpenTicket(t.TicketId))">
                                            <span>
                                                <span class="badge bg-secondary me-1">@t.TicketNumber</span>
                                                <span class="small">@t.CustomerName</span>
                                            </span>
                                            <span class="badge bg-primary">@t.SimilarityPercentage.ToString("F0")%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ticket-ref-locked d-flex align-items-center justify-content-between">
                                            <span class="small" style="color: var(--crm-text-muted);">
                                                <span class="material-icons" style="font-size: 14px; vertical-align: middle;">lock</span>
                                                Caso simile (accesso riservato)
                                            </span>
                                            <span class="badge bg-secondary">@t.SimilarityPercentage.ToString("F0")%</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Input -->
        <div class="card-footer border-top" style="background: var(--crm-surface);">
            <div class="input-group">
                @* Textarea nativa con binding su oninput: RadzenTextArea aggiorna il valore solo
                   al blur, quindi l'invio con Invio partiva col testo vecchio e non ripuliva il
                   campo. Il newline di default su Invio è soppresso da preventEnterNewline (JS). *@
                <textarea id="@InputId"
                          class="form-control"
                          @ref="_inputRef"
                          @bind="_input"
                          @bind:event="oninput"
                          @onkeydown="@OnKeyDown"
                          placeholder="Fai una domanda sui dati del CRM o descrivi un problema da risolvere…"
                          rows="2"
                          disabled="@_loading"
                          style="resize: none;"></textarea>
                <RadzenButton Click="@SendAsync"
                              Icon="send"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(_loading || string.IsNullOrWhiteSpace(_input))" />
            </div>
        </div>
    </div>
</div>

<style>
    .chat-bubble-user {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        padding: 10px 14px;
        border-radius: 16px 16px 4px 16px;
        max-width: 75%;
        word-wrap: break-word;
    }

    .chat-content-user {
        white-space: pre-wrap;
    }

    .chat-bubble-assistant {
        background-color: var(--crm-surface-muted);
        color: var(--crm-text);
        padding: 10px 14px;
        border-radius: 16px 16px 16px 4px;
        max-width: 80%;
        word-wrap: break-word;
    }

    /* Contenuto Markdown della risposta */
    .chat-content > *:first-child { margin-top: 0; }
    .chat-content > *:last-child { margin-bottom: 0; }

    .chat-content p { margin: 0 0 .5rem; }
    .chat-content ul, .chat-content ol { margin: 0 0 .5rem; padding-left: 1.25rem; }
    .chat-content li { margin-bottom: .15rem; }
    .chat-content h1, .chat-content h2, .chat-content h3, .chat-content h4 {
        font-size: 1rem;
        font-weight: 600;
        margin: .75rem 0 .35rem;
    }

    .chat-content a {
        color: var(--crm-link);
        font-weight: 500;
        text-decoration: none;
        border-bottom: 1px dotted color-mix(in srgb, var(--crm-link) 55%, transparent);
    }

    .chat-content a:hover {
        border-bottom-style: solid;
    }

    .chat-content code {
        background: color-mix(in srgb, var(--crm-text) 8%, transparent);
        border-radius: 4px;
        padding: .05rem .3rem;
        font-size: .85em;
    }

    .chat-content pre {
        background: color-mix(in srgb, var(--crm-text) 8%, transparent);
        border-radius: 8px;
        padding: .5rem .75rem;
        overflow-x: auto;
        margin: 0 0 .5rem;
    }

    .chat-content table {
        border-collapse: collapse;
        margin: .25rem 0 .5rem;
        width: 100%;
        font-size: .875rem;
    }

    .chat-content th, .chat-content td {
        border: 1px solid var(--crm-border);
        padding: .3rem .55rem;
        text-align: left;
        vertical-align: top;
    }

    .chat-content th {
        background: color-mix(in srgb, var(--crm-text) 6%, transparent);
        font-weight: 600;
    }

    .chat-content blockquote {
        border-left: 3px solid var(--crm-border-strong);
        margin: 0 0 .5rem;
        padding: .1rem .75rem;
        color: var(--crm-text-muted);
    }

    /* Indicatore attività tool ("Cerco il cliente…") */
    .tool-status {
        display: flex;
        align-items: center;
        gap: .45rem;
        font-size: .82rem;
        font-style: italic;
        color: var(--crm-text-muted);
        margin-top: .25rem;
    }

    .tool-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--crm-link);
        animation: assistant-pulse 1.1s ease-in-out infinite;
        flex-shrink: 0;
    }

    @@keyframes assistant-pulse {
        0%, 100% { opacity: .35; transform: scale(.85); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Suggerimenti di esempio (stato vuoto) */
    .suggestion-chip {
        border: 1px solid var(--crm-border);
        background: var(--crm-surface);
        color: var(--crm-text);
        border-radius: 999px;
        padding: .35rem .85rem;
        font-size: .85rem;
        cursor: pointer;
        transition: all .15s ease;
    }

    .suggestion-chip:hover {
        border-color: var(--crm-link);
        color: var(--crm-link);
    }

    .ticket-ref {
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 8px;
        transition: background-color 0.15s ease;
    }

    .ticket-ref:hover {
        background-color: color-mix(in srgb, var(--crm-text) 6%, transparent);
    }

    .ticket-ref-locked {
        padding: 4px 8px;
        border-radius: 8px;
        opacity: 0.75;
    }

    /* Feedback voto risposta */
    .feedback-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.6rem;
    }

    .feedback-label {
        font-size: 0.78rem;
        color: var(--crm-text-muted);
    }

    .fb-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border: 1px solid var(--crm-border);
        border-radius: 8px;
        background: var(--crm-surface);
        color: var(--crm-text-muted);
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .fb-btn:hover {
        border-color: var(--crm-border-strong);
        color: var(--crm-text);
    }

    .fb-btn .material-icons {
        font-size: 15px;
    }

    .fb-btn.up {
        background: rgba(22, 163, 74, .14);
        border-color: rgba(22, 163, 74, .45);
        color: #16a34a;
    }

    .fb-btn.down {
        background: rgba(220, 38, 38, .14);
        border-color: rgba(220, 38, 38, .45);
        color: #dc2626;
    }

    .feedback-thanks {
        font-size: 0.78rem;
        color: #16a34a;
        font-weight: 500;
    }

    .feedback-comment {
        margin-top: 0.5rem;
    }
</style>
