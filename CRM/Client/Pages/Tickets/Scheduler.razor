@page "/Tickets/Schedule"
@using Models
@using Radzen
@using Radzen.Blazor

<div class="ticket-planning-page">
    <PageHeader Model="_pageHeader">
        <Actions>
            <div class="ticket-planning-actions">
                <RadzenButton Click="@GoToAgenda" Icon="event" ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Flat" Size="ButtonSize.Medium"
                              Text="@Localize["Agenda"]" />
                <RadzenButton Click="@SwitchToTimeline" Icon="view_timeline" ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Flat" Size="ButtonSize.Medium"
                              Text="Timeline giorno" />
            </div>
        </Actions>
    </PageHeader>

    <div class="ticket-planning-surface">
        <CascadingValue Value="_maxNumMonthlyTicket" TValue="int" Name="MaxNumDaylyTicket">
            <BlazoringComponents.Scheduler.AGScheduler @ref="schedulerTickets" TItem="TicketSchedulerViewModel"
                                                       @bind-DateCurrent="@DateCurrent"
                                                       @bind-CurrentView="@_viewMode"
                                                       Loader="LoadTickets"
                                                       UpdatePeriod="UpdatePeriod"
                                                       DateProperty="Date"
                                                       TimeProperty="Time"
                                                       DateEndProperty="DateEnd"
                                                       CompanyProperty="Company"
                                                       UserProperty="User"
                                                       BackColorProperty="BackColor"
                                                       DescriptionProperty="Description"
                                                       OnNewTicket="NewTicket"
                                                       OnTicketMove="MoveTicket"
                                                       ViewMode="@ViewMode"
                                                       Loading="@_loading">
                <Filter>
                    <div class="ticket-planning-filter">
                        <RadzenDropDownDataGrid class="form-control" @bind-value="@IdUserAssigned" TValue="string"
                                                AllowFiltering="true" AllowClear="true" Change="OnChangeIdUser"
                                                FilterCaseSensitivity="@FilterCaseSensitivity.CaseInsensitive"
                                                Data="@_users" Count="@_users.Count"
                                                TextProperty="NameComplete" ValueProperty="Id">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                        <label>@Localize["User"]</label>
                    </div>
                </Filter>
                <Details>
                    <CRM.Client.Pages.Tickets.Preview IdTicket="@context" ViewCommands="false"></CRM.Client.Pages.Tickets.Preview>
                </Details>
            </BlazoringComponents.Scheduler.AGScheduler>
        </CascadingValue>
    </div>
</div>

<style>
    .ticket-planning-page {
        padding: 1.25rem;
    }

    .ticket-planning-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .ticket-planning-surface {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
    }

    .ticket-planning-filter {
        min-width: min(360px, 100%);
        position: relative;
    }

    @@media (max-width: 768px) {
        .ticket-planning-page {
            padding: .75rem;
        }

        .ticket-planning-actions {
            width: 100%;
        }
    }
</style>
