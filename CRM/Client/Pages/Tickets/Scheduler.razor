@page "/Tickets/Schedule"
@using Models
@using Radzen
@using Radzen.Blazor

<div class="row">
    <div class="col p-4">
       @*  <!-- ? NUOVO: Toggle Vista Timeline -->
        <div class="view-toggle-container mb-3">
            <RadzenButton Click="@SwitchToTimeline" Icon="schedule" ButtonStyle="ButtonStyle.Info" 
                         Variant="Variant.Flat" Size="ButtonSize.Medium" 
                         Text="@Localize["Vista Timeline Oraria"]" 
                         class="timeline-toggle-btn" />
            <span class="toggle-hint">@Localize["Visualizza i ticket per fasce orarie"]</span>
        </div> *@

        <CascadingValue Value="_maxNumMonthlyTicket" TValue="int" Name="MaxNumDaylyTicket">
            
            <BlazoringComponents.Scheduler.AGScheduler @ref="schedulerTickets" TItem="TicketSchedulerViewModel" @bind-DateCurrent="@DateCurrent" @bind-CurrentView="@_viewMode"  Loader="LoadTickets" UpdatePeriod="UpdatePeriod"
                                                       DateProperty="Date" TimeProperty="Time" DateEndProperty="DateEnd" CompanyProperty="Company" UserProperty="User" BackColorProperty="BackColor"
                                                       DescriptionProperty="Description" OnNewTicket="NewTicket" ViewMode=@ViewMode Loading=@_loading>

                <Filter>
                
                    <div class="form-floating">
                        
                        <RadzenDropDownDataGrid class="form-control" @bind-value="@IdUserAssigned" TValue="string" AllowFiltering="true" AllowClear="true" Change="OnChangeIdUser" FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive
                                                Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                                <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />

                            </Columns>
                        </RadzenDropDownDataGrid>

                        <label>@Localize["User"]</label>

                    </div>
                </Filter>
                <Details>

                    <CRM.Client.Pages.Tickets.Preview IdTicket=context ViewCommands="false"></CRM.Client.Pages.Tickets.Preview>

                </Details>
            </BlazoringComponents.Scheduler.AGScheduler>
        </CascadingValue>
    </div>
</div>

<style>
    .view-toggle-container {
        background: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .timeline-toggle-btn {
        transition: all 0.3s ease;
    }

    .timeline-toggle-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(23, 162, 184, 0.3);
    }

    .toggle-hint {
        color: #6b7280;
        font-size: 0.9rem;
        font-style: italic;
    }

    @@media (max-width: 768px) {
        .view-toggle-container {
            flex-direction: column;
            align-items: flex-start;
        }

        .toggle-hint {
            font-size: 0.8rem;
        }
    }
</style>
