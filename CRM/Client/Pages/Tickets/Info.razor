@* @page "/Tickets/{Id:int}/intervention/{IdIntervention:int}" *@

@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@using static CRM.Client.Helpers.PageHelper

@if (_ticket == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model=@_pageHeader>
    </PageHeader>
     <div class="d-none d-md-block mb-3">
        <RadzenSelectBar Size="@_buttonSize"   @bind-Value="selectView" TValue="TicketViews" Change="@((args) => Change(args, "SelectBar with single selection"))" >
            <Items>
                <RadzenSelectBarItem  Text=@Localize["Ticket Data"] Icon="format_list_bulleted"  Value="TicketViews.Ticket" />
                <RadzenSelectBarItem Text=@Localize["Attachments"] Icon = "attach_file" Value="TicketViews.Allegati" />
                <RadzenSelectBarItem Text=@Localize["Chat"] Icon="chat" Value="TicketViews.Chat" />
                <RadzenSelectBarItem Text=@Localize["Services"] Icon="construction" Value="TicketViews.Interventi" />
                @if (_ticket.Permits.Close() || _ticket.Closed)
                {
                    <RadzenSelectBarItem Text=@Localize["Chiusura"] Icon="done" Value="TicketViews.Chiusura" />
                }
            </Items>

        </RadzenSelectBar>
    </div>
    <!-- Mobile: Dropdown -->
    <div class="d-md-none mb-3">
        <RadzenDropDown @bind-Value="selectView" TValue="TicketViews"
                        Change="@((args) => Change(args, "SelectBar with single selection"))"
                        Data="@_viewOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Style="width: 100%;"
                        Placeholder="Seleziona vista..." />
    </div>

    @if (selectView == TicketViews.Ticket)
    {
        if (_partialView == PartialViews.Details)
        {
            <Details Id="@Id" PageMode="PageModality.Child" OnClickEdit="EditTicket" OnClickCancel="GotoIndex" OnClickTicketClose="CloseTicket"></Details>
        }
        else
        {
            <Edit Id="@Id" PageMode="PageModality.Child" OnClickSave="(async () => await SaveTicket())" OnClickCancel="CancelTicket"></Edit>
        }
    }
    else if (selectView == TicketViews.Chat)
    {
        <CRM.Client.Pages.TicketChats.Index  IdTicket="@Id"></CRM.Client.Pages.TicketChats.Index>
    }
    else if (selectView == TicketViews.Chiusura)
    {
        @if (_ticket.Closed)
        {
            <DetailsClose  Id="@Id" OnClickTicketReOpen="@OnRefresh"></DetailsClose>

        }
        else if (_ticket.Permits.Close())
        {
            <CRM.Client.Pages.Tickets.Close Id="@Id" OnClickCancel="ClosingCloseForm" OnClickSave="UpdateForm"></CRM.Client.Pages.Tickets.Close>
        }
    }
    else if (selectView == TicketViews.Allegati)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.Attachments.Index OnClickEdit="IndexEditAttachment" OnClickDetails="IndexDetailsAttachment" IdParent="@Id" AttachmentType="AttachmentTypes.Ticket"></CRM.Client.Pages.Attachments.Index>
        }
        else if (_partialView == PartialViews.Edit)
        {
            <CRM.Client.Pages.Attachments.Edit Id="@_idAttachment" IdParent="@Id" AttachmentType=AttachmentTypes.Ticket OnClickClose="CloseAttachment"></CRM.Client.Pages.Attachments.Edit>
        }
        else if (_partialView == PartialViews.Details)
        {
            <CRM.Client.Pages.Attachments.Details Id="@_idAttachment"  OnClickCancel="CloseAttachment" 
                                                  OnClickEdit="DetailsEditAttachment" OnClickAddFile="AddFileAttachment"></CRM.Client.Pages.Attachments.Details>
        }
        else if (_partialView == PartialViews.AddFiles)
        {
            <CRM.Client.Pages.Attachments.Upload Id="@_idAttachment.Value" OnClickClose="CloseAttachment"></CRM.Client.Pages.Attachments.Upload>
        }


    }
    else if (selectView == TicketViews.Interventi)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.TicketInterventions.Index OnClickEdit="InterventionIndexEdit" OnClickDetails="InterventionDetails" PageMode="PageModality.Child" IdTicket="@Id"></CRM.Client.Pages.TicketInterventions.Index>
        }
        else if (_partialView == PartialViews.Details)
        {
            <CRM.Client.Pages.TicketInterventions.Details Id="@_idIntervention" OnClickEdit="InterventionDetailsEdit"
                                                          OnClickCancel="InterventionIndex" OnClickPdfViewer="InterventionPDFViewer"></CRM.Client.Pages.TicketInterventions.Details>
        }
        else if (_partialView == PartialViews.Edit)
        {
            <CRM.Client.Pages.TicketInterventions.Edit Id="@_idIntervention" IdTicket="@Id" OnClickSave="InterventionCloseForm" OnClickCancel="InterventionCloseForm"></CRM.Client.Pages.TicketInterventions.Edit>
        }
        else if (_partialView == PartialViews.PDFViewer)
        {
            <CRM.Client.Pages.TicketInterventions.ReportViewer Id="@_idIntervention.Value"></CRM.Client.Pages.TicketInterventions.ReportViewer>
        }
        else if (_partialView == PartialViews.Null)
        {
            <Waiting></Waiting>
        }
    }
    

}