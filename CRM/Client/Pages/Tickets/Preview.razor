@page "/Tickets/Preview/{Id:int}"

@if (_ticket == null)
{
    <div class="preview-loading">
        <Waiting></Waiting>
    </div>
}
else
{
    <div class="modern-preview-container ticket-preview-dialog">
        <!-- Header Card -->
        <div class="preview-header-card">
            <div class="header-content">
                <div class="ticket-number">
                    <span class="material-icons">confirmation_number</span>
                    <h3>Ticket #@_ticket.Id</h3>
                </div>
                <div class="ticket-status" style="background: @GetContrastBackgroundColor(_ticket.StateColor); color: @GetContrastTextColor(_ticket.StateColor);">
                    <span class="status-text">@_ticket.State</span>
                </div>
            </div>
        </div>

        <!-- Description Card -->
        <div class="description-card">
            <div class="card-header-modern">
                <span class="material-icons">description</span>
                <h5>Descrizione</h5>
            </div>
            <div class="card-body-modern">
                <p class="description-text">@_ticket.Description</p>
            </div>
        </div>

        @* Stessa disposizione della scheda completa: i dati del ticket in una colonna, il cliente
           nelle altre. Divisi in tre schedine corte lasciavano buchi in fondo alla riga. *@
        <div class="info-grid">
            <div class="info-card">
                <div class="info-card-header">
                    <span class="material-icons">category</span>
                    <span class="info-label">Dati del ticket</span>
                </div>
                <div class="info-card-body">
                    <div class="info-row">
                        <span class="info-key"><DisplayName For="@(() => _ticket.DescType)" /></span>
                        <span class="info-value">@_ticket.DescType</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key"><DisplayName For="@(() => _ticket.DateOpened)" /></span>
                        <span class="info-value">@_ticket.DateOpened.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    @if (_ticket.TicketType?.Date != (int)PropertyStates.No)
                    {
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.Date)" /></span>
                            <span class="info-value">@(_ticket.Date?.ToShortDateString() ?? "-")</span>
                        </div>

                        @if (_ticket.TicketType?.Time != (int)PropertyStates.No)
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.Time)" /></span>
                                @* La cornice solo se un orario c'e' davvero: su un trattino sembrava
                                   un campo da compilare. *@
                                @if (_ticket.Time.HasValue)
                                {
                                    <span class="info-value time-badge">
                                        <span class="material-icons">schedule</span>
                                        @_ticket.Time.Value.ToString("HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span class="info-value">-</span>
                                }
                            </div>
                        }

                        @if (_ticket.TicketType?.DateEnd != (int)PropertyStates.No)
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.DateEnd)" /></span>
                                <span class="info-value">@(_ticket.DateEnd?.ToShortDateString() ?? "-")</span>
                            </div>
                        }
                    }

                    <div class="info-row">
                        <span class="info-key"><DisplayName For="@(() => _ticket.DateExpired)" /></span>
                        <span class="info-value">@(_ticket.DateExpired?.ToShortDateString() ?? "-")</span>
                    </div>
                </div>
            </div>

            @* Il cliente occupa due colonne: chiude la riga e i suoi valori sono i piu' lunghi. *@
            <div class="info-card client-card">
                <div class="info-card-header">
                    <span class="material-icons">business</span>
                    <span class="info-label">Cliente</span>
                </div>
                <div class="info-card-body">
                    <div class="info-row">
                        <span class="info-key"><DisplayName For="@(() => _ticket.Company)" /></span>
                        <span class="info-value company-name">@_ticket.Company</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_ticket.Product))
                    {
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.Product)" /></span>
                            <span class="info-value">@_ticket.Product</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_ticket.Article) && _ticket.TicketType?.IdArticolo != (int)PropertyStates.No)
                    {
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.Article)" /></span>
                            <span class="info-value">@_ticket.Article</span>
                        </div>
                    }

                    @* Di che lavoro si tratta: con l'entita' questi due campi non arrivavano, e
                       l'anteprima di un ticket di produzione non diceva di quale commessa fosse. *@
                    @if (!string.IsNullOrWhiteSpace(_ticket.CommessaCode))
                    {
                        <div class="info-row">
                            <span class="info-key">@Localize["Commessa"]</span>
                            <span class="info-value">@_ticket.CommessaCode</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_ticket.CommessaFaseName))
                    {
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.CommessaFaseName)" /></span>
                            <span class="info-value">@_ticket.CommessaFaseName</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Users Section -->
            <div class="info-card users-card">
                <div class="info-card-header">
                    <span class="material-icons">people</span>
                    <span class="info-label">Utenti</span>
                </div>
                <div class="info-card-body">
                    <!-- User Opened -->
                    <div class="info-row">
                        <span class="info-key"><DisplayName For="@(() => _ticket.IdUserOpened)" /></span>
                        <span class="info-value">
                            <div class="user-badge-inline">
                                <span class="user-avatar-small">@GetUserInitials(_userOpened?.NameComplete)</span>
                                <span>@_userOpened?.NameComplete</span>
                            </div>
                        </span>
                    </div>

                    <!-- Assigned Users -->
                    <div class="assigned-users-section">
                        <div class="assigned-header">
                            <span class="assigned-label">
                                @if (_assignedUsers.Count > 1)
                                {
                                    <text>@Localize["Assigned Users"] (@_assignedUsers.Count)</text>
                                }
                                else
                                {
                                    <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                }
                            </span>
                        </div>
                        <div class="assigned-users-list">
                            @if (_assignedUsers.Any())
                            {
                                @foreach (var user in _assignedUsers)
                                {
                                    var isMain = _assignedUsers.IndexOf(user) == 0;
                                    <div class="assigned-user-item @(isMain ? "main-user" : "")">
                                        <span class="user-avatar">@GetUserInitials(user.NameComplete)</span>
                                        <div class="user-info">
                                            <span class="user-name">@user.NameComplete</span>
                                            @if (isMain)
                                            {
                                                <span class="main-badge">★ Principale</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-users">
                                    <span class="material-icons">person_off</span>
                                    <em>@Localize["Not Assigned"]</em>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
