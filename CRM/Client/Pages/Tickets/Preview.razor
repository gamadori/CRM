@page "/Tickets/Preview/{Id:int}"

<div class="container">

    @if (_ticket == null)
    {
        <Waiting></Waiting>
    }
    else
    {
       @* <BlazorHeader Header="@($"{Localize["Ticket #"]} {_ticket.Id}")"></BlazorHeader>
*@
    
        <div class="row rounded-3 bg-light">
            <div class="co">

                <div class="row g-3">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">Descrizione</h4>
                         <p class="note-report">@_ticket.Description</p>  
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row"><DisplayName For="@(() => _ticket.State)" /></th>
                                <td style="background-color:@_ticket.StateColor"><span style="mix-blend-mode: difference;color:white">@_ticket.StateDesc</span></td>
                            </tr>
                            <tr>
                                <th scope="row"><DisplayName For="@(() => _ticket.DateOpened)" /></th>
                                <td>@_ticket.DateOpened.ToString("G")</td>

                            </tr>
                            <tr>
                                <th scope="row"><DisplayName For="@(() => _ticket.Company)" /></th>
                                <td><span>@_ticket.Company.RagioneSociale</span></td>

                            </tr>
                            <tr>
                                <th scope="row"><DisplayName For="@(() => _ticket.IdType)" /></th>
                                <td><span>@_ticket.TicketType.Desc</span></td>
                            </tr>

                            @if (_ticket.TicketType.Date != (int)PropertyStates.No)
                            {
                                <tr>
                                    <th scope="row"><DisplayName For="@(() => _ticket.Date)" /></th>
                                    <td><span>@_ticket.Date?.ToShortDateString()</span></td>
                                </tr>

                                <tr>
                                    <th scope="row"><DisplayName For="@(() => _ticket.DateEnd)" /></th>
                                    <td><span>@_ticket.DateEnd?.ToShortTimeString()</span></td>
                                </tr>

                                <tr>
                                    <th scope="row"><DisplayName For="@(() => _ticket.Date)" /></th>
                                    <td><span>@_ticket.Date?.ToShortDateString()</span></td>
                                </tr>
                            }
                            @if (_ticket.TicketType.IdArticolo != (int)PropertyStates.No)
                            {
                                <tr>
                                    <th scope="row"><DisplayName For="@(() => _ticket.IdArticle)" /></th>
                                    <td><span>@_ticket.Article?.NameComplete</span></td>
                                </tr>


                            }
                            <tr>
                                <th scope="row"><DisplayName For="@(() => _ticket.IdUserOpened)" /></th>
                                <td><span>@_userOpened?.NameComplete</span></td>
                            </tr>
                            
                            @* ✅ MODIFICATO: Visualizza tutti gli utenti assegnati *@
                            <tr>
                                <th scope="row">
                                    @if (_assignedUsers.Count > 1)
                                    {
                                        <span>@Localize["Assigned Users"] (@_assignedUsers.Count)</span>
                                    }
                                    else
                                    {
                                        <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                    }
                                </th>
                                <td>
                                    @if (_assignedUsers.Any())
                                    {
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var user in _assignedUsers)
                                            {
                                                <li class="py-1">
                                                    @if (_assignedUsers.IndexOf(user) == 0)
                                                    {
                                                        <span class="badge bg-primary me-1">★</span>
                                                        <strong>@user.NameComplete</strong>
                                                        <small class="text-muted ms-1">(principale)</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary me-1">👤</span>
                                                        <span>@user.NameComplete</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <em class="text-muted">@Localize["Not Assigned"]</em>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
