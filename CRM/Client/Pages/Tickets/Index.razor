@page "/Tickets"
@page "/Tickets/Index"
@page "/Tickets/Index/{TypeSearch:int}"
@page "/Tickets/Index/{TypeSearch:int}/{IdUser}"
@page "/Companies/{IdCompany:int}/Tickets"
@page "/Users/{IdUser:int}/Tickets"

@using Radzen
@using Radzen.Blazor
@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters


@if (_ticketView != null && _user != null)
{
    @if (PageMode != CRM.Client.Helpers.PageHelper.PageModality.Child)
    {
        <PageHeader Model="@_pageHeader">
        </PageHeader>
    }

    <RadzenDataGrid @ref="grdTickets" IsLoading="@_isLoading" Count="@_numRecords" Responsive="@_isResponsable" Data="@_ticketView?.Items" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
                AllowSorting="true" AllowFiltering="true" AllowPaging="true" AllowColumnResize=true 
                    PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="TicketDTO" EmptyText="Nessun Ticket" CellRender="@CellRender" CellClick="@OnCellClick" >
        
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                <RedGButton RGButtonType="RGButtonType.New" Click="@NewTicket"></RedGButton>
                @if (_user != null && !_user.IsClient)
                {
                    <RedGDropDownGrid TValue="string" @bind-Value="_idUser" AllowClear="true" Style="width: 250px;" Label="@Localize["Filter by User"]"
                        Data="@_users" TItem="ApplicationUser" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id" Change="OnChangeIdUser">
                        <ChildColumns>
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Surname)" Title="@Localize[nameof(ApplicationUser.Surname)]" Width="auto" />
                            <RadzenDropDownDataGridColumn Property="@nameof(ApplicationUser.Name)" Title="@Localize[nameof(ApplicationUser.Name)]" Width="auto" />
                        </ChildColumns>
                
                        <End>
                            <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                        </End>
                    </RedGDropDownGrid>

                    <RedGSelectEnum TValue="TicketTypeSearch" TEnum="TicketTypeSearch" @bind-Value="TypeSearch" Change=OnChangeFilter Style="width: 200px;" Label="@Localize["Filter by State"]" AllowClear>
                    </RedGSelectEnum>
                }
            </div>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Id)" FormatString="{0:000000}" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.Id), typeof(Ticket))" />
            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Date)" FormatString="{0:d}" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.Date), typeof(Ticket))" />


            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Company)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.IdCompany), typeof(Ticket))" Type="typeof(string)" FilterProperty="@nameof(TicketDTO.IdCompany)" FilterValue="@_companyFilter" FilterOperator="FilterOperator.Equals">
                <FilterTemplate>

                    <FilterDropDown Items="@_companies" TItem="CompanyDTO" TValue="int?" @bind-Value=@_companyFilter UniqueID="@grdTickets.UniqueID" Property=@nameof(TicketDTO.IdCompany) TextProperty="@nameof(CompanyDTO.RagioneSociale)"
                                    ValueProperty="Id"></FilterDropDown>
                </FilterTemplate>
            </RadzenDataGridColumn>


            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Product)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.IdProduct), typeof(Ticket))" Type="typeof(string)" FilterProperty="Product.Name"
                                  SortProperty="Product.Name">

            </RadzenDataGridColumn>


            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Article)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.IdArticle), typeof(Ticket))" Type="typeof(string)"
            FilterProperty="Article" SortProperty="Article" />

            <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.IdUserAssigned)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.IdUserAssigned), typeof(Ticket))" FilterProperty="@nameof(TicketDTO.IdUserAssigned)" FilterValue="@_userFilter" FilterOperator="FilterOperator.Equals">
                <Template Context="item">
                    @if (!string.IsNullOrWhiteSpace(item.IdUserAssigned))
                    {
                        <UserData IdUser="@item.IdUserAssigned"></UserData>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.GroupAssigned))
                            {
                                <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                                    <span class="material-icons" style="font-size:14px;">groups</span>
                                    @item.GroupAssigned
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Non assegnato</span>
                            }

                            @if (item.CanClaim)
                            {
                                <RadzenButton Icon="@(_claimingTicketId == item.Id ? "hourglass_top" : "front_hand")"
                                              Text="@(_claimingTicketId == item.Id ? "..." : "Prendi")"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Disabled="@(_claimingTicketId != null)"
                                              Click="@(() => ClaimTicket(item))" />
                            }
                        </div>
                    }
                </Template>
                <FilterTemplate>

                    <FilterDropDown Items="@_users" TItem="ApplicationUser" TValue="string" @bind-Value=@_userFilter  UniqueID="@grdTickets.UniqueID" Property=@nameof(TicketDTO.IdUserAssigned) TextProperty="@nameof(ApplicationUser.NameComplete)"
                    ValueProperty="Id"></FilterDropDown>
                </FilterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Context="item" TItem="TicketDTO" Property="@nameof(TicketDTO.State)" SortProperty="IdState" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.IdState), typeof(Ticket))" Filterable="false" Sortable="true" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <span class="ticket-state-text" style="@GetStateTextStyle(item?.StateColor)">
                        @Localize[item?.State ?? eTicketStates.Created.ToString()]
                    </span>
                    @if (item?.IsBlocked == true)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" title="@item.BlockReason">
                            <span class="material-icons align-middle" style="font-size:13px;">report_problem</span>
                            Bloccato
                        </span>
                    }
                </Template>

            </RadzenDataGridColumn>
            @if (_user != null && _user.IsAdmin)
            {
                <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Invoiced)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.Invoiced), typeof(Ticket))" Type="typeof(bool)" />
            }
            @* <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                <RadzenDataGridColumn TItem="TicketDTO" Property="@nameof(TicketDTO.Invoiced)" Title="@TranslateHelper.GetDisplayName(nameof(Ticket.Invoiced), typeof(Ticket))" Type="typeof(string)" />
            </AuthorizeView> *@
            <RadzenDataGridColumn TItem="TicketDTO" Context="item" Title="@TranslateHelper.GetDisplayName(nameof(TicketDTO.MinuteWorkFormatted), typeof(TicketDTO))">
                <Template>
                <span>@DateTimeHelper.MinuteFormat(item?.MinuteWork)</span>
                </Template>
                <FooterTemplate>
                        <b> @_ticketView?.Total</b>
                </FooterTemplate>
            </RadzenDataGridColumn>



            <RadzenDataGridColumn Context="item" TItem="TicketDTO" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.JustifyAll">
                <Template Context="item">

                    <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id)) Visible=@(item.Permits.Edit())></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item?.Id)) Visible=@(item.Permits.Delete())></RedGButton>
                </Template>
           
            </RadzenDataGridColumn>
       
        </Columns>
    </RadzenDataGrid>

}
else
{
    <Waiting></Waiting>
}
    
