@page "/Tickets/{Id:int}/Details"
@page "/Tickets/{Id:int}/Details/{BackUrl}"

@using CRM.Shared.Helper

@if (_ticket == null)
{
    <div class="preview-loading">
        <Waiting></Waiting>
    </div>
}
else
{
    <div class="ticket-details-page">
        @if (PageMode != CRM.Client.Helpers.PageHelper.PageModality.Child)
        {
            <PageHeader Model="@_pageHeader">
            </PageHeader>
        }

        <div class="modern-preview-container">
            <!-- Header Card -->
            <div class="preview-header-card">
                <div class="header-content">
                    <div class="ticket-number">
                        <span class="material-icons">confirmation_number</span>
                        <h3>Ticket #@_ticket.Id</h3>
                    </div>
                    <div class="ticket-status" style="background: @GetContrastBackgroundColor(_ticket.StateColor); color: @GetContrastTextColor(_ticket.StateColor);">
                        <span class="status-text">@_ticket.State</span>
                    </div>
                </div>
            </div>

            <!-- Description Card -->
            <div class="description-card">
                <div class="card-header-modern">
                    <span class="material-icons">description</span>
                    <h5>Descrizione</h5>
                </div>
                <div class="card-body-modern">
                    <p class="description-text">@_ticket.Description</p>
                </div>
            </div>

            <div class="description-card operational-summary-card">
                <div class="card-header-modern summary-header">
                    <div class="summary-title">
                        <span class="material-icons">summarize</span>
                        <h5>Riepilogo operativo</h5>
                    </div>
                    @if (_ticket.OperationalSummaryUpdatedAt.HasValue)
                    {
                        <span class="summary-meta">
                            Aggiornato @_ticket.OperationalSummaryUpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(_ticket.OperationalSummaryUpdatedByName))
                            {
                                <text> da @_ticket.OperationalSummaryUpdatedByName</text>
                            }
                        </span>
                    }
                </div>
                <div class="card-body-modern summary-body">
                    @if (_isEditingSummary && _ticket.Permits.Edit())
                    {
                        <RadzenTextArea @bind-Value="_summaryDraft"
                                        Rows="6"
                                        class="summary-editor"
                                        Style="width: 100%;"
                                        Placeholder="Nessun riepilogo operativo salvato." />

                        @if (!string.IsNullOrWhiteSpace(_summaryMessage))
                        {
                            <div class="summary-message @(_summaryMessageIsError ? "summary-message-error" : "summary-message-info")">
                                @_summaryMessage
                            </div>
                        }

                        <div class="summary-actions">
                            <RadzenButton Text="@(_isSavingSummary ? "Salvataggio..." : "Salva riepilogo")"
                                          Icon="save"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="SaveSummary"
                                          Disabled="@(_isProposingSummary || _isSavingSummary)" />
                            <RadzenButton Text="Annulla"
                                          Icon="close"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="CancelSummaryEdit"
                                          Disabled="@(_isProposingSummary || _isSavingSummary)" />
                        </div>
                    }
                    else
                    {
                        <div class="summary-read-row">
                            @if (!string.IsNullOrWhiteSpace(_ticket.OperationalSummary))
                            {
                                <div class="summary-readonly">@_ticket.OperationalSummary</div>
                            }
                            else
                            {
                                <div class="summary-empty">Nessun riepilogo operativo salvato.</div>
                            }

                            @if (_ticket.Permits.Edit())
                            {
                                <div class="summary-actions summary-actions-readonly">
                                    <RadzenButton Text="@(_isProposingSummary ? "Generazione..." : "Proponi da chat")"
                                                  Icon="auto_awesome"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="ProposeSummary"
                                                  Disabled="@(_isProposingSummary || _isSavingSummary)" />
                                    <RadzenButton Text="Modifica"
                                                  Icon="edit"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="EditSummary"
                                                  Disabled="@(_isProposingSummary || _isSavingSummary)" />
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_summaryMessage))
                        {
                            <div class="summary-message @(_summaryMessageIsError ? "summary-message-error" : "summary-message-info")">
                                @_summaryMessage
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="info-grid">
                <!-- Ticket Type -->
                <div class="info-card">
                    <div class="info-card-header">
                        <span class="material-icons">category</span>
                        <span class="info-label">Tipo e Dettagli</span>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.DescType)" /></span>
                            <span class="info-value">@_ticket.DescType</span>
                        </div>
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.DateOpened)" /></span>
                            <span class="info-value">@_ticket.DateOpened.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>

                <!-- Date/Time Section -->
                @if (_ticket.TicketType.Date != (int)PropertyStates.No)
                {
                    <div class="info-card">
                        <div class="info-card-header">
                            <span class="material-icons">event</span>
                            <span class="info-label">Data e Orario</span>
                        </div>
                        <div class="info-card-body">
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.Date)" /></span>
                                <span class="info-value">@(_ticket.Date?.ToShortDateString() ?? "-")</span>
                            </div>

                            @if (_ticket.TicketType.Time != (int)PropertyStates.No)
                            {
                                <div class="info-row">
                                    <span class="info-key"><DisplayName For="@(() => _ticket.Time)" /></span>
                                    <span class="info-value time-badge">
                                        @if (_ticket.Time.HasValue)
                                        {
                                            <span class="material-icons">schedule</span>
                                            @_ticket.Time.Value.ToString("HH:mm")
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    </span>
                                </div>
                            }

                            @if (_ticket.TicketType.DateEnd != (int)PropertyStates.No)
                            {
                                <div class="info-row">
                                    <span class="info-key"><DisplayName For="@(() => _ticket.DateEnd)" /></span>
                                    <span class="info-value">@(_ticket.DateEnd?.ToShortDateString() ?? "-")</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Company & Contact -->
                <div class="info-card">
                    <div class="info-card-header">
                        <span class="material-icons">business</span>
                        <span class="info-label">Cliente</span>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.Company)" /></span>
                            <span class="info-value company-name">@_ticket.Company</span>
                        </div>

                        <div class="info-row">
                            <span class="info-key">@Localize["Richiedente"]</span>
                            <span class="info-value">
                                @if (!string.IsNullOrEmpty(_ticket.RequesterName))
                                {
                                    <span class="material-icons" style="font-size: 16px; vertical-align: middle; margin-right: 4px;">
                                        contact_phone
                                    </span>
                                    @_ticket.RequesterName
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_ticket.Product))
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.Product)" /></span>
                                <span class="info-value">@_ticket.Product</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_ticket.Article))
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.Article)" /></span>
                                <span class="info-value">@_ticket.Article</span>
                            </div>
                        }

                        @if (_ticket.IdDeal != null)
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.DealName)" /></span>
                                <span class="info-value">
                                    <RadzenButton Icon="work"
                                                  Text="@(string.IsNullOrWhiteSpace(_ticket.DealName) ? _ticket.IdDeal.Value.ToString() : _ticket.DealName)"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => NavigationManager.NavigateTo($"/Deals/{_ticket.IdDeal}"))" />
                                </span>
                            </div>
                        }

                        @if (_ticket.IdCommessaFase != null)
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.CommessaFaseName)" /></span>
                                <span class="info-value">
                                    <span class="badge bg-light text-dark border">
                                        <span class="material-icons align-middle" style="font-size:14px;">view_timeline</span>
                                        @(string.IsNullOrWhiteSpace(_ticket.CommessaFaseName) ? _ticket.IdCommessaFase.Value.ToString() : _ticket.CommessaFaseName)
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Users Section -->
                <div class="info-card users-card">
                    <div class="info-card-header">
                        <span class="material-icons">people</span>
                        <span class="info-label">Utenti</span>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.IdUserOpened)" /></span>
                            <span class="info-value">@_ticket.UserOpened</span>
                        </div>

                        <div class="assigned-users-section">
                            <div class="assigned-header">
                                <span class="assigned-label">
                                    <DisplayName For="@(() => _ticket.IdUserAssigned)" />
                                </span>
                            </div>

                            @if (_isLoadingUsers)
                            {
                                <div class="no-users">
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <em>Caricamento utenti...</em>
                                </div>
                            }
                            else
                            {
                                <div class="assigned-users-list">
                                    @if (_assignedUsers != null && _assignedUsers.Any())
                                    {
                                        @foreach (var user in _assignedUsers)
                                        {
                                            var isMain = _assignedUsers.IndexOf(user) == 0;
                                            <div class="assigned-user-item @(isMain ? "main-user" : "")">
                                                <span class="user-avatar">@GetUserInitials(user.NameComplete)</span>
                                                <div class="user-info">
                                                    <span class="user-name">@user.NameComplete</span>
                                                    @if (isMain)
                                                    {
                                                        <span class="main-badge">★ Principale</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(_ticket.UserAssigned))
                                    {
                                        <div class="assigned-user-item main-user">
                                            <span class="user-avatar">@GetUserInitials(_ticket.UserAssigned)</span>
                                            <div class="user-info">
                                                <span class="user-name">@_ticket.UserAssigned</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-users">
                                            <span class="material-icons">person_off</span>
                                            <em>Nessun utente assegnato</em>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Work / Close info -->
                <div class="info-card">
                    <div class="info-card-header">
                        <span class="material-icons">access_time</span>
                        <span class="info-label">Lavoro</span>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-key"><DisplayName For="@(() => _ticket.MinuteWorkFormatted)" /></span>
                            <span class="info-value">@DateTimeHelper.MinuteFormat(_ticket.MinuteWork)</span>
                        </div>

                        @if (_ticket.Closed)
                        {
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.UserClosed)" /></span>
                                <span class="info-value">@_ticket.UserClosed</span>
                            </div>
                            <div class="info-row">
                                <span class="info-key"><DisplayName For="@(() => _ticket.DateClosed)" /></span>
                                <span class="info-value">@_ticket.DateClosed?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @* Feedback - cliccabile per dettagli *@
                            <div class="info-row">
                                <span class="info-key">Feedback</span>
                                <span class="info-value">
                                    @if (_isLoadingFeedback)
                                    {
                                        <span class="spinner-border spinner-border-sm" style="width:12px;height:12px;"></span>
                                    }
                                    else if (_feedback != null)
                                    {
                                        <span style="cursor:pointer;" @onclick="ShowFeedbackDetails" title="Clicca per dettagli">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="@(i <= _feedback.Rating ? "text-warning" : "text-muted")" style="font-size:14px;">★</span>
                                            }
                                            <span class="material-icons text-muted ms-1" style="font-size:14px;vertical-align:middle;">open_in_new</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:0.85rem;">—</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Footer actions -->
            @if (ViewCommands)
            {
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body d-flex gap-2 flex-wrap">
                        <RedGButton RGButtonType="RGButtonType.Back" Text="@Localize["Lista Tickets"]" Click="Annulla"></RedGButton>

                        @if (_ticket.Permits.Edit())
                        {
                            <RedGButton RGButtonType="RGButtonType.Edit" Click="Edit" AutoLabel=true />
                        }

                        @if (_ticket.Permits.Assign())
                        {
                            <RedGButton RGButtonType="RGButtonType.AssignTicket" Click="PrepareAssign" Text=@Localize["Assign"] />
                        }

                        @if (!_ticket.Closed && _ticket.Permits.Close())
                        {
                            <RedGButton RGButtonType="RGButtonType.CloseTicket" Click="TicketClose" Text=@Localize["Chiudi Ticket"] />
                        }

                        <RedGButton RGButtonType="RGButtonType.Download" Text="@Localize["Download PDF"]" Click="DownloadPdf" Disabled="_isDownloadingPdf"></RedGButton>

                        @if (_idInboundEmail != null)
                        {
                            <RadzenButton Icon="mail" Text="Email originale" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => NavigationManager.NavigateTo($"/InboundEmails/{_idInboundEmail}"))" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
