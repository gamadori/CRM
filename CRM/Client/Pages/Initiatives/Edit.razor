@page "/Initiatives/New"
@page "/Initiatives/{Id:int}/Edit"
@using CRM.Shared
@using CRM.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@using static CRM.Client.Helpers.PageHelper
@attribute [Authorize]

<div class="commercial-page">
    @if (PageMode != PageModality.Child)
    {
        <PageHeader Model="_pageHeader"></PageHeader>
    }

    @if (_loading)
    {
        <Waiting></Waiting>
    }
    else
    {
        <section class="form-card">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="form-error">@_error</div>
            }

            <div class="form-grid">
                <label class="field-wide">
                    <span>Nome</span>
                    <input @bind="_model.Name" placeholder="Es. Fiera di Hannover 2026, Giro Germania marzo" />
                </label>

                <label>
                    <span>Tipo</span>
                    <select @bind="_model.Kind">
                        @foreach (var kind in Enum.GetValues<InitiativeKind>())
                        {
                            <option value="@kind">@KindText(kind)</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Stato</span>
                    <select @bind="_model.State">
                        @foreach (var state in Enum.GetValues<InitiativeState>())
                        {
                            <option value="@state">@StateText(state)</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Luogo</span>
                    <input @bind="_model.Location" placeholder="Hannover, Germania e Austria..." />
                </label>

                <label>
                    <span>Budget previsto</span>
                    <input type="number" step="0.01" @bind="_model.BudgetPlanned" />
                </label>

                <div class="form-field">
                    <span>Responsabile</span>
                    <RadzenDropDown TValue="string" @bind-Value="_model.IdOwner"
                                    Data="_users"
                                    TextProperty="NameComplete"
                                    ValueProperty="Id"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    AllowClear="true"
                                    Placeholder="Responsabile iniziativa"
                                    Style="width: 100%;" />
                </div>

                <label>
                    <span>Dal</span>
                    <input type="date" @bind="_model.DateFrom" />
                </label>

                <label>
                    <span>Al</span>
                    <input type="date" @bind="_model.DateTo" />
                </label>

                <div class="form-field field-wide">
                    <span>Partecipanti</span>

                    <RadzenDropDown TValue="string" Value="@_memberToAdd" Data="_addableUsers"
                                    TextProperty="NameComplete" ValueProperty="Id"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    AllowClear="false"
                                    Disabled="@(_addableUsers.Count == 0)"
                                    Placeholder="@(_addableUsers.Count == 0 ? "Tutti gli utenti sono già nell'elenco" : "Aggiungi una persona")"
                                    Change="@(args => AddMember(args as string))"
                                    Style="width: 100%;" />

                    @if (_members.Count == 0)
                    {
                        <p class="members-empty">
                            Nessun partecipante. Chi aggiungi qui riceve una presenza sull'intero periodo,
                            che potrai accorciare dal dettaglio se non c'è per tutti i giorni.
                        </p>
                    }
                    else
                    {
                        <div class="members">
                            @foreach (var member in _members)
                            {
                                <div class="member-row" @key="member.IdUser">
                                    <div class="member-name">
                                        <strong>@member.UserName</strong>
                                        @if (member.IdUser == _model.IdOwner)
                                        {
                                            <small>responsabile</small>
                                        }
                                    </div>

                                    <RadzenDropDown TValue="InitiativeMemberRole" @bind-Value="member.Role"
                                                    Data="RoleOptions" TextProperty="Text" ValueProperty="Value"
                                                    Style="width: 100%;" />

                                    <input class="member-note" @bind="member.Notes" placeholder="Note (facoltative)" />

                                    <button type="button" class="member-remove" title="Togli dall'elenco"
                                            @onclick="@(() => RemoveMember(member))">
                                        <span class="material-icons">close</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <label class="field-wide">
                    <span>Obiettivo</span>
                    <textarea rows="3" @bind="_model.Objective" placeholder="Cosa ci si aspetta, scritto prima di partire"></textarea>
                </label>

                @if (!IsNew)
                {
                    <label class="field-wide">
                        <span>Relazione finale</span>
                        <textarea rows="5" @bind="_model.ClosingNotes" placeholder="L'unica parte del resoconto che si scrive a mano: costi, lead e documenti sono calcolati"></textarea>
                    </label>
                }
            </div>

            <div class="form-actions">
                <button type="button" class="ghost-action" @onclick="Cancel">Annulla</button>
                <button type="button" class="primary-action" disabled="@_saving" @onclick="Save">
                    @(_saving ? "Salvataggio..." : "Salva")
                </button>
            </div>
        </section>
    }
</div>

<style>
    .commercial-page { min-height: calc(100vh - 1rem); padding: 1.25rem; background: var(--crm-page-bg); color: var(--crm-text); }
    .form-card { border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); box-shadow: var(--crm-shadow); padding: 1.1rem; }
    .form-error { margin-bottom: .9rem; padding: .65rem .8rem; border-radius: 8px; background: color-mix(in srgb, #dc2626 12%, transparent); color: #dc2626; font-weight: 800; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; }
    .form-grid label, .form-grid .form-field { display: grid; gap: .3rem; min-width: 0; }
    /* NON chiamarla "col-2": Bootstrap definisce gia' .col-2 come colonna 2/12 e le impone
       width:16.6%. Il campo occupava lo span giusto ma restava largo un sesto della scheda,
       e la riga dei partecipanti gli traboccava fuori sovrapponendosi. */
    .form-grid .field-wide { grid-column: span 2; }
    /* Solo le etichette dirette: un "span" qualunque prendeva anche le icone material-icons
       dei pulsanti, e il text-transform:uppercase spezza la legatura del font (la "x" di
       chiusura veniva disegnata come la parola CLOSE). */
    .form-grid > label > span, .form-grid > .form-field > span { color: var(--crm-text-muted); font-size: .8rem; font-weight: 800; text-transform: uppercase; }
    .form-grid input, .form-grid select, .form-grid textarea { min-height: 40px; padding: .45rem .6rem; border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-text); font: inherit; }
    .form-grid textarea { min-height: unset; resize: vertical; }
    .form-grid input:focus-visible, .form-grid select:focus-visible, .form-grid textarea:focus-visible { border-color: var(--crm-link); outline: none; }
    .members-empty { margin: .5rem 0 0; color: var(--crm-text-muted); font-size: .85rem; }
    .members { display: grid; gap: .5rem; margin-top: .6rem; }
    .member-row { display: grid; grid-template-columns: minmax(160px, 1.2fr) minmax(140px, .9fr) minmax(160px, 1.4fr) 38px; align-items: center; gap: .5rem; padding: .5rem .6rem; border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-muted); }
    .member-name { display: grid; gap: .1rem; min-width: 0; }
    .member-name strong { overflow-wrap: anywhere; }
    .member-name small { color: var(--crm-text-muted); font-size: .72rem; text-transform: uppercase; font-weight: 800; }
    .member-note { min-height: 38px; padding: .4rem .55rem; border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-text); font: inherit; }
    .member-note:focus-visible { border-color: var(--crm-link); outline: none; }
    .member-remove { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; padding: 0; border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-text-muted); }
    .member-remove:hover { border-color: #dc2626; color: #dc2626; }
    .member-remove .material-icons { font-size: 18px; }
    .form-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: 1.1rem; }
    .primary-action, .ghost-action { display: inline-flex; align-items: center; justify-content: center; padding: .62rem 1.1rem; border: 1px solid color-mix(in srgb, var(--crm-link) 28%, var(--crm-border)); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-link); font-weight: 800; }
    .primary-action { background: var(--crm-link); border-color: var(--crm-link); color: var(--crm-surface-raised); }
    .primary-action:disabled { opacity: .55; }
    .ghost-action:hover { background: var(--crm-surface-hover); }
    @@media (max-width: 820px) { .form-grid { grid-template-columns: 1fr; } .form-grid .field-wide { grid-column: span 1; } .member-row { grid-template-columns: 1fr 38px; } .member-row .member-note { grid-column: 1 / -1; } }
</style>
