@page "/Projects/{Id:int}/Details"
@using CRM.Shared.Helper

<BlazorHeader Header="Dettagli Progetto" />

@if (_project == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            
            <RedGDetailField Icon="folder" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _project.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="event">
                <LabelContent><DisplayName For="@(() => _project.StartDate)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.StartDate.ToString("d")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="description">
                <LabelContent><DisplayName For="@(() => _project.Description)" /></LabelContent>
                <ChildContent><pre class="mb-0">@_project.Description</pre></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person_add">
                <LabelContent><DisplayName For="@(() => _project.IdUserCreate)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.UserCreate?.NameComplete</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="account_circle">
                <LabelContent><DisplayName For="@(() => _project.IdUserLeader)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_project.UserLeader?.NameComplete</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Lista Progetti"]" OnClick="Annulla" />
                @if (_project.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}