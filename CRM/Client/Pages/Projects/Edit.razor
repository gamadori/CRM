@page "/Projects/New"
@page "/Projects/{Id:int}/Edit"

<h3>Progetto</h3>
<hr />

@if (_project == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="container m-3">
        <EditForm Model="@_project" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row mb-3">
                <div class="col-md-8">
                    <DisplayName For="@(()=>_project.Name)" />
                    <input id="Name" class="form-control" @bind-value="@_project.Name" />
                    <ValidationMessage For="@(() => _project.Name)" />
                </div>
            
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <DisplayName For="@(()=>_project.Description)" />
                    <RadzenTextArea class="form-control" @bind-Value=@_project.Description Rows="4"></RadzenTextArea>
                    <ValidationMessage For="@(() => _project.Description)" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <DisplayName For="@(()=>_project.IdCompany)" />
                    <div class="input-group mb-3">
                        <RadzenDropDown @ref="_ddCompany" class="form-control" @bind-Value=@_project.IdCompany Data=@_companies AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive AllowClear="true" TextProperty="RagioneSociale" ValueProperty="Id"  PageSize=@ConstHelper.PageSize>

                        </RadzenDropDown>
                        <BtnCompanies OnGetCompany="OnGetCompany"></BtnCompanies>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <DisplayName For="@(()=>_project.IdProduct)" />
                    
                    <RadzenDropDown class="form-control" @bind-Value=@_project.IdProduct  Data=@_products AllowFiltering=true FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive AllowClear="true" TextProperty="Name" ValueProperty="Id" PageSize="10">
                    
                    </RadzenDropDown>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <DisplayName For="@(()=>_project.IdUserLeader)" />
                    <div class="input-group mb-3">
                        <RadzenDropDown @ref="_ddUsers" class="form-control" @bind-Value=@_project.IdUserLeader Data=@_users AllowFiltering=true  FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive AllowClear="true" TextProperty="NameComplete" ValueProperty="Id" PageSize="10">

                        </RadzenDropDown>
                        <BtnUsers OnGetItem="OnGetUser"></BtnUsers>
            
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <BlazorButton Template="TemplateButton.Submit" Text="Salva" />
                    <BlazorButton Template="TemplateButton.Cancel" OnClick="Annulla" Text="Annulla" />
                </div>
            </div>
        </EditForm>
    </div>
    
}
