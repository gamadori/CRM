@page "/Settings/Groups"
@page "/Settings/Groups/Index"


@if (_groups != null)
{
    <PageHeader 
            Model=@_pageHeader>
    </PageHeader>

    <RadzenDataGrid @ref="_grdGroup" IsLoading="@_isLoading" Count="@_paging.TotalCount" Responsive=true Data="@_groups" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode="FilterMode.Advanced"
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="@ConstHelper.PageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="CRM.Shared.Group" PagingSummaryFormat="@_pagingSummaryFormat">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
            </div>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="CRM.Shared.Group" Property="@nameof(CRM.Shared.Group.Name)" Title=@TranslateHelper.GetDisplayName(nameof(CRM.Shared.Group.Name), typeof(CRM.Shared.Group)) />

            <RadzenDataGridColumn Context="item" TItem="CRM.Shared.Group" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                    <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}