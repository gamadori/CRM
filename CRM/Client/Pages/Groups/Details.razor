@page "/Settings/Groups/{Id:int}/Details"

<BlazorHeader Header="@Localize["Dettagli Gruppo"]"></BlazorHeader>

<BlazorBreadCrumb Model="@_bread"></BlazorBreadCrumb>

@if (_group == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="groups" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _group.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_group.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="description">
                <LabelContent><DisplayName For="@(() => _group.Description)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_group.Description</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorLink Href="/Settings/Groups" Template="TemplateButton.Back" Text="Lista Gruppi" />
                <BlazorButton OnClick="EditGroup" Template="TemplateButton.Edit" Label="true" />
            </div>
        </div>
    </div>
}