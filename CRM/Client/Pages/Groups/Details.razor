@page "/Settings/Groups/Details/{Id:int}"

<BlazorHeader Header="@Localize["Dettagli Gruppo"]"></BlazorHeader>

<BlazorBreadCrumb Model="@_bread"></BlazorBreadCrumb>

@if (_group == null)
{
    <Waiting></Waiting>
}
else
{

<dl class="row">
    <dt class="col-sm-2">
        <DisplayName For="@(()=>_group.Name)" />
    </dt>
    <dd class="col-sm-10">
        <span>@_group.Name</span>
    </dd>

    <dt class="col-sm-2">
        <DisplayName For="@(()=>_group.Description)" />
    </dt>
    <dd class="col-sm-10">
        <span>@_group.Description</span>
    </dd>
    
</dl>
<div>
    <BlazorLink Href="/Settings/Groups" Template="TemplateButton.Back" Text="Lista Gruppi" />
    <BlazorButton OnClick="EditGroup" Template="TemplateButton.Edit" Label="true" />
    
</div>
}