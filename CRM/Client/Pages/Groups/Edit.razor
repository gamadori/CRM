@page "/Settings/Groups/New"
@page "/Settings/Groups/{Id:int}/Edit"

@if (_group == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader 
            Model=@_pageHeader>
    </PageHeader>

     <EditForm Model="@_group" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_group.Name" For="@(() => _group.Name)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextArea @bind-Value="@_group.Description" For="@(() => _group.Description)" Rows="3" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack Gap="0.25rem">
                                <RedGTextArea @bind-Value="@_group.AiRoutingHints" For="@(() => _group.AiRoutingHints)" Rows="4"
                                              Placeholder="Es. Assistenza elettrica sulle linee di taglio: quadri, sensori, azionamenti. Non tratta software gestionale ne' ricambi meccanici." />
                                <span style="font-size:0.75rem; color:var(--crm-text-muted, #64748b);">
                                    Testo su cui l'AI sceglie il gruppo quando smista un ticket: indica cosa tratta e
                                    cosa non tratta. Si modifica anche da Impostazioni &rsaquo; Smistamento ticket.
                                </span>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
    </EditForm>
   
}