@page "/Settings/Groups/AddUser"
@using Radzen
@using Radzen.Blazor
<h3>Aggiungi Utente al Gruppo</h3>
<hr />
@if (_userGroup == null)
{
    <Waiting></Waiting>
}
else
{
     <PageHeader 
            Model=@_pageHeader>
    </PageHeader>

    <EditForm Model="@_userGroup" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col">

                <div class="mb-3">

                    <DisplayName For="@(()=>_userGroup.IdUser)" />
                    <RadzenDropDownDataGrid class="form-control" @bind-value="@_userGroup.IdUser" TValue="string"  AllowFiltering="true" AllowClear="true" FilterCaseSensitivity=FilterCaseSensitivity.CaseInsensitive
                                            Data="@_users" Count="@_users.Count" TextProperty="NameComplete" ValueProperty="Id" Style="margin-bottom: 20px" />

                    <ValidationMessage For="@(() => _userGroup.IdUser)" />
                </div>


            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col">
                <BlazorButton Type="BtnType.Submit" Style="BtnStyle.Primary" Text="Salva" Icon="save"></BlazorButton>
                <BlazorButton Style="BtnStyle.Secondary" OnClick="Cancel" Text="Annulla" Icon="cancel"></BlazorButton>
            </div>
        </div>
    </EditForm>








}