@page "/Settings/Groups/{Id:int}/Info"
@page "/Settings/Groups/{Id:int}"
@using Radzen
@using Radzen.Blazor
@using static CRM.Client.Helpers.PageHelper



@if (_group == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader 
            Model=@_pageHeader>
    </PageHeader>

    <RadzenSelectBar @bind-Value="selectView" TValue="GroupViews" Change="@((args) => Change(args, "SelectBar with single selection"))" Style="margin-bottom: 20px;">
        <Items>
            <RadzenSelectBarItem Text="Dati Gruppo" Value="GroupViews.Group" />
            <RadzenSelectBarItem Text="Utenti" Value="GroupViews.Users" />

        </Items>
    </RadzenSelectBar>

    @if (selectView == GroupViews.Group)
    {
        if (_partialView == PartialViews.Details)
        {
            <Details Id="@Id" PageMode=PageModality.Child OnClickEdit="EditGroup" OnClickCancel="CancelGroup"></Details>
        }
        else
        {
            <Edit Id="@Id" PageMode=PageModality.Child OnClickSave="(async () => await SaveGroup())" OnClickCancel="CancelGroup"></Edit>
        }
    }
    else if (selectView == GroupViews.Users)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.Settings.Users.Index PageMode=PageModality.Child @ref="_pageUsersIndex" IdGroup="@Id" CmdDetails="false" CmdEdit="false" OnClickEdit="@((s) => OnClickNew(s))"
                                                   OnClickDelete="@(async (s)=> await OnClickDelete(s))" BreadCrumbVisible=false
                                                   MessagePrepareDelete="@_messagePrepareDelete"></CRM.Client.Pages.Settings.Users.Index>
        }
        else if (_partialView == PartialViews.Details)
        {
            <CRM.Client.Pages.Settings.Users.Details Id="@_idUser" PageMode=PageModality.Child CloseForm="UsersCloseForm" OnClickEdit="DetailsEditUser"></CRM.Client.Pages.Settings.Users.Details>
        }
        else if (_partialView == PartialViews.Edit)
        {
            <CRM.Client.Pages.Settings.Users.Edit Id="@_idUser" PageMode=PageModality.Child CloseForm="UsersCloseForm" IdCompany="@Id"></CRM.Client.Pages.Settings.Users.Edit>
        }
        else if (_partialView == PartialViews.New)
        {

        }


    }
}