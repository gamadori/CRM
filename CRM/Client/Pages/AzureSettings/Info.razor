@page "/Settings/AzureSettings"
@using CRM.Client.Models;
@using CRM.Client.Services;
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.Extensions.Localization;

@attribute [Authorize(Policy = "AdminRole")]

<PageHeader Model="@_pageHeader"></PageHeader>
<div class="container">
    <div class="row d-flex justify-content-around">

       
        <BlazorIcon href="AzureSettings/Translator" Icon="translate" Text=@Localize["Traduttore"] />
        <BlazorIcon href="AzureSettings/OCR" Icon="menage_search" Text=@Localize["OCR"] />
       
    </div>

</div>
@code {
    [Inject]
    IStringLocalizer<CRM.Shared.Resources.App> Localize { get; set; }
    [Inject]
    IHeaderService HeaderService { get; set; }


    private PageHeaderModel _pageHeader = null;

    protected async override Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();

        await base.OnInitializedAsync();
    }

}
