@page "/Companies"
@page "/Companies/Index"

@using BlazoringComponents.DropDownButton
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor




    <PageHeader PageMode="@PageMode">
    </PageHeader>


@if (_companies != null)
{
    <RadzenDataGrid @ref="grdCompanies" IsLoading="@_isLoading" Count="@_paging.TotalCount" Responsive=true Data="@_companies" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode=@_filterMode
                    AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="CompanyDTO">
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                @if (_user != null && _user.CompanyPermits.Insert())
                {
                    @if (IdReseller == null)
                    {
                        <RedGButton RGButtonType="RGButtonType.New" Click="@NewCompany"></RedGButton>
                    }
                    else
                    {
                        <BtnCompanies OnGetCompany="OnGetCustomer" IdCompanyParent="@IdCompanyParent" Text=@Localize["Add Customer"]></BtnCompanies>
                    }
                }
                @if (IdReseller == null)
                {
                    <RadzenButton Icon="account_tree" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Small"
                                  Click="@(() => NavigationManager.NavigateTo("/Companies/Tree"))"
                                  title="@Localize["Struttura Aziende"]" />
                }
                <RedGTextBox @bind-Value="@_search" Label="@Localize["search..."]" @oninput="@(args => FilterChanged(args?.Value?.ToString()))" Style="width: 300px; margin-left: 10px;">
                    <End>
                        <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                    </End>
                </RedGTextBox>
            </div>
            
        </HeaderTemplate>

        <Columns>
            <RadzenDataGridColumn Context="item" TItem="CompanyDTO" Title="@Localize["BusinessName"]" Property="@nameof(CompanyDTO.RagioneSociale)" FilterProperty="RagioneSociale">
                <Template>
                       <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OnClickName(item?.Id)">@item?.RagioneSociale</a>
                </Template>
            </RadzenDataGridColumn>
       
            <RadzenDataGridColumn TItem="CompanyDTO" Property="@nameof(CompanyDTO.PIva)" Title="@Localize["VAT"]" />
            <RadzenDataGridColumn TItem="CompanyDTO" Property="@nameof(CompanyDTO.Telefono)" Title="@Localize["Phone"]" />
            <RadzenDataGridColumn TItem="CompanyDTO" Property="@nameof(CompanyDTO.Citta)" Title="@Localize["City"]" />
            <RadzenDataGridColumn TItem="CompanyDTO" Property="@nameof(CompanyDTO.Stato)" Title="@Localize["Country"]" />


            @if (PageMode == PageHelper.PageModality.Visualization)
            {
                <RadzenDataGridColumn Context="item" TItem="CompanyDTO"  Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="item">
                    
                        <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>
                                   
                </Template>
            </RadzenDataGridColumn>
           }
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}


