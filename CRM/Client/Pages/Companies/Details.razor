@page "/Companies/{Id:int}/Details"
@using Radzen

<PageHeader PageMode="@PageMode">
</PageHeader>

@if (_company != null)
{
    @* Testata: il nome dell'azienda e' il titolo, non il primo campo. Sotto, i dati che si
       cercano per primi (P.IVA, citta', telefono, email) gia' cliccabili. *@
    <RedGDetailHeader Icon="business" Kicker="@Localize["Azienda"]" Title="@_company.RagioneSociale">
        <Symbol>
            @if (!string.IsNullOrWhiteSpace(_logo))
            {
                <img src="@_logo" alt="@_company.RagioneSociale" />
            }
            else
            {
                <span class="material-icons">business</span>
            }
        </Symbol>
        <Chips>
            <span class="crm-chip crm-chip-primary">@LocalizeCompanyTypes[_company.CompanyType.ToString()]</span>
            @if (!string.IsNullOrWhiteSpace(_company.Stato))
            {
                <span class="crm-chip">@_company.Stato</span>
            }
            @if (_company.IdReseller != null && _company.IdReseller > 0 && !string.IsNullOrWhiteSpace(_company.ResellerName))
            {
                <span class="crm-chip" title="@Localize["Reseller"]">
                    <span class="material-icons" style="font-size: 14px;">store</span>
                    @_company.ResellerName
                </span>
            }
        </Chips>
        <Facts>
            <RedGDetailFact Icon="receipt_long" Value="@_company.PIva">
                <LabelContent><DisplayName For="@(() => _company.PIva)" /></LabelContent>
            </RedGDetailFact>
            <RedGDetailFact Icon="location_on" Value="@CityLine">
                <LabelContent><DisplayName For="@(() => _company.Citta)" /></LabelContent>
            </RedGDetailFact>
            <RedGDetailFact Icon="phone" Value="@_company.Telefono" Href="@TelHref(_company.Telefono)">
                <LabelContent><DisplayName For="@(() => _company.Telefono)" /></LabelContent>
            </RedGDetailFact>
            <RedGDetailFact Icon="mail_outline" Value="@_company.Email" Href="@(string.IsNullOrWhiteSpace(_company.Email) ? null : $"mailto:{_company.Email}")">
                <LabelContent><DisplayName For="@(() => _company.Email)" /></LabelContent>
            </RedGDetailFact>
            <RedGDetailFact Icon="language" Value="@_company.Web" Href="@WebHref(_company.Web)" Target="_blank">
                <LabelContent><DisplayName For="@(() => _company.Web)" /></LabelContent>
            </RedGDetailFact>
        </Facts>
        <Actions>
            <RedGButton RGButtonType="RGButtonType.Back" Click="@(() => NavigationManager.NavigateTo("/Companies"))" Text="@Localize["Companies"]" />
            @if (_hasChildren)
            {
                <RadzenButton Icon="account_tree" ButtonStyle="Radzen.ButtonStyle.Light"
                              Text="@Localize["Struttura Aziende"]"
                              Click="OpenTreeDialog" />
            }
            <AuthorizeView Policy="@ePolicy.SuperUserRole.ToString()">
                <Authorized Context="AuthorizeRole">
                    <RedGButton RGButtonType="RGButtonType.Edit" Click="EditCompany" AutoLabel=true></RedGButton>
                </Authorized>
            </AuthorizeView>
        </Actions>
    </RedGDetailHeader>
}

<RedGDetailPage IsLoading="@(_company == null)">
    <ChildContent>
        @if (_company != null)
        {
            <RedGDetailSection Title="Anagrafica" Icon="business">
                <RedGDetailField Icon="receipt_long">
                    <LabelContent><DisplayName For="@(() => _company.PIva)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.PIva</p></ChildContent>
                </RedGDetailField>

                @if (!string.IsNullOrEmpty(_company.CodiceFiscale))
                {
                    <RedGDetailField Icon="badge">
                        <LabelContent><DisplayName For="@(() => _company.CodiceFiscale)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark">@_company.CodiceFiscale</p></ChildContent>
                    </RedGDetailField>
                }

                @if (!string.IsNullOrEmpty(_company.CodiceSDI))
                {
                    <RedGDetailField Icon="qr_code_2">
                        <LabelContent><DisplayName For="@(() => _company.CodiceSDI)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark">@_company.CodiceSDI</p></ChildContent>
                    </RedGDetailField>
                }

                <RedGDetailField Icon="category">
                    <LabelContent><DisplayName For="@(() => _company.CompanyType)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@LocalizeCompanyTypes[_company.CompanyType.ToString()]</p></ChildContent>
                </RedGDetailField>

                @if (_company.IdReseller != null && _company.IdReseller > 0)
                {
                    <RedGDetailField Icon="store">
                        <LabelContent><DisplayName For="@(() => _company.IdReseller)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark">@_company.ResellerName</p></ChildContent>
                    </RedGDetailField>
                }
            </RedGDetailSection>

            <RedGDetailSection Title="Indirizzo" Icon="location_on">
                <RedGDetailField Icon="location_on">
                    <LabelContent><DisplayName For="@(() => _company.Indirizzo)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.Indirizzo</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="markunread_mailbox">
                    <LabelContent><DisplayName For="@(() => _company.Cap)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.Cap</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="location_city">
                    <LabelContent><DisplayName For="@(() => _company.Citta)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.Citta</p></ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="flag">
                    <LabelContent><DisplayName For="@(() => _company.Stato)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.Stato</p></ChildContent>
                </RedGDetailField>
            </RedGDetailSection>

            <RedGDetailSection Title="Contatti" Icon="contact_phone">
                <RedGDetailField Icon="phone">
                    <LabelContent><DisplayName For="@(() => _company.Telefono)" /></LabelContent>
                    <ChildContent><p class="mb-0 text-dark">@_company.Telefono</p></ChildContent>
                </RedGDetailField>

                @if (!string.IsNullOrEmpty(_company.Mobile))
                {
                    <RedGDetailField Icon="smartphone">
                        <LabelContent><DisplayName For="@(() => _company.Mobile)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark">@_company.Mobile</p></ChildContent>
                    </RedGDetailField>
                }

                @if (!string.IsNullOrEmpty(_company.Fax))
                {
                    <RedGDetailField Icon="print">
                        <LabelContent><DisplayName For="@(() => _company.Fax)" /></LabelContent>
                        <ChildContent><p class="mb-0 text-dark">@_company.Fax</p></ChildContent>
                    </RedGDetailField>
                }

                <RedGDetailField Icon="email">
                    <LabelContent><DisplayName For="@(() => _company.Email)" /></LabelContent>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(_company.Email))
                        {
                            <a href="mailto:@_company.Email">@_company.Email</a>
                        }
                        else
                        {
                            <p class="mb-0"></p>
                        }
                    </ChildContent>
                </RedGDetailField>

                <RedGDetailField Icon="language">
                    <LabelContent><DisplayName For="@(() => _company.Web)" /></LabelContent>
                    <ChildContent>
                        @if (!string.IsNullOrWhiteSpace(_company.Web))
                        {
                            <a href="@WebHref(_company.Web)" target="_blank" rel="noopener noreferrer">@_company.Web</a>
                        }
                        else
                        {
                            <p class="mb-0"></p>
                        }
                    </ChildContent>
                </RedGDetailField>
            </RedGDetailSection>

            @if (!string.IsNullOrWhiteSpace(_company.Note))
            {
                <RedGDetailSection Title="Note" Icon="note">
                    <RedGDetailField Icon="note" ContainerClass="full">
                        <LabelContent><DisplayName For="@(() => _company.Note)" /></LabelContent>
                        <ChildContent>@((MarkupString)_company.Note)</ChildContent>
                    </RedGDetailField>
                </RedGDetailSection>
            }
        }
    </ChildContent>
</RedGDetailPage>

@code {
    /// <summary>Citta' e CAP insieme, come si scrive su una busta: "BARBERINO - TAVERNELLE (50028)".</summary>
    private string CityLine => _company == null
        ? string.Empty
        : string.Join(" ", new[] { _company.Citta, string.IsNullOrWhiteSpace(_company.Cap) ? null : $"({_company.Cap})" }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    private static string TelHref(string phone)
        => string.IsNullOrWhiteSpace(phone) ? null : $"tel:{phone.Replace(" ", "")}";

    private static string WebHref(string web)
    {
        if (string.IsNullOrWhiteSpace(web))
            return null;

        return web.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
               web.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? web
            : $"https://{web}";
    }
}
