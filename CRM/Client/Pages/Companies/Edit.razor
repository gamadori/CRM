@page "/Companies/Edit"
@page "/Companies/Edit/{Id:int}"
@using Radzen
@using Radzen.Blazor

<BlazorHeader Header="@Localize["Azienda"]" Visible=@(PageMode != PageHelper.PageModality.Dialog)>

</BlazorHeader>

@if (_company == null)
{
    <Waiting></Waiting>
}
else
{
    <EditForm Model="@_company" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <RedGTextBox @bind-Value="@_company.RagioneSociale" For="@(() => _company.RagioneSociale)" />
                    <RedGTextBox @bind-Value="@_company.Indirizzo" For="@(() => _company.Indirizzo)" />
                     <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_company.Cap" For="@(() => _company.Cap)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_company.Citta" For="@(() => _company.Citta)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RedGTextBox @bind-Value="@_company.Stato" For="@(() => _company.Stato)" />
                    <RedGTextBox @bind-Value="@_company.Email" For="@(() => _company.Email)" />
                    <RedGTextBox @bind-Value="@_company.Web" For="@(() => _company.Web)" />
                     <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_company.Telefono" For="@(() => _company.Telefono)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="6">
                           <RadzenStack>
                                <RedGTextBox @bind-Value="@_company.Fax" For="@(() => _company.Fax)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RedGDropDown TItem="EnumField" @bind-value="@_company.CompanyType" TValue="CompanyTypes" For="@(()=>
                        _company.CompanyType)" AllowFiltering="true"
                        Data="@_companyTypesFields" TextProperty="Text" ValueProperty="Value">
                    </RedGDropDown>
                    <RedGDropDown TItem="CompanyItem" @bind-value="@_company.IdReseller" For="@(() => _company.IdReseller)" TValue="int?" AllowFiltering="true"
                                    Data="@_companies" TextProperty="@nameof(CompanyItem.RagioneSociale)" ValueProperty="@nameof(CompanyItem.Id)" Disabled=@_resellerDisabled>
                    </RedGDropDown>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
        <RedGButton RGButtonType="RGButtonType.Submit" />
    </EditForm>
    
}