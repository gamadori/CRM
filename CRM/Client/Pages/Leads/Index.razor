@page "/Leads"
@page "/Leads/Index"
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="commercial-page">
    <PageHeader Model="_pageHeader">
        <Actions>
            <RedGButton RGButtonType="RGButtonType.New" Text="Nuovo lead" Click="@(_ => NewLead())"></RedGButton>
        </Actions>
    </PageHeader>

    <section class="commercial-metrics">
        <article>
            <span>Valore filtrato</span>
            <strong>@_leads.Total.ToString("C")</strong>
        </article>
        <article>
            <span>Lead filtrati</span>
            <strong>@TotalCount</strong>
        </article>
        <article>
            <span>Qualificati in pagina</span>
            <strong>@QualifiedCount</strong>
        </article>
        <article>
            <span>Score medio</span>
            <strong>@AverageScore.ToString("0")</strong>
        </article>
    </section>

    <section class="commercial-filters">
        <div class="search-box">
            <span class="material-icons">search</span>
            <input @bind="_search" @bind:event="oninput" placeholder="Cerca nome, azienda, email o telefono" />
        </div>
        <select @bind="_status">
            <option value="">Tutti gli stati</option>
            @foreach (var status in Enum.GetValues<LeadStatus>())
            {
                <option value="@status">@StatusText(status)</option>
            }
        </select>
        <select @bind="_source">
            <option value="">Tutte le fonti</option>
            @foreach (var source in Enum.GetValues<LeadSource>())
            {
                <option value="@source">@SourceText(source)</option>
            }
        </select>
        <button type="button" class="icon-action" title="Applica filtri" @onclick="ApplyFilters">
            <span class="material-icons">tune</span>
        </button>
        <button type="button" class="icon-action" title="Pulisci filtri" @onclick="ClearFilters">
            <span class="material-icons">filter_alt_off</span>
        </button>
    </section>

    @if (_loading)
    {
        <Waiting></Waiting>
    }
    else if (!_leads.Items.Any())
    {
        <section class="empty-state">
            <span class="material-icons">person_search</span>
            <strong>Nessun lead trovato</strong>
            <p>Modifica i filtri o registra un nuovo lead.</p>
        </section>
    }
    else
    {
        <section class="commercial-table-wrap">
            <table class="commercial-table">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Azienda</th>
                        <th>Prodotto</th>
                        <th>Stato</th>
                        <th>Fonte</th>
                        <th>Score</th>
                        <th>Valore</th>
                        <th>Owner</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in _leads.Items)
                    {
                        <tr>
                            <td>
                                <div class="lead-name">
                                    <button type="button" class="text-link" @onclick="@(() => Edit(lead.Id))">@lead.Name</button>
                                    @* Nato da una cattura in fiera: c'e' la foto del biglietto da
                                       confrontare con quello che ha letto l'OCR. La sera, davanti
                                       a cento righe, serve sapere quali si possono verificare. *@
                                    @if (lead.IdBusinessCard != null)
                                    {
                                        <span class="card-badge material-icons"
                                              title="Biglietto da visita disponibile"
                                              aria-label="Biglietto da visita disponibile">contact_mail</span>
                                    }
                                </div>
                                <small>@lead.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(lead.CompanyNameResolved) ? "-" : lead.CompanyNameResolved)</strong>
                                <small>@(string.IsNullOrWhiteSpace(lead.Email) ? lead.Phone : lead.Email)</small>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(lead.ProductSummary) ? "-" : lead.ProductSummary)</td>
                            <td><span class="state-chip @LeadStateClass(StatusText(lead.Status))">@StatusText(lead.Status)</span></td>
                            <td>@SourceText(lead.Source)</td>
                            <td>
                                <div class="score-bar">
                                    <div><i style="width:@lead.Score%"></i></div>
                                    <strong>@lead.Score</strong>
                                </div>
                            </td>
                            <td class="money">@lead.EstimatedValue.ToString("C")</td>
                            <td>@lead.UserName</td>
                            <td>
                                <div class="row-actions">
                                    <RedGButton RGButtonType="RGButtonType.Edit" title="Modifica"
                                                Disabled="@(!lead.Permits.Edit())"
                                                Click="@(_ => Edit(lead.Id))"></RedGButton>
                                    @* Nessun preset per la conversione: icona e stile espliciti, che
                                       in RedGButton hanno la precedenza sul tipo. *@
                                    <RedGButton Icon="swap_horiz" ButtonStyle="ButtonStyle.Info" title="Converti in opportunita"
                                                Disabled="@(lead.Status == LeadStatus.Converted || !lead.Permits.Edit())"
                                                Click="@(_ => ConvertLead(lead))"></RedGButton>
                                    <RedGButton RGButtonType="RGButtonType.Delete" title="Elimina"
                                                Disabled="@(!lead.Permits.Delete())"
                                                Click="@(_ => Delete(lead.Id))"></RedGButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="pager">
            <button type="button" disabled="@(!CanGoPrevious)" @onclick="PreviousPage">
                <span class="material-icons">chevron_left</span>
                <span>Precedente</span>
            </button>
            <strong>Pagina @_pageNumber di @TotalPages</strong>
            <button type="button" disabled="@(!CanGoNext)" @onclick="NextPage">
                <span>Successiva</span>
                <span class="material-icons">chevron_right</span>
            </button>
        </section>
    }
</div>

<style>
    .commercial-page { min-height: calc(100vh - 1rem); padding: 1.25rem; background: var(--crm-page-bg); color: var(--crm-text); }
    .primary-action, .icon-action, .row-actions button, .pager button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; border: 1px solid color-mix(in srgb, var(--crm-link) 28%, var(--crm-border)); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-link); font-weight: 800; transition: background-color 120ms ease, border-color 120ms ease; }
    .icon-action:hover, .row-actions button:hover:not(:disabled), .pager button:hover:not(:disabled) { background: var(--crm-surface-hover); border-color: color-mix(in srgb, var(--crm-link) 45%, var(--crm-border)); }
    .primary-action { padding: .62rem .85rem; background: var(--crm-link); border-color: var(--crm-link); color: var(--crm-surface-raised); }
    .primary-action:hover { background: color-mix(in srgb, var(--crm-link) 88%, var(--crm-text)); }
    .commercial-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; margin-bottom: 1rem; }
    .commercial-metrics article, .commercial-filters, .commercial-table-wrap { border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); box-shadow: var(--crm-shadow); }
    .commercial-metrics article { display: grid; gap: .2rem; padding: .9rem; }
    .commercial-metrics span, .commercial-table small { color: var(--crm-text-muted); }
    .commercial-metrics strong { font-size: 1.35rem; overflow-wrap: anywhere; }
    .commercial-filters { display: grid; grid-template-columns: minmax(240px, 1fr) 180px 180px 42px 42px; gap: .6rem; padding: .75rem; margin-bottom: 1rem; }
    .commercial-filters select, .search-box { min-height: 40px; border: 1px solid var(--crm-border); border-radius: 8px; background: var(--crm-surface-raised); color: var(--crm-text); }
    .commercial-filters select:focus-visible, .search-box:focus-within { border-color: var(--crm-link); outline: none; }
    .search-box { display: flex; align-items: center; gap: .5rem; padding: .42rem .55rem; min-width: 0; }
    .search-box .material-icons { color: var(--crm-text-muted); }
    .search-box input { width: 100%; border: 0; outline: 0; min-width: 0; background: transparent; color: inherit; }
    .search-box input::placeholder { color: var(--crm-text-muted); }
    .icon-action { width: 40px; height: 40px; padding: 0; }
    .commercial-table-wrap { overflow-x: auto; }
    .commercial-table { width: 100%; min-width: 1120px; border-collapse: collapse; }
    .commercial-table th, .commercial-table td { padding: .78rem .85rem; border-bottom: 1px solid var(--crm-border); vertical-align: middle; }
    .commercial-table th { color: var(--crm-text-muted); font-size: .76rem; text-transform: uppercase; letter-spacing: 0; background: var(--crm-surface-muted); }
    .commercial-table tbody tr:hover td { background: var(--crm-surface-hover); }
    .commercial-table small { display: block; margin-top: .15rem; }
    .text-link { border: 0; padding: 0; background: transparent; color: var(--crm-link); font-weight: 850; text-align: left; }
    .lead-name { display: flex; align-items: center; gap: .35rem; min-width: 0; }
    .card-badge { flex: 0 0 auto; font-size: 16px; color: var(--crm-text-muted); cursor: default; }
    .state-chip { display: inline-flex; border-radius: 999px; padding: .25rem .55rem; font-weight: 850; font-size: .78rem; }
    .state-new { background: color-mix(in srgb, #64748b 15%, transparent); color: var(--crm-text-muted); }
    .state-active { background: color-mix(in srgb, #0d9488 15%, transparent); color: #0d9488; }
    .state-won { background: color-mix(in srgb, #16a34a 15%, transparent); color: #16a34a; }
    .state-lost { background: color-mix(in srgb, #dc2626 15%, transparent); color: #dc2626; }
    .score-bar { display: grid; grid-template-columns: 1fr 34px; align-items: center; gap: .45rem; min-width: 120px; }
    .score-bar div { height: 7px; border-radius: 999px; overflow: hidden; background: color-mix(in srgb, var(--crm-text-muted) 22%, transparent); }
    .score-bar i { display: block; height: 100%; background: var(--crm-link); }
    .money { font-weight: 850; }
    .row-actions { display: flex; justify-content: flex-end; gap: .35rem; }
    .row-actions button { width: 34px; height: 34px; padding: 0; }
    .row-actions button .material-icons, .row-actions button .rzi { font-size: 18px; }
    .row-actions button:disabled, .pager button:disabled { opacity: .45; }
    .pager { display: flex; align-items: center; justify-content: center; gap: .75rem; padding: 1rem 0; }
    .pager button { padding: .45rem .7rem; }
    .pager .material-icons { font-size: 18px; }
    .empty-state { min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .5rem; color: var(--crm-text-muted); text-align: center; }
    .empty-state .material-icons { font-size: 48px; }
    @@media (max-width: 1080px) { .commercial-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } .commercial-filters { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 720px) { .commercial-metrics, .commercial-filters { grid-template-columns: 1fr; } .icon-action { width: 100%; } }
</style>
