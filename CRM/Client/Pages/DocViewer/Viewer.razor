@page "/DocViewer/Viewer/{Id:int}"

<!-- wrapper che occupa tutto lo spazio del dialog -->
<div style="position:absolute; inset:0; margin:0; padding:0; box-sizing:border-box;">
   
    <div class="card shadow-sm" style="display:flex; flex-direction:column; height:100%; margin:0; box-sizing:border-box;">
        <div @ref="containerRef" class="card-body" style="flex:1 1 auto; padding:0; overflow:auto; position:relative;">
            
            @if (!_loaded)
            {
                <!-- Spinner di caricamento -->
                <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.9); z-index:1000;">
                    <div style="text-align:center;">
                        <div class="spinner-border text-primary" role="status" style="width:3rem; height:3rem;">
                            <span class="visually-hidden">Caricamento...</span>
                        </div>
                        <div class="mt-3 text-muted">@_loadingMessage</div>
                    </div>
                </div>
            }

            <canvas id="dxfCanvas" @ref="canvasRef" style="width:100%; height:100%; display:block;"></canvas>
            <div id="fileHost" @ref="fileHostRef" style="width:100%; height:100%; display:none;"></div>
        </div>
        <div class="card-footer" style="flex:0 0 auto;">
            <RedGButton RGButtonType="RGButtonType.Close" Text="Chiudi" Click="Close" Visible="@CloseEnabled"></RedGButton>
            <RedGButton RGButtonType="RGButtonType.Download" Text="Download" Visible="@DownloadEnabled" Click="Export" />
        </div>
    </div>
</div>


