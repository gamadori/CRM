@page "/Commesse/{Id:int}"
@page "/Commesse/{Id:int}/Details"
@* Destinazione della voce "Fase" nel breadcrumb dei ticket di produzione: apre le fasi operative *@
@page "/Commesse/{Id:int}/Fasi/{FaseId:int}"
@using CRM.Client.Helpers
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Client.Shared.Components.Gantt
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICommessaService CommessaService
@inject ICommessaFaseService FaseService
@inject IBaseRestService<ApplicationUser, UsersFilterModel, string> UserSvc
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notification
@inject Microsoft.Extensions.Localization.IStringLocalizer<CRM.Shared.Resources.App> Localize

<PageHeader Model="_pageHeader"></PageHeader>

@if (_c == null)
{
    <Waiting></Waiting>
}
else
{
    <!-- Header -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-light text-dark border">@_c.Code</span>
                        <span class="badge @CommessaUi.StateBadgeClass(_c.State)">@CommessaUi.StateText(_c.State)</span>
                        @if (_c.IsExpectedLate)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                <span class="material-icons align-middle" style="font-size:14px;">event_busy</span>
                                @Localize["Prevista oltre consegna"]
                            </span>
                        }
                    </div>
                    <h4 class="mb-1">@(string.IsNullOrWhiteSpace(_c.Name) ? _c.Code : _c.Name)</h4>
                    <div class="text-muted small d-flex flex-wrap gap-3">
                        @if (_c.IdCompany != null)
                        {
                            <a href="@($"/Companies/{_c.IdCompany}")" class="text-decoration-none"><span class="material-icons align-middle" style="font-size:16px;">business</span> @_c.CompanyName</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_c.ProductName))
                        {
                            <span><span class="material-icons align-middle" style="font-size:16px;">precision_manufacturing</span> @_c.ProductName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_c.ArticleSerial))
                        {
                            <span><span class="material-icons align-middle" style="font-size:16px;">qr_code_2</span> @_c.ArticleSerial</span>
                        }
                        @if (_c.IdOrder != null)
                        {
                            <a href="@($"/{ConstHelper.ClientOrdersPath}/{_c.IdOrder}/Details")" class="text-decoration-none"><span class="material-icons align-middle" style="font-size:16px;">receipt_long</span> @(string.IsNullOrWhiteSpace(_c.OrderNumber) ? _c.IdOrder.ToString() : _c.OrderNumber)</a>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border" title="@Localize["Produzione senza ordine"]">@Localize["Interna"]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_c.ResponsibleName))
                        {
                            <span><span class="material-icons align-middle" style="font-size:16px;">engineering</span> @_c.ResponsibleName</span>
                        }
                    </div>
                </div>
                <div class="text-end" style="min-width:230px;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="progress flex-grow-1" style="height:10px;">
                            <div class="progress-bar bg-success" style="width:@(_c.Progress)%"></div>
                        </div>
                        <strong>@_c.Progress%</strong>
                    </div>
                    <RadzenDropDown TValue="CommessaStates" Value="_c.State" Data="_stateOptions" TextProperty="Text" ValueProperty="Value"
                                    Style="width:210px" Change="@(args => OnChangeState((CommessaStates)args))" />
                </div>
            </div>

            <hr class="my-3" />
            <div class="row g-3 small">
                <div class="col-6 col-md-2"><div class="text-muted">@Localize["Inizio piano"]</div><strong>@_c.StartDatePlanned.ToString("dd/MM/yyyy")</strong></div>
                <div class="col-6 col-md-2"><div class="text-muted">@Localize["Consegna"]</div><strong>@_c.EndDatePlanned.ToString("dd/MM/yyyy")</strong></div>
                <div class="col-6 col-md-2">
                    <div class="text-muted">@Localize["Data prevista"]</div>
                    <strong class="@(_c.IsExpectedLate ? "text-danger" : "")">@(_c.ExpectedEndDate?.ToString("dd/MM/yyyy") ?? "-")</strong>
                    @if (_c.IsExpectedLate)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">+@_c.ExpectedDelayDays gg</span>
                    }
                </div>
                <div class="col-6 col-md-2"><div class="text-muted">@Localize["Inizio effettivo"]</div><strong>@(_c.StartDateActual?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                <div class="col-6 col-md-2"><div class="text-muted">@Localize["Fine effettiva"]</div><strong>@(_c.EndDateActual?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                <div class="col-6 col-md-2"><div class="text-muted">@Localize["Ore a budget"]</div><strong>@(_c.BudgetHours?.ToString() ?? "-")</strong></div>
                <div class="col-6 col-md-2 text-md-end d-flex gap-2 justify-content-md-end">
                    <RadzenButton Icon="event_repeat" Text="@Localize["Riprogramma"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="OpenReschedule" Disabled="@(_c.State is CommessaStates.Delivered or CommessaStates.Cancelled)" />
                    <RadzenButton Icon="edit" Text="@Localize["Modifica"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ToggleEdit" />
                </div>
            </div>

            @if (_reschedule != null)
            {
                <div class="border rounded p-3 mt-3">
                    <div class="fw-semibold mb-2 d-flex align-items-center gap-2">
                        <span class="material-icons" style="font-size:20px;">event_repeat</span>
                        @Localize["Sposta il piano su una nuova consegna"]
                    </div>

                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small mb-1">@Localize["Consegna attuale"]</label>
                            <div class="form-control form-control-sm bg-body-secondary">@_c.EndDatePlanned.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">@Localize["Nuova consegna"]</label>
                            <RadzenDatePicker TValue="DateTime" @bind-Value="_reschedule.Delivery" DateFormat="dd/MM/yyyy" Style="width:100%" />
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">@ReschedulePreview()</div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
                        <RadzenButton Icon="event_repeat" Text="@Localize["Sposta il piano"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="ApplyReschedule" Disabled="@(_rescheduleBusy || _reschedule.Delivery.Date == _c.EndDatePlanned.Date)" />
                        <RadzenButton Icon="close" Text="@Localize["Annulla"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => _reschedule = null)" Disabled="@_rescheduleBusy" />

                        @* Azione distinta e distruttiva: rifà le fasi dal modello del prodotto. *@
                        <RadzenButton Icon="restart_alt" Text="@Localize["Ripristina dal modello"]" ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button"
                                      Size="ButtonSize.Small" Class="ms-auto" Click="ApplyRebuild" Disabled="@_rescheduleBusy" />
                    </div>
                    <div class="small text-muted mt-2">
                        @Localize["\"Ripristina dal modello\" ricostruisce le fasi dal template del prodotto sulla nuova consegna: scarta durate, dipendenze e fasi modificate a mano. Consentito solo se nessuna fase è stata avviata."]
                    </div>
                </div>
            }

            @if (_c.IsExpectedLate)
            {
                <div class="alert alert-danger border d-flex align-items-start gap-2 py-2 mt-3 mb-0">
                    <span class="material-icons" style="font-size:20px;">warning</span>
                    <div>
                        <div class="fw-semibold">@Localize["La previsione supera la data di consegna"]</div>
                        <div class="small">
                            Consegna @_c.EndDatePlanned.ToString("dd/MM/yyyy"),
                            prevista @_c.ExpectedEndDate!.Value.ToString("dd/MM/yyyy")
                            con @(_c.ExpectedDelayDays == 1 ? "1 giorno" : $"{_c.ExpectedDelayDays} giorni") di ritardo.
                        </div>
                    </div>
                </div>
            }

            @if (_edit != null)
            {
                <div class="border rounded p-3 mt-3 bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small mb-1">@Localize["Nome"]</label>
                            <input class="form-control form-control-sm" @bind="_edit.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">@Localize["Responsabile"]</label>
                            <RadzenDropDown TValue="string" @bind-Value="_edit.IdUserResponsible" Data="_users" TextProperty="NameComplete" ValueProperty="Id"
                                            AllowFiltering="true" AllowClear="true" Style="width:100%" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1">@Localize["Priorità"]</label>
                            <RadzenNumeric TValue="int" @bind-Value="_edit.Priority" Style="width:100%" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1">@Localize["Ore a budget"]</label>
                            <RadzenNumeric TValue="int?" @bind-Value="_edit.BudgetHours" Min="0" Style="width:100%" />
                        </div>
                        <div class="col-md-6">
                            @* Le date non si toccano da qui: sposterebbero l'intestazione lasciando
                               le fasi dov'erano. Ci pensa Riprogramma, che trasla anche il piano. *@
                            <label class="form-label small mb-1">@Localize["Date pianificate"]</label>
                            <div class="form-control form-control-sm d-flex align-items-center justify-content-between bg-body-secondary">
                                <span>@_c.StartDatePlanned.ToString("dd/MM/yyyy") &rarr; @_c.EndDatePlanned.ToString("dd/MM/yyyy")</span>
                                <RadzenButton Icon="event_repeat" Text="@Localize["Riprogramma"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => { _edit = null; OpenReschedule(); })" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">@Localize["Note"]</label>
                            <input class="form-control form-control-sm" @bind="_edit.Note" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <RadzenButton Icon="save" Text="@Localize["Salva"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveEdit" />
                        <RadzenButton Icon="close" Text="@Localize["Annulla"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => _edit = null)" />
                    </div>
                </div>
            }
        </div>
    </div>

    @* Cambiando tab a mano si torna a vedere tutti i ticket della commessa. *@
    <RadzenSelectBar @bind-Value="_view" TValue="View" Style="margin-bottom:16px;" Size="ButtonSize.Small"
                     Change="@(_ => _ticketsFaseFilter = null)">
        <Items>
            <RadzenSelectBarItem Text="@Localize["Panoramica"]" Value="View.Overview" Icon="dashboard" />
            <RadzenSelectBarItem Text="@Localize["Pianificazione"]" Value="View.Plan" Icon="view_timeline" />
            <RadzenSelectBarItem Text="@Localize["Fasi operative"]" Value="View.Phases" Icon="checklist" />
            <RadzenSelectBarItem Text="@Localize["Ticket"]" Value="View.Tickets" Icon="confirmation_number" />
        </Items>
    </RadzenSelectBar>

    @switch (_view)
    {
        case View.Overview:
            <div class="row g-3">
                <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                    <div class="text-muted small">@Localize["Fasi"]</div><div class="fs-3 fw-bold">@_c.PhaseCount</div></div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                    <div class="text-muted small">@Localize["Ticket"]</div><div class="fs-3 fw-bold">@_c.TicketCount</div></div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                    <div class="text-muted small">@Localize["Fasi completate"]</div><div class="fs-3 fw-bold">@_fasi.Count(f => f.State == CommessaFaseStates.Done)/@_fasi.Count</div></div></div></div>
                <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                    <div class="text-muted small">@Localize["Giorni alla consegna"]</div><div class="fs-3 fw-bold @( (_c.EndDatePlanned.Date - DateTime.Today).Days < 0 ? "text-danger" : "")">@((_c.EndDatePlanned.Date - DateTime.Today).Days)</div></div></div></div>
                @if (!string.IsNullOrWhiteSpace(_c.Description) || !string.IsNullOrWhiteSpace(_c.Note))
                {
                    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(_c.Description)) { <div class="text-muted small mb-1">@Localize["Descrizione"]</div><p class="mb-2" style="white-space:pre-wrap;">@_c.Description</p> }
                        @if (!string.IsNullOrWhiteSpace(_c.Note)) { <div class="text-muted small mb-1">@Localize["Note"]</div><p class="mb-0" style="white-space:pre-wrap;">@_c.Note</p> }
                    </div></div></div>
                }
            </div>
            break;

        case View.Plan:
            <div class="card border-0 shadow-sm"><div class="card-body">
                <RedGGantt @ref="_gantt" CommessaId="@Id" OnProgressChanged="ReloadHeaderAsync" />
            </div></div>
            break;

        case View.Phases:
            <div class="card border-0 shadow-sm"><div class="card-body">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>@Localize["Fase"]</th><th>@Localize["Gruppo"]</th><th>@Localize["Tipo ticket"]</th><th>@Localize["Previsti"]</th><th>@Localize["Regola"]</th><th style="width:120px;">@Localize["Stato"]</th><th style="width:90px;" class="text-center">@Localize["Ticket"]</th><th style="width:260px;"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _fasi.Where(x => !x.IsMilestone))
                        {
                            <tr class="@(f.HasBlockingTickets ? "table-danger" : "")">
                                <td style="padding-left:@(Depth(f) * 16 + 8)px">@f.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(f.GroupName) ? "—" : f.GroupName)</td>
                                <td>@(string.IsNullOrWhiteSpace(f.TicketTypeName) ? "—" : f.TicketTypeName)</td>
                                <td>
                                    @if (f.TicketPlans.Any())
                                    {
                                        <span class="badge bg-light text-dark border">@GeneratedPlanCount(f)/@f.TicketPlans.Count</span>
                                        <span class="small text-muted">@string.Join(", ", f.TicketPlans.OrderBy(p => p.SortOrder).Select(p => p.Title))</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="small text-muted">@CompletionModeText(f.CompletionMode)</span></td>
                                <td>
                                    <span class="badge @FaseBadge(f.State)">@CommessaUi.FaseStateText(f.State)</span>
                                    @if (f.HasBlockingTickets)
                                    {
                                        <div class="small text-danger fw-semibold" title="@string.Format(Localize["{0} ticket bloccati"], f.BlockedTicketCount)">
                                            <span class="material-icons align-middle" style="font-size:15px;">report_problem</span>
                                            @Localize["Bloccata"]
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(f.TakenByName))
                                    {
                                        <div class="small text-muted text-truncate" title="@($"Presa in carico da {f.TakenByName}{(f.TakenAt != null ? $" il {f.TakenAt:dd/MM/yyyy}" : "")}")">@f.TakenByName</div>
                                    }
                                </td>
                                <td class="text-center">@(f.TicketCount > 0 ? $"{f.ClosedTicketCount}/{f.TicketCount}" : "—")</td>
                                <td class="text-end">
                                    @if (f.State == CommessaFaseStates.Done)
                                    {
                                        <span class="text-success small"><span class="material-icons align-middle" style="font-size:16px;">check_circle</span> @Localize["Fatto"]</span>
                                    }
                                    else if (f.PendingPlannedTicketCount > 0)
                                    {
                                        <RadzenButton Icon="add_task" Text="@Localize["Genera previsti"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                      Disabled="@(!CanTake(f))" Click="@(() => GeneratePendingPlans(f))" />
                                    }
                                    else if ((f.IdTicketType != null || f.TicketPlans.Any()) && f.AutoCreateTicketOnTake)
                                    {
                                        @if (f.TicketCount > 0)
                                        {
                                            <RadzenButton Icon="confirmation_number" Text="@Localize["Vedi ticket"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                          Click="@(() => ShowPhaseTickets(f))" />
                                            @if (f.IdTicketType != null)
                                            {
                                                <RadzenButton Icon="add" Text="@Localize["Nuovo"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                              Disabled="@(!CanTake(f))" Click="@(() => TakeInCharge(f))" />
                                            }
                                        }
                                        else
                                        {
                                            <span title="@TakeBlockedReason(f)">
                                                <RadzenButton Icon="play_arrow" Text="@Localize["Prendi in carico"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                              Disabled="@(!CanTake(f))" Click="@(() => TakeInCharge(f))" />
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span title="@CompleteBlockedReason(f)">
                                            <RadzenButton Icon="check" Text="@Localize["Completa"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                                          Disabled="@(!CanTake(f) || !CanComplete(f))" Click="@(() => MarkDone(f))" />
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!_fasi.Any(x => !x.IsMilestone))
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">@Localize["Nessuna fase. Aggiungile dalla scheda Pianificazione."]</td></tr>
                        }
                    </tbody>
                </table>
                <div class="small text-muted mt-2"><span class="material-icons align-middle" style="font-size:14px;">info</span> @Localize["Una fase con dipendenze aperte non è avviabile finché i predecessori non sono completati."]</div>
            </div></div>
            break;

        case View.Tickets:
            @if (_ticketsFaseFilter != null)
            {
                <div class="alert alert-light border d-flex flex-wrap align-items-center gap-2 py-2 mb-3">
                    <span class="material-icons" style="font-size:18px;">filter_alt</span>
                    <span>@Localize["Ticket della fase"] <strong>@FaseName(_ticketsFaseFilter.Value)</strong></span>
                    <button class="btn btn-sm btn-link ms-auto p-0" @onclick="@(() => _ticketsFaseFilter = null)">
                        @Localize["Mostra tutti i ticket della commessa"]
                    </button>
                </div>
            }

            @* @key: cambiando filtro il componente viene ricreato, cosi' rilegge i ticket. *@
            <CRM.Client.Pages.Tickets.Index @key="_ticketsFaseFilter"
                                            IdCommessa="@Id"
                                            IdCommessaFase="@_ticketsFaseFilter"
                                            PageMode="CRM.Client.Helpers.PageHelper.PageModality.Child"
                                            OnClickDetails="OpenTicket" OnClickEdit="EditTicket" />
            break;
    }
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Presente quando si arriva dalla voce "Fase" del breadcrumb: apre le fasi operative.</summary>
    [Parameter] public int? FaseId { get; set; }

    private enum View { Overview, Plan, Phases, Tickets }

    private PageHeaderModel? _pageHeader;
    private CommessaDTO? _c;
    private List<CommessaFaseDTO> _fasi = new();
    private List<ApplicationUser> _users = new();
    private View _view = View.Overview;

    /// <summary>Fase di cui mostrare i soli ticket; null = tutti quelli della commessa.</summary>
    private int? _ticketsFaseFilter;
    private Commessa? _edit;

    private record StateOption(string Text, CommessaStates Value);
    private List<StateOption> _stateOptions => new()
    {
        new(Localize["Pianificata"], CommessaStates.Planned),
        new(Localize["In lavorazione"], CommessaStates.InProgress),
        new(Localize["Sospesa"], CommessaStates.Suspended),
        new(Localize["Collaudo"], CommessaStates.Testing),
        new(Localize["Completata"], CommessaStates.Completed),
        new(Localize["Consegnata"], CommessaStates.Delivered),
        new(Localize["Annullata"], CommessaStates.Cancelled),
    };

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();

        // Arrivando da /Commesse/{id}/Fasi/{faseId} si apre direttamente l'elenco delle fasi.
        if (FaseId != null)
            _view = View.Phases;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _c = await CommessaService.GetItemAsync(Id);
        _fasi = await FaseService.GetTreeAsync(Id) ?? new();
        if (_users.Count == 0)
        {
            var u = await UserSvc.Get(new UsersFilterModel { PageSize = 1000 });
            _users = u?.Items?.ToList() ?? new();
        }
        StateHasChanged();
    }

    private async Task ReloadHeaderAsync()
    {
        _c = await CommessaService.GetItemAsync(Id);
        _fasi = await FaseService.GetTreeAsync(Id) ?? new();
        StateHasChanged();
    }

    private int Depth(CommessaFaseDTO f)
    {
        int d = 0; var cur = f; int guard = 0;
        while (cur?.ParentId != null && guard++ < 50)
        {
            d++;
            cur = _fasi.FirstOrDefault(x => x.Id == cur.ParentId);
        }
        return d;
    }

    private static string FaseBadge(CommessaFaseStates s) => s switch
    {
        CommessaFaseStates.Pending => "bg-secondary",
        CommessaFaseStates.InProgress => "bg-primary",
        CommessaFaseStates.Done => "bg-success",
        _ => "bg-light text-dark"
    };

    private string CompletionModeText(CommessaFaseCompletionMode mode) => mode switch
    {
        CommessaFaseCompletionMode.Manual => Localize["Manuale"],
        CommessaFaseCompletionMode.AnyTicketClosed => Localize["Un ticket chiuso"],
        CommessaFaseCompletionMode.ProgressManual => Localize["Percentuale manuale"],
        _ => Localize["Tutti i ticket chiusi"]
    };

    /// <summary>
    /// Fase avviabile se tutti i predecessori sono completati (dipendenze vincolanti) e se
    /// l'utente e' abilitato: CanTake arriva dal server, che applica la regola sul gruppo.
    /// </summary>
    private bool CanTake(CommessaFaseDTO f)
        => f.CanTake && SequenceAllowsStart(f);

    /// <summary>
    /// Il vincolo di sequenza riguarda l'avvio: una fase già in lavorazione non si ricongela se un
    /// predecessore torna aperto (es. ticket riaperto). Stessa regola del server, che la applica
    /// davvero su ticket e completamento manuale.
    /// </summary>
    private bool SequenceAllowsStart(CommessaFaseDTO f)
        => f.State != CommessaFaseStates.Pending
            || f.Dependencies.All(d => _fasi.FirstOrDefault(x => x.Id == d.IdPredecessorFase)?.State == CommessaFaseStates.Done);

    /// <summary>Motivo per cui il pulsante e' disabilitato, mostrato in tooltip.</summary>
    private string TakeBlockedReason(CommessaFaseDTO f)
    {
        if (!f.CanTake)
            return string.IsNullOrWhiteSpace(f.GroupName)
                ? Localize["Non sei abilitato a eseguire questa fase."]
                : string.Format(Localize["Riservata al gruppo \"{0}\", di cui non fai parte."], f.GroupName);

        return SequenceAllowsStart(f) ? string.Empty : Localize["Ci sono fasi precedenti non ancora completate."];
    }

    /// <summary>Il flag "Richiede ticket" della fase: niente chiusura senza un ticket che la documenti.</summary>
    private static bool CanComplete(CommessaFaseDTO f)
        => !f.HasBlockingTickets && (!f.RequiresTicket || f.ClosedTicketCount > 0);

    private string CompleteBlockedReason(CommessaFaseDTO f)
        => f.HasBlockingTickets
            ? Localize["La fase contiene ticket bloccati: risolvi i blocchi prima di completarla."]
            : CanComplete(f)
            ? TakeBlockedReason(f)
            : Localize["La fase richiede almeno un ticket chiuso per poter essere completata."];

    private void TakeInCharge(CommessaFaseDTO f)
    {
        if (_c == null) return;
        // La fase viaggia nella rotta, non piu' in query: serve al breadcrumb Commessa > Fase > Ticket.
        var q = new List<string>();
        if (f.IdTicketType != null) q.Add($"IdType={f.IdTicketType}");
        if (f.IdGroup != null) q.Add($"IdGroup={f.IdGroup}");
        if (_c.IdCompany != null) q.Add($"IdCompany={_c.IdCompany}");
        if (_c.IdArticle != null) q.Add($"IdArticle={_c.IdArticle}");
        // Il prodotto e' quello della commessa: nel ticket arriva gia' scelto e non modificabile.
        if (_c.IdProduct != null) q.Add($"IdProduct={_c.IdProduct}");
        var desc = string.IsNullOrWhiteSpace(f.Description) ? $"{_c.Code} — {f.Name}" : $"{_c.Code} — {f.Name}\n{f.Description}";
        q.Add($"Descr={Uri.EscapeDataString(desc)}");
        Nav.NavigateTo($"/Commesse/{Id}/Fasi/{f.Id}/Tickets/New?{string.Join("&", q)}");
    }

    private async Task MarkDone(CommessaFaseDTO f)
    {
        f.State = CommessaFaseStates.Done;
        f.Progress = 100;
        var resp = await FaseService.SaveAsync(f);
        if (resp.State) await ReloadHeaderAsync();
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"]);
    }

    private async Task OnChangeState(CommessaStates state)
    {
        if (_c == null || state == _c.State) return;
        var resp = await CommessaService.ChangeStateAsync(Id, state);
        if (resp.State && resp.Data != null) { _c = resp.Data; Notification.Notify(NotificationSeverity.Success, Localize["Fatto"], Localize["Stato aggiornato"]); }
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"]);
    }

    private void ToggleEdit()
    {
        if (_edit != null) { _edit = null; return; }
        if (_c == null) return;
        _edit = new Commessa
        {
            Id = _c.Id,
            Name = _c.Name,
            Note = _c.Note,
            IdUserResponsible = _c.IdUserResponsible,
            Priority = _c.Priority,
            BudgetHours = _c.BudgetHours,
            StartDatePlanned = _c.StartDatePlanned,
            EndDatePlanned = _c.EndDatePlanned,
            State = _c.State,
            IdCompany = _c.IdCompany
        };
    }

    private async Task SaveEdit()
    {
        if (_edit == null) return;
        var resp = await CommessaService.PostAsync(_edit);
        if (resp.State) { _edit = null; await ReloadHeaderAsync(); Notification.Notify(NotificationSeverity.Success, Localize["Fatto"], Localize["Commessa aggiornata"]); }
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Salvataggio fallito"]);
    }

    private sealed class RescheduleModel
    {
        public DateTime Delivery { get; set; }
    }

    private RescheduleModel? _reschedule;
    private bool _rescheduleBusy;

    /// <summary>
    /// Valorizzato solo mentre la tab Pianificazione è aperta: il Gantt carica le fasi
    /// all'inizializzazione, quindi dopo una riprogrammazione va ricaricato a mano. Se la tab è
    /// chiusa il riferimento è null e non serve: il componente si inizializza quando la si apre.
    /// </summary>
    private RedGGantt? _gantt;

    private async Task RefreshPlanAsync()
    {
        await LoadAsync();
        await ReloadHeaderAsync();
        if (_gantt != null)
            await _gantt.ReloadAsync();
    }

    private void OpenReschedule()
    {
        if (_c == null) return;
        _reschedule = new RescheduleModel { Delivery = _c.EndDatePlanned.Date };
    }

    /// <summary>
    /// Anticipa a parole la regola del server: in avanti le fasi avviate restano ferme, indietro
    /// si spostano anche loro. Il conteggio dei giorni resta al server, che ha il calendario festivo.
    /// </summary>
    private string ReschedulePreview()
    {
        if (_c == null || _reschedule == null) return string.Empty;

        var giorni = (_reschedule.Delivery.Date - _c.EndDatePlanned.Date).Days;
        if (giorni == 0) return Localize["Scegli una data diversa da quella attuale."];

        var avviate = _fasi.Count(f => f.State != CommessaFaseStates.Pending);
        var verso = giorni > 0 ? Localize["posticipa"] : Localize["anticipa"];
        var testa = $"{verso} di {Math.Abs(giorni)} giorni solari ({_fasi.Count} fasi).";

        if (avviate == 0)
            return $"{testa} {Localize["Nessuna fase avviata: si sposta tutto."]}";

        return giorni > 0
            ? $"{testa} {avviate} {Localize["fasi già avviate restano dove sono."]}"
            : $"{testa} {Localize["Anche le"]} {avviate} {Localize["fasi già avviate si spostano, per non sovrapporsi a quelle da fare."]}";
    }

    private async Task ApplyReschedule()
    {
        if (_c == null || _reschedule == null) return;
        _rescheduleBusy = true;
        var resp = await CommessaService.RescheduleAsync(Id, _reschedule.Delivery);
        _rescheduleBusy = false;

        if (resp.State)
        {
            _reschedule = null;
            await RefreshPlanAsync();
            Notification.Notify(NotificationSeverity.Success, Localize["Piano spostato"], resp.Message ?? string.Empty, 8000);
        }
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"], 8000);
    }

    private async Task ApplyRebuild()
    {
        if (_c == null || _reschedule == null) return;

        var conferma = await DialogService.Confirm(
            Localize["Le fasi verranno ricostruite dal template del prodotto: durate, dipendenze e fasi modificate a mano andranno perse. I ticket già creati restano, ma senza fase collegata."],
            Localize["Ripristinare il piano dal modello?"],
            new ConfirmOptions { OkButtonText = Localize["Ripristina"], CancelButtonText = Localize["Annulla"] });

        if (conferma != true) return;

        _rescheduleBusy = true;
        var resp = await CommessaService.RebuildPlanFromTemplateAsync(Id, _reschedule.Delivery);
        _rescheduleBusy = false;

        if (resp.State)
        {
            _reschedule = null;
            await RefreshPlanAsync();
            Notification.Notify(NotificationSeverity.Success, Localize["Piano ricostruito"], resp.Message ?? string.Empty, 8000);
        }
        else Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? Localize["Operazione fallita"], 8000);
    }

    /// <summary>Apre la tab Ticket mostrando i soli ticket della fase indicata.</summary>
    private void ShowPhaseTickets(CommessaFaseDTO f)
    {
        _ticketsFaseFilter = f.Id;
        _view = View.Tickets;
    }

    private string FaseName(int idFase) => _fasi.FirstOrDefault(x => x.Id == idFase)?.Name ?? $"#{idFase}";

    private static int GeneratedPlanCount(CommessaFaseDTO f)
        => f.TicketPlans.Count(p => p.IdTicket != null);

    private async Task GeneratePendingPlans(CommessaFaseDTO f)
    {
        var pending = f.TicketPlans
            .Where(p => p.IdTicket == null)
            .OrderBy(p => p.SortOrder)
            .ToList();

        if (!pending.Any())
            return;

        foreach (var plan in pending)
        {
            var resp = await FaseService.GenerateTicketFromPlanAsync(plan.Id);
            if (!resp.State)
            {
                Notification.Notify(NotificationSeverity.Error, Localize["Errore"], resp.Message ?? string.Format(Localize["Generazione ticket \"{0}\" fallita"], plan.Title));
                await ReloadHeaderAsync();
                return;
            }
        }

        Notification.Notify(NotificationSeverity.Success, Localize["Fatto"], string.Format(Localize["{0} ticket generati"], pending.Count));
        await ReloadHeaderAsync();
        ShowPhaseTickets(f);
    }

    // Rotta annidata sotto la commessa: il breadcrumb del ticket parte da qui, non da /Tickets.
    private void OpenTicket(int id) => Nav.NavigateTo($"/Commesse/{Id}/Tickets/{id}");
    private void EditTicket(int? id) => Nav.NavigateTo(id == null ? "/Tickets/New" : $"/Tickets/{id}/Edit");
}
