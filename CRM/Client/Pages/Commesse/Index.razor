@page "/Commesse"
@page "/Commesse/Index"
@using CRM.Client.Helpers
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICommessaService CommessaService
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject DialogService DialogService

<PageHeader Model="_pageHeader"></PageHeader>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="max-width: 340px;">
            <span class="input-group-text"><span class="material-icons">search</span></span>
            <input class="form-control" placeholder="Cerca codice, nome, azienda"
                   @bind="_filter.Search" @bind:event="oninput" @onkeyup="OnSearchKey" />
        </div>
        <RadzenDropDown TValue="CommessaStates?" @bind-Value="_stateFilter" Data="_stateOptions"
                        TextProperty="Text" ValueProperty="Value" AllowClear="true"
                        Placeholder="Stato" Style="width: 200px;" Change="@(async _ => await Reload())" />
    </div>
</div>

<RadzenDataGrid @ref="_grid" IsLoading="@_isLoading" Count="@_count" Data="@_items" LoadData="@LoadData"
                AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center"
                TItem="CommessaDTO" AllowSorting="true" EmptyText="Nessuna commessa">
    <Columns>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="Code" Title="Codice" Width="130px" />
        <RadzenDataGridColumn TItem="CommessaDTO" Property="Name" Title="Commessa">
            <Template Context="c">
                <a href="@($"/Commesse/{c.Id}")" class="text-decoration-none fw-semibold">@(string.IsNullOrWhiteSpace(c.Name) ? c.Code : c.Name)</a>
                @if (!string.IsNullOrWhiteSpace(c.ArticleSerial))
                {
                    <div class="small text-muted"><span class="material-icons align-middle" style="font-size:13px;">qr_code_2</span> @c.ArticleSerial</div>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="CompanyName" Title="Azienda">
            <Template Context="c">
                @if (c.IdCompany != null)
                {
                    <a href="@($"/Companies/{c.IdCompany}")" class="text-decoration-none">@c.CompanyName</a>
                }
                else { <span>-</span> }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="OrderNumber" Title="Ordine" Width="130px">
            <Template Context="c">
                @if (c.IdOrder != null)
                {
                    <a href="@($"/{ConstHelper.ClientOrdersPath}/{c.IdOrder}/Details")" class="text-decoration-none">@(string.IsNullOrWhiteSpace(c.OrderNumber) ? c.IdOrder.ToString() : c.OrderNumber)</a>
                }
                else { <span>-</span> }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="State" Title="Stato" Width="140px" Sortable="false">
            <Template Context="c"><span class="badge @CommessaUi.StateBadgeClass(c.State)">@CommessaUi.StateText(c.State)</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="Progress" Title="Avanzamento" Width="170px" Sortable="false">
            <Template Context="c">
                <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:8px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width:@(c.Progress)%"></div>
                    </div>
                    <small class="text-muted" style="width:34px;">@c.Progress%</small>
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="CommessaDTO" Property="EndDatePlanned" Title="Consegna" Width="120px" FormatString="{0:dd/MM/yyyy}" />
        <RadzenDataGridColumn TItem="CommessaDTO" Context="c" Title="" Width="130px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <Template Context="c">
                <div class="d-flex gap-2 justify-content-center">
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Secondary" Click="@(() => Nav.NavigateTo($"/Commesse/{c.Id}"))" />
                    @if (c.Permits.Delete())
                    {
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => Delete(c))" />
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private PageHeaderModel? _pageHeader;
    private RadzenDataGrid<CommessaDTO>? _grid;
    private IEnumerable<CommessaDTO>? _items;
    private CommessaFilter _filter = new() { PageSize = 15, Skip = 0, Top = 15 };
    private CommessaStates? _stateFilter;
    private int _count;
    private bool _isLoading;

    private record StateOption(string Text, CommessaStates? Value);
    private readonly List<StateOption> _stateOptions = new()
    {
        new("Pianificata", CommessaStates.Planned),
        new("In lavorazione", CommessaStates.InProgress),
        new("Sospesa", CommessaStates.Suspended),
        new("Collaudo", CommessaStates.Testing),
        new("Completata", CommessaStates.Completed),
        new("Consegnata", CommessaStates.Delivered),
        new("Annullata", CommessaStates.Cancelled),
    };

    protected override async Task OnInitializedAsync() => _pageHeader = await HeaderService.Create();

    private async Task LoadData(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            _filter.Skip = args.Skip;
            _filter.Top = args.Top;
            _filter.OrderBy = args.OrderBy;
            _filter.State = _stateFilter;
            var resp = await CommessaService.GetSummaryAsync(_filter);
            _items = resp?.Items ?? new List<CommessaDTO>();
            _count = resp?.MetaData?.TotalCount ?? 0;
        }
        finally { _isLoading = false; }
    }

    private async Task Reload() { if (_grid != null) await _grid.Reload(); }
    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Reload(); }

    private async Task Delete(CommessaDTO c)
    {
        if (await DialogService.Confirm($"Eliminare la commessa {c.Code}?", "Conferma") == true)
        {
            await CommessaService.DeleteAsync(c.Id);
            await Reload();
        }
    }
}
