@page "/TicketInterventions/{InterventionId:int}/ExpenseReceipts/Create"
@* Spesa di una visita: il contesto sta nel percorso, come per l'intervento. La trasferta dal
   cliente potenziale e' proprio il caso in cui la spesa c'e' e il lavoro fatturabile no. *@
@page "/Activities/{ActivityId:int}/ExpenseReceipts/Create"
@* Creazione senza contesto nel percorso: e' la rotta che rende registrabili le spese che un
   lavoro di riferimento non ce l'hanno (corsi, bollette, cancelleria). *@
@page "/ExpenseReceipts/Create"
@using CRM.Shared.DTOs
@using Microsoft.Extensions.Localization
@using System.IO
@using CRM.Shared
@using CRM.Client.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Radzen.DialogService DialogService
@inject IBaseRestService<ApplicationUser, UsersFilterModel, string> _userService
@inject IInitiativeService InitiativeService
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

<BlazorHeader Header="@Localize["NewExpenseReceipt"]"></BlazorHeader>

@if (_isLoading)
{
    <Waiting></Waiting>
}
else
{
    <div class="container-fluid px-3 py-3">

        <!-- Breadcrumb: la scia risale da dove si e' arrivati - intervento, agenda o elenco -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                @if (InterventionId.HasValue)
                {
                    <li class="breadcrumb-item"><a href="/TicketInterventions">@Localize["Interventions"]</a></li>
                    <li class="breadcrumb-item"><a href="/TicketInterventions/@InterventionId">@Localize["InterventionNumber", InterventionId]</a></li>
                    <li class="breadcrumb-item"><a href="/TicketInterventions/@InterventionId/ExpenseReceipts">@Localize["ExpenseReceipts"]</a></li>
                }
                else if (ActivityId.HasValue)
                {
                    <li class="breadcrumb-item"><a href="/Agenda">Agenda</a></li>
                    <li class="breadcrumb-item"><a href="/Activities/@ActivityId/Info">@ActivityLabel</a></li>
                    <li class="breadcrumb-item"><a href="/ExpenseReceipts">@Localize["ExpenseReceipts"]</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="/ExpenseReceipts">@Localize["ExpenseReceipts"]</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Localize["New"]</li>
            </ol>
        </nav>

        @* Il contesto non si digita mai: o e' nel percorso perche' si arriva da li' (intervento,
           attivita' in agenda), oppure non c'e' e la spesa e' un costo generale. Nessuno conosce a
           memoria il numero di un intervento, ed e' il motivo per cui la casella numerica che lo
           chiedeva e' stata tolta. *@
        @* Chi ha speso si chiede SEMPRE, anche con un contesto: con piu' assegnati - il caso che
           la presa in carico dal gruppo ha reso frequente - chi registra non e' per forza chi ha
           pagato il pranzo, e attribuirlo per default a chi sta scrivendo sbaglia in silenzio. *@
        <div class="card mb-3">
            <div class="card-header bg-light">
                <strong>@ContextTitle</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">
                        <i class="material-icons align-middle" style="font-size:18px;">person</i>
                        @Localize["Spender"] <span class="text-danger">*</span>
                    </label>
                    <RadzenDropDown TValue="string" @bind-Value="_model.IdUserSpender"
                                    Data="_users" TextProperty="NameComplete" ValueProperty="Id"
                                    AllowFiltering="true" AllowClear="false"
                                    FilterCaseSensitivity="Radzen.FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@Localize["SelectPerson"]" Style="width:100%" />
                    <div class="form-text">
                        La spesa viene rimborsata a questa persona ed entra nel suo totale.
                        @if (InterventionId.HasValue)
                        {
                            <text>Preselezionato fra gli assegnati dell'intervento: cambialo se ha pagato un altro.</text>
                        }
                        else if (ActivityId.HasValue)
                        {
                            <text>Preselezionato su chi ha in carico la visita: cambialo se ha pagato un altro.</text>
                        }
                        else
                        {
                            <text>Preselezionato su di te: cambialo se stai registrando la spesa di un collega.</text>
                        }
                    </div>
                </div>

                @* L'iniziativa e' un contesto a se', non un'alternativa alla visita: i costi comuni
                   di una fiera o di un giro clienti - stand, volo, albergo dei dieci giorni - non
                   appartengono a nessuna visita in particolare, e senza questo campo finirebbero
                   fra i costi generali proprio mentre il resoconto li conta come costi di quella
                   occasione. *@
                <div class="mb-3">
                    <label class="form-label">
                        <i class="material-icons align-middle" style="font-size:18px;">event_note</i>
                        Iniziativa
                    </label>
                    <RadzenDropDown TValue="int?" @bind-Value="_model.IdInitiative"
                                    Data="_initiatives" TextProperty="Name" ValueProperty="Id"
                                    AllowFiltering="true" AllowClear="true"
                                    FilterCaseSensitivity="Radzen.FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="Nessuna" Style="width:100%" />
                    <div class="form-text">
                        Fiera o trasferta a cui la spesa appartiene. Può convivere con la visita: il pranzo
                        col cliente durante il giro è di entrambe. Sono elencate le iniziative dell'ultimo
                        anno e quelle future.
                    </div>
                </div>

                @if (ActivityId.HasValue)
                {
                    <div class="form-text">
                        La spesa resta legata a questa visita: la ritrovi nell'elenco note spese con il
                        suo contesto, anche se la visita non produce un ticket.
                    </div>
                }
                else if (!InterventionId.HasValue)
                {
                    <div class="form-text">
                        Spesa che non si riferisce a un lavoro specifico: bolletta, cancelleria, corso,
                        abbonamento. Per le spese di un intervento o di una visita, registrale da lì:
                        il collegamento viene impostato da solo.
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="material-icons align-middle">error</i>
                @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;"></div>
                    <h5 class="text-muted">@Localize["Processing"]</h5>
                    <p class="small text-muted">@Localize["AzureAnalyzingDocument"]</p>
                </div>
            </div>
        }
        else if (_extractionResult != null)
        {
            <!-- Fase 2: Revisione Dati Estratti -->
            <div class="row g-4">
                <!-- Colonna PDF -->
                @if (_previewDataUrl != null)
                {
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="material-icons align-middle text-danger">picture_as_pdf</i>
                                @Localize["UploadedDocument"]
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div style="height: 700px; overflow: auto;">
                                @if (_previewContentType == "application/pdf")
                                {
                                    <iframe src="@_previewDataUrl" 
                                            style="width: 100%; height: 100%; border: none;"
                                            title="Preview PDF">
                                    </iframe>
                                }
                                else
                                {
                                    <img src="@_previewDataUrl" alt="Preview" style="width: 100%; height: auto;" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
                }

                <!-- Colonna Form -->
                <div class="@(_previewDataUrl != null ? "col-lg-5" : "col-12")">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="material-icons align-middle">edit</i>
                                @Localize["ExtractedData"]
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (_extractionResult.Success)
                            {
                                <div class="alert alert-success mb-3">
                                    <i class="material-icons align-middle">check_circle</i>
                                    @Localize["ExtractionCompleted"]
                                </div>

                                @if (_extractionResult.AverageConfidence.HasValue)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">@Localize["ExtractionConfidence"]</label>
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar @GetConfidenceClass(_extractionResult.AverageConfidence.Value)" 
                                                 role="progressbar" 
                                                 style="width: @((_extractionResult.AverageConfidence.Value * 100).ToString("F0"))%">
                                                @((_extractionResult.AverageConfidence.Value * 100).ToString("F0"))%
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (IsMultiDocument)
                                {
                                    <div class="alert alert-info mb-3">
                                        <div class="fw-semibold">
                                            @Localize["MultiDocumentPdfDetected", _model.Documents.Count]
                                        </div>
                                        <div class="small text-muted">
                                            Verranno create <strong>@_model.Documents.Count note spese distinte</strong>,
                                            una per documento, tutte collegate a questo file. Ognuna ha i suoi importi
                                            e la sua valuta: controllale qui sotto prima di salvare.
                                        </div>

                                        @* Un PDF di scontrini e' quasi sempre di una trasferta sola, quindi
                                           di una valuta sola: compilarle una per una sarebbe lavoro inutile
                                           nel caso normale. *@
                                        @if (DocumentsWithoutCurrency().Count > 0 && !string.IsNullOrWhiteSpace(CurrencyToApply))
                                        {
                                            <button type="button" class="btn btn-sm btn-warning mt-2"
                                                    @onclick="ApplyCurrencyToAllDocuments">
                                                Imposta @CurrencyToApply su tutte
                                            </button>
                                        }
                                    </div>
                                }

                                @* Escludere non e' cancellare: finche' non si salva si puo' rimettere,
                                   altrimenti per un clic sbagliato tocca ricaricare il file. *@
                                @if (_excludedDocuments.Any())
                                {
                                    <div class="alert alert-secondary d-flex align-items-center gap-2 py-2">
                                        <i class="material-icons" style="font-size:18px;">block</i>
                                        <span class="small flex-fill">
                                            @_excludedDocuments.Count
                                            @(_excludedDocuments.Count == 1 ? "documento escluso" : "documenti esclusi")
                                            dal lotto: @string.Join(", ", _excludedDocuments.Select(DescribeDocument))
                                        </span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="RestoreExcludedDocuments">
                                            Ripristina
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="material-icons align-middle">warning</i>
                                    @Localize["ExtractionFailedEnterManually"]
                                </div>
                            }

                            <EditForm Model="@_model" OnValidSubmit="SaveReceipt">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                @* Con piu' documenti ogni nota spese ha la sua scheda: i campi in comune
                                   restano fuori (chi ha speso, note, conferma), quelli che appartengono
                                   al singolo documento stanno dentro. I campi aggregati che c'erano prima
                                   - un esercente "A / B", un totale sommato, una valuta sola - non
                                   corrispondevano a niente di cio' che veniva salvato. *@
                                @if (IsMultiDocument)
                                {
                                    @foreach (var doc in _model.Documents)
                                    {
                                        var missing = string.IsNullOrWhiteSpace(doc.Currency);
                                        <div class="card mb-3 @(missing ? "border-warning" : "")">
                                            <div class="card-header d-flex align-items-center gap-2 @(missing ? "bg-warning-subtle" : "bg-light")">
                                                <i class="material-icons" style="font-size:18px;">receipt_long</i>
                                                <strong>Nota spese @(doc.SortOrder + 1) di @_model.Documents.Count</strong>
                                                @if (doc.PageFrom.HasValue)
                                                {
                                                    <span class="small text-muted">
                                                        (pag. @doc.PageFrom@(doc.PageTo > doc.PageFrom ? $"-{doc.PageTo}" : ""))
                                                    </span>
                                                }
                                                @if (missing)
                                                {
                                                    <span class="badge bg-warning text-dark ms-auto">valuta da indicare</span>
                                                }
                                                @* Nessuna euristica indovina sempre se due pagine sono la
                                                   stessa fattura: chi guarda il documento lo sa, e deve
                                                   poterlo dire. *@
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary @(missing ? "" : "ms-auto")"
                                                        title="Toglila dal lotto: fa parte del documento precedente"
                                                        @onclick="() => ExcludeDocument(doc)">
                                                    <i class="material-icons align-middle" style="font-size:16px;">block</i>
                                                    Non è una nota spese a sé
                                                </button>
                                            </div>
                                            <div class="card-body">
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <label class="form-label small">@Localize["Merchant"]</label>
                                                        <input class="form-control" @bind="doc.MerchantName" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small">@Localize["TransactionDate"]</label>
                                                        <input type="date" class="form-control" @bind="doc.TransactionDate" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small">@Localize["TotalAmount"] *</label>
                                                        <input type="number" step="0.01" class="form-control" @bind="doc.TotalAmount" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small">@Localize["Tax"]</label>
                                                        <input type="number" step="0.01" class="form-control" @bind="doc.TaxAmount" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small">@Localize["Currency"]</label>
                                                        <input class="@(missing ? "form-control is-invalid" : "form-control")"
                                                               placeholder="da indicare"
                                                               @bind="doc.Currency" @bind:event="oninput" />
                                                    </div>
                                                </div>

                                                @if (missing)
                                                {
                                                    <div class="small text-warning-emphasis mt-2">
                                                        <i class="material-icons align-middle" style="font-size:16px;">report_problem</i>
                                                        Senza valuta questa nota resta <strong>da convertire</strong>
                                                        e non entra in nessun totale.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">store</i>
                                        @Localize["Merchant"]
                                    </label>
                                    <InputText @bind-Value="_model.MerchantName" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">event</i>
                                        @Localize["TransactionDate"]
                                    </label>
                                    <InputDate @bind-Value="_model.TransactionDate" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">euro</i>
                                        @Localize["TotalAmount"] *
                                    </label>
                                    <InputNumber @bind-Value="_model.TotalAmount" class="form-control" step="0.01" />
                                    <ValidationMessage For="@(() => _model.TotalAmount)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">calculate</i>
                                        @Localize["Tax"]
                                    </label>
                                    <InputNumber @bind-Value="_model.TaxAmount" class="form-control" step="0.01" />
                                    <ValidationMessage For="@(() => _model.TaxAmount)" />
                                </div>

                                @* La valuta mancante non e' un dettaglio: senza, la spesa non entra
                                   in nessun totale. Va detto dove si guarda, non in una riga di
                                   aiuto sotto il campo. *@
                                <div class="mb-3 @(CurrencyMissing ? "currency-missing" : "")">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">payments</i>
                                        @Localize["Currency"]
                                        @if (CurrencyMissing)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">da indicare</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="_model.Currency"
                                               class="@(CurrencyMissing ? "form-control is-invalid" : "form-control")"
                                               placeholder="da indicare"
                                               @onblur="ProposeExchangeRate" />

                                    @if (CurrencyMissing)
                                    {
                                        <div class="alert alert-warning mt-2 mb-0 py-2 px-3">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="material-icons" style="font-size:20px;">report_problem</i>
                                                <div class="flex-fill">
                                                    @* Due situazioni diverse, e conviene distinguerle: un simbolo
                                                       ambiguo si conferma con un clic, un documento che la valuta
                                                       non la scrive proprio va compilato a mano. *@
                                                    @if (_currencyCandidates.Any())
                                                    {
                                                        <div class="fw-semibold">
                                                            Sul documento c'è <strong>@_extractionResult?.CurrencySymbol</strong>,
                                                            che appartiene a più valute: conferma quale.
                                                        </div>
                                                    }
                                                    else if (ReadFromDocument)
                                                    {
                                                        <div class="fw-semibold">
                                                            Valuta non trovata sul documento.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="fw-semibold">
                                                            Valuta non indicata.
                                                        </div>
                                                    }
                                                    <div class="small mt-1">
                                                        Finché manca, questa spesa resta <strong>da convertire</strong>:
                                                        non entra nei totali del periodo, né in quelli della persona.
                                                    </div>

                                                    <div class="btn-group btn-group-sm flex-wrap mt-2" role="group">
                                                        @foreach (var c in _currencyCandidates)
                                                        {
                                                            <button type="button" class="btn btn-warning"
                                                                    @onclick="() => PickCurrency(c)">@c</button>
                                                        }
                                                        @* Quasi tutte le spese sono nella valuta di casa: il caso
                                                           normale deve costare un clic. Resta una scelta esplicita,
                                                           non il ripiego automatico che marcava EUR ogni scontrino. *@
                                                        <button type="button" class="btn btn-outline-secondary"
                                                                @onclick="() => PickCurrency(_baseCurrency)">
                                                            È in @_baseCurrency
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @* Il cambio si chiede solo quando serve davvero, cioe' quando la spesa non e'
                                   gia' nella valuta di casa. *@
                                @if (_needsRate)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="material-icons align-middle" style="font-size:18px;">currency_exchange</i>
                                            @Localize["ExchangeRateTo", _baseCurrency]
                                        </label>
                                        <div class="input-group">
                                            <InputNumber @bind-Value="_model.ExchangeRate" class="form-control" step="0.000001" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="ProposeExchangeRate" disabled="@_loadingRate">
                                                @(_loadingRate ? "..." : Localize["Suggest"])
                                            </button>
                                        </div>
                                        <div class="form-text">
                                            @if (_rateUnavailable)
                                            {
                                                <span class="text-warning">
                                                    Cambio non disponibile per questa valuta o data: indicalo a mano,
                                                    oppure salva e resterà da convertire.
                                                </span>
                                            }
                                            else if (_model.ExchangeRate.HasValue && _model.TotalAmount.HasValue)
                                            {
                                                <span>
                                                    @_model.TotalAmount.Value.ToString("N2") @_model.Currency =
                                                    <strong>@((_model.TotalAmount.Value * _model.ExchangeRate.Value).ToString("N2")) @_baseCurrency</strong>
                                                    — riferimento BCE, modificabile se la carta ha applicato un cambio diverso.
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@Localize["EcbRateHint"]</span>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">description</i>
                                        @Localize["Description"]
                                    </label>
                                    <InputTextArea @bind-Value="_model.Description" class="form-control" rows="3" />
                                </div>
                                }

                                @* Da qui in giu' i campi valgono per tutto quello che si sta salvando,
                                   una nota o dieci. *@
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="material-icons align-middle" style="font-size:18px;">note</i>
                                        @Localize["Notes"]
                                    </label>
                                    <InputTextArea @bind-Value="_model.Notes" class="form-control" rows="2" />
                                </div>

                                <div class="form-check mb-3">
                                    <InputCheckbox @bind-Value="_model.IsConfirmed" class="form-check-input" id="confirmCheck" />
                                    <label class="form-check-label" for="confirmCheck">
                                        @Localize["ConfirmDataImmediately"]
                                    </label>
                                </div>

                                @* Riepilogo di cosa non tornera' nei conti, subito sopra il pulsante:
                                   e' l'ultimo punto in cui si guarda prima di salvare, ed e' li' che
                                   l'avviso ha ancora la possibilita' di cambiare qualcosa. *@
                                @if (ConversionWarnings.Any())
                                {
                                    <div class="alert alert-warning d-flex align-items-start gap-2">
                                        <i class="material-icons">warning</i>
                                        <div>
                                            <div class="fw-semibold">Salvando adesso, non entra nei totali:</div>
                                            <ul class="mb-0 ps-3 small">
                                                @foreach (var warning in ConversionWarnings)
                                                {
                                                    <li>@warning</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn @(ConversionWarnings.Any() ? "btn-warning" : "btn-success") flex-fill"
                                            disabled="@_isSaving">
                                        @if (_isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="material-icons align-middle" style="font-size:18px;">save</i>
                                        @Localize["SaveExpenseReceipt"]
                                    </button>
                                    <button type="button" @onclick="ResetForm" class="btn btn-outline-secondary">
                                        <i class="material-icons align-middle" style="font-size:18px;">refresh</i>
                                        @Localize["UploadAnother"]
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Fase 1: Upload File -->
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="material-icons align-middle me-2">cloud_upload</i>
                                @Localize["UploadReceiptOrInvoice"]
                            </h5>
                        </div>
                        <div class="card-body">

                            @* Dichiarare che cosa si carica fa risparmiare un'analisi Azure sui PDF:
                               senza, il file viene letto due volte, come fattura e come scontrini,
                               perche' dall'esterno i due casi sono indistinguibili. Resta
                               facoltativo - "Non lo so" e' il comportamento di prima. *@
                            <div class="mb-3">
                                <div class="form-label mb-1">Che cosa stai caricando?</div>
                                <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Tipo di documento">
                                    <button type="button"
                                            class="@KindButtonClass(ReceiptDocumentKind.Unknown)"
                                            @onclick="() => SetKind(ReceiptDocumentKind.Unknown)">
                                        Non lo so
                                    </button>
                                    <button type="button"
                                            class="@KindButtonClass(ReceiptDocumentKind.Invoice)"
                                            @onclick="() => SetKind(ReceiptDocumentKind.Invoice)">
                                        <i class="material-icons align-middle" style="font-size:16px;">description</i>
                                        Una fattura
                                    </button>
                                    <button type="button"
                                            class="@KindButtonClass(ReceiptDocumentKind.Receipts)"
                                            @onclick="() => SetKind(ReceiptDocumentKind.Receipts)">
                                        <i class="material-icons align-middle" style="font-size:16px;">receipt</i>
                                        Scontrini
                                    </button>
                                </div>
                                <div class="form-text">@KindHint</div>
                            </div>

                            <div class="upload-zone mb-3">
                                <InputFile @ref="_inputFile" OnChange="OnFileSelected" accept="image/*,.pdf"
                                           class="d-none" id="receipt-file" />
                                <label for="receipt-file" class="upload-label">
                                    <i class="material-icons upload-icon">add_photo_alternate</i>
                                    <p class="mb-2"><strong>@Localize["SelectReceiptOrInvoice"]</strong></p>
                                    <p class="text-muted small mb-0">@Localize["AcceptedReceiptFiles"]</p>
                                </label>
                            </div>

                            <div class="text-center text-muted">
                                <p class="mb-2">@Localize["Or"]</p>
                                <button @onclick="ShowManualForm" class="btn btn-outline-secondary">
                                    <i class="material-icons align-middle" style="font-size:18px;">edit_note</i>
                                    @Localize["EnterManuallyWithoutDocument"]
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="material-icons align-middle">info</i>
                        <strong>@Localize["Tip"]:</strong> @Localize["AzureUploadHint"]
                    </div>
                </div>
            </div>
        }

        @* Si torna dove si e' partiti. Senza il controllo l'indirizzo diventava
           "/TicketInterventions//ExpenseReceipts", con il doppio slash e nessuna pagina dietro. *@
        <div class="mt-4">
            <a href="@CancelUrl"
               class="btn btn-outline-secondary">
                <i class="material-icons align-middle" style="font-size:18px;">arrow_back</i>
                @Localize["Cancel"]
            </a>
        </div>
    </div>
}

<style>
    /* Il blocco della valuta mancante si stacca dal resto del modulo: e' l'unico campo che, se
       resta vuoto, fa nascere la spesa fuori dai totali. */
    .currency-missing {
        border-left: 4px solid #ffc107;
        padding-left: .75rem;
        margin-left: -.75rem;
    }

    .upload-zone {
        border: 3px dashed #dee2e6;
        border-radius: 8px;
        padding: 60px 20px;
        text-align: center;
        background-color: #f8f9fa;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .upload-zone:hover {
        border-color: #0d6efd;
        background-color: #e7f1ff;
    }

    .upload-label {
        cursor: pointer;
        display: block;
        margin: 0;
    }

    .upload-icon {
        font-size: 64px;
        color: #6c757d;
        margin-bottom: 16px;
    }

    .upload-zone:hover .upload-icon {
        color: #0d6efd;
    }
</style>
