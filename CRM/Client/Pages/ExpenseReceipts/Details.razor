@page "/TicketInterventions/{InterventionId:int}/ExpenseReceipts/{ReceiptId:int}/Details"
@* Gestita dalla scheda dell'attivita': il ritorno e il breadcrumb restano sull'attivita'. *@
@page "/Activities/{ActivityId:int}/ExpenseReceipts/{ReceiptId:int}/Details"
@* Senza contesto nel percorso: una spesa che un intervento non ce l'ha era invisibile, perche'
   non esisteva un indirizzo a cui guardarla. *@
@page "/ExpenseReceipts/{ReceiptId:int}/Details"
@using CRM.Shared.DTOs
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

<BlazorHeader Header="@Localize["ExpenseReceiptDetails"]"></BlazorHeader>

@if (_isLoading)
{
    <Waiting></Waiting>
}
else 
{
    <PageHeader>
    </PageHeader>
    if (_receipt == null)
    {
    

        <div class="alert alert-danger">
            <i class="material-icons align-middle">error</i>
            @Localize["ExpenseReceiptNotFound"]
        </div>
    }
    else
    {
        <div class="container-fluid px-3 py-3">

            @* <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/TicketInterventions">Interventi</a></li>
                    <li class="breadcrumb-item"><a href="/TicketInterventions/@InterventionId">Intervento #@InterventionId</a></li>
                    <li class="breadcrumb-item"><a href="/TicketInterventions/@InterventionId/ExpenseReceipts">Note Spese</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nota #@ReceiptId</li>
                </ol>
            </nav> *@

            <!-- Header con stato -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1">
                        Nota Spese #@_receipt.Id
                        @if (_receipt.IsConfirmed)
                        {
                            <span class="badge bg-success ms-2">
                                <i class="material-icons align-middle" style="font-size:16px;">check_circle</i>
                                Confermata
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-2">
                                <i class="material-icons align-middle" style="font-size:16px;">pending</i>
                                In attesa di conferma
                            </span>
                        }
                    </h4>
                    @if (_receipt.WasAutoExtracted)
                    {
                        <small class="text-muted">
                            <i class="material-icons align-middle" style="font-size:14px;">smart_toy</i>
                            Estratto automaticamente con Azure Form Recognizer
                        </small>
                    }
                </div>
                <div class="d-flex gap-2">
                    @if (!_receipt.IsConfirmed)
                    {
                        <button @onclick="ConfirmReceipt" class="btn btn-success" disabled="@_isConfirming">
                            <i class="material-icons align-middle" style="font-size:18px;">check_circle</i>
                            Conferma Dati
                        </button>
                    }
                    <a href="@EditUrl" class="btn btn-primary">
                        <i class="material-icons align-middle" style="font-size:18px;">edit</i>
                        Modifica
                    </a>
                    <button @onclick="DeleteReceipt" class="btn btn-danger" disabled="@_isDeleting">
                        <i class="material-icons align-middle" style="font-size:18px;">delete</i>
                        Elimina
                    </button>
                </div>
            </div>

            <div class="row g-4">
                <!-- Colonna PDF / Documento -->
                @if (_receipt.HasAttachment)
                {
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="material-icons align-middle text-danger">picture_as_pdf</i>
                                    @Localize["AttachedDocument"]
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div style="height: 800px; overflow: auto;">
                                    @* <iframe src="/api/AttachmentFiles/@_receipt.AttachmentFileId/download" 
                                            style="width: 100%; height: 100%; border: none;"
                                            title="Documento Receipt">
                                    </iframe> *@
                                    @if (_receipt!.AttachmentFileId != null)
                                    {
                                        <CRM.Client.Pages.DocViewer.Viewer Id="@_receipt.AttachmentFileId.Value" CloseEnabled="false"></CRM.Client.Pages.DocViewer.Viewer>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-light">
                                <a href="/api/AttachmentFiles/@_receipt.AttachmentFileId/download" 
                                   class="btn btn-sm btn-outline-primary"
                                   target="_blank">
                                    <i class="material-icons align-middle" style="font-size:16px;">download</i>
                                    @Localize["DownloadPdf"]
                                </a>
                                <span class="ms-2 text-muted small">@_receipt.AttachmentFileName</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Colonna Dati Estratti -->
                <div class="@(_receipt.HasAttachment ? "col-lg-5" : "col-12")">
                    @if (_documentResults.Count > 0)
                    {
                        <section class="mb-4" aria-labelledby="fiscal-documents-title">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 id="fiscal-documents-title" class="mb-0">
                                    <i class="material-icons align-middle">receipt_long</i>
                                    @(_documentResults.Count > 1 ? Localize["ReceiptsInDocument"] : Localize["FiscalDocument"])
                                </h5>
                                @if (_documentResults.Count > 1)
                                {
                                    <span class="badge bg-primary">@_documentResults.Count</span>
                                }
                            </div>

                            @for (var i = 0; i < _documentResults.Count; i++)
                            {
                                var document = _documentResults[i];
                                <article class="border rounded p-3 mb-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                        <div>
                                            <div class="text-muted small">@Localize["ReceiptNumber", i + 1]</div>
                                            @if (document.PageFrom.HasValue)
                                            {
                                                <div class="text-muted small">
                                                    @Localize["Page"] @document.PageFrom@(document.PageTo > document.PageFrom ? $"-{document.PageTo}" : null)
                                                </div>
                                            }
                                            <strong>@(string.IsNullOrWhiteSpace(document.MerchantName) ? Localize["MerchantNotDetected"] : document.MerchantName)</strong>
                                        </div>
                                        <strong class="text-success text-nowrap">@DocumentMoney(document, document.TotalAmount)</strong>
                                    </div>
                                    <dl class="row mb-0 small">
                                        <dt class="col-5 text-muted fw-normal">@Localize["Date"]</dt>
                                        <dd class="col-7 mb-1">@(document.TransactionDate?.ToString("dd/MM/yyyy") ?? Localize["NotDetected"])</dd>
                                        @if (document.TaxAmount.HasValue)
                                        {
                                            <dt class="col-5 text-muted fw-normal">@Localize["Tax"]</dt>
                                            <dd class="col-7 mb-1">@DocumentMoney(document, document.TaxAmount)</dd>
                                        }
                                        @if (document.Lines?.Count > 0)
                                        {
                                            <dt class="col-5 text-muted fw-normal">@Localize["Items"]</dt>
                                            <dd class="col-7 mb-1">@document.Lines.Count</dd>
                                        }
                                    </dl>
                                    @if (document.Lines?.Count > 0)
                                    {
                                        <details class="mt-2">
                                            <summary class="small text-primary">@Localize["LineCount", document.Lines.Count]</summary>
                                            <div class="table-responsive mt-2">
                                                <table class="table table-sm mb-0 small">
                                                    <thead>
                                                        <tr>
                                                            <th>@Localize["Description"]</th>
                                                            <th class="text-end">@Localize["QuantityShort"]</th>
                                                            <th class="text-end">@Localize["Price"]</th>
                                                            <th class="text-end">@Localize["Total"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in document.Lines)
                                                        {
                                                            <tr>
                                                                <td>@line.Description</td>
                                                                <td class="text-end">@line.Quantity?.ToString("N2")</td>
                                                                <td class="text-end">@DocumentMoney(document, line.UnitPrice)</td>
                                                                <td class="text-end">@DocumentMoney(document, line.TotalPrice)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </details>
                                    }
                                </article>
                            }

                            <div class="d-flex justify-content-between align-items-center border-top border-2 pt-3">
                                <strong>@Localize["DocumentTotal"]</strong>
                                <h5 class="mb-0 text-success">@Money(_receipt.TotalAmount)</h5>
                            </div>
                        </section>
                    }

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="material-icons align-middle">info</i>
                                @(_documentResults.Count > 0 ? "Riepilogo Nota Spese" : "Dati Nota Spese")
                            </h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-borderless">
                                <tbody>
                                    @if (_documentResults.Count == 0 && !string.IsNullOrEmpty(_receipt.MerchantName))
                                    {
                                        <tr>
                                            <td class="text-muted" style="width: 40%;">
                                                <i class="material-icons align-middle" style="font-size:18px;">store</i>
                                                Commerciante
                                            </td>
                                            <td><strong>@_receipt.MerchantName</strong></td>
                                        </tr>
                                    }

                                    @if (_documentResults.Count == 0 && _receipt.TransactionDate.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">event</i>
                                                Data Transazione
                                            </td>
                                            <td><strong>@_receipt.TransactionDate.Value.ToString("dd/MM/yyyy")</strong></td>
                                        </tr>
                                    }

                                    @* Da dove nasce la spesa. Senza questa riga una spesa di visita,
                                       aperta dal suo indirizzo diretto, non mostrava alcun legame
                                       con la visita che l'ha prodotta. *@
                                    <tr>
                                        <td class="text-muted">
                                            <i class="material-icons align-middle" style="font-size:18px;">@ContextIcon</i>
                                            Contesto
                                        </td>
                                        <td>
                                            @if (ContextUrl != null)
                                            {
                                                <a href="@ContextUrl"><strong>@ContextText</strong></a>
                                            }
                                            else
                                            {
                                                <strong>@ContextText</strong>
                                            }
                                        </td>
                                    </tr>

                                    @if (_receipt.TotalAmount.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                @* Icona neutra: l'euro qui era sbagliato quanto il simbolo. *@
                                                <i class="material-icons align-middle" style="font-size:18px;">receipt_long</i>
                                                Importo Totale
                                            </td>
                                            <td><h5 class="mb-0 text-success">@Money(_receipt.TotalAmount)</h5></td>
                                        </tr>
                                    }

                                    @if (_receipt.TaxAmount.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">calculate</i>
                                                IVA/Tasse
                                            </td>
                                            <td><strong class="text-info">@Money(_receipt.TaxAmount)</strong></td>
                                        </tr>
                                    }

                                    @if (_receipt.NetAmount.HasValue)
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">account_balance_wallet</i>
                                                Importo Netto
                                            </td>
                                            <td><strong>@Money(_receipt.NetAmount)</strong></td>
                                        </tr>
                                    }

                                    @if (!string.IsNullOrEmpty(_receipt.Currency))
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">payments</i>
                                                Valuta
                                            </td>
                                            <td><strong>@_receipt.Currency</strong></td>
                                        </tr>
                                    }

                                    @if (_documentResults.Count == 0 && !string.IsNullOrEmpty(_receipt.Description))
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">description</i>
                                                Descrizione
                                            </td>
                                            <td>@_receipt.Description</td>
                                        </tr>
                                    }

                                    @if (!string.IsNullOrEmpty(_receipt.Notes))
                                    {
                                        <tr>
                                            <td class="text-muted">
                                                <i class="material-icons align-middle" style="font-size:18px;">note</i>
                                                Note
                                            </td>
                                            <td>@_receipt.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Info Estrazione -->
                    @if (_receipt.WasAutoExtracted)
                    {
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="material-icons align-middle" style="font-size:18px;">smart_toy</i>
                                    Informazioni Estrazione
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (_receipt.ExtractionConfidence.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted">Affidabilità</small>
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar @GetConfidenceClass(_receipt.ExtractionConfidence.Value)" 
                                                 role="progressbar" 
                                                 style="width: @((_receipt.ExtractionConfidence.Value * 100).ToString("F0"))%"
                                                 aria-valuenow="@((_receipt.ExtractionConfidence.Value * 100).ToString("F0"))" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                                @((_receipt.ExtractionConfidence.Value * 100).ToString("F0"))%
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (_receipt.ProcessedDate.HasValue)
                                {
                                    <small class="text-muted">
                                        <i class="material-icons align-middle" style="font-size:14px;">schedule</i>
                                        Elaborato il @_receipt.ProcessedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                }
                            </div>
                        </div>
                    }

                    <!-- Info Conferma -->
                    @if (_receipt.IsConfirmed && _receipt.ConfirmedDate.HasValue)
                    {
                        <div class="card border-0 shadow-sm border-start border-success border-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0 text-success">
                                    <i class="material-icons align-middle" style="font-size:18px;">verified</i>
                                    Dati Confermati
                                </h6>
                            </div>
                            <div class="card-body">
                                <small class="text-muted">
                                    <i class="material-icons align-middle" style="font-size:14px;">schedule</i>
                                    Confermato il @_receipt.ConfirmedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                </small>
                                @if (!string.IsNullOrEmpty(_receipt.ConfirmedByUserName))
                                {
                                    <br />
                                    <small class="text-muted">
                                        <i class="material-icons align-middle" style="font-size:14px;">person</i>
                                        da @_receipt.ConfirmedByUserName
                                    </small>
                                }
                            </div>
                        </div>
                    }

                    <!-- Metadati -->
                    <div class="card border-0 shadow-sm mt-3">
                        <div class="card-body">
                            <small class="text-muted">
                                <div>
                                    <i class="material-icons align-middle" style="font-size:14px;">add_circle</i>
                                    Creato il @_receipt.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                @if (_receipt.LastModifiedDate.HasValue)
                                {
                                    <div class="mt-1">
                                        <i class="material-icons align-middle" style="font-size:14px;">edit</i>
                                        Modificato il @_receipt.LastModifiedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Azioni Footer -->
            <div class="mt-4 d-flex gap-2">
                <a href="@ListUrl" class="btn btn-outline-secondary">
                    <i class="material-icons align-middle" style="font-size:18px;">arrow_back</i>
                    Torna alle Note Spese
                </a>
            </div>
        </div>
    }
}
<style>
    iframe {
        background-color: #f8f9fa;
    }
</style>
