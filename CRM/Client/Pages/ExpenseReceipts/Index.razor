@page "/TicketInterventions/{InterventionId:int}/ExpenseReceipts"
@* Elenco delle spese di una visita. Vive anche dentro la scheda dell'attivita': la stessa
   pagina serve i due contenitori, perche' l'elenco e le sue azioni sono identici. *@
@page "/Activities/{ActivityId:int}/ExpenseReceipts"
@using CRM.Shared.DTOs
@using CRM.Client.Helpers
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Radzen.DialogService DialogService
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

@if (_isLoading)
{
    <Waiting></Waiting>
}
else
{
    @* Da dentro la scheda dell'attivita' l'intestazione la mette la pagina che ci contiene. *@
    @if (!Embedded)
    {
        <PageHeader></PageHeader>
    }

    <div class="@(Embedded ? "" : "container-fluid px-3 py-3")">

        <!-- Riepilogo -->
        @if (_summary != null)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Note spese</div>
                            <div class="h3 mb-0 text-primary">@_summary.TotalReceiptsCount</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Importo totale</div>
                            <div class="h3 mb-0 text-success">@Base(_summary.TotalExpenses)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">IVA/Tasse</div>
                            <div class="h3 mb-0 text-info">@Base(_summary.TotalTaxes)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Netto</div>
                            <div class="h3 mb-0 text-dark">@Base(_summary.TotalNet)</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Un totale che nasconde le righe non convertite e' peggio di un totale mancante:
               si dice quante sono e che nei totali qui sopra non ci sono. *@
            @if (_summary.NeedsConversionCount > 0)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                    <i class="material-icons">warning</i>
                    <span>
                        <strong>@_summary.NeedsConversionCount</strong>
                        @(_summary.NeedsConversionCount == 1 ? "nota spese" : "note spese")
                        senza valuta o cambio: <strong>non</strong> nei totali qui sopra.
                    </span>
                </div>
            }

            @* Su un'iniziativa le spese sono di piu' persone: senza questo avviso, chi vede solo
               le proprie confronterebbe il totale del resoconto con la somma delle righe qui
               sotto e leggerebbe la differenza come un errore dei conti. *@
            @if (!_canSeeAll)
            {
                <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3">
                    <i class="material-icons">visibility_off</i>
                    <span>
                        Vedi solo le <strong>tue</strong> note spese. Il costo totale dell'iniziativa
                        comprende anche quelle dei colleghi.
                    </span>
                </div>
            }

            @* Spaccato per persona: su una fiera e' la domanda vera ("a chi devo rimborsare cosa"),
               su un intervento sarebbe rumore, quindi compare solo dove serve. *@
            @if (InitiativeId.HasValue && _summary.ByUser.Count > 1)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body py-2">
                        <div class="small text-muted mb-1">Da rimborsare</div>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var user in _summary.ByUser)
                            {
                                <span>
                                    @(user.UserName ?? "—")
                                    <strong>@Base(user.TotalBase)</strong>
                                    <span class="text-muted small">(@user.Count)</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="material-icons">info</i>
                <span>
                    <strong>@_summary.ConfirmedReceiptsCount</strong> confermata/e &bull;
                    <strong>@_summary.PendingReceiptsCount</strong> in attesa
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="material-icons align-middle">error</i>
                @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Azioni -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Elenco note spese</h5>
            <div class="d-flex gap-2">
                @* Il prospetto stampa esattamente queste spese, raggruppate per tipologia: e' la
                   forma in cui servono a chi le deve dedurre, perche' vitto, alloggio e trasporti
                   hanno trattamenti diversi. *@
                <button type="button" class="btn btn-outline-secondary" disabled="@_isDownloading"
                        title="Prospetto PDF raggruppato per tipologia" @onclick="DownloadReport">
                    @if (_isDownloading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="material-icons align-middle" style="font-size:18px;">picture_as_pdf</i>
                    }
                    Report PDF
                </button>
                <a href="@CreateUrl" class="btn btn-primary">
                    <i class="material-icons align-middle" style="font-size:18px;">add</i>
                    Aggiungi nota spese
                </a>
            </div>
        </div>

        <!-- Elenco -->
        @if (_receipts == null || !_receipts.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="material-icons text-muted" style="font-size: 64px;">receipt_long</i>
                    <p class="text-muted mt-3">@EmptyText</p>
                    <a href="@CreateUrl" class="btn btn-primary">
                        Aggiungi la prima nota spese
                    </a>
                </div>
            </div>
        }
        else
        {
            @* Tabella e non schede: con una fiera le spese sono decine, e qui si confrontano
               importi e date incolonnati per mettere insieme un rimborso. Le schede reggevano
               quando l'unico contenitore era l'intervento, cioe' due o tre righe. Stesso
               linguaggio visivo dell'elenco generale: e' lo stesso dato. *@
            <div class="receipts-table-wrap">
                <table class="receipts-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            @if (_showUserColumn)
                            {
                                <th class="col-user">Persona</th>
                            }
                            <th>Esercente</th>
                            <th>Tipologia</th>
                            <th class="num">Importo</th>
                            <th class="num col-base">In @(_summary?.BaseCurrency ?? "EUR")</th>
                            <th>Stato</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var receipt in _receipts)
                        {
                            <tr class="@(receipt.NeedsConversion ? "row-warn" : "")" @onclick="() => OpenReceipt(receipt.Id)">
                                <td class="nowrap">
                                    @((receipt.TransactionDate ?? receipt.CreatedDate).ToString("dd/MM/yyyy"))
                                    @if (receipt.HasAttachment)
                                    {
                                        <i class="material-icons row-flag" title="Documento allegato">attach_file</i>
                                    }
                                </td>
                                @if (_showUserColumn)
                                {
                                    <td class="nowrap col-user">@(receipt.UserSpenderName ?? "—")</td>
                                }
                                <td class="merchant">
                                    @(receipt.MerchantName ?? receipt.Description ?? "—")
                                    @if (receipt.WasAutoExtracted)
                                    {
                                        <i class="material-icons row-flag" title="Estratto automaticamente dal documento">smart_toy</i>
                                    }
                                </td>
                                <td>
                                    @if (receipt.Category.HasValue)
                                    {
                                        <span class="category">
                                            @ExpenseCategories.Label(receipt.Category)
                                            @if (receipt.CategoryIsSuggestion)
                                            {
                                                @* Una proposta non confermata si distingue: su questo
                                                   campo cambia la deducibilita'. *@
                                                <span class="category-suggested" title="@receipt.CategoryReason">?</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="category category-missing">da indicare</span>
                                    }
                                </td>
                                @* Valuta della riga, non quella di casa: e' quello che c'e' scritto
                                   sul documento. *@
                                <td class="num">@CurrencyUi.Money(receipt.TotalAmount, receipt.Currency ?? "?")</td>
                                <td class="num col-base">
                                    @if (receipt.NeedsConversion)
                                    {
                                        <span class="to-convert-badge" title="Manca la valuta o il cambio: non entra nei totali">da convertire</span>
                                    }
                                    else
                                    {
                                        @CurrencyUi.Money(receipt.AmountBase, _summary?.BaseCurrency)
                                    }
                                </td>
                                <td>
                                    <span class="status @(receipt.IsConfirmed ? "ok" : "pending")">
                                        @(receipt.IsConfirmed ? "Confermata" : "In attesa")
                                    </span>
                                </td>
                                @* Le azioni non devono far partire anche l'apertura della riga. *@
                                <td class="row-actions" @onclick:stopPropagation="true">
                                    <a href="@EditUrl(receipt.Id)" class="icon-action" title="Modifica">
                                        <i class="material-icons">edit</i>
                                    </a>
                                    @if (!receipt.IsConfirmed)
                                    {
                                        <button type="button" class="icon-action ok" disabled="@_isConfirming"
                                                title="Conferma i dati" @onclick="() => ConfirmReceipt(receipt.Id)">
                                            <i class="material-icons">check</i>
                                        </button>
                                    }
                                    <button type="button" class="icon-action danger" disabled="@_isDeleting"
                                            title="Elimina" @onclick="() => DeleteReceipt(receipt)">
                                        <i class="material-icons">delete</i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        }

        @if (!Embedded)
        {
            <div class="mt-4">
                <a href="@BackUrl" class="btn btn-outline-secondary">
                    <i class="material-icons align-middle" style="font-size:18px;">arrow_back</i>
                    @BackText
                </a>
            </div>
        }
    </div>
}

@* Gli stili della tabella stanno in Index.razor.css: sono scoped, quindi non si prendono da
   Overview.razor.css anche se le due tabelle devono somigliarsi. *@
