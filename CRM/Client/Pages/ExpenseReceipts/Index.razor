@page "/TicketInterventions/{InterventionId:int}/ExpenseReceipts"
@* Elenco delle spese di una visita. Vive anche dentro la scheda dell'attivita': la stessa
   pagina serve i due contenitori, perche' l'elenco e le sue azioni sono identici. *@
@page "/Activities/{ActivityId:int}/ExpenseReceipts"
@using CRM.Shared.DTOs
@using CRM.Client.Helpers
@using Microsoft.Extensions.Localization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Radzen.DialogService DialogService
@inject IStringLocalizer<CRM.Shared.Resources.App> Localize

@if (_isLoading)
{
    <Waiting></Waiting>
}
else
{
    @* Da dentro la scheda dell'attivita' l'intestazione la mette la pagina che ci contiene. *@
    @if (!Embedded)
    {
        <PageHeader></PageHeader>
    }

    <div class="@(Embedded ? "" : "container-fluid px-3 py-3")">

        <!-- Riepilogo -->
        @if (_summary != null)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Note spese</div>
                            <div class="h3 mb-0 text-primary">@_summary.TotalReceiptsCount</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Importo totale</div>
                            <div class="h3 mb-0 text-success">@Base(_summary.TotalExpenses)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">IVA/Tasse</div>
                            <div class="h3 mb-0 text-info">@Base(_summary.TotalTaxes)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="text-muted small">Netto</div>
                            <div class="h3 mb-0 text-dark">@Base(_summary.TotalNet)</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Un totale che nasconde le righe non convertite e' peggio di un totale mancante:
               si dice quante sono e che nei totali qui sopra non ci sono. *@
            @if (_summary.NeedsConversionCount > 0)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                    <i class="material-icons">warning</i>
                    <span>
                        <strong>@_summary.NeedsConversionCount</strong>
                        @(_summary.NeedsConversionCount == 1 ? "nota spese" : "note spese")
                        senza valuta o cambio: <strong>non</strong> nei totali qui sopra.
                    </span>
                </div>
            }

            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="material-icons">info</i>
                <span>
                    <strong>@_summary.ConfirmedReceiptsCount</strong> confermata/e &bull;
                    <strong>@_summary.PendingReceiptsCount</strong> in attesa
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="material-icons align-middle">error</i>
                @_errorMessage
                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
            </div>
        }

        <!-- Azioni -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Elenco note spese</h5>
            <a href="@CreateUrl" class="btn btn-primary">
                <i class="material-icons align-middle" style="font-size:18px;">add</i>
                Aggiungi nota spese
            </a>
        </div>

        <!-- Elenco -->
        @if (_receipts == null || !_receipts.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="material-icons text-muted" style="font-size: 64px;">receipt_long</i>
                    <p class="text-muted mt-3">@EmptyText</p>
                    <a href="@CreateUrl" class="btn btn-primary">
                        Aggiungi la prima nota spese
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var receipt in _receipts)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card expense-receipt-card border-0 shadow-sm h-100 @(receipt.IsConfirmed ? "border-start border-success border-3" : "")">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        @if (receipt.HasAttachment)
                                        {
                                            <i class="material-icons text-danger align-middle">picture_as_pdf</i>
                                        }
                                        else
                                        {
                                            <i class="material-icons text-secondary align-middle">description</i>
                                        }
                                        <strong class="ms-1">#@receipt.Id</strong>
                                    </div>
                                    @if (receipt.IsConfirmed)
                                    {
                                        <span class="badge bg-success">
                                            <i class="material-icons align-middle" style="font-size:14px;">check_circle</i>
                                            Confermata
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="material-icons align-middle" style="font-size:14px;">pending</i>
                                            In attesa
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(receipt.MerchantName))
                                {
                                    <h6 class="card-title">@receipt.MerchantName</h6>
                                }

                                @if (!string.IsNullOrEmpty(receipt.Description))
                                {
                                    <p class="card-text text-muted small">@receipt.Description</p>
                                }

                                <div class="mb-2">
                                    @if (receipt.TransactionDate.HasValue)
                                    {
                                        <div class="small text-muted">
                                            <i class="material-icons align-middle" style="font-size:16px;">event</i>
                                            @receipt.TransactionDate.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(receipt.UserSpenderName))
                                    {
                                        <div class="small text-muted">
                                            <i class="material-icons align-middle" style="font-size:16px;">person</i>
                                            @receipt.UserSpenderName
                                        </div>
                                    }
                                </div>

                                @if (receipt.TotalAmount.HasValue)
                                {
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div>
                                            <div class="small text-muted">Totale</div>
                                            @* Valuta della riga, non quella di casa: e' quello che c'e'
                                               scritto sul documento. *@
                                            <div class="h5 mb-0 text-success">@CurrencyUi.Money(receipt.TotalAmount, receipt.Currency)</div>
                                        </div>
                                        @if (receipt.TaxAmount.HasValue)
                                        {
                                            <div>
                                                <div class="small text-muted">IVA</div>
                                                <div class="small">@CurrencyUi.Money(receipt.TaxAmount, receipt.Currency)</div>
                                            </div>
                                        }
                                    </div>

                                    @if (receipt.NeedsConversion)
                                    {
                                        <div class="small text-warning mt-1">
                                            <i class="material-icons align-middle" style="font-size:14px;">warning</i>
                                            Da convertire: non entra nei totali
                                        </div>
                                    }
                                    else if (!string.Equals(receipt.Currency, _summary?.BaseCurrency, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="small text-muted mt-1">
                                            = @CurrencyUi.Money(receipt.AmountBase, _summary?.BaseCurrency)
                                        </div>
                                    }
                                }

                                @if (receipt.WasAutoExtracted && receipt.ExtractionConfidence.HasValue)
                                {
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            <i class="material-icons align-middle" style="font-size:14px;">smart_toy</i>
                                            Estratto automaticamente (@((receipt.ExtractionConfidence.Value * 100).ToString("F0"))%)
                                        </small>
                                    </div>
                                }

                                <div class="expense-receipt-actions mt-auto pt-3 d-flex gap-2">
                                    <a href="@DetailsUrl(receipt.Id)" class="btn btn-sm btn-outline-primary flex-fill"
                                       title="Visualizza">
                                        <i class="material-icons align-middle" style="font-size:16px;">visibility</i>
                                    </a>
                                    <a href="@EditUrl(receipt.Id)" class="btn btn-sm btn-outline-secondary"
                                       title="Modifica">
                                        <i class="material-icons align-middle" style="font-size:16px;">edit</i>
                                    </a>
                                    @if (!receipt.IsConfirmed)
                                    {
                                        <button @onclick="() => ConfirmReceipt(receipt.Id)"
                                                class="btn btn-sm btn-success"
                                                disabled="@_isConfirming" title="Conferma i dati">
                                            <i class="material-icons align-middle" style="font-size:16px;">check</i>
                                        </button>
                                    }
                                    <button @onclick="() => DeleteReceipt(receipt)"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@_isDeleting" title="Elimina">
                                        <i class="material-icons align-middle" style="font-size:16px;">delete</i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!Embedded)
        {
            <div class="mt-4">
                <a href="@BackUrl" class="btn btn-outline-secondary">
                    <i class="material-icons align-middle" style="font-size:18px;">arrow_back</i>
                    @BackText
                </a>
            </div>
        }
    </div>
}

<style>
    .expense-receipt-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .expense-receipt-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .expense-receipt-card .card-body {
        min-height: 100%;
    }

    .expense-receipt-actions {
        width: 100%;
    }
</style>
