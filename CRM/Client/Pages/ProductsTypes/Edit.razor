@page "/Settings/ProductsTypes/New"
@page "/Settings/ProductsTypes/{Id:int}/Edit"
@using Radzen
@using Radzen.Blazor



@if (_productType == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="_pageHeader">
    </PageHeader>

    <EditForm Model="@_productType" OnValidSubmit="HandleValidSubmit">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_productType.Name" For="@(() => _productType.Name)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_productType.Description" For="@(() => _productType.Description)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel=true />
    </EditForm>

   
}