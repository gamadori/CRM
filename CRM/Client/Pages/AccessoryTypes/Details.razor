@page "/Settings/AccessoryTypes/{Id:int}/Details"
@using CRM.Shared.Helper

<BlazorHeader Header="Dettagli Tipo Accessorio" />

@if (_accessoryType == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            
            <RedGDetailField Icon="category" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _accessoryType.Name)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_accessoryType.Name</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="description">
                <LabelContent><DisplayName For="@(() => _accessoryType.Description)" /></LabelContent>
                <ChildContent><span class="note-report mb-0">@_accessoryType.Description</span></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" Text="@Localize["Back"]" OnClick="Annulla" />
                @if (_accessoryType.Permits.Edit())
                {
                    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
                }
            </div>
        </div>
    </div>
}