@page "/Settings/AccessoryTypes"
@page "/Settings/AccessoryTypes/Index"

@using Radzen
@using Radzen.Blazor
@using CRM.Shared.Helper
@using CRM.Client.Shared.Filters



<BlazorHeader Header="@_header" Visible="@(PageMode != PageHelper.PageModality.Dialog)"></BlazorHeader>




@if (_accessoryTypes != null)
{

    <BlazorBreadCrumb Model=@_bread Visible=@(PageMode != PageHelper.PageModality.Dialog)></BlazorBreadCrumb>
    
    
    <div class=row>
        <div class="col">
            <BlazorButton Template="TemplateButton.New" Label=true OnClick="NewAccessoryType"></BlazorButton>
        
        </div>
    </div>

    <RadzenDataGrid @ref="grdAccessoryTypes" IsLoading="@_isLoading" Responsive=true Count="@_accessoryTypes.Items.Count" Data="@_accessoryTypes.Items" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode=@_filterMode
                AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="10" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="AccessoryTypeModel" EmptyText=@Localize["No Accessory Type"]>
        <Columns>


            <RadzenDataGridColumn Context="item" TItem="AccessoryTypeModel" Title="@TranslateHelper.GetDisplayName(nameof(AccessoryTypeModel.Language), typeof(AccessoryTypeModel))" Property="@nameof(AccessoryTypeModel.Language)" FilterProperty="Language">
                <Template>
                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OnClickName(item?.Id)">@item?.Language</a>
                </Template>
            </RadzenDataGridColumn>


            <RadzenDataGridColumn Context="item" TItem="AccessoryTypeModel" Filterable="false" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="item">
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Secondary" Icon="format_list_bulleted" title="Dettagli"  Size="Radzen.ButtonSize.Medium" Click="@(args => Details(item.Id))">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Primary" Icon="edit" Size="Radzen.ButtonSize.Medium" title="Edit" Visible=@_user.ArticlePermits.Edit() Click="@(args => Edit(item.Id))">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="Radzen.ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.Medium" title="Elimina" Visible=@_user.ArticlePermits.Delete() Click="@(args => Delete(item.Id))">
                    </RadzenButton>
                   
                </Template>
           
            </RadzenDataGridColumn>
       
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}

    
    