@page "/EmailsSent/{Id:int}/Details"
@page "/EmailSent/{Id:int}"
@using BlazoringComponents.DropDownButton
@using CRM.Shared.Helper

<BlazorHeader Header="Dettagli Email" />

@if (_email == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <RedGDetailField Icon="schedule" ContainerClass="mb-4">
                <LabelContent><DisplayName For="@(() => _email.DateSent)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_email.DateSent</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="person">
                <LabelContent><DisplayName For="@(() => _email.IdUser)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@($"{_user?.UserName} ({_user?.NameComplete})")</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="mail">
                <LabelContent><DisplayName For="@(() => _email.To)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_email.To</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="cc">
                <LabelContent><DisplayName For="@(() => _email.CC)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_email.CC</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="subject">
                <LabelContent><DisplayName For="@(() => _email.Subject)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_email.Subject</p></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="message">
                <LabelContent><DisplayName For="@(() => _email.Message)" /></LabelContent>
                <ChildContent><pre class="mb-0">@_email.Message</pre></ChildContent>
            </RedGDetailField>

            <RedGDetailField Icon="check_circle">
                <LabelContent><DisplayName For="@(() => _email.Result)" /></LabelContent>
                <ChildContent><p class="mb-0 text-dark">@_email.Result</p></ChildContent>
            </RedGDetailField>

        </div>

        <!-- Footer con azioni -->
        <div class="card-footer bg-light border-top py-3">
            <div class="d-flex gap-2">
                <BlazorButton Template="TemplateButton.Back" OnClick="Annulla" Text="Emails" />
            </div>
        </div>
    </div>
}
