@page "/Orders/{Id:int}/Details"
@using CRM.Client.Helpers
@using CRM.Client.Models
@using CRM.Client.Services
@using CRM.Shared
@using CRM.Shared.DTOs
@using CRM.Shared.Helper
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject IOrderService OrderService
@inject ICommessaService CommessaService
@inject IInvoiceService InvoiceService
@inject IHeaderService HeaderService
@inject NavigationManager Nav
@inject DialogService DialogService
@inject NotificationService Notification
@inject HttpClient Http
@inject IJSRuntime JS

<PageHeader Model="_pageHeader"></PageHeader>

@if (_order == null)
{
    <Waiting></Waiting>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <RadzenButton Icon="arrow_back" Text="Lista" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Nav.NavigateTo($"/{ConstHelper.ClientOrdersPath}"))" />
        <RadzenButton Icon="picture_as_pdf" Text="Fattura di cortesia" ButtonStyle="ButtonStyle.Secondary"
                      IsBusy="@_downloadingPdf" Disabled="@_downloadingPdf" Click="DownloadPdf" />
        @if (_order.State != OrderStates.Cancelled)
        {
            <RadzenButton Icon="receipt_long" Text="Crea fattura" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_creatingInvoice" Disabled="@_creatingInvoice" Click="CreateInvoice" />
        }
        @if (_order.Permits.Edit() && _order.IdInvoice == null && _order.State != OrderStates.Invoiced)
        {
            <RadzenButton Icon="edit" Text="Modifica" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo($"/{ConstHelper.ClientOrdersPath}/{_order.Id}/Edit"))" />
        }
        @* Scorciatoia all'elenco filtrato: dalla tabella si arriva a una commessa per volta,
           e su un ordine con molte righe avviate serve vederle tutte insieme. *@
        @if (_commesseByRow.Any())
        {
            <RadzenButton Icon="precision_manufacturing" Text="@($"Commesse ({_commesseByRow.Sum(r => r.Value.Count)})")"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"/Commesse?IdOrder={_order.Id}"))" />
        }
        @if (_order.IdQuote != null)
        {
            <RadzenButton Icon="request_quote" Text="Preventivo" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"/{ConstHelper.ClientQuotesPath}/{_order.IdQuote}/Details"))" />
        }
        @if (_order.IdDeal != null)
        {
            <RadzenButton Icon="work" Text="Opportunita" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"/Deals/{_order.IdDeal}"))" />
        }
        @if (_order.IdCompany != null)
        {
            <RadzenButton Icon="business" Text="Azienda" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"/Companies/{_order.IdCompany}"))" />
        }
        @if (_order.IdInvoice != null)
        {
            <RadzenButton Icon="receipt" Text="Fattura" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo($"/{ConstHelper.ClientInvoicesPath}/{_order.IdInvoice}/Details"))" />
        }
        <RadzenDropDown TValue="OrderStates" Value="_order.State" Data="_stateOptions" TextProperty="Text" ValueProperty="Value"
                        Style="width:180px" Change="@(args => OnChangeState((OrderStates)args))" />
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><small class="text-muted d-block">Numero</small><strong>@_order.Number</strong></div>
                <div class="col-md-3"><small class="text-muted d-block">Data</small>@_order.Date.ToString("dd/MM/yyyy")</div>
                <div class="col-md-3"><small class="text-muted d-block">Consegna</small>@(_order.DeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                <div class="col-md-3"><small class="text-muted d-block">Stato</small><span class="badge @StateClass(_order.State)">@StateText(_order.State)</span></div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Azienda</small>
                    @if (_order.IdCompany != null)
                    {
                        <a href="@($"/Companies/{_order.IdCompany}")" class="text-decoration-none fw-semibold">@_order.CompanyName</a>
                    }
                    else
                    {
                        @_order.CompanyName
                    }
                </div>
                <div class="col-md-3"><small class="text-muted d-block">Contatto</small>@(string.IsNullOrEmpty(_order.ContactName) ? "-" : _order.ContactName)</div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Preventivo</small>
                    @if (_order.IdQuote != null)
                    {
                        <a href="@($"/{ConstHelper.ClientQuotesPath}/{_order.IdQuote}/Details")" class="text-decoration-none fw-semibold">
                            @(string.IsNullOrEmpty(_order.QuoteNumber) ? _order.IdQuote.Value.ToString() : _order.QuoteNumber)
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Opportunita</small>
                    @if (_order.IdDeal != null)
                    {
                        <a href="@($"/Deals/{_order.IdDeal}")" class="text-decoration-none fw-semibold">
                            @(string.IsNullOrWhiteSpace(_order.DealName) ? _order.IdDeal.Value.ToString() : _order.DealName)
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
                <div class="col-md-3"><small class="text-muted d-block">Owner</small>@_order.UserName</div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Fattura</small>
                    @if (_order.IdInvoice != null)
                    {
                        <a href="@($"/{ConstHelper.ClientInvoicesPath}/{_order.IdInvoice}/Details")" class="text-decoration-none fw-semibold">
                            @(string.IsNullOrWhiteSpace(_order.InvoiceNumber) ? _order.IdInvoice.Value.ToString() : _order.InvoiceNumber)
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Descrizione</th><th class="text-end">Q.ta</th><th class="text-end">Prezzo</th>
                        <th class="text-end">Sc.%</th><th class="text-end">IVA%</th><th class="text-end">Netto</th><th class="text-end">Totale</th>
                        <th style="min-width:230px;">Produzione</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _order.Rows)
                    {
                        <tr>
                            <td>@r.Description</td>
                            <td class="text-end">@r.Quantity</td>
                            <td class="text-end">@r.UnitPrice.ToString("C")</td>
                            <td class="text-end">@r.DiscountPct</td>
                            <td class="text-end">@r.VatRate</td>
                            <td class="text-end">@r.LineNet.ToString("C")</td>
                            <td class="text-end">@r.LineTotal.ToString("C")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge @CommessaUi.RowStatusBadgeClass(r.ProductionStatus)">@CommessaUi.RowStatusText(r.ProductionStatus)</span>
                                    @if (r.ProductionStatus == RowProductionStatus.None)
                                    {
                                        @if (r.ProductHasTemplate)
                                        {
                                            <RadzenButton Icon="precision_manufacturing" Text="Avvia produzione" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                                          IsBusy="@(_busyRow == r.Id)" Disabled="@(_busyRow != null)" Click="@(() => StartProduction(r))" />
                                        }
                                        else
                                        {
                                            @* Niente template: o la riga e' merce da spedire (conferma pronto),
                                               o e' un lavoro senza ciclo predefinito e vuole una commessa aperta. *@
                                            <RadzenButton Icon="check" Text="Conferma pronto" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                          IsBusy="@(_busyRow == r.Id)" Disabled="@(_busyRow != null)" Click="@(() => ConfirmReady(r))" />
                                            <RadzenButton Icon="folder_open" Text="Apri commessa" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                          Disabled="@(_busyRow != null)" Click="@(() => OpenCommessa(r))"
                                                          title="Lavoro senza ciclo predefinito: commessa con ticket aggiunti a mano" />
                                        }
                                    }
                                    else if (r.ProductionStatus is RowProductionStatus.InProduction or RowProductionStatus.Closed && _commesseByRow.TryGetValue(r.Id, out var cc) && cc.Any())
                                    {
                                        @foreach (var c in cc)
                                        {
                                            <a href="@($"/Commesse/{c.Id}")" class="badge bg-light text-dark border text-decoration-none" title="@c.Name">@c.Code</a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-7">
            @if (!string.IsNullOrWhiteSpace(_order.Note))
            {
                <div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <small class="text-muted d-block">Note</small>
                    <p class="mb-0">@_order.Note</p>
                </div></div>
            }
        </div>
        <div class="col-md-5">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between"><span>Imponibile</span><strong>@_order.Subtotal.ToString("C")</strong></div>
                <div class="d-flex justify-content-between text-muted"><span>Sconto</span><span>@_order.TotalDiscount.ToString("C")</span></div>
                <div class="d-flex justify-content-between"><span>IVA</span><strong>@_order.TotalVat.ToString("C")</strong></div>
                <hr />
                <div class="d-flex justify-content-between fs-5"><span>Totale</span><strong>@_order.Total.ToString("C")</strong></div>
            </div></div>
        </div>
    </div>

}

@code {
    [Parameter] public int Id { get; set; }

    private PageHeaderModel? _pageHeader;
    private OrderDTO? _order;
    private bool _downloadingPdf;
    private bool _creatingInvoice;
    private int? _busyRow;
    private Dictionary<int, List<CommessaDTO>> _commesseByRow = new();

    private record StateOption(string Text, OrderStates Value);
    private readonly List<StateOption> _stateOptions = new()
    {
        new("Confermato", OrderStates.Confirmed),
        new("In produzione", OrderStates.InProduction),
        new("Consegnato", OrderStates.Delivered),
        new("Fatturato", OrderStates.Invoiced),
        new("Annullato", OrderStates.Cancelled),
    };

    protected override async Task OnInitializedAsync()
    {
        _pageHeader = await HeaderService.Create();
        _order = await OrderService.GetItemAsync(Id);
        await LoadCommesse();
    }

    private async Task LoadCommesse()
    {
        var list = await CommessaService.GetByOrderAsync(Id);
        _commesseByRow = list.Where(c => c.IdOrderRow != null)
                             .GroupBy(c => c.IdOrderRow!.Value)
                             .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task StartProduction(OrderRowDTO r)
    {
        if (await DialogService.Confirm($"Avviare la produzione della riga \"{r.Description}\" (x{r.Quantity})? Verranno create le commesse dal template del prodotto.", "Conferma") != true)
            return;
        _busyRow = r.Id;
        try
        {
            var resp = await CommessaService.StartProductionAsync(r.Id);
            if (resp.State)
            {
                Notification.Notify(NotificationSeverity.Success, "Fatto", resp.Message ?? "Produzione avviata");
                _order = await OrderService.GetItemAsync(Id);
                await LoadCommesse();
            }
            else Notification.Notify(NotificationSeverity.Error, "Errore", resp.Message ?? "Operazione fallita");
        }
        finally { _busyRow = null; }
    }

    /// <summary>
    /// Commessa a fasi libere per una riga senza template: consegna e ore stimate si dichiarano
    /// nel dialogo perché non c'è un modello da cui dedurle, e diventano la baseline del consuntivo.
    /// </summary>
    private async Task OpenCommessa(OrderRowDTO r)
    {
        var parameters = new Dictionary<string, object>
        {
            { nameof(CRM.Client.Pages.Commesse.OpenCommessaDialog.IdOrderRow), r.Id },
            { nameof(CRM.Client.Pages.Commesse.OpenCommessaDialog.DefaultName), r.Description ?? string.Empty }
        };

        // Solo se l'ordine ha una consegna: passare null qui lascerebbe il dialogo senza il suo
        // default, che e' oggi + 30 giorni.
        if (_order?.DeliveryDate != null)
            parameters[nameof(CRM.Client.Pages.Commesse.OpenCommessaDialog.DefaultDate)] = _order.DeliveryDate.Value;

        var created = await DialogService.OpenAsync<CRM.Client.Pages.Commesse.OpenCommessaDialog>(
            $"Apri commessa — {r.Description}",
            parameters,
            new DialogOptions { Width = "720px", CloseDialogOnOverlayClick = false });

        if (created is not true) return;

        _order = await OrderService.GetItemAsync(Id);
        await LoadCommesse();
    }

    private async Task ConfirmReady(OrderRowDTO r)
    {
        _busyRow = r.Id;
        try
        {
            var resp = await CommessaService.ConfirmRowReadyAsync(r.Id);
            if (resp.State)
            {
                Notification.Notify(NotificationSeverity.Success, "Fatto", "Riga confermata pronta");
                _order = await OrderService.GetItemAsync(Id);
            }
            else Notification.Notify(NotificationSeverity.Error, "Errore", resp.Message ?? "Operazione fallita");
        }
        finally { _busyRow = null; }
    }

    private async Task DownloadPdf()
    {
        _downloadingPdf = true;
        try
        {
            var response = await Http.GetAsync($"{ConstHelper.OrdersPath}/{Id}/pdf");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"{_order?.Number ?? $"Ordine-{Id}"}-cortesia.pdf";
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", bytes);
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, "Errore", "Download PDF fallito");
            }
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Errore", ex.Message);
        }
        finally
        {
            _downloadingPdf = false;
        }
    }

    private async Task CreateInvoice()
    {
        if (await DialogService.Confirm("Creare una fattura da questo ordine?", "Conferma") != true)
            return;

        _creatingInvoice = true;
        try
        {
            var resp = await InvoiceService.CreateFromOrderAsync(Id);
            if (resp.State && resp.Data != null)
            {
                Notification.Notify(NotificationSeverity.Success, "Fatto", $"Fattura {resp.Data.Number} creata");
                Nav.NavigateTo($"/{ConstHelper.ClientInvoicesPath}/{resp.Data.Id}/Details");
            }
            else
            {
                Notification.Notify(NotificationSeverity.Warning, "Attenzione", resp.Message ?? "Operazione fallita");
            }
        }
        finally
        {
            _creatingInvoice = false;
        }
    }

    private async Task OnChangeState(OrderStates state)
    {
        if (_order == null || state == _order.State) return;
        var resp = await OrderService.ChangeStateAsync(Id, state);
        if (resp.State)
        {
            _order = resp.Data;
            Notification.Notify(NotificationSeverity.Success, "Fatto", "Stato aggiornato");
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Errore", resp.Message ?? "Operazione fallita");
        }
    }

    private static string StateText(OrderStates s) => s switch
    {
        OrderStates.Confirmed => "Confermato",
        OrderStates.InProduction => "In produzione",
        OrderStates.Delivered => "Consegnato",
        OrderStates.Invoiced => "Fatturato",
        OrderStates.Cancelled => "Annullato",
        _ => s.ToString()
    };

    private static string StateClass(OrderStates s) => s switch
    {
        OrderStates.Confirmed => "bg-primary",
        OrderStates.InProduction => "bg-info text-dark",
        OrderStates.Delivered => "bg-success",
        OrderStates.Invoiced => "bg-secondary",
        OrderStates.Cancelled => "bg-danger",
        _ => "bg-light text-dark"
    };
}
