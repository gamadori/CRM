@page "/Articles/{Id:int}/Info"
@page "/Articles/{Id:int}"
@page "/Companies/{CompanyId:int}/Articles/{Id:int}"

@using Radzen
@using Radzen.Blazor
@using static CRM.Client.Helpers.PageHelper

@if (_article == null)
{
    <Waiting></Waiting>
}
else
{
    <PageHeader Model="_pageHeader">
    </PageHeader>
    <!-- Desktop: SelectBar -->
    <div class="d-none d-md-block mb-3">
        <RadzenSelectBar @bind-Value="selectView" TValue="ProductViews" Change="@((args) => Change(args, "SelectBar with single selection"))" Style="margin-bottom: 20px;">
            <Items>
                <RadzenSelectBarItem Text="@Localize["Data Product"]" Value="ProductViews.Product" />
                <RadzenSelectBarItem Text="@Localize["Documenti Macchina"]" Value="ProductViews.Attachments" />
                <RadzenSelectBarItem Text="@($"{Localize["Documenti"]} {_article.Product?.Name}")" Value="ProductViews.ProductAttachments" />
                <RadzenSelectBarItem Text="@Localize["Tickets"]" Value="ProductViews.Ticket" />
                @* <RadzenSelectBarItem Text="@Localize["Backups"]" Value="ProductViews.Backups" /> *@
            </Items>
        </RadzenSelectBar>
    </div>
    <!-- Mobile: Dropdown -->
    <div class="d-md-none mb-3">
        <RadzenDropDown @bind-Value="selectView" TValue="ProductViews"
                        Change="@((args) => Change(args, "SelectBar with single selection"))"
                        Data="@_viewOptions"
                        TextProperty="Text"
                        ValueProperty="Value"
                        Style="width: 100%;"
                        Placeholder=@Localize["Seleziona vista..."] />
    </div>
    @if (selectView == ProductViews.Product)
    {
        if (_partialView == PartialViews.Details)
        {

            <Details Id="@Id" OnClickEdit="EditProduct" OnClickCancel="OnGotoIndex" PageMode="PageModality.Child"></Details>
        }
        else
        {
            <Edit Id="@Id" OnClickSave="(async () => await SaveProduct())" OnClickCancel="CancelProduct" PageMode="PageModality.Child"></Edit>
        }
    }
    else if (selectView == ProductViews.Attachments)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.Attachments.Index IdParent="@Id" AttachmentType=@AttachmentTypes.Article OnClickEdit="IndexEditAttachment"
                OnClickDetails="IndexDetailsAttachment"></CRM.Client.Pages.Attachments.Index>
        }
        else if (_partialView == PartialViews.Edit)
        {
            <CRM.Client.Pages.Attachments.Edit Id="@_idAttachment" IdParent="@Id" AttachmentType=@AttachmentTypes.Article OnClickClose="CloseAttachment"></CRM.Client.Pages.Attachments.Edit>
        }
        else if (_partialView == PartialViews.Details)
        {
            <CRM.Client.Pages.Attachments.Details Id="@_idAttachment" OnClickCancel="CloseAttachment"
                                      OnClickEdit="DetailsEditAttachment" OnClickAddFile="AddFileAttachment"></CRM.Client.Pages.Attachments.Details>
        }
        else if (_partialView == PartialViews.AddFiles)
        {
            <CRM.Client.Pages.Attachments.Upload Id="@_idAttachment.Value" OnClickClose="CloseAttachment"></CRM.Client.Pages.Attachments.Upload>
        }
    }
    else if (selectView == ProductViews.ProductAttachments)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.Attachments.Index ReadOnly="true" IdParent="@_article.IdProduct" AttachmentType=@AttachmentTypes.Product  OnClickDetails="IndexProductDetailsAttachment"></CRM.Client.Pages.Attachments.Index>
        }
        else
        {
            <CRM.Client.Pages.Attachments.Details ReadOnly="true" Id="@_idAttachment" OnClickCancel="CloseProductAttachment"
                                                  OnClickEdit="DetailsEditAttachment" ></CRM.Client.Pages.Attachments.Details>
        }
        
    }
    else if (selectView == ProductViews.Ticket)
    {
        if (_partialView == PartialViews.Index)
        {
            <CRM.Client.Pages.Tickets.Index IdArticle="@Id"  OnClickEdit="EditTicket" OnClickDetails="DetailsTicket" PageMode="PageModality.Child">

            </CRM.Client.Pages.Tickets.Index>
        }
        else if (_partialView == PartialViews.Details)
        {
            <CRM.Client.Pages.Tickets.Info Id="@_idTicket.GetValueOrDefault()" OnGotoIndex="IndexTicket" PageMode="PageModality.Child"></CRM.Client.Pages.Tickets.Info>
            
        }
        else if (_partialView == PartialViews.Edit)
        {
            <CRM.Client.Pages.Tickets.Edit Id="@_idTicket" IdCompany="@_article?.IdCompany" IdArticle=@Id PageMode="PageModality.Child" OnClickSave="TicketCloseForm" OnClickCancel="TicketCloseForm"></CRM.Client.Pages.Tickets.Edit>
        }
    }
    @* else if (selectView == ProductViews.Backups)
    {
        <CRM.Client.Pages.ArticleBackups.Index IdArticle="@Id"></CRM.Client.Pages.ArticleBackups.Index>
    } *@

}