@page "/Articles/Details/{Id:int}"

@if (_article == null)
{
    <Waiting></Waiting>
}
else
{

    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.SerialNumber)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.SerialNumber</p>
        </div>
    </div>
    @if (_article.SaleDate != null)
    {
    
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.SaleDate)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.SaleDate?.ToString("d")</p>
        </div>
    </div>
    }
    @if (_article.DeliveryDate != null)
    {
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.DeliveryDate)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.DeliveryDate?.ToString("d")</p>
        </div>
    </div>
    }
    @if (_article.TestDate != null)
    {
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.TestDate)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
                <p class="mb-0 text-dark">@_article.TestDate?.ToString("d")</p>
        </div>
    </div>
    }
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.IdProduct)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.Product?.Name</p>
        </div>
    </div>
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.IdCompany)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.Company?.RagioneSociale</p>
        </div>
    </div>
    <div class="mb-4">
        <h6 class="text-dark fw-semibold mb-3 d-flex align-items-center">
            <span class="material-icons me-2 text-primary" style="font-size: 20px;">badge</span>
            <DisplayName For="@(() => _article.Description)" />
        </h6>
        <div class="p-3 bg-light rounded border-start border-primary border-4">
            <p class="mb-0 text-dark">@_article.Description</p>
        </div>
    </div>

<div>
    <BlazorButton  Template="TemplateButton.Back" Text="Lista Tipo Prodotti" OnClick="Annulla" />
    <BlazorButton OnClick="Edit" Template="TemplateButton.Edit" Label="true" />
    
</div>
}