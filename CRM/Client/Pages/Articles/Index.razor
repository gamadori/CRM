@page "/Articles"
@page "/Articles/Index"
@page "/Companies/{IdCompany:int}/Articles"

@using Radzen
@using Radzen.Blazor
@using BlazoringComponents.DropDownButton


@if (_articles != null)
{
    <PageHeader Model="@_pageHeader">
    </PageHeader>

    <RadzenDataGrid @ref="grdArticles" IsLoading="@_isLoading" Responsive=@_isResponsable Count="@_paging.TotalCount" Data="@_articles" LoadData="@LoadData" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterMode=@_filterMode 
        AllowSorting="true" AllowFiltering="true" AllowPaging="true"
                    PageSize="@_articletPageSize" PagerHorizontalAlign="Radzen.HorizontalAlign.Center" TItem="ArticleDTO" PagingSummaryFormat="@pagingSummaryFormat" ShowPagingSummary=true>
        <HeaderTemplate>
            <div class="d-flex align-items-center gap-5">
                <RedGButton RGButtonType="RGButtonType.New" Click="@NewItem"></RedGButton>
                <AuthorizeView Policy="@ePolicy.AdminRole.ToString()">
                    <Authorized>
                        <RadzenButton Icon="upload_file" Text="Importa Excel" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(() => NavigationManager.NavigateTo("/Articles/Import"))" />
                    </Authorized>
                </AuthorizeView>
                <RedGTextBox @bind-Value="@_filter.SerialNumber" Label="@Localize["search serial..."]" @oninput="@OnChangeSerialNumberFilter">
                    <End>
                        <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                    </End>
                </RedGTextBox>
               <RedGDropDown TItem="@CompanyDTO" Label="@Localize["search company..."]" TValue="int?" ValueChanged="OnChangeCompany" Data="@_companies" ValueProperty="Id" TextProperty="RagioneSociale" AllowFiltering="true">
                    <End>
                        <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                    </End>
                </RedGDropDown>
                <RedGDropDown TItem="ProductDTO" Label="@Localize["search product..."]" TValue="int?" Data="@_products" ValueChanged="OnChangeProduct" ValueProperty="Id" TextProperty="Name" AllowFiltering="true">
                    <End>
                        <RadzenIcon Icon="search" Style="color: var(--crm-text-muted, #9e9e9e); font-size: 20px;" />
                    </End>
                </RedGDropDown>
            </div>

        </HeaderTemplate>
        <Columns>
            @* <RadzenDataGridColumn Context="item" TItem="Article" Title=@TranslateHelper.GetDisplayName(nameof(Article.SerialNumber), typeof(Article)) Property="@nameof(Article.SerialNumber)" FilterProperty="SerialNumber">
                <Template>
                    <a href="#" class="link-primary" @onclick:preventDefault @onclick="async ()=>await OnClickSerialNumber(item?.Id)">@item?.SerialNumber</a>
                </Template>
            </RadzenDataGridColumn> *@

            <RadzenDataGridColumn TItem="ArticleDTO"
                                  Property="@nameof(ArticleDTO.SerialNumber)"
                                  Title="@Localize["Serial Number"]"
                                  Width="250px">
                <Template Context="item">
                    <div class="d-flex align-items-center py-2">
                        <div class="product-icon bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <span class="material-icons text-primary" style="font-size: 20px;">@MaterialIcons.Article</span>
                        </div>
                        <div>
                            <a href="#" class="link-primary" @onclick:preventDefault @onclick="async () => await OnClickSerialNumber(item?.Id)">@item?.SerialNumber</a>
                        </div>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ArticleDTO"
                                  Property="ProductName"
                                  Title="@Localize["Product"]"
                                  Width="180px">
                <Template Context="item">
                    @if (!string.IsNullOrEmpty(item.ProductName))
                    {
                        <div style="display:inline-flex;align-items:center;gap:8px;white-space:nowrap;">
                            <span class="material-icons text-info" style="font-size:14px;vertical-align:middle;">
                                @MaterialIcons.Catalogo
                            </span>
                            <span title="@item.ProductName">@item.ProductName</span>
                        </div>
                    }
                </Template>
            </RadzenDataGridColumn>
       
            
            <RadzenDataGridColumn TItem="ArticleDTO" Property="CompanyName" Title="@TranslateHelper.GetDisplayName(nameof(Company.RagioneSociale), typeof(Company))" />

            <RadzenDataGridColumn TItem="ArticleDTO" Property="RecipientCompanyName" Title="@TranslateHelper.GetDisplayName(nameof(Article.IdRecipientCompany), typeof(Article))" />


            @if (PageMode != PageHelper.PageModality.Dialog)
            {
                <RadzenDataGridColumn Context="item"
                                      TItem="ArticleDTO"
                                      Filterable="false"
                                      Sortable="false"
                                      TextAlign="Radzen.TextAlign.Center"
                                      Width="200px"
                                      Title="">
                    <Template Context="item">
                        <RedGButton RGButtonType="RGButtonType.View" Click=@(() => Details(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Edit" Click=@(() => Edit(item.Id))></RedGButton>
                        <RedGButton RGButtonType="RGButtonType.Delete" Click=@(() => Delete(item))></RedGButton>

                    </Template>
                </RadzenDataGridColumn>
           }
        </Columns>
    </RadzenDataGrid>
}
else
{
    <Waiting></Waiting>
}
