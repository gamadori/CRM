@page "/Articles/New"
@page "/Articles/{Id:int}/Edit"
@page "/Companies/{IdCompany:int}/Articles/{Id:int}/Edit"
@using Radzen
@using Radzen.Blazor

<PageHeader Model="@_pageHeader">
</PageHeader>

@if (_article == null)
{
    <Waiting></Waiting>
}
else
{
   
    <EditForm Model="@_article" OnValidSubmit="HandleValidSubmitAsync">
        <RadzenRow Gap="1rem" class="mb-3">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenStack>
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_article.SerialNumber" For="@(() => _article.SerialNumber)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="ProductDTO" TValue="int?" ValueProperty="Id" TextProperty="@nameof(ProductDTO.Name)" @bind-Value="@_article.IdProduct" For="@(() => _article.IdProduct)"
                                              Data="_products" AllowFiltering="true" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    @* Acquirente *@
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="@nameof(CompanyDTO.Id)" TextProperty="@nameof(CompanyDTO.RagioneSociale)" @bind-Value="@_article.IdCompany" For="@(() => _article.IdCompany)"
                                              Data="_companies" AllowFiltering="true" Disabled="_lockCompany">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_article.Country" For="@(() => _article.Country)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    @* Destinatario *@
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGDropDown TItem="CompanyDTO" TValue="int?" ValueProperty="@nameof(CompanyDTO.Id)" TextProperty="@nameof(CompanyDTO.RagioneSociale)" @bind-Value="@_article.IdRecipientCompany" For="@(() => _article.IdRecipientCompany)"
                                              Data="_companies" AllowFiltering="true">
                                    <End>
                                        <RedGButtonDialog DialogMode="RedGDialog.DialogMode.Selection" OnSelectItem=OnGetRecipientCompany DialogType="RedGDialog.DialogType.Companies"></RedGButtonDialog>
                                    </End>
                                </RedGDropDown>
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="6">
                            <RadzenStack>
                                <RedGTextBox @bind-Value="@_article.RecipientCountry" For="@(() => _article.RecipientCountry)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeSM="4">
                            <RadzenStack>
                                <RedGDateTimePicker @bind-Value="_article.TestDate" For="@(() => _article.TestDate)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="4">
                            <RadzenStack>
                                <RedGDateTimePicker @bind-Value="_article.SaleDate" For="@(() => _article.SaleDate)" />
                            </RadzenStack>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeSM="4">
                            <RadzenStack>
                                <RedGDateTimePicker @bind-Value="_article.DeliveryDate" For="@(() => _article.DeliveryDate)" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RedGTextArea @bind-Value="@_article.Description" For="@(() => _article.Description)" Rows="5" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RedGButton RGButtonType="RGButtonType.Cancel" Click="Annulla" AutoLabel="true" />
        <RedGButton RGButtonType="RGButtonType.Submit" AutoLabel="true" />
    </EditForm>

}