@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Accesso esterno";
    Layout = "_LayoutIdentity";
}

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">

@section Styles {
    <link rel="stylesheet" href="~/css/identity-login.css" asp-append-version="true" />
}

@* Questa pagina si vede solo quando l'accesso NON va a buon fine: quando riesce si viene
   rimandati direttamente all'applicazione. *@
<div class="login-wrapper">
    <div class="login-card login-card-narrow">
        <div class="login-form-pane">
            <div class="login-header">
                <div class="login-logo">
                    <img src="/img/CRMLogin.png" alt="CRM Logo" />
                </div>
            </div>

            <div class="login-body">
                <div class="outcome-box">
                    <span class="material-symbols-outlined outcome-icon">info</span>
                    <h1 class="outcome-title">@Model.OutcomeTitle</h1>
                    <p class="outcome-detail">@Model.OutcomeDetail</p>
                </div>

                <a class="btn-login btn-login-secondary" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span>Torna al login</span>
                </a>

                <div class="footer-text">
                    © 2025 CRM System
                </div>
            </div>
        </div>
    </div>
</div>
