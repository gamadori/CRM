@page
@model InvitedConfirmationModel
@{
    Layout = "_LayoutIdentity";
    ViewData["Title"] = "Registrazione Utente";
}

<h1>@ViewData["Title"]</h1>
<p>

    @if ((bool?)ViewData["Status"] == true)
    {
        <div class="alert alert-success" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:"><use xlink:href="#check-circle-fill" /></svg>
            <h4 class="alert-heading">Conferma Email</h4>
            <p> La Registrazione è stata completata. Prego <a asp-page="./Login">clicca qui per log in</a>.</p>
            <hr>
            <p class="mb-0"></p>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:"><use xlink:href="#exclamation-triangle-fill" /></svg>
            <h4 class="alert-heading">Errore Conferma Email</h4>
            <p>
                Errore durante registrazione dell'utente, contattare l'amministratore del sito.
            </p>
                        <hr>
<p class="mb-0"></p>
        </div>
    }
    </p>

