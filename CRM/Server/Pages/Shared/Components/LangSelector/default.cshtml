@using CRM.Server.Models

@model LanguageSelectorModel


<div class="collapse navbar-collapse" id="navbarNavDarkDropdown">
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="@Model.Language.Flag" alt="@Model.Language.LanguageCode" />
            </a>
            <ul class="dropdown-menu dropdown-menu-dark" style="width:auto!important" >
                @foreach (var lang in Model.Languages)
                {
                    <li><a class="dropdown-item" onclick="return reloadPage('@lang.LanguageCode');" href="#"><img  src="@lang.Flag"/></a></li>


                }
               
            </ul>
        </li>
    </ul>
</div>

<script type="text/javascript">
    function reloadPage(lang) {
        
        document.cookie = "lang=" + lang;
        
       
        window.location.reload();
        return false;
    }

    

</script>