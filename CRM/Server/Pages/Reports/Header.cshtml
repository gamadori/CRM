
@page
@model CRM.Server.Pages.Reports.HeaderModel
@{
   Layout = null;   /*"~/Pages/Shared/_LayoutReport.cshtml";*/

}
<div id="header" style="padding-bottom:5px">
    <table style="font-family: Arial, Helvetica, sans-serif; width: 100%">
        <tr>
            <td>
            @if (Model.Logo != null)
            {
                    <img style="height: 59px;"  src="@Model.Logo" />
                }
            else
            {
                <img src="~/img/report/logo.png" style="height: 59px; width: 295px"></img>
            }
            </td>
            <td style="font-family: Arial, Helvetica, sans-serif; font-size: 14px" class="auto-style4">
                @Model.Company?.Indirizzo - @Model.Company?.Stato
                <br />
                Tel. @Model.Company?.Telefono / Fax @Model.Company?.Fax               
                <br />
                @Model.Company?.Email<br />
                @Model.Company?.Web
               
            </td>
        </tr>
    </table>
    <hr style="color:#0066FF" />
</div>
