  <!-- ✅ COPIA AUTOMATICA SATELLITE ASSEMBLIES PER LOCALIZZAZIONE -->
  <Target Name="CopySatelliteAssemblies" AfterTargets="Build">
    <ItemGroup>
      <SharedSatelliteAssemblies Include="$(OutputPath)..\..\..\Shared\bin\$(Configuration)\$(TargetFramework)\**\*.resources.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedSatelliteAssemblies)" DestinationFolder="$(OutputPath)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="Pages\Shared\_LayoutReport.cshtml" />
    <Content Update="Deployment\app_offline.template.htm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
